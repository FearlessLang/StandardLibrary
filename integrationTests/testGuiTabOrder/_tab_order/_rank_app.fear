use base.Main as Main;
use base.Block as Block;
use base.Void as Void;
use base.Color as Color;
use base.Sections as Sections;
use base.Slot as Slot;
use base.Slots as Slots;
use base.WidthNat as WidthNat;
use base.HeightNat as HeightNat;

TabOrder: Main{ sys -> sys.gui.run{f -> Block#
  .let[mut Slot[mut Sections]] sections= {Slots#[mut Sections]}
  .return{f
    .title "GuiTabOrder: Tab after a replaced content of a section"
    .virtualPixelSpace(WidthNat#400, HeightNat#300)
    .content.pane{::
      .background(Color.ghostWhite)
      .horizontal .maxPerLine 1
      .button{:: .text "Replace the content of section zero" .action{Block#(sections!.content(0).textField{:: .width 300 .height 40 .text "new content zero"}, Void)}}
      .sections{:: .save sections
        .section.textField{:: .width 300 .height 40 .text "title zero"}.and.textField{:: .width 300 .height 40 .text "content zero"}
        .section.textField{:: .width 300 .height 40 .text "title one"}.and.label{:: .text "content one"}
        .expand 0 .pack
        }
      }
    }
  }}
