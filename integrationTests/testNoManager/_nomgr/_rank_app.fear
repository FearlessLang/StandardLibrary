use base.UnitTests as UnitTests;
use base.Test as Test;
use base.Lists as L;

Pub: base.DataRead{}

NoManagerTests: UnitTests{::
  .test NoManagerMessages
  .test NoManagerBadAttenuate
  }

NoManagerMessages: Test{::
  .checkNonDetErrWithSys({::.isMsg{:: == (
     `The message "Show" is not sent: this program was not started by the Fearless manager.`
    )}}, {t -> t.manager.show})
  .checkNonDetErrWithSys({::.isMsg{:: == (
     `The message "Register" is not sent: this program was not started by the Fearless manager.`
    )}}, {t -> base.Block#
      .openIso s = t
      .return{s.manager.register(s.dataRead(Pub).read(L#("path.bin")).readBytes)}
      })
  }

NoManagerBadAttenuate: Test{::
  .checkDetErrWithSys({::.isMsg{:: == (
     `The message "Attenuate" is not sent: "Bad" is not a qualified type name, like "hello.Main".`
    )}}, {t -> t.manager.attenuate("hello", "Bad", {})})
  .checkDetErrWithSys({::.isMsg{:: == (
     `The message "Attenuate" is not sent: "Bad" is not a qualified type name, like "hello.Main".`
    )}}, {t -> t.manager.attenuate("hello", "hello.A", L#("Bad"))})
  }
