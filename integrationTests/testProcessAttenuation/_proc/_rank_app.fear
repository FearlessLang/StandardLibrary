use base.Main as Main;
use base.SystemAttenuator as SystemAttenuator;
use base.NoManager as NoManager;
use base.Error as Error;
use base.Block as Block;
use base.Void as Void;
use base.Str as Str;
use base.Lists as Lists;
use base.RunningMain as RunningMain;
use base.InfoMain as InfoMain;
use base.Info as Info;
use base.Infos as Infos;
use base.Action as Action;
use base.Nat as Nat;
use base.Duration as Duration;
use base.Continue as Continue;
use base.Break as Break;

///Every method reaches the received System, but the download capability is revoked.
NoDownload: SystemAttenuator { u -> {'s
  .try -> u.try; .out -> u.out; .inputCursor -> u.inputCursor; .assetRead -> u.assetRead;
  .download -> Error.nonDeterministic "NoDownload: System.download is revoked.";
  .dataRead -> u.dataRead; .dataReadWrite -> u.dataReadWrite; .manager -> u.manager; .process -> u.process;
  .readLog l -> u.readLog l; .gui -> u.gui; .revocation -> u.revocation;
  .iso -> NoDownload#(u.iso.close); .close -> s;
  }}
///Prints which of the download and manager capabilities it can reach.
Child: Main { sys -> Block#
  .do{ sys.out.println "child starts" }
  .do{ sys.try#(sys.iso.close, {s -> s.download}).run{
    .ok _ -> sys.out.println "child: download ok";
    .info _ -> sys.out.println "child: download revoked";
    }}
  .do{ sys.try#(sys.iso.close, {s -> s.manager}).run{
    .ok _ -> sys.out.println "child: manager ok";
    .info _ -> sys.out.println "child: manager revoked";
    }}
  .return{ sys.out.println "child ends" }
  }
Failing: Main { sys -> Error.msg "the failing main throws" }
///Runs Child with no attenuator and with NoDownload, then Failing: the output shows that every new process keeps the attenuators of this one.
Parent: Main { sys -> Block#
  .do{ sys.out.println "parent starts" }
  .do{ sys.try#(sys.iso.close, {s -> s.manager}).run{
    .ok _ -> sys.out.println "parent: manager ok";
    .info _ -> sys.out.println "parent: manager revoked";
    }}
  .do{ sys.try#(sys.iso.close, {s -> s.process.run(Child, {})}).run{
    .ok _ -> sys.out.println "parent: child ok";
    .info i -> sys.out.println("parent: child failed: "+((i.getMap.get "msg").getMsg));
    }}
  .do{ sys.try#(sys.iso.close, {s -> s.process.run(Child, Lists#[SystemAttenuator](NoDownload))}).run{
    .ok _ -> sys.out.println "parent: child ok";
    .info i -> sys.out.println("parent: child failed: "+((i.getMap.get "msg").getMsg));
    }}
  .do{ sys.try#(sys.iso.close, {s -> s.process.run(Failing, {})}).run{
    .ok _ -> sys.out.println "parent: failing ok";
    .info i -> sys.out.println("parent: failing failed: "+((i.getMap.get "msg").getMsg));
    }}
  .return{ sys.out.println "parent ends" }
  }
///Counts for a while, long enough for a process started with it to be terminated before it ends.
Spin: Main { sys -> Block#
  .var[Nat] i = {0}
  .loop(i, {c -> Block#(c.set((c.get) + 1), (c.get) >= 50000000 ? { .then -> Break#; .else -> Continue# })})
  .return{ sys.out.println "spin ends" }
  }
Twice: InfoMain { sys, arg -> Infos.list(arg, arg) }
FailingInfo: InfoMain { sys, arg -> Error.msg "the failing info main throws" }
SpinInfo: InfoMain { sys, arg -> Block#.do{ Spin.main(sys) }.return{ arg } }
Caught: { #(a: mut Action[Void]): Str -> a.run{.ok _ -> "ok"; .info i -> (i.getMap.get "msg").getMsg} }
///Starts processes and waits for them, ends them, and calls them again once surely terminated.
Starter: Main { sys -> Block#
  .do{ sys.out.println "starter starts" }
  .let[mut RunningMain[Void]] child= {sys.process.start(Child, {})}
  .do{ sys.out.println("child awaited: "+((child.awaitUpTo(Duration.seconds 60)).isSome.str)) }
  .do{ sys.out.println("child again: "+(Caught#(sys.try#(child.iso.close, {r -> Block#.openIso m = r .return{m.await}})))) }
  .do{ sys.out.println("twice: "+((sys.process.run(Twice, Infos.map("line", Infos.msg `a "quoted" word`), {})).str)) }
  .let[mut RunningMain[Info]] twice= {sys.process.start(Twice, Infos.msg "ab", {})}
  .do{ sys.out.println("twice awaited: "+((twice.awaitUpTo(Duration.seconds 60)).str{::})) }
  .do{ sys.try#(sys.iso.close, {s -> s.process.run(FailingInfo, Infos.msg "x", {})}).run{
    .ok _ -> sys.out.println "failing info ok";
    .info i -> sys.out.println("failing info failed: "+((i.getMap.get "msg").getMsg));
    }}
  .let[mut RunningMain[Info]] spinInfo= {sys.process.start(SpinInfo, Infos.msg "x", {})}
  .do{ spinInfo.terminate }
  .do{ sys.out.println "spin info terminated" }
  .let[mut RunningMain[Void]] spin= {sys.process.start(Spin, {})}
  .do{ sys.out.println("spin awaited: "+((spin.awaitUpTo(Duration.milliSeconds 1)).isSome.str)) }
  .do{ spin.terminate }
  .do{ sys.out.println "spin terminated" }
  .do{ sys.out.println("spin again: "+(Caught#(sys.try#(spin.iso.close, {r -> Block#.openIso m = r .return{m.terminate}})))) }
  .let[mut RunningMain[Void]] failing= {sys.process.start(Failing, {})}
  .do{ sys.process.run(Spin, {}) }
  .do{ sys.out.println("failing terminated: "+(Caught#(sys.try#(failing.iso.close, {r -> Block#.openIso m = r .return{m.terminate}})))) }
  .return{ sys.out.println "starter ends" }
  }
