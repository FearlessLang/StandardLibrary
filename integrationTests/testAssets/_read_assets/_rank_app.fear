use base.UnitTests as UnitTests;
use base.Test as Test;
use base.Block as Block;
use base.Str as Str;
use base.UStr as UStr;
use base.BadTextReason as BadTextReason;
use base.StrFixer as StrFixer;
use base.UStrFixer as UStrFixer;
use base.F as F;
use base.Void as Void;

AssetTextReadAsciiTests: UnitTests { ::
  .test AssetTextReadAsciiPlainFiles
  .test AssetTextReadAsciiRepeatedRead
  .test AssetTextReadAsciiConsumeProtocol
  .test AssetOriginalFileName
  }

AssetTextReadAsciiPlainFiles: Test { ::
  .checkWithSys { s->
    AutoLoadTestText
      .readStr(s.assetRead, base.StrCleaners.utf8OrElse{UnexpectedBadStr})
      .assertEq "Hello! We are automatically reading this file!"
    }
  .checkWithSys { s->
    GoodAsciiStr#(AssetTextGoodAscii.readStr(s.assetRead, base.StrCleaners.utf8OrElse{UnexpectedBadStr}))
    }
  .checkWithSys { s->
    GoodAsciiUStr#(AssetTextGoodAscii.readUStr(s.assetRead, base.UStrCleaners.utf8OrElse{UnexpectedBadUStr}))
    }
  .checkWithSys { s->
    GoodAsciiStr#(AssetTextGoodAscii.readStr(s.assetRead, base.StrCleaners.asciiOrElse{UnexpectedBadStr}))
    }
  .checkWithSys { s->
    GoodAsciiUStr#(AssetTextGoodAscii.readUStr(s.assetRead, base.UStrCleaners.asciiOrElse{UnexpectedBadUStr}))
    }
  .checkWithSys { s->
    GoodAsciiStr#(AssetTextGoodAscii.readStr(s.assetRead, base.StrCleaners.latin1OrElse{UnexpectedBadStr}))
    }
  .checkWithSys { s->
    GoodAsciiUStr#(AssetTextGoodAscii.readUStr(s.assetRead, base.UStrCleaners.latin1OrElse{UnexpectedBadUStr}))
    }
  .checkWithSys { s->
    AutoZipLoadSubTestTextInZip
      .readStr(s.assetRead, base.StrCleaners.utf8OrElse{UnexpectedBadStr})
      .assertEq "Hello! We are automatically reading this file from a zip!"
    }
  }

AssetTextReadAsciiRepeatedRead: Test { ::
  .checkWithSys { s-> Block#
    .do { GoodAsciiStr#(AssetTextGoodAscii.readStr(s.assetRead, base.StrCleaners.utf8OrElse{UnexpectedBadStr})) }
    .do { GoodAsciiStr#(AssetTextGoodAscii.readStr(s.assetRead, base.StrCleaners.utf8OrElse{UnexpectedBadStr})) }
    .do { GoodAsciiUStr#(AssetTextGoodAscii.readUStr(s.assetRead, base.UStrCleaners.utf8OrElse{UnexpectedBadUStr})) }
    .do { GoodAsciiUStr#(AssetTextGoodAscii.readUStr(s.assetRead, base.UStrCleaners.utf8OrElse{UnexpectedBadUStr})) }
    .done
    }
  }

AssetTextReadAsciiConsumeProtocol: Test { ::
  .check {
    GoodAsciiStr#(AssetTextGoodAscii.consumeStr("ascii-consume-1", base.StrCleaners.utf8OrElse{UnexpectedBadStr}))
    }
  .checkWithSys { sys -> Block#(
    GoodAsciiStr#(AssetTextGoodAscii.consumeStr("ascii-consume-2", base.StrCleaners.utf8OrElse{UnexpectedBadStr})),
    sys.try#{
      AssetTextGoodAscii.consumeStr("ascii-consume-2", base.StrCleaners.utf8OrElse{UnexpectedBadStr})
      }.assertInfo)}
  .check {
    GoodAsciiStr#(AssetTextGoodAscii.consumeStr("ascii-consume-3a", base.StrCleaners.utf8OrElse{UnexpectedBadStr}))
    }
  .check {
    GoodAsciiStr#(AssetTextGoodAscii.consumeStr("ascii-consume-3b", base.StrCleaners.utf8OrElse{UnexpectedBadStr}))
    }
  .check {
    GoodAsciiUStr#(AssetTextGoodAscii.consumeUStr("ascii-consume-4", base.UStrCleaners.utf8OrElse{UnexpectedBadUStr}))
    }
  .checkWithSys { sys -> Block#(
    GoodAsciiUStr#(AssetTextGoodAscii.consumeUStr("ascii-consume-5", base.UStrCleaners.utf8OrElse{UnexpectedBadUStr})),
    sys.try#{
      AssetTextGoodAscii.consumeUStr("ascii-consume-5", base.UStrCleaners.utf8OrElse{UnexpectedBadUStr})
      }.assertInfo)}
  }

AssetOriginalFileName: Test { ::
  .check { AutoLoadTestText.originalFileName.assertEq "test_text.txt" }
  .check { AssetTextGoodAscii.originalFileName.assertEq "good_ascii.txt" }
  .check { AutoZipLoadSubTestTextInZip.originalFileName.assertEq "test_text_in_zip.txt" }
  }

GoodAsciiStr: F[Str,Void] { ::.assertEq "Hello safe Str!" }

GoodAsciiUStr: F[UStr,Void] { ::.scalarHex.assertEq "0048 0065 006C 006C 006F 0020 0073 0061 0066 0065 0020 0053 0074 0072 0021"}

UnexpectedBadStr: StrFixer { reason, byteOffset, byteLength, rejectedValue ->
  "[unexpected recovery:"
  + (BadTextReasonName#reason)
  + ":"
  + byteOffset
  + ":"
  + byteLength
  + ":"
  + rejectedValue
  + "]"
  }

UnexpectedBadUStr: UStrFixer { reason, byteOffset, byteLength, rejectedValue ->
  (UnexpectedBadStr#(reason,byteOffset,byteLength,rejectedValue)).u
  }
BadTextReasonName: F[BadTextReason,Str] { ::.match {
  .malformedEncoding -> "malformedEncoding";
  .truncatedEncoding -> "truncatedEncoding";
  .notScalar -> "notScalar";
  .notInStr -> "notInStr";
  }}