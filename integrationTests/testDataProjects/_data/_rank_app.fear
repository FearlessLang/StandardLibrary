use base.UnitTests as UnitTests;
use base.Test as Test;
use base.Block as Block;
use base.Try as Try;
use base.Lists as L;

Q: base.UnencodableRecover{ scalar, index -> L#(63.getByte) }
Pub: base.DataRead{}
Notes: base.DataEdit{}
Broken: base.DataRead{}
Gone: base.DataRead{}
Nope: base.DataEdit{}

DataProjectTests: UnitTests{::
  .test DataProjectReads
  .test DataProjectReadErrors
  .test DataProjectWrites
  .test DataProjectWriteErrors
  .test DataProjectDeletes
  .test DataProjectFolderDeletes
  .test DataProjectDeleteErrors
  .test DataProjectLocks
  .test DataProjectsNotReachable
  }

DataProjectReads: Test{::
  .checkWithSys{s -> s.dataRead(Pub).paths({}).assertEq({::}, L#("notes", "pics", "readme.txt", "todo"))}
  .checkWithSys{s -> s.dataRead(Pub).paths(L#("pics")).assertEq({::}, L#("deep", "inner", "one.txt"))}
  .checkWithSys{s -> s.dataRead(Pub).paths(L#("pics", "inner")).assertEq({::}, L#("three.txt"))}
  .checkWithSys{s -> s.dataRead(Pub).read(L#("readme.txt")).label.assertEq "data.Pub/readme.txt"}
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("readme.txt")).readStr(base.StrCleaners.utf8)).assertEq "hi"}
  .checkWithSys{s -> s.dataRead(Pub).read(L#("readme.txt")).readBytes.size.assertEq 2}
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("notes", "a.txt")).readStr(base.StrCleaners.utf8)).assertEq "first"}
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("pics", "deep", "two.txt")).readStr(base.StrCleaners.utf8)).assertEq "deeper"}
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("pics", "inner", "three.txt")).readStr(base.StrCleaners.utf8)).assertEq "nested"}
  .checkWithSys{s -> (s.dataRead(Notes).read(L#("readme.txt")).readStr(base.StrCleaners.utf8)).assertEq "hi"}
  }

DataProjectReadErrors: Test{::
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Pub/none"
    |"names no resource."
    )}}, {t -> t.dataRead(Pub).paths(L#("none"))})
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Pub/.hidden"
    |`is not valid: ".hidden" is not a valid folder name. A folder name uses only lowercase letters, digits and underscores, starts with a letter or an underscore, and is not "con", "prn", "aux", "nul", "com1" to "com9" or "lpt1" to "lpt9".`
    )}}, {t -> t.dataRead(Pub).paths(L#(".hidden"))})
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Pub/notes/b.txt"
    |"names no resource."
    )}}, {t -> t.dataRead(Pub).read(L#("notes", "b.txt"))})
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Pub/"
    |"names the root folder, not a file."
    )}}, {t -> t.dataRead(Pub).read({})})
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Pub/data.fearless"
    |`is not valid: "data.fearless" is not a valid file name.`
    |"A file name is a name, a dot and an extension."
    |`The name uses only lowercase letters, digits and underscores, starts with a letter or an underscore, and is not "con", "prn", "aux", "nul", "com1" to "com9" or "lpt1" to "lpt9".`
    |`The extension is 1 to 16 lowercase letters or digits, other than "zip" and "fearless", or one of "css.map", "d.ts", "d.ts.map", "js.map", "min.css", "min.js", "tar.bz2", "tar.gz", "tar.lz", "tar.lz4", "tar.xz", "tar.zst".`
    )}}, {t -> t.dataRead(Pub).read(L#("data.fearless"))})
  .checkNonDetErrWithSys({::.isMsg{:: == (
     `No data project is mounted on "data.Nope".`
    )}}, {t -> t.dataRead(Nope).paths({})})
  .checkNonDetErrWithSys({::.isMsg{:: == (
     `No dataEdit project is mounted on "data.Nope".`
    )}}, {t -> t.dataEdit(Nope).read(L#("readme.txt"))})
  }

DataProjectWrites: Test{::
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("w1", "b.txt"), "second")}
    .return{(s.dataEdit(Notes).read(L#("w1", "b.txt")).readStr(base.StrCleaners.utf8)).assertEq "second"}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("fresh", "deeper", "c.txt"), "third")}
    .return{(s.dataEdit(Notes).read(L#("fresh", "deeper", "c.txt")).readStr(base.StrCleaners.utf8)).assertEq "third"}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("wz", "deep", "four.txt"), "zipped")}
    .return{s.dataEdit(Notes).paths(L#("wz", "deep")).assertEq({::}, L#("four.txt", "two.txt"))}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("wn", "inner", "three.txt"), "renested")}
    .return{(s.dataEdit(Notes).read(L#("wn", "inner", "three.txt")).readStr(base.StrCleaners.utf8)).assertEq "renested"}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("wf", "new", "five.txt"), "in a new folder of a zip")}
    .return{s.dataEdit(Notes).paths(L#("wf")).assertEq({::}, L#("new", "one.txt"))}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeUStrUtf16Le(L#("u16.txt"), "caf".u("00E9"))}
    .return{s.dataEdit(Notes).read(L#("u16.txt")).readBytes.assertEq({::}, L#(99.getByte, 0.getByte, 97.getByte, 0.getByte, 102.getByte, 0.getByte, 233.getByte, 0.getByte))}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeBytes(L#("raw.bin"), L#(72.getByte, 105.getByte))}
    .return{(s.dataEdit(Notes).read(L#("raw.bin")).readStr(base.StrCleaners.utf8)).assertEq "Hi"}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeStrUtf32Be(L#("u32.txt"), "A")}
    .return{s.dataEdit(Notes).read(L#("u32.txt")).readBytes.assertEq({::}, L#(0.getByte, 0.getByte, 0.getByte, 65.getByte))}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeUStrAscii(L#("ascii.txt"), "caf".u("00E9"), Q)}
    .return{(s.dataEdit(Notes).read(L#("ascii.txt")).readStr(base.StrCleaners.utf8)).assertEq "caf?"}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).writeUStrLatin1(L#("latin1.txt"), "caf".u("00E9 1F600"), Q)}
    .return{s.dataEdit(Notes).read(L#("latin1.txt")).readBytes.assertEq({::}, L#(99.getByte, 97.getByte, 102.getByte, 233.getByte, 63.getByte))}
    }
  }

DataProjectWriteErrors: Test{::
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Notes/Bad.txt"
    |`is not valid: "Bad.txt" is not a valid file name.`
    |"A file name is a name, a dot and an extension."
    |`The name uses only lowercase letters, digits and underscores, starts with a letter or an underscore, and is not "con", "prn", "aux", "nul", "com1" to "com9" or "lpt1" to "lpt9".`
    |`The extension is 1 to 16 lowercase letters or digits, other than "zip" and "fearless", or one of "css.map", "d.ts", "d.ts.map", "js.map", "min.css", "min.js", "tar.bz2", "tar.gz", "tar.lz", "tar.lz4", "tar.xz", "tar.zst".`
    )}}, {t -> t.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("Bad.txt"), "no")})
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Notes/wz/x.zip"
    |`is not valid: "x.zip" is not a valid file name.`
    |"A file name is a name, a dot and an extension."
    |`The name uses only lowercase letters, digits and underscores, starts with a letter or an underscore, and is not "con", "prn", "aux", "nul", "com1" to "com9" or "lpt1" to "lpt9".`
    |`The extension is 1 to 16 lowercase letters or digits, other than "zip" and "fearless", or one of "css.map", "d.ts", "d.ts.map", "js.map", "min.css", "min.js", "tar.bz2", "tar.gz", "tar.lz", "tar.lz4", "tar.xz", "tar.zst".`
    )}}, {t -> t.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("wz", "x.zip"), "no")})
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Notes/other.fearless"
    |`is not valid: "other.fearless" is not a valid file name.`
    |"A file name is a name, a dot and an extension."
    |`The name uses only lowercase letters, digits and underscores, starts with a letter or an underscore, and is not "con", "prn", "aux", "nul", "com1" to "com9" or "lpt1" to "lpt9".`
    |`The extension is 1 to 16 lowercase letters or digits, other than "zip" and "fearless", or one of "css.map", "d.ts", "d.ts.map", "js.map", "min.css", "min.js", "tar.bz2", "tar.gz", "tar.lz", "tar.lz4", "tar.xz", "tar.zst".`
    )}}, {t -> t.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("other.fearless"), "no")})
  .checkNonDetErrWithSys({::.isMsg{:: == (
     `No dataEdit project is mounted on "data.Nope".`
    )}}, {t -> t.dataEdit(Nope).writeStrAsciiUtf8Latin1(L#("x.txt"), "no")})
  }

DataProjectDeletes: Test{::
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("d1", "inner", "three.txt"))}
    .return{s.dataEdit(Notes).paths(L#("d1")).assertEq({::}, L#("keep.txt"))}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("d2", "one.txt"))}
    .return{s.dataEdit(Notes).paths(L#("d2")).assertEq({::}, L#("two.txt"))}
    }
  .checkWithSys{s -> s.dataEdit(Notes).delete(L#("d3", "one.txt"))}
  .checkWithSys{s -> s.dataEdit(Notes).delete(L#("d4", "a.txt"))}
  .checkWithSys{s -> Block#
    .let n= {s.dataEdit(Notes).read(L#("mv", "one.txt"))}
    .do{(n.readStr(base.StrCleaners.utf8)).assertEq "inside"}
    .do{s.dataEdit(Notes).delete(L#("mv", "one.txt"))}
    .do{s.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("mv", "one.txt"), "again")}
    .return{(n.readStr(base.StrCleaners.utf8)).assertEq "again"}
    }
  }

DataProjectFolderDeletes: Test{::
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("of", "sub"))}
    .return{s.dataEdit(Notes).paths(L#("of")).assertEq({::}, L#("keep.txt"))}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("zf", "sub"))}
    .return{s.dataEdit(Notes).paths(L#("zf")).assertEq({::}, L#("keep.txt"))}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("zn", "inner"))}
    .return{s.dataEdit(Notes).paths(L#("zn")).assertEq({::}, L#("keep.txt"))}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("ow"))}
    .return{Try#(s.iso.close, {t -> t.dataEdit(Notes).paths(L#("ow"))}).assertInfo{::.isMsg{:: == (
       "The path data.Notes/ow"
      |"names no resource."
      )}}}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("zw"))}
    .return{Try#(s.iso.close, {t -> t.dataEdit(Notes).paths(L#("zw"))}).assertInfo{::.isMsg{:: == (
       "The path data.Notes/zw"
      |"names no resource."
      )}}}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("op", "sub"))}
    .return{Try#(s.iso.close, {t -> t.dataEdit(Notes).paths(L#("op"))}).assertInfo{::.isMsg{:: == (
       "The path data.Notes/op"
      |"names no resource."
      )}}}
    }
  .checkWithSys{s -> Block#
    .do{s.dataEdit(Notes).delete(L#("zp", "sub"))}
    .return{Try#(s.iso.close, {t -> t.dataEdit(Notes).paths(L#("zp"))}).assertInfo{::.isMsg{:: == (
       "The path data.Notes/zp"
      |"names no resource."
      )}}}
    }
  }

DataProjectDeleteErrors: Test{::
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Notes/d5/b.txt"
    |"names no resource."
    )}}, {t -> t.dataEdit(Notes).delete(L#("d5", "b.txt"))})
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Notes/data.fearless"
    |`is not valid: "data.fearless" is not a valid file name.`
    |"A file name is a name, a dot and an extension."
    |`The name uses only lowercase letters, digits and underscores, starts with a letter or an underscore, and is not "con", "prn", "aux", "nul", "com1" to "com9" or "lpt1" to "lpt9".`
    |`The extension is 1 to 16 lowercase letters or digits, other than "zip" and "fearless", or one of "css.map", "d.ts", "d.ts.map", "js.map", "min.css", "min.js", "tar.bz2", "tar.gz", "tar.lz", "tar.lz4", "tar.xz", "tar.zst".`
    )}}, {t -> t.dataEdit(Notes).delete(L#("data.fearless"))})
  .checkDetErrWithSys({::.isMsg{:: == (
     "The path data.Notes/"
    |"names the root folder, which cannot be deleted."
    )}}, {t -> t.dataEdit(Notes).delete({})})
  .checkNonDetErrWithSys({::.isMsg{:: == (
     `No dataEdit project is mounted on "data.Nope".`
    )}}, {t -> t.dataEdit(Nope).delete(L#("readme.txt"))})
  }

DataProjectsNotReachable: Test{::
  .checkNonDetErrWithSys({::.isMsg{:: == (
     `The root folder of the data project mounted on "data.Gone" cannot be reached.`
    )}}, {t -> t.dataRead(Gone).paths({})})
  .checkNonDetErrWithSys({::.isMsg{:: == (
     "The folder at the path data.Broken/notes"
    |`holds "Bad.txt", which is not a valid resource name: the data project changed while this program runs.`
    )}}, {t -> t.dataRead(Broken).paths(L#("notes"))})
  }

_LockRun: base.InfoMain{sys, arg -> Block#(sys.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("lk", "c.txt"), "run"), arg)}
_LockStart: base.InfoMain{sys, arg -> Block#(sys.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("lk", "d.txt"), "start"), arg)}
DataProjectLocks: Test{::
  .checkWithSys{s -> Block#
    .do{Block#(s.locked[base.Info](L#[base.DataRead](Pub), L#[base.DataEdit](Notes), {s.process.run(_LockRun, base.Infos.msg "", {})}), base.Void)}
    .do{(s.dataEdit(Notes).read(L#("lk", "c.txt")).readStr(base.StrCleaners.utf8)).assertEq "run"}
    .return{s.dataEdit(Notes).delete(L#("lk", "c.txt"))}
    }
  .checkWithSys{s -> Block#
    .let[mut base.CapRunningMain[base.Info]] started= {s.locked[mut base.CapRunningMain[base.Info]](L#[base.DataRead](Pub), L#[base.DataEdit](Notes), {s.process.start(_LockStart, base.Infos.msg "", {})})}
    .do{(s.dataEdit(Notes).read(L#("lk", "d.txt")).readStr(base.StrCleaners.utf8)).assertEq "start"}
    .do{Block#(started.await, base.Void)}
    .return{s.dataEdit(Notes).delete(L#("lk", "d.txt"))}
    }
  .checkWithSys{s -> (s.locked[base.Str](L#[base.DataRead](Pub), L#[base.DataEdit](Notes), {Block#
    .do{s.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("lk", "a.txt"), "locked")}
    .return{(s.dataEdit(Notes).read(L#("lk", "a.txt")).readStr(base.StrCleaners.utf8))+(s.dataRead(Pub).read(L#("readme.txt")).readStr(base.StrCleaners.utf8))}
    })).assertEq "lockedhi"}
  .checkDetErrWithSys({::.isMsg{:: == (
     `The data project mounted on "data.Notes" is used while sys.locked runs, but it is not in the reads or the edits of that sys.locked.`
    )}}, {t -> Block#.openIso s = t .return{s.locked[base.List[base.Str]](L#[base.DataRead](Pub), {}, {s.dataEdit(Notes).paths({})})}})
  .checkDetErrWithSys({::.isMsg{:: == (
     `The data project mounted on "data.Notes" is changed while sys.locked runs, but that sys.locked holds only a read lock of it: it is in the reads, not in the edits.`
    )}}, {t -> Block#.openIso s = t .return{s.locked[base.Void](L#[base.DataRead](Notes), {}, {s.dataEdit(Notes).writeStrAsciiUtf8Latin1(L#("lk", "b.txt"), "no")})}})
  .checkDetErrWithSys({::.isMsg{:: == (
     "sys.locked is called inside the function of another sys.locked."
    )}}, {t -> Block#.openIso s = t .return{s.locked[base.Void](L#[base.DataRead](Pub), {}, {s.locked[base.Void](L#[base.DataRead](Pub), {}, {base.Void})})}})
  }
