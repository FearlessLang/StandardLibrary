use base.Main as Main;
use base.Void as Void;
use base.Nat as Nat;
use base.Block as Block;
use base.Frame as Frame;
use base.Color as Color;
use base.Red as Red;
use base.Green as Green;
use base.Blue as Blue;
use base.Alpha as Alpha;
use base.Label as Label;
use base.Pane as Pane;
use base.Border as Border;
use base.Mouse as Mouse;
use base.Slot as Slot;
use base.Slots as Slots;
use base.KeyStroke as Key;
use base.XInt as X;
use base.YInt as Y;
use base.WidthNat as Width;
use base.HeightNat as Height;
use base.Duration as Duration;
use base.Instant as Instant;
use base.Break as Break;
use base.Continue as Continue;

Live:Main{sys -> sys.gui.run{f -> Block#
  .let[mut Slot[mut Label]] status = {Slots#[mut Label]}
  .let[mut Slot[mut Label]] countB = {Slots#[mut Label]}
  .let[mut Slot[mut Label]] countD = {Slots#[mut Label]}
  .let[mut Slot[mut Pane]] areaA = {Slots#[mut Pane]}
  .let[mut Slot[mut Pane]] areaB = {Slots#[mut Pane]}
  .let[mut Slot[mut Pane]] root = {Slots#[mut Pane]}
  .let[mut Slot[mut Mouse]] oldC = {Slots#[mut Mouse]}
  .let[mut Slot[mut Label]] hover = {Slots#[mut Label]}
  .let[mut Slot[mut Label]] grown = {Slots#[mut Label]}
  .let[mut Slot[mut Pane]] cleared = {Slots#[mut Pane]}
  .let[mut Slot[mut Border]] replaced = {Slots#[mut Border]}
  .let[mut Slot[mut Label]] swapped = {Slots#[mut Label]}
  .var[Nat] pressedB = {0}
  .var[Nat] releasedB = {0}
  .var[Nat] pressedD = {0}
  .var[Nat] releasedD = {0}
  .return{f
    .title "GuiLive: live changes are atomic"
    .onKey{::
      .pressed{:: .matchOnly(Key#"SPACE") .doOnly{e -> Block#
        .do{pressedD.set(pressedD.get + 1)}
        .return{Block#(countD!.text("SPACE pressed "+(pressedD.get.str)+", released "+(releasedD.get.str)), Void)}
        }}
      .released{:: .matchOnly(Key#"SPACE") .doOnly{e -> Block#
        .do{releasedD.set(releasedD.get + 1)}
        .return{Block#(countD!.text("SPACE pressed "+(pressedD.get.str)+", released "+(releasedD.get.str)), Void)}
        }}
      }
    .content{::
      .background(Color.ghostWhite)
      .save root
      .pane{::
        .vertical
        .label{:: .text "status: none" .save status}
        .label{:: .text "A: press Add. For 3 seconds a button is built: nothing may appear in the green area."}
        .label{:: .text "Then a yellow New button appears; clicking it must set the status to: New ran"}
        .pane{::
          .width 520 .height 50
          .background(Color.alienMint)
          .mouse{:: .clicked{e -> Block#(status!.text "status: green area clicked", Void)}}
          .save areaA
          }
        .button{:: .text "Add" .action{Block#(areaA!.button{b -> Block#
          .do{Block#(b.text "New", Void)}
          .do{LiveWait#(f, Duration.seconds 3)}
          .do{Block#(b.background(Color.rubberDuck), Void)}
          .return{b.action{Block#(status!.text "status: New ran", Void)}}
          }, Void)}}
        .label{:: .text "B: press Rebind, then within 3 seconds click the blue area: the two counts must stay equal."}
        .label{:: .text "pressed 0, released 0" .save countB}
        .pane{::
          .width 520 .height 50
          .background(Color.sleepyBlue)
          .mouse{::
            .pressed{e -> Block#
              .do{pressedB.set(pressedB.get + 1)}
              .return{Block#(countB!.text("pressed "+(pressedB.get.str)+", released "+(releasedB.get.str)), Void)}
              }
            .released{e -> Block#
              .do{releasedB.set(releasedB.get + 1)}
              .return{Block#(countB!.text("pressed "+(pressedB.get.str)+", released "+(releasedB.get.str)), Void)}
              }
            }
          .save areaB
          }
        .button{:: .text "Rebind" .action{Block#(areaB!.mouse{m -> Block#
          .do{Block#(m.pressed{e -> Block#
            .do{pressedB.set(pressedB.get + 1)}
            .return{Block#(countB!.text("pressed "+(pressedB.get.str)+", released "+(releasedB.get.str)), Void)}
            }, Void)}
          .do{LiveWait#(f, Duration.seconds 3)}
          .return{m.released{e -> Block#
            .do{releasedB.set(releasedB.get + 1)}
            .return{Block#(countB!.text("pressed "+(pressedB.get.str)+", released "+(releasedB.get.str)), Void)}
            }}
          }, Void)}}
        .label{:: .text "C: click the purple area: the status must be: second .mouse ran"}
        .pane{p -> Block#
          .do{Block#(p.width 520 .height 50 .background(Color.wizardPurple), Void)}
          .do{Block#(p.mouse{:: .save oldC .clicked{e -> Block#(status!.text "status: first .mouse ran", Void)}}, Void)}
          .do{Block#(p.mouse{:: .clicked{e -> Block#(status!.text "status: second .mouse ran", Void)}}, Void)}
          .do{Block#(oldC!.clicked{e -> Block#(status!.text "status: a builder saved from the replaced .mouse added a handler", Void)}, Void)}
          .return{p}
          }
        .label{:: .text "D: hold SPACE for 2 seconds, then release it: each count must grow by exactly one."}
        .label{:: .text "SPACE pressed 0, released 0" .save countD}
        .label{:: .text "E: press Gray: the whole window turns gray (160,160,160) up to its corners; then Red: it turns opaque red (230,64,48)."}
        .pane{::
          .button{:: .text "Gray" .action{Block#(root!.radius 20 .background(Color.transparent), Void)}}
          .button{:: .text "Red" .action{Block#(root!.background(Color#(Red#(230.getByte), Green#(64.getByte), Blue#(48.getByte), Alpha#(128.getByte))), Void)}}
          }
        .label{:: .text "F: drag the window so its bottom right corner is near the screen's, then press Fix: it becomes 840x900 and nothing fails."}
        .label{:: .text "G: press Resizable, make the window larger by dragging its edge, then press Corner: it moves to the bottom right and nothing fails."}
        .label{:: .text "H: hold SPACE, click Swap keys while holding it, then release SPACE: the two SPACE counts of D must be equal."}
        .pane{::
          .button{:: .text "Fix" .action{Block#(f.fixedSize(840, 900), Void)}}
          .button{:: .text "Resizable" .action{Block#(f.resizable, Void)}}
          .button{:: .text "Corner" .action{Block#(f.location'(X.origin + (f.screenWidth - (Width#840)), Y.origin + (f.screenHeight - (Height#900))), Void)}}
          .button{:: .text "Swap keys" .action{Block#(f.onKey{::
            .pressed{:: .matchOnly(Key#"SPACE") .doOnly{e -> Block#
              .do{pressedD.set(pressedD.get + 1)}
              .return{Block#(countD!.text("SPACE pressed "+(pressedD.get.str)+", released "+(releasedD.get.str)), Void)}
              }}
            .released{:: .matchOnly(Key#"SPACE") .doOnly{e -> Block#
              .do{releasedD.set(releasedD.get + 1)}
              .return{Block#(countD!.text("SPACE pressed "+(pressedD.get.str)+", released "+(releasedD.get.str)), Void)}
              }}
            }, Void)}}
          }
        }
      .pane{::
        .vertical
        .label{:: .text "I to M: click at the spot given, then do not move: hover must show the text given."}
        .label{:: .text "hover: none" .save hover}
        .label{:: .text "I: at the left edge of Grow: the label grows, Grow moves right and is not highlighted; hover: label I"}
        .pane{::
          .pane{:: .mouse{:: .entered{e -> Block#(hover!.text "hover: label I", Void)}} .label{:: .text "I" .save grown}}
          .pane{:: .mouse{:: .entered{e -> Block#(hover!.text "hover: Grow", Void)}} .button{:: .text "Grow" .action{Block#(grown!.text(grown!.text + " WWWWWWWWWW"), Void)}}}
          }
        .label{:: .text "J: at the middle of Clear: a green box takes the place of Clear; hover: box J"}
        .pane{::
          .width 520 .height 50
          .background(Color.cardboard)
          .mouse{:: .entered{e -> Block#(hover!.text "hover: area J", Void)}}
          .save cleared
          .button{:: .text "Clear" .action{Block#(cleared!.clear.pane{::
            .width 200 .height 30
            .background(Color.goblinGreen)
            .mouse{:: .entered{e -> Block#(hover!.text "hover: box J", Void)}}
            }, Void)}}
          }
        .label{:: .text "K: at the middle of Replace: a blue box takes the place of Replace; hover: box K"}
        .border{::
          .width 520 .height 50
          .background(Color.cardboard)
          .mouse{:: .entered{e -> Block#(hover!.text "hover: area K", Void)}}
          .save replaced
          .center{:: .button{:: .text "Replace" .action{Block#(replaced!.center{::
            .background(Color.sleepyBlue)
            .mouse{:: .entered{e -> Block#(hover!.text "hover: box K", Void)}}
            }, Void)}}}
          }
        .label{:: .text "L: at the middle of Nudge: the window moves 100 pixels sideways, Nudge is not highlighted; hover: left box L or right box L"}
        .pane{::
          .pane{:: .width 100 .height 30 .background(Color.dustyRose) .mouse{:: .entered{e -> Block#(hover!.text "hover: left box L", Void)}}}
          .pane{:: .mouse{:: .entered{e -> Block#(hover!.text "hover: Nudge", Void)}} .button{:: .text "Nudge" .action{Block#
            .let[X] x = {f.locationX}
            .let[X] to = {(x >= (X#(+100))).if{.then -> x - (Width#100); .else -> x + (Width#100)}}
            .return{Block#(f.location'(to, f.locationY), Void)}
            }}}
          .pane{:: .width 100 .height 30 .background(Color.dustyRose) .mouse{:: .entered{e -> Block#(hover!.text "hover: right box L", Void)}}}
          }
        .label{:: .text "M: at the middle of Swap content: the window shows only: M: the new content was entered"}
        .button{:: .text "Swap content" .action{f.content{::
          .background(Color.ghostWhite)
          .mouse{:: .entered{e -> Block#(swapped!.text "M: the new content was entered", Void)}}
          .label{:: .text "M: the new content was not entered" .save swapped}
          }}}
        }
      }
    }
  }}
LiveWait: {#(f: read Frame, d: Duration): Void -> Block#
  .let[Instant] end = {f.elapsed + d}
  .loop{Block#
    .if{f.elapsed >= end} .return{Break#}
    .return{Continue#}
    }
  .done
  }
