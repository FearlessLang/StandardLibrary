use base.UnitTests as UnitTests;
use base.Test as Test;
use base.Block as Block;
use base.Try as Try;
use base.Lists as L;

Recover: base.StrFixer { reason, byteOffset, byteLength, rejectedValue -> "?" }
Pub: base.DataRead{}
Base: { #(s: mut base.System): base.Str -> s.dataRead(Pub).read(L#("base.txt")).readStr(base.StrCleaners.utf8) }

DownloadTests: UnitTests{::
  .test DownloadsThatSucceed
  .test DownloadsRefusedByTheirUrl
  .test DownloadsThatFail
  }

DownloadsThatSucceed: Test{::
  .checkWithSys{s -> s.download.downloadStr(Base#s+"/ok", 1000, base.StrCleaners.utf8).assertEq "hello download"}
  .checkWithSys{s -> s.download.downloadBytes(Base#s+"/bytes", 1000).assertEq({::}, L#(65.getByte, 66.getByte, 67.getByte))}
  .checkWithSys{s -> s.download.downloadStr(Base#s+"/start", 1000, base.StrCleaners.utf8).assertEq "landed"}
  .checkWithSys{s -> s.download.downloadStr(Base#s+"/accent", 1000, base.StrCleaners.utf8OrElse{Recover}).assertEq "caf?"}
  .checkWithSys{s -> s.download.downloadUStr(Base#s+"/accent", 1000, base.UStrCleaners.utf8).size.assertEq 4}
  .checkWithSys{s -> s.download.downloadImage(Base#s+"/img.png", 100000, 1000000).width.get.assertEq 3}
  }

DownloadsRefusedByTheirUrl: Test{::
  .checkDetErrWithSys({::.isMsg{:: == (
     "Invalid URL descriptor."
    |"unsupported scheme (only http/https allowed): ftp in ftp://127.0.0.1/x"
    )}}, {t -> t.download.downloadStr("ftp://127.0.0.1/x", 1000, base.StrCleaners.utf8)})
  .checkDetErrWithSys({::.isMsg{::.startsWith(
     "Invalid URL descriptor."
    |""
    )}}, {t -> t.download.downloadStr("not a url", 1000, base.StrCleaners.utf8)})
  .checkDetErrWithSys({::.isMsg{:: == (
     "Invalid URL descriptor."
    |"port out of range: 99999"
    |"url: http://127.0.0.1:99999/x"
    )}}, {t -> t.download.downloadStr("http://127.0.0.1:99999/x", 1000, base.StrCleaners.utf8)})
  }

DownloadsThatFail: Test{::
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadBytes(b+"/big", 4)}).assertInfo{::.isMsg{:: == (
       "Download exceeds maxBytes."
      |"url: "+b+"/big"
      |"bytesRead: 10"
      |"maxBytes: 4"
      )}}}
    }
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadBytes(b+"/chunked", 4)}).assertInfo{::.isMsg{:: == (
       "Download exceeds maxBytes."
      |"url: "+b+"/chunked"
      |"bytesRead: 10"
      |"maxBytes: 4"
      )}}}
    }
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadStr(b+"/accent", 1000, base.StrCleaners.utf8)}).assertInfo{:: > "msg" .isMsg{:: == "StrCleaners.utf8: notInStr: the byte sequence C3 A9 at byte offset 3 of the line encodes U+00E9, which is not a character of Str; the characters of Str are U+000A and U+0020 to U+007E"} & > "line" .isMsg{:: == "1"} & > "col" .isMsg{:: == "5"}}}
    }
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadStr(b+"/loop", 1000, base.StrCleaners.utf8)}).assertInfo{::.isMsg{:: == (
       "Download failed."
      |"url: "+b+"/loop"
      |"too many redirects"
      )}}}
    }
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadStr(b+"/file", 1000, base.StrCleaners.utf8)}).assertInfo{::.isMsg{:: == (
       "Invalid URL descriptor."
      |"unsupported scheme (only http/https allowed): file in file:///etc/passwd"
      )}}}
    }
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadStr(b+"/missing", 1000, base.StrCleaners.utf8)}).assertInfo{::.isMsg{:: == (
       "Download failed."
      |"url: "+b+"/missing"
      |"HTTP status: 404"
      )}}}
    }
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadStr(b+"/back", 1000, base.StrCleaners.utf8)}).assertInfo{::.isMsg{:: == (
       "Download failed."
      |"url: "+b+"/missing"
      |"HTTP status: 404"
      )}}}
    }
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadStr(b+"/space", 1000, base.StrCleaners.utf8)}).assertInfo{::.isMsg{:: == (
       "Download failed."
      |"url: "+b+"/space"
      |"redirect to a malformed Location: /a b"
      )}}}
    }
  .checkWithSys{s -> Block#
    .let b= {Base#s}
    .return{Try#(s.iso.close, {t -> t.download.downloadStr(b+"/ftp", 1000, base.StrCleaners.utf8)}).assertInfo{::.isMsg{:: == (
       "Invalid URL descriptor."
      |"unsupported scheme (only http/https allowed): ftp in ftp://127.0.0.1/caf%C3%A9"
      )}}}
    }
  }
