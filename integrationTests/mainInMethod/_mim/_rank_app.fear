use base.Main as Main;

///A main declared at the top level: it is one of the mains of this package.
TopMain:Main{s->base.Debug#("top level main")}

///A main declared inside a method: a main captures nothing, so it has an instance,
///and it is a main of this package too, even though it is written inside "MkFree.mk".
MkFree:{.mk:Main->FreeMain:Main{s->base.Debug#("capture free main in a method")}}
