use base.Main as Main;
use base.Nat as Nat;
use base.RunRecursion as RunRecursion;
use base.Debug as Debug;
use base.Error as Error;
use base.Try as Try;

Naive: {#(n: Nat): Nat -> (n == 0).if{.then -> 0; .else -> n + (this#(n - 1))}}
SumBy: {#(r: RunRecursion, n: Nat): Nat -> (n == 0).if{.then -> 0; .else -> n + (r#{this#(r, n - 1)})}}
Crowded: RunRecursion{.depth -> 1_000_000; .stackSize -> 1_048_576}
Spread: RunRecursion{.depth -> 100; .stackSize -> 1_048_576}
Inner: RunRecursion{.depth -> 10}
Mixed: {#(n: Nat): Nat -> (n == 0).if{.then -> 0; .else -> SumBy#(Inner, 20) + (RunRecursion#{this#(n - 1)})}}
Nest: {.size: Nat}
Build: {#(n: Nat): Nest -> (n == 0).if{.then -> {0}; .else -> Wrap#(RunRecursion#{this#(n - 1)})}}
Wrap: {#(inner: Nest): Nest -> {RunRecursion#{inner.size} + 1}}
Two: RunRecursion{.depth -> 2}
Fail: {#(n: Nat): Nat -> (n == 0).if{.then -> Error.msg "deep boom"; .else -> Two#{this#(n - 1)}}}

NaiveSum: Main{s -> Debug#(Naive#1_000_000)}
DeepSum: Main{s -> Debug#(SumBy#(RunRecursion, 1_000_000))}
CrowdedSum: Main{s -> Debug#(SumBy#(Crowded, 1_000_000))}
SpreadSum: Main{s -> Debug#(SumBy#(Spread, 1_000_000))}
MixedSum: Main{s -> Debug#(Mixed#10_000)}
NestSize: Main{s -> Debug#(Build#1_000_000.size)}
ErrorsPropagate: Main{s -> Debug#(Try#{RunRecursion#{RunRecursion#[Nat]{Error.msg "deep boom"}}}.run{.ok n -> n.str; .info i -> i.softMsg})}
GluedTrace: Main{s -> Debug#(Fail#4)}
