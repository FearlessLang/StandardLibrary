use base.Main as Main;
use base.Block as Block;
use base.Void as Void;
use base.Var as Var;
use base.Color as Color;
use base.Pane as Pane;
use base.Slot as Slot;
use base.Slots as Slots;
use base.WidthNat as WidthNat;
use base.HeightNat as HeightNat;
use base.CapInputCursor as CapInputCursor;
use base.StrCleaners as StrCleaners;

ShowInput: Main { sys -> sys.gui.run{f -> Block#
  .let[mut Slot[mut Pane]] lines= {Slots#[mut Pane]}
  .var[mut CapInputCursor] at= {sys.inputCursor}
  .return{f
    .title "Show input: drop more files here"
    .virtualPixelSpace(WidthNat#600, HeightNat#400)
    .modelFps(10, {:: .action{ShowFiles#(at, lines!)}})
    .content.pane{::
      .background (Color.ghostWhite)
      .vertical .minPerLine 1000000 .heightGap 0
      .save lines
      }
    }
  }}
ShowFiles: {#(at: mut Var[mut CapInputCursor], lines: mut Pane): Void -> at.get#.match{
  .empty -> Void;
  .some file -> Block#
    .do{(file.readStr(StrCleaners.text)).split("" | "").flow.for{l -> Block#(lines.label{:: .text l .topInset 0 .bottomInset 0}, Void)}}
    .do{at.set(at.get.next)}
    .return{this#(at, lines)}
  }}
