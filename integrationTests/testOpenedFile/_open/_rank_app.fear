use base.UnitTests as UnitTests;
use base.Test as Test;
use base.Lists as L;

Recover: base.StrFixer { reason, byteOffset, byteLength, rejectedValue -> "?" }
Name: base.F[base.BadTextReason,base.Str]{ ::.match{
  .malformedEncoding -> "malformedEncoding";
  .truncatedEncoding -> "truncatedEncoding";
  .notScalar -> "notScalar";
  .notInStr -> "notInStr";
  }}
Show: base.StrFixer { reason, byteOffset, byteLength, rejectedValue ->
  "["+(Name#reason)+":"+byteOffset+":"+byteLength+":"+rejectedValue+"]"
  }
Pub: base.DataRead{}

OpenedFileTests: UnitTests{::
  .test TheOpenedFile
  .test TextCutByTheEndOfTheBytes
  .test TheCleaners
  }

TheOpenedFile: Test{::
  .checkWithSys{s -> s.inputCursor#.isSome.assertTrue}
  .checkWithSys{s -> s.inputCursor#.match{.some n -> n.label; .empty -> "none"}.assertEq "not?s.txt"}
  .checkWithSys{s -> s.inputCursor#.match{.some n -> n.readStr(base.StrCleaners.utf8OrElse{Recover}); .empty -> "none"}.assertEq "caf? time"}
  .checkWithSys{s -> s.inputCursor.next#.isSome.assertFalse}
  }

TextCutByTheEndOfTheBytes: Test{::
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("cut8.bin")).readStr(base.StrCleaners.utf8OrElse{Show})).assertEq "a[truncatedEncoding:1:2:226]"}
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("cut16.bin")).readStr(base.StrCleaners.utf16LeOrElse{Show})).assertEq "a[truncatedEncoding:2:2:55357]"}
  }

TheCleaners: Test{::
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("mixed.bin")).readUStr(base.UStrCleaners.text)).scalarHex.assertEq "0061 000A 0062 000A 0063 000A 0064 00E9 FFFD 000A"}
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("mixed.bin")).readStr(base.StrCleaners.text)).assertEq("a" | "b" | "c" | "de?" | "")}
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("mixed.bin")).readUStr(base.UStrCleaners.line)).scalarHex.assertEq "0061 0020 0062 0020 0063 0020 0064 00E9 FFFD 0020"}
  .checkDetErrWithSys({::.isMsg{:: == "UStrCleaners.utf8: malformedEncoding: the bytes FF at byte offset 13 of the line are not UTF-8"}}, {s -> s.dataRead(Pub).read(L#("mixed.bin")).readUStr(base.UStrCleaners.utf8)})
  .checkWithSys{s -> (s.dataRead(Pub).read(L#("cut8.bin")).readStr(base.StrCleaners.utf8Then{mut base.StrScalarCleaner{.nextScalar n -> "<"+(n.str)+">"; .end -> "!"}})).assertEq "<97><65533>!"}
  }