CellMatch[R:**]: { mut .empty: R; mut .x: R; mut .o: R; }

Cell: Sealed, WidenTo[Cell] {
  .match[R:**](m: mut CellMatch[R]): R;
  .isEmpty: Bool -> this.match{.empty->True; .x->False; .o->False};
  .isX: Bool -> this.match{.x->True; .empty->False; .o->False};
  .isO: Bool -> this.match{.o->True; .empty->False; .x->False};
  .text: Str -> this.match{.empty->" "; .x->"X"; .o->"O"};
  }
CellEmpty: Cell { ::.empty }
CellX: Cell { ::.x }
CellO: Cell { ::.o }

AllLines:F[mut List[mut List[Nat]]]{Lists#(
  Lists#(0,1,2), Lists#(3,4,5), Lists#(6,7,8),
  Lists#(0,3,6), Lists#(1,4,7), Lists#(2,5,8),
  Lists#(0,4,8), Lists#(2,4,6)
  )}

EmptyBoard:F[mut List[Cell]]{ (0=~~=8).flow.map{_ -> CellEmpty}.list }

Winner: { #(board: mut List[Cell]): mut Opt[Cell] -> AllLines#.flow.mapFilter{line -> board.get(line.get 0).match{
  .empty -> {};
  .x -> (board.get(line.get 1).isX && {board.get(line.get 2).isX}).toOpt{CellX};
  .o -> (board.get(line.get 1).isO && {board.get(line.get 2).isO}).toOpt{CellO};
  }}.first }

Models: { #: mut Model -> Block#
  .var board       = { EmptyBoard# }
  .var turn        = { True }
  .let slots      = { (0=~~=8).flow.map{_ -> Slots#[mut Button]}.list }
  .let statusSlot = { Slots#[mut Label] }
  .return { mut Model: Pipe[mut Model] {'self
    .close -> self;
    mut .slot(i: Nat): mut Slot[mut Button] -> slots.get(i);
    mut .statusSlot: mut Slot[mut Label] -> statusSlot;
    mut .cell(i: Nat): Cell -> board.get.get(i);
    mut .cellText(i: Nat): Str -> self.cell(i).text;
    mut .winner: mut Opt[Cell] -> Winner#(board.get);
    mut .full: Bool -> board.get.flow.all{c -> c.isEmpty.not};
    mut .status: Str -> self.winner.match{
      .some m -> m.text + " wins!";
      .empty -> self.full.if{.then->"Draw!"; .else->(turn.get?{.then->"X"; .else->"O"}) + "'s turn"};
      };
    mut .play(i: Nat): Void -> (self.cell(i).isEmpty && {self.winner.isEmpty}).thenDo{Block#(
      board.set(board.get.with(i, turn.get?{.then->CellX; .else->CellO})),
      turn.set(turn.get.not),
      self.refresh)};
    mut .reset: Void -> Block#(
      board.set(EmptyBoard#),
      turn.set(True),
      self.refresh
      );
    //Button-cell slots are only populated by button-based UIs (Frozen,
    //Chunk); a canvas-based UI (Resizable) never creates or .saves those
    //Buttons, so the per-cell text push is skipped where a slot was never
    //filled rather than throwing on Slot!.
    mut .refresh: Void -> Block#(
      statusSlot!.text(self.status),
      (0=~~=8).flow.forEach{i -> Block#(slots.get(i).isFull.thenDo{Block#(slots.get(i)!.text(self.cellText(i)), Void)}, Void)},
      Void);
    }}}
