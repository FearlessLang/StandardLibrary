CellButton: { #(model: mut Model, i: Nat): mut Scope[Button] -> {::
  .width 60
  .height 60
  .textHeight 28
  .text(model.cellText(i))
  .action{model.play(i)}
  .save(model.slot(i))
  }}

Row: { #(model: mut Model, line: mut List[Nat]): mut Scope[Pane] -> {::
  .button(CellButton#(model, line.get 0))
  .button(CellButton#(model, line.get 1))
  .button(CellButton#(model, line.get 2))
  }}

Gui: Consumer[mut Frame] {
  mut .model: mut Model;
  ::
  .title "Tic-Tac-Toe"
  .content{::
    .background (Color.ghostWhite)
    .label{:: .text(this.model.status) .save(this.model.statusSlot) }
    .pane(Row#(this.model, AllLines#.get 0))
    .pane(Row#(this.model, AllLines#.get 1))
    .pane(Row#(this.model, AllLines#.get 2))
    .button{:: .text "New Game" .action{this.model.reset} }
    }
  }
