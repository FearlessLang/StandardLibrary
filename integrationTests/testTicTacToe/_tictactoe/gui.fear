//Entry screen: pick which of the three layout techniques to open. Each
//button opens its own frame (independent Model, so games don't interfere),
//and the chooser stays open so the three can be compared side by side.
ChooserGui: Consumer[mut Frame] {
  mut .gui: mut GuiC;
  ::
  .title "Tic-Tac-Toe: pick a layout"
  .content{::
    .background (Color.ghostWhite)
    .label{:: .text "Three ways to lay out the 3x3 board:" }
    .button{:: .text "Frozen (fixed window)" .action{Models# |>{ m -> this.gui.run(mut FrozenGui{.model->m}) }} }
    .button{:: .text "Chunked grid (.chunk 3)" .action{Models# |>{ m -> this.gui.run(mut ChunkGui{.model->m}) }} }
    .button{:: .text "Resizable square (canvas)" .action{this.gui.run(ResizableGuis#(Models#, Slots#[mut Pane]))} }
    }
  }
