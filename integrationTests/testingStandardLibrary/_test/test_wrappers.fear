ExtentNatTests: Test {::
  .check{(Width#3) + (Width#4) .assertEq(Width#7)}
  .check{(Width#7) - (Width#4) .assertEq(Width#3)}
  .check{(Width#3) * 4 .assertEq(Width#12)}
  .check{(Width#7) .getTruncDiv 2 .assertEq(Width#3)}
  .check{Width.zero .assertEq(Width#0)}
  .check{(Height#3) + (Height#4) .assertEq(Height#7)}
  .checkDetErr({_ -> True}, {(Width#3) - (Width#4)})
  .checkDetErr({_ -> True}, {(Width#2) * (Math.maxNat)})
  }

ExtentNatGapTests: Test {::
  .check{(Width#3) .gap(Width#7) .assertEq(Width#4)}
  .check{(Width#7) .gap(Width#3) .assertEq(Width#4)}
  .check{(Width#5) .gap(Width#5) .assertEq(Width.zero)}
  .check{(Width#0) .gap(Width#(Math.maxNat)) .assertEq(Width#(Math.maxNat))}
  }

CoordIntNegativeTests: Test {::
  .check{(X#(-5)) + (Width#3) .assertEq(X#(-2))}
  .check{(X#(-5)) - (Width#3) .assertEq(X#(-8))}
  .check{X.origin - (Width#7) .assertEq(X#(-7))}
  .check{(X#(-7)) .to(X#(+3)) .assertEq(Width#10)}
  .check{(X#(-7)) .gap(X#(+3)) .assertEq(Width#10)}
  .check{(X#(+3)) .gap(X#(-7)) .assertEq(Width#10)}
  .check{(X#(-7)) .gap(X#(-2)) .assertEq(Width#5)}
  .check{(X#(-5)) < (X.origin) .assertTrue}
  .check{Rects#(X#(-10), Y#(-10), Width#30, Height#30) .contains(X#(-5), Y#(-5)) .assertTrue}
  .check{Rects#(X#(-10), Y#(-10), Width#30, Height#30) .contains(X#(+21), Y#(+0)) .assertFalse}
  .check{Rects#(X#(-10), Y#(-10), Width#30, Height#30) .right .assertEq(X#(+20))}
  .checkDetErr({_ -> True}, {(X#(+3)) .to(X#(-7))})
  }

CoordIntTests: Test {::
  .check{(X#(+10)) + (Width#5) .assertEq(X#(+15))}
  .check{(X#(+10)) - (Width#5) .assertEq(X#(+5))}
  .check{(Y#(+10)) + (Height#5) .assertEq(Y#(+15))}
  .check{(Y#(+10)) - (Height#5) .assertEq(Y#(+5))}
  .check{X.origin .assertEq(X#(+0))}
  .check{Y.origin .assertEq(Y#(+0))}
  .check{(X#(+3)) - (Width#4) .assertEq(X#(-1))}
  }

CoordIntDiffTests: Test {::
  .check{(X#(+3)) .to(X#(+10)) .assertEq(Width#7)}
  .check{(Y#(+3)) .to(Y#(+10)) .assertEq(Height#7)}
  .check{(X#(+3)) .gap(X#(+10)) .assertEq(Width#7)}
  .check{(X#(+10)) .gap(X#(+3)) .assertEq(Width#7)}
  .check{(X#(+0)) .gap(X#(Math.maxInt)) .assertEq(Width#(Math.maxInt.getNat))}
  .checkDetErr({_ -> True}, {(X#(+10)) .to(X#(+3))})
  }

CoordIntRoundTripTests: Test {::
  .check{(X#(+4)) + ((X#(+4)) .to(X#(+9))) .assertEq(X#(+9))}
  .check{(X#(+9)) - ((X#(+4)) .to(X#(+9))) .assertEq(X#(+4))}
  .check{(Width#40) .getTruncDiv 2 .assertEq((Width#100) .getTruncDiv 5)}
  }

WrapperNatAgreementTests: Test {::
  .check{(Width#200) * 2 .getTruncDiv 5 .assertEq(Width#(200 * 2 .aluDiv 5))}
  .check{(Width#500) .getTruncDiv 12 .assertEq(Width#(500 .aluDiv 12))}
  .check{X.origin + (((Width#500) - (Width#200)) .getTruncDiv 2) .assertEq(X#((500 - 200) .aluDiv 2 .getInt))}
  .check{((X#(+7)) >= (X#(+3))) && {(X#(+7)) <= ((X#(+3)) + (Width#10))} .assertEq(7 .inRange(3 =~~= (3 + 10)))}
  .check{((X#(+2)) >= (X#(+3))) && {(X#(+2)) <= ((X#(+3)) + (Width#10))} .assertEq(2 .inRange(3 =~~= (3 + 10)))}
  .check{((X#(+20)) >= (X#(+3))) && {(X#(+20)) <= ((X#(+3)) + (Width#10))} .assertEq(20 .inRange(3 =~~= (3 + 10)))}
  .check{((X#(+13)) >= (X#(+3))) && {(X#(+13)) <= ((X#(+3)) + (Width#10))} .assertEq(13 .inRange(3 =~~= (3 + 10)))}
  }

LevelByteTests: Test {::
  .check{(Red#(20.getByte)) + (Red#(30.getByte)) .assertEq(Red#(50.getByte))}
  .check{(Blue#(30.getByte)) - (Blue#(20.getByte)) .assertEq(Blue#(10.getByte))}
  .check{(Green#(20.getByte)) .gap(Green#(50.getByte)) .assertEq(Green#(30.getByte))}
  .check{(Green#(50.getByte)) .gap(Green#(20.getByte)) .assertEq(Green#(30.getByte))}
  .check{(Red#(50.getByte)) .getTruncDiv 4 .assertEq(Red#(12.getByte))}
  .check{Alpha.min .assertEq(Alpha#(0.getByte))}
  .check{Alpha.max .assertEq(Alpha#(255.getByte))}
  .check{Alpha.transparent .assertEq(Alpha.min)}
  .check{Alpha.opaque .assertEq(Alpha.max)}
  .check{Red.min .assertEq(Red#(Math.minByte))}
  .check{Blue.max .assertEq(Blue#(Math.maxByte))}
  .checkDetErr({_ -> True}, {Red.max + (Red#(1.getByte))})
  .checkDetErr({_ -> True}, {Red.min - (Red#(1.getByte))})
  }

LevelFloatTests: Test {::
  .check{(Saturation#(0.25)) + (Saturation#(0.5)) .assertEq(Saturation#(0.75))}
  .check{(Brightness#(0.75)) - (Brightness#(0.25)) .assertEq(Brightness#(0.5))}
  .check{(Saturation#(0.25)) .gap(Saturation#(0.75)) .assertEq(Saturation#(0.5))}
  .check{(Saturation#(0.75)) .gap(Saturation#(0.25)) .assertEq(Saturation#(0.5))}
  .check{Saturation.min .assertEq(Saturation#(0.0))}
  .check{Saturation.max .assertEq(Saturation#(+1.0))}
  .check{Brightness.min .assertEq(Brightness#(0.0))}
  .check{Brightness.max .assertEq(Brightness#(+1.0))}
  .checkNonDetErr({_ -> True}, {Saturation.max + (Saturation#(0.5))})
  .checkNonDetErr({_ -> True}, {Saturation.min - (Saturation#(0.5))})
  }

CyclicFloatTests: Test {::
  .check{(Hue#(0.25)) + (Hue#(0.5)) .assertEq(Hue#(0.75))}
  .check{(Hue#(0.75)) + (Hue#(0.5)) .assertEq(Hue#(0.25))}
  .check{(Hue#(0.25)) - (Hue#(0.5)) .assertEq(Hue#(0.75))}
  .check{(Hue#(0.5)) - (Hue#(0.25)) .assertEq(Hue#(0.25))}
  .check{(Hue#(0.5)) + (Hue#(0.5)) .assertEq(Hue#(0.0))}
  .check{(Hue#(0.25)) .normalize .assertEq(Hue#(0.25))}
  .check{Hue.period .assertEq(+1.0)}
  .check{(Hue#(0.5)) + (Hue#(0.25)) + (Hue#(0.5)) .assertEq((Hue#(0.25)) + (Hue#(0.5)) + (Hue#(0.5)))}
  }

DurationTests: Test {::
  .check{(Duration.seconds 2) .assertEq(Duration.milliSeconds 2000)}
  .check{(Duration.seconds 1) + (Duration.seconds 2) .assertEq(Duration.seconds 3)}
  .check{(Duration.seconds 3) - (Duration.seconds 1) .assertEq(Duration.seconds 2)}
  .check{(Duration.seconds 1) .gap(Duration.seconds 4) .assertEq(Duration.seconds 3)}
  .check{(Duration.seconds 3) * 2 .assertEq(Duration.seconds 6)}
  .check{(Duration.seconds 6) .getTruncDiv 2 .assertEq(Duration.seconds 3)}
  .check{Duration.zero .assertEq(Duration#0)}
  .checkDetErr({_ -> True}, {(Duration.seconds 1) - (Duration.seconds 2)})
  }

InstantTests: Test {::
  .check{Instant.origin + (Duration.seconds 5) .assertEq(Instant#5000000)}
  .check{(Instant#5000000) - (Duration.seconds 2) .assertEq(Instant#3000000)}
  .check{(Instant#1000000) .to(Instant#4000000) .assertEq(Duration.seconds 3)}
  .check{(Instant#4000000) .gap(Instant#1000000) .assertEq(Duration.seconds 3)}
  .check{(Instant#1000000) .gap(Instant#4000000) .assertEq(Duration.seconds 3)}
  .check{Instant.origin .assertEq(Instant#0)}
  .check{(Instant#7) + ((Instant#7) .to(Instant#20)) .assertEq(Instant#20)}
  .checkDetErr({_ -> True}, {(Instant#4000000) .to(Instant#1000000)})
  .checkDetErr({_ -> True}, {Instant.origin - (Duration.seconds 1)})
  }

RectTests: Test {::
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .right .assertEq(X#(+40))}
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .bottom .assertEq(Y#(+60))}
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .contains(X#(+25), Y#(+35)) .assertTrue}
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .contains(X#(+10), Y#(+20)) .assertTrue}
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .contains(X#(+40), Y#(+60)) .assertTrue}
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .contains(X#(+9), Y#(+35)) .assertFalse}
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .contains(X#(+41), Y#(+35)) .assertFalse}
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .contains(X#(+25), Y#(+19)) .assertFalse}
  .check{Rects#(X#(+10), Y#(+20), Width#30, Height#40) .contains(X#(+25), Y#(+61)) .assertFalse}
  .check{Rects#(X#(+0), Y#(+0), Width.zero, Height.zero) .contains(X#(+0), Y#(+0)) .assertTrue}
  .check{Rects#(X#(+0), Y#(+0), Width.zero, Height.zero) .contains(X#(+1), Y#(+0)) .assertFalse}
  }

TestWrappers: Test {::
  .test ExtentNatTests
  .test ExtentNatGapTests
  .test CoordIntNegativeTests
  .test CoordIntTests
  .test CoordIntDiffTests
  .test CoordIntRoundTripTests
  .test WrapperNatAgreementTests
  .test LevelByteTests
  .test LevelFloatTests
  .test CyclicFloatTests
  .test DurationTests
  .test InstantTests
  .test RectTests
  }
