GuiSectionsTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{x -> Block#(x
      .section("a", {::}).content{::}
      .section("b", {::}).content{::}
      .section("c", {::}).content{::}
      .expand "b" .index("a", 2),
      Error.msg(x.names.get 0 + (x.names.get 1) + (x.names.get 2) + " " + (x.index "a" .str) + " " + (x.isExpanded "b" .str) + " " + (x.isExpanded "a" .str))
      )}
    }}}).run{
      .ok _ -> Error.msg "The sections always stop the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "bca 2 True False"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{x -> Block#(x
      .section("a", {::}).content{::}
      .section("b", {::}).content{::}
      .section("c", {::}).content{::}
      .autoCollapse(False) .expand "c" .expand "b" .expand "a",
      Error.msg((x.isExpanded "a" .str) + (x.isExpanded "b" .str) + (x.isExpanded "c" .str) + " " + (x.autoCollapse(True).isExpanded "a" .str) + (x.isExpanded "b" .str) + (x.isExpanded "c" .str) + " " + (x.expand "c" .isExpanded "a" .str) + (x.isExpanded "c" .str) + " " + (x.collapse "c" .isExpanded "c" .str))
      )}
    }}}).run{
      .ok _ -> Error.msg "The sections always stop the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "TrueTrueTrue TrueFalseFalse FalseTrue False"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{:: .section("a", {::}).content{::} .section("a", {::}).content{::} .paint{g -> Error.msg "A second section named a was accepted"}}
    }}}).run{
      .ok _ -> Error.msg "A second section named a always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == `This Sections already has a section named "a": the name identifies the section, so every section of a Sections has its own name`}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{:: .section("a", {::}).content{::} .section("b", {::}).content{::} .expand "c" .paint{g -> Error.msg "Expanding a missing section was accepted"}}
    }}}).run{
      .ok _ -> Error.msg "Expanding a missing section always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == `There is no section named "c" in this Sections: the names of its sections are "a", "b"`}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{:: .remove "a" .paint{g -> Error.msg "Removing from an empty Sections was accepted"}}
    }}}).run{
      .ok _ -> Error.msg "Removing from an empty Sections always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == `There is no section named "a" in this Sections: it has no sections`}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{:: .section("a", {::}).content{::} .section("b", {::}).content{::} .index("a", 2) .paint{g -> Error.msg "An index past the end was accepted"}}
    }}}).run{
      .ok _ -> Error.msg "An index past the end always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == `.index("a", 2) is out of range: this Sections has 2 sections, so the index is at most 1`}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{:: .autoCollapse(False) .tabs .paint{g -> Error.msg "Tabs without autoCollapse were accepted"}}
    }}}).run{
      .ok _ -> Error.msg "Tabs without autoCollapse always stop the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == ".tabs is called on a Sections with .autoCollapse(False): a row of tabs shows the content of one section at a time, so tabs need .autoCollapse(True)"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{:: .tabs .autoCollapse(False) .paint{g -> Error.msg "Tabs without autoCollapse were accepted"}}
    }}}).run{
      .ok _ -> Error.msg "Tabs without autoCollapse always stop the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == ".autoCollapse(False) is called on a Sections shown as tabs: a row of tabs shows the content of one section at a time. Call .column first"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .sections{x -> Error.msg(x.section("a", {::}).content{:: .width 100 .height 40}.section("b", {::}).content{:: .width 60 .height 30}.width.str + " " + (x.height.str) + " " + (x.pack.width.str) + " " + (x.height.str) + " " + (x.tabs.pack.width.str) + " " + (x.height.str))}
    }}}).run{
      .ok _ -> Error.msg "The sections always stop the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[112] Height[82] Width[112] Height[148] Width[112] Height[82]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#300).content{::
    .sections{:: .width 300 .height 200 .tabs .section("a", {:: .width 50 .height 30}).content{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))}} .expand "a"}
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[288] Height[152]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#300).content{::
    .sections{:: .width 300 .height 200 .section("a", {::}).content{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))}} .expand "a"}
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[288] Height[24]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#300).content{::
    .sections{:: .onToggle{x, n -> Error.msg "A program call ran onToggle"}
      .section("a", {::}).content{:: .paint{g -> Error.msg "A collapsed content was drawn"}}
      .section("b", {::}).content{::}
      .expand "a" .expand "b"}
    .pane{:: .paint{g -> Error.msg "Only the expanded content was drawn"}}
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Only the expanded content was drawn"}}.assertTrue{i};
      }}
  }
