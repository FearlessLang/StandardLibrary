GuiFrameTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .let[mut Slot[mut Pane]] root = {Slots#[mut Pane]}
    .do{Block#(f.modelFps(100, {:: .action{Error.msg(root!.background.str + " " + (root!.radius.str))}}), Void)}
    .return{f.undecorated(Alpha.opaque).fixedSize(Width#300, Height#80).content{::
      .radius 20
      .background(Color#(Red#(200.getByte), Green#(0.getByte), Blue#(0.getByte), Alpha#(128.getByte)))
      .save root
      }}
    }}).run{
      .ok _ -> Error.msg "A model action always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == (Color#(Red#(200.getByte), Green#(0.getByte), Blue#(0.getByte), Alpha#(128.getByte)).str + " 20")}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .var swapped = {False}
    .let[mut Slot[mut Pane]] root = {Slots#[mut Pane]}
    .do{Block#(f.modelFps(100, {:: .action{Block#
      .if{swapped.get} .do{Error.msg(root!.background.str + " " + (root!.radius.str))}
      .do{swapped.set True}
      .return{f.content{:: .save root}}
      }}), Void)}
    .return{f.undecorated(Alpha.opaque).fixedSize(Width#300, Height#80).content{::}}
    }}).run{
      .ok _ -> Error.msg "A model action always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == (Color.transparent.str + " 12")}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{Block#(f.maximized, Error.msg "A maximized window kept its explicit location")}}), Void)}
    .return{f.undecorated(Alpha.opaque).location(X#(+0), Y#(+0)).content{::}}
    }}).run{
      .ok _ -> Error.msg "A model action always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "A maximized window cannot also have an explicit location"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{Block#(f.maximized, Error.msg "A maximized window kept its explicit size")}}), Void)}
    .return{f.undecorated(Alpha.opaque).fixedSize(Width#300, Height#80).content{::}}
    }}).run{
      .ok _ -> Error.msg "A model action always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "A maximized window cannot also have an explicit size"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{Block#(f.location(X#(+0), Y#(+0)), Error.msg "A maximized window accepted an explicit location")}}), Void)}
    .return{f.undecorated(Alpha.opaque).maximized.content{::}}
    }}).run{
      .ok _ -> Error.msg "A model action always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "A maximized window cannot also have an explicit location"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{Block#(f.resizable(Width#300, Height#80), Error.msg "A maximized window accepted an explicit size")}}), Void)}
    .return{f.undecorated(Alpha.opaque).maximized.content{::}}
    }}).run{
      .ok _ -> Error.msg "A model action always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "A maximized window cannot also have an explicit size"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{Block#(f.fixedSize(Width#100000, Height#80), Error.msg "A window larger than the screen was accepted")}}), Void)}
    .return{f.undecorated(Alpha.opaque).location(X#(+0), Y#(+0)).content{::}}
    }}).run{
      .ok _ -> Error.msg "A model action always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: .startsWith "Window must fit on screen: window=100000x80, screen="}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{Block#(f.resizable(f.screenWidth, f.screenHeight).fixedSize(f.screenWidth, f.screenHeight), Error.msg "A shown window with no explicit location took the screen size")}}), Void)}
    .return{f.undecorated(Alpha.opaque).fixedSize(Width#300, Height#80).content{::}}
    }}).run{
      .ok _ -> Error.msg "A model action always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "A shown window with no explicit location took the screen size"}}.assertTrue{i};
      }}
  }
