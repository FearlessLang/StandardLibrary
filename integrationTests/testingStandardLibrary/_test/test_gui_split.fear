GuiSplitTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content{::
    .split{:: .first{:: .width 100 .height 40 } .second{:: .width 60 .height 30 } .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[178] Height[52]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content{::
    .split{:: .vertical .first{:: .width 100 .height 40 } .second{:: .width 60 .height 30 } .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[112] Height[88]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content{::
    .split{:: .width 300 .height 80 .first{:: .width 100 .height 40 } .second{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} } }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[182] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content{::
    .split{:: .width 300 .height 80 .divider 150 .first{:: .width 100 } .second{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} } }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[132] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content{::
    .split{:: .width 300 .height 80 .divider 250 .first{:: .width 100 } .second{:: .fill .width 60 .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} } }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[60] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content{::
    .split{:: .width 300 .height 80 .divider 10 .first{:: .fill .width 100 .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} } }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[100] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content{::
    .split{:: .width 300 .height 80 .second{:: .width 200 } .second{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} } }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[282] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content{::
    .split{:: .width 300 .height 120 .firstS{:: .fill .vertical .first{:: .height 30 } .second{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} } } .second{:: .width 50 } }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[24] Height[60]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).contentB{::
    .centerS{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[288] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .split{sp -> Error.msg(sp.divider(150).divider.str)} }}}).run{
      .ok _ -> Error.msg "The split always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "150"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .split{:: .divider 40000 } }}}).run{
      .ok _ -> Error.msg "A divider over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "divider 40000 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  }
