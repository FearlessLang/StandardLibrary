GuiSplitTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{:: .width 100 .height 40 }.and.pane{:: .width 60 .height 30 }.with{:: .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[117] Height[52]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{::
    .split.pane{:: .width 100 .height 40 }.and.pane{:: .width 60 .height 30 }.with{sp -> Error.msg(sp.pack .width.str + " " + (sp.height.str) + " " + (sp.dividerPositions.str{::}))}
    }}}).run{
      .ok _ -> Error.msg "The split always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[177] Height[52] [100]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{::
    .split.pane{:: .width 100 .height 40 }.and.pane{:: .width 60 .height 30 }.with{sp -> Error.msg(sp.vertical .pack .width.str + " " + (sp.height.str) + " " + (sp.dividerPositions.str{::}))}
    }}}).run{
      .ok _ -> Error.msg "The split always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[112] Height[87] [40]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{:: .width 100 }.and.pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }.with{:: .width 300 .height 80 }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[283] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{:: .fill .width 100 .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }.and.pane{:: .fill }.with{:: .width 300 .height 80 .dividerPositions(Lists#150) }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[150] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{:: .width 100 }.and.pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }.with{:: .width 300 .height 80 .dividerPositions(Lists#150) }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[133] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{:: .width 100 }.and.pane{:: .fill .width 60 .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }.with{:: .width 300 .height 80 .dividerPositions(Lists#250) }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[60] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{:: .fill .width 100 .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }.and.pane{::}.with{:: .width 300 .height 80 .dividerPositions(Lists#10) }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[100] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{::}.and.pane{:: .width 200 .paint{g -> Error.msg "A replaced widget was drawn"}}.with{:: .width 300 .height 80 .dividerPositions(Lists#100) .region(1).pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} } }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[183] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content.border{::
    .center.pane{:: .width 200 .paint{g -> Error.msg "A replaced widget was drawn"}}
    .center.pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))}}
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[288] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.split.pane{:: .height 30 }.and.pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }.with{:: .fill .vertical .dividerPositions(Lists#30) }
      .and.pane{:: .width 50 }.with{:: .width 300 .height 120 .dividerPositions(Lists#100) }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[88] Height[61]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content.border{::
    .center.split.pane{::}.and.pane{::}.with{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[288] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .split.pane{::}.and.pane{::}.with{sp -> Error.msg(sp.dividerPositions.str{::} + " " + (sp.draggable.str) + " " + (sp.dividerPositions(Lists#150).draggable(False).dividerPositions.str{::}) + " " + (sp.draggable.str))} }}}).run{
      .ok _ -> Error.msg "The split always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "[0] True [150] False"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .split.pane{::}.and.pane{::}.with{:: .dividerPositions(Lists#40000) } }}}).run{
      .ok _ -> Error.msg "A divider position over the limit always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "dividerPositions [40000]: the position 40000 at index 0 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{::
    .split.pane{:: .width 20 .height 20 }.and.pane{:: .width 100 .height 20 }.with{sp -> Error.msg(sp.width.str + " " + (sp.height.str) + " " + (sp.dividerPositions.str{::}))}
    }}}).run{
      .ok _ -> Error.msg "The split always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[117] Height[32] [0]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{::
    .split.pane{:: .width 20 .height 20 }.and.pane{:: .width 100 .height 20 }.with{sp -> Error.msg(sp.vertical.width.str + " " + (sp.height.str))}
    }}}).run{
      .ok _ -> Error.msg "The split always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[117] Height[37]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{::
    .split.pane{:: .width 100 .height 40 }.and.pane{:: .width 60 .height 30 }.and.pane{:: .width 50 .height 20 }.with{sp -> Error.msg(sp.size.str + " " + (sp.dividerPositions.str{::}) + " " + (sp.pack .width.str) + " " + (sp.height.str) + " " + (sp.dividerPositions.str{::}))}
    }}}).run{
      .ok _ -> Error.msg "The split always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "3 [0, 5] Width[232] Height[52] [100, 165]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{::
    .split.pane{:: .width 100 .height 40 }.and.pane{:: .width 60 .height 30 }.and.pane{:: .width 50 .height 20 }.with{sp -> Error.msg(sp.vertical .pack .width.str + " " + (sp.height.str) + " " + (sp.dividerPositions.str{::}))}
    }}}).run{
      .ok _ -> Error.msg "The split always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[112] Height[112] [40, 75]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{::}.and.pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }.and.pane{::}.with{:: .width 300 .height 80 .dividerPositions(Lists#(100, 200)) }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[95] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{::}.and.pane{::}.and.pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }.with{:: .width 300 .height 80 .dividerPositions(Lists#(100, 200)) }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[83] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#400, Height#200).content.pane{::
    .split.pane{:: .width 200 .paint{g -> Error.msg "A replaced widget was drawn"}}.and.pane{::}.and.pane{::}.with{:: .width 300 .height 80 .dividerPositions(Lists#(100, 200)) .region(0).pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} } }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[100] Height[68]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .split.pane{::}.and.pane{::}.and.pane{::}.with{:: .dividerPositions(Lists#100) } }}}).run{
      .ok _ -> Error.msg "A wrong number of divider positions always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "dividerPositions [100]: 1 position is given, but this Split has 2 dividers: one position per divider"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .split.pane{::}.and.pane{::}.and.pane{::}.with{:: .dividerPositions(Lists#(100, 104)) } }}}).run{
      .ok _ -> Error.msg "Divider positions closer than a divider always stop the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "dividerPositions [100, 104]: the divider at index 1, at 104, overlaps the divider at index 0, which takes the 5 virtual pixels from 100 to 105; each position must be at least 5 more than the position before it"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .split.pane{::}.and.pane{::}.and.pane{::}.with{:: .region(3).pane{::} } }}}).run{
      .ok _ -> Error.msg "A region index past the last region always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "There is no region at index 3 in this Split: it has 3 regions, so the index is at most 2"}}.assertTrue{i};
      }}
  }
