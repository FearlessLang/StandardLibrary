ClFeed: {
  #(c: mut base.UStrCleaner, a: Nat): base.UStr -> c.nextByte(a.getByte) + (c.end);
  #(c: mut base.UStrCleaner, a: Nat, b: Nat): base.UStr -> c.nextByte(a.getByte) + (this#(c, b));
  #(c: mut base.UStrCleaner, a: Nat, b: Nat, d: Nat): base.UStr -> c.nextByte(a.getByte) + (this#(c, b, d));
  #(c: mut base.UStrCleaner, a: Nat, b: Nat, d: Nat, e: Nat): base.UStr -> c.nextByte(a.getByte) + (this#(c, b, d, e));
  }
ClFeedS: {
  #(c: mut base.StrCleaner, a: Nat): Str -> c.nextByte(a.getByte) + (c.end);
  #(c: mut base.StrCleaner, a: Nat, b: Nat): Str -> c.nextByte(a.getByte) + (this#(c, b));
  #(c: mut base.StrCleaner, a: Nat, b: Nat, d: Nat): Str -> c.nextByte(a.getByte) + (this#(c, b, d));
  #(c: mut base.StrCleaner, a: Nat, b: Nat, d: Nat, e: Nat): Str -> c.nextByte(a.getByte) + (this#(c, b, d, e));
  }
ClShow: base.StrFixer{ reason, byteOffset, byteLength, rejectedValue ->
  "["+(reason.match{.malformedEncoding -> "malformedEncoding"; .truncatedEncoding -> "truncatedEncoding"; .notScalar -> "notScalar"; .notInStr -> "notInStr"})+":"+byteOffset+":"+byteLength+":"+rejectedValue+"]"
  }
TextCleanerTests: Test {::
  .check{ClFeed#(base.UStrCleaners.utf16BeOrElse{{_, _, _, _ -> "?".u}}#("".u), 216, 61, 222, 0).scalarHex.assertEq "1F600"}
  .check{ClFeedS#(base.StrCleaners.utf16LeOrElse{ClShow}#(""), 0, 220, 97, 0).assertEq "[notScalar:0:2:56320]a"}
  .check{ClFeedS#(base.StrCleaners.utf16BeOrElse{ClShow}#(""), 216, 61, 0, 97).assertEq "[notScalar:0:2:55357]a"}
  .check{ClFeedS#(base.StrCleaners.utf32BeOrElse{ClShow}#(""), 0, 17, 0, 0).assertEq "[notScalar:0:4:1114112]"}
  .check{ClFeedS#(base.StrCleaners.utf32LeOrElse{ClShow}#(""), 0, 216, 0, 0).assertEq "[notScalar:0:4:55296]"}
  .check{ClFeedS#(base.StrCleaners.asciiOrElse{ClShow}#(""), 128, 97).assertEq "[malformedEncoding:0:1:128]a"}
  .check{ClFeedS#(base.StrCleaners.latin1OrElse{ClShow}#(""), 233).assertEq "[notInStr:0:1:233]"}
  .check{ClFeedS#(base.StrCleaners.utf8OrElse{ClShow}#(""), 192, 128).assertEq "[malformedEncoding:0:2:192]"}
  .check{ClFeedS#(base.StrCleaners.utf8OrElse{ClShow}#(""), 224, 128, 128).assertEq "[malformedEncoding:0:3:224]"}
  .check{ClFeedS#(base.StrCleaners.utf8OrElse{ClShow}#(""), 240, 128, 128, 128).assertEq "[malformedEncoding:0:4:240]"}
  .check{ClFeedS#(base.StrCleaners.utf8OrElse{ClShow}#(""), 237, 160, 128).assertEq "[notScalar:0:3:55296]"}
  .check{ClFeedS#(base.StrCleaners.utf8OrElse{ClShow}#(""), 244, 144, 128, 128).assertEq "[notScalar:0:4:1114112]"}
  .check{ClFeedS#(base.StrCleaners.utf8OrElse{ClShow}#(""), 97, 226, 130).assertEq "a[truncatedEncoding:1:2:226]"}
  .check{ClFeedS#(base.StrCleaners.utf8OrElse{ClShow}#("xy"), 97).assertEq "xya"}
  .check{ClFeed#(base.UStrCleaners.text#("e".u), 204, 129).scalarHex.assertEq "00E9"}
  .check{ClFeed#(base.UStrCleaners.text#("".u), 97, 13).scalarHex.assertEq "0061 000A"}
  .check{ClFeed#(base.UStrCleaners.text#("".u), 13, 195, 169).scalarHex.assertEq "000A 00E9"}
  .check{ClFeed#(base.UStrCleaners.text#("".u), 11, 12, 194, 133).scalarHex.assertEq "000A 000A 000A"}
  .check{ClFeedS#(base.StrCleaners.text#(""), 9, 239, 172, 129).assertEq " fi"}
  .check{ClFeedS#(base.StrCleaners.text#(""), 230, 151, 165).assertEq ""}
  .check{ClFeedS#(base.StrCleaners.utf8Then{mut base.StrScalarCleaner{.nextScalar n -> "<"+(n.str)+">"; .end -> "!"}}#("xy"), 97).assertEq "<120><121><97>!"}
  .check{ClFeed#(base.UStrCleaners.utf8Then{mut base.UStrScalarCleaner{.nextScalar n -> ("<"+(n.str)+">").u; .end -> "!".u}}#("".u), 195, 169).scalarHex.assertEq "003C 0032 0033 0033 003E 0021"}
  .checkDetErr({::.isMsg{:: == "UStrCleaners.utf8: notScalar: the byte sequence ED A0 80 at byte offset 0 of the line encodes U+D800, which is not a unicode scalar value"}}, {ClFeed#(base.UStrCleaners.utf8#("".u), 237, 160, 128)})
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .textArea{a -> Error.msg("["+(a.cleaner{start -> {.nextByte b -> "".u; .end -> "E".u}}.text("").text)+"]")}}}}).run{
      .ok _ -> Error.msg "The scope always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "[]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .textArea{a -> Error.msg(a.cleaner{start -> {.nextByte b -> "".u; .end -> start.isEmpty?{.then -> ("a" | "b").u; .else -> "(".u + start + (")".u)}}}.text("x").text)}}}}).run{
      .ok _ -> Error.msg "The scope always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == ("a" | "(b)")}}.assertTrue{i};
      }}
  }
