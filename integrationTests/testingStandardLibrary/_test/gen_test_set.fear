Set1Imm0Size0Test: Test {::
    .check{Sets#({::}, 1, 2, 3).size .assertEq 3}
    .check{Sets#[Nat, Nat]({::}).size .assertEq 0}
  }

Set1Imm0IsEmpty0Test: Test {::
    .check{Sets#[Nat, Nat]({::}).isEmpty .assertTrue}
    .check{Sets#({::}, 1).isEmpty .assertFalse}
  }

Set1Imm0NotEmpty0Test: Test {::
    .check{Sets#[Nat, Nat]({::}).notEmpty .assertFalse}
    .check{Sets#({::}, 1).notEmpty .assertTrue}
  }

Set1Imm0Contains1Test: Test {::
    .check{Sets#({::}, 1).contains(1) .assertTrue}
    .check{Sets#({::}, 0).contains(1) .assertFalse}
  }

Set1Imm0Opt1Test: Test {::
    .check{Sets#[Int, Nat]({::.imm.abs}, +1, -2).opt(-1)! .assertEq +1}
    .check{Sets#({::}, 1, 2).opt(3).assertEmpty {::}}
  }

Set1Imm0Get1Test: Test {::
    .check{Sets#({::.imm.abs}, +1, -2).get(-1) .assertEq +1}
    .checkDetErr({_ -> True}, {Sets#({::}, 1, 2).get(3)})
  }

Set1Imm0Plus1Test: Test {::
    .check{Sets#({::}, 1) + 2 .assertEq({::}, Sets#({::}, 1, 2))}
    // if the final method `.getInt` is typod the error isn't a normal compiler error but:
    /*
    java.lang.AssertionError:  .viewHash[A:imm](base.F[read A,base.InferUnknown]):base.OrderHashBy[A]@base.OrderHashBy;  .viewHash[A:imm](base.F[read A,read base.Int]):base.OrderHashBy[A]@base.OrderHashBy;The assert above is actually a big deal. It can logically break in an better version of Fearless
    when inference would know about subtypes when selecting the 'chosen'.
    Same origin can appear multiple times when the same generic supertype is inherited with
    different instantiation arguments (Fearless allows this; Java forbids it).
    Currently, Fearless requires the programmer to select a winning signature by overriding it.*/
    .check{Sets#({::.imm.abs.getInt}, +1) + -1 .assertEq({::}, Sets#({::}, +1))}
  }

Set1Imm0Dash1Test: Test {::
    .check{Sets#({::}, 2, 3) - 2 - 3 .isEmpty .assertTrue}
    .check{Sets#({::}, 1) - 2 .assertEq({::}, Sets#({::}, 1))}
  }

Set1Imm1Union2Test: Test {::
    .let s1={Sets#({::}, +1, +2)}
    .let s2={Sets#({::}, +2, +3)}
    .check{s1.union({::}, s2) .assertEq({::}, Sets#({::}, +1, +2, +3))}
    .check{s1.union({::.imm.abs.getInt}, Sets#({::}, -1, -2)) .assertEq({::}, s1)}
  }

Set1Imm0PlusPlus1Test: Test {::
    .let s1={Sets#({::}, 1, 2)}
    .let s2={Sets#({::}, 2, 3)}
    .check{s1 ++ s2 .assertEq({::}, Sets#({::}, 1, 2, 3))}
  }

Set1Imm1Intersection2Test: Test {::
    .let s1={Sets#({::}, 1, 2)}
    .let s2={Sets#({::}, 2, 3)}
    .check{s1.intersection({::}, s2) .assertEq({::}, Sets#({::}, 2))}
    .check{Sets#({::}, 1, 2, 3).intersection({::}, Sets#({::})) .isEmpty .assertTrue}
  }

Set1Imm0And1Test: Test {::
    .let s1={Sets#({::}, 1, 2)}
    .let s2={Sets#({::}, 2, 3)}
    .check{s1 & s2 .assertEq({::}, Sets#({::}, 2))}
  }

Set1Imm1Difference2Test: Test {::
    .let s1={Sets#({::}, +1, +2, +3)}
    .let s2={Sets#({::}, +2)}
    .check{s1 -- s2.assertEq({::}, Sets#({::}, +1, +3))}
    .check{s1.difference({::}, s2) .assertEq({::}, Sets#({::}, +1, +3))}
    .check{s1.difference({::.imm.abs.getInt}, Sets#({::}, -2)) .assertEq({::}, Sets#({::}, +1, +3))}
  }

Set1Imm0DashDash1Test: Test {::
    .let s1={Sets#({::}, 1, 2, 3)}
    .let s2={Sets#({::}, 2)}
    .check{s1 -- s2 .assertEq({::}, Sets#({::}, 1, 3))}
  }


Set1Imm0SymmetricDifference1Test: Test {::
    .let s1={Sets#({::}, 1, 2, 3)}
    .let s2={Sets#({::}, 2, 4)}
    .check{s1.symmetricDifference(s2) .assertEq({::}, Sets#({::}, 1, 3, 4))}
  }

Set1Imm1SymmetricDifference2Test: Test {::
    .let s1={Sets#({::}, 1, 2, 3)}
    .let s2={Sets#({::}, 2, 4)}
    .check{s1.symmetricDifference({::}, s2) .assertEq({::}, Sets#({::}, 1, 3, 4))}
  }


Set1Imm1ContainsAll2Test: Test {::
    .check{Sets#({::}, +1, +2).containsAll({::.imm.abs}, Sets#({::}, -1, -2)) .assertTrue}
    .check{Sets#({::}, +1, +2).containsAll({::.imm.abs}, Sets#({::}, -1, -3)) .assertFalse}
  }

Set1Imm0ContainsAll1Test: Test {::
    .let s1={Sets#({::}, 1, 2, 3)}
    .check{s1.containsAll(Sets#({::}, 1, 2)) .assertTrue}
    .check{s1.containsAll(Sets#({::}, 1, 2, 4)) .assertFalse}
  }

Set1Imm1IsSubset2Test: Test {::
    .check{Sets#({::}, -1, -2).isSubset({::.imm.abs}, Sets#({::}, +1, +2)) .assertTrue}
    .check{Sets#({::}, -1, -3).isSubset({::.imm.abs}, Sets#({::}, +1, +2)) .assertFalse}
  }

Set1Imm1IsDisjoint2Test: Test {::
    .check{Sets#({::}, +1, +2).isDisjoint({::.imm.abs}, Sets#({::}, -3, -4)) .assertTrue}
    .check{Sets#({::}, +1, +2).isDisjoint({::.imm.abs}, Sets#({::}, -1, -3)) .assertFalse}
  }

Set1Imm0IsDisjoint1Test: Test {::
  .check{Sets#({::}, 1, 2).isDisjoint(Sets#({::}, 3, 4)) .assertTrue}
  .check{Sets#({::}, 1, 2).isDisjoint(Sets#({::}, 2, 3)) .assertFalse}
  }

Set1Imm1DistinctBy1Test: Test {::
    .let s={Sets#({::}, +1, -1, +2, -2)}
    .check{s.distinctBy({::.imm.abs}).str{::} .assertEq "{-1, -2}"}
  }

Set1Imm0Flow0Test: Test {::
    .check{Sets#({::}, 1, 2, 3).flow.list .assertEq({::}, Lists#(1, 2, 3))}
  }

Set1Imm0SeqFlow0Test: Test {::
    .check{Sets#({::}, 1, 2, 3).seqFlow.list .assertEq({::}, Lists#(1, 2, 3))}
  }

Set1Imm0Str0Test: Test {::
    .check{Sets#({::}, -1, +2, -3).str .assertEq "{-3, -1, +2}"}
    .check{Sets#({::.imm.abs}, -1, +2, -3).str .assertEq "{1, 2, 3}"}
    .check{Sets#[Int,Int]({::}).str .assertEq "{}"}
  }

Set1Imm1Cmp3Test: Test {::
    .let s1={Sets#({::}, +1, +2, +3)}
    .let s2={Sets#({::}, -2, -3, -1)}
    .check{Sets#[Int,Int]({::.imm.abs.getInt}).cmp(s1, s2, {.eq -> 0; .lt -> 1; .gt -> 2}) .assertEq 1}
  }

Set1Imm0List0Test: Test {::
    .check{ Sets#({::.imm.abs}, -3, +2, -1).list.assertEq({::}, Lists#(-1, +2, -3)) }
  }

