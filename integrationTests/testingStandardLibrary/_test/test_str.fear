StrBasicsTests: Test {::
  .check{"" .isEmpty .assertEq True}
  .check{"" .size .assertEq 0}
  .check{"a" .isEmpty .assertEq False}
  .check{"a" .size .assertEq 1}
  .check{"ab" .size .assertEq 2}
  .check{"" .imm .assertEq ""}
  .check{"a" .imm .assertEq "a"}
  .check{"a" .str .assertEq "a"}
  .check{"a" .close .assertEq "a"}
  .check{"ab" .close .assertEq "ab"}
  .check{"ab" .repeat(3) .assertEq "ababab"}
  .checkDetErr({::.isMsg{:: == "Str.sub: the range 3 to 4 is out of range for a Str of size 2."}}, {"ab".sub(3, 4)})
  .checkDetErr({::.isMsg{:: == "Str.sub: the range 0 to 1 is out of range for an empty Str."}}, {"".sub(0, 1)})
  .checkDetErr({::.isMsg{:: == "Str.sub: from 2 is greater than to 1."}}, {"ab".sub(2, 1)})
  .checkDetErr({::.isMsg{::.startsWith "Str.replaceSimultaneous:"}}, {"ab".replaceSimultaneous(Lists#("a", "x", "ab", "y"))})
  .checkDetErr({::.isMsg{::.startsWith "Str.replaceSimultaneousOrdered:"}}, {"ab".replaceSimultaneousOrdered(Lists#("", "x"))})
  }

StrConcatTests: Test {::
  .check{"a" + "b" .assertEq "ab"}
  .check{"ab" + "c" .assertEq "abc"}
  .check{"a" + "" .assertEq "a"}
  .check{"" + "a" .assertEq "a"}
  .check{"" + "" .assertEq ""}
  .check{"a" + "" + "b" .assertEq "ab"}
  .check{"" + "a" + "" .assertEq "a"}
  .check{"a" + "b" + "c" .assertEq "abc"}
  .check{"x=" + True .assertEq "x=True"}
  .check{"x=" + False .assertEq "x=False"}
  .check{"x=" + True .str .assertEq "x=True"}
  .check{"x=" + True + False .assertEq "x=TrueFalse"}
  .check{"n=" + 5 .assertEq "n=5"}
  .check{"n=" + 4_294_967_295 .assertEq "n=4294967295"}
  .check{"a" + "b" .size .assertEq 2}
  .check{"a" + "" .size .assertEq 1}
  .check{"" + "b" .size .assertEq 1}
  }

StrSepOpsTests: Test {::
  .check{"a" | "b" .size .assertEq 3}
  .check{"a" | "b" | "c" .size .assertEq 5}
  .check{"" | "a" .size .assertEq 2}
  .check{"a" | "" .size .assertEq 2}
  .check{"a" | .size .assertEq 2}
  .check{"a" | .assertEq ("a" | "")}
  .check{"a" | | "b" .size .assertEq 4}
  .check{"a" ^ "b" .size .assertEq 3}
  .check{"a" ^ "b" ^ "c" .size .assertEq 5}
  .check{"" ^ "a" .size .assertEq 2}
  .check{"a" ^ "" .size .assertEq 2}
  .check{"a" ^ .size .assertEq 2}
  .check{"a" ^ .assertEq ("a" ^ "")}
  .check{"a" ^ ^ "b" .size .assertEq 4}
  .check{"a" | True .size .assertEq 6}
  .check{"a" ^ True .size .assertEq 6}
  .check{"" | "" .isEmpty .assertEq False}
  .check{"" ^ "" .isEmpty .assertEq False}
  }

StrOrderTests: Test {::
  .check{"a" .assertEq "a"}
  .check{"a" .assertNotEq "b"}
  .check{"a" .assertLt "b"}
  .check{"b" .assertGt "a"}
  .check{"a" .assertLe "a"}
  .check{"a" .assertGe "a"}
  .check{"a" .assertLt "aa"}
  .check{"aa" .assertGt "a"}
  .check{"a" .assertLt "ab"}
  .check{"A" .assertLt "a"}
  .check{"a" .assertGt "A"}
  }

StrEscapeTests: Test {::
  .check{"" .escape .assertEq (`""`)}
  .check{"" .escape .size .assertEq 2}
  .check{"a" .escape .assertEq ("" ^ "a" ^)}
  .check{"a" .escape .size .assertEq 3}
  .check{"abc" .escape .assertEq ("" ^ "abc" ^)}
  .check{"a" | "b" .escape .assertEq ("" ^ "a" ^ " | " ^ "b" ^)}
  .check{"a" ^ "b" .escape .assertEq ("`"+`a"b`+"`")}
  }

StrParseIntTests: Test {::
  .check{"" .int .assertEq({::}, {})}
  .check{"+0" .int .assertEq({::}, Opts#(+0))}
  .check{"-0" .int .assertEq({::}, Opts#(+0))}
  .check{"+1" .int .assertEq({::}, Opts#(+1))}
  .check{"-1" .int .assertEq({::}, Opts#(-1))}
  .check{"+9_223_372_036_854_775_807" .int .assertEq({::}, Opts#(Math.maxInt))}
  .check{"-9_223_372_036_854_775_808" .int .assertEq({::}, Opts#(Math.minInt))}
  .check{"+9_223_372_036_854_775_808" .int .assertEq({::}, {})}
  .check{"-9_223_372_036_854_775_809" .int .assertEq({::}, {})}
  .check{"2147483647" .int .assertEq({::}, {})}
  .check{"+000" .int .assertEq({::}, Opts#(+0))}
  .check{"-000" .int .assertEq({::}, Opts#(+0))}
  .check{"+0001" .int .assertEq({::}, Opts#(+1))}
  .check{"-0001" .int .assertEq({::}, Opts#(-1))}
  .check{"+1_000" .int .assertEq({::}, Opts#(+1000))}
  .check{"+_1" .int .assertEq({::}, {})}
  .check{"+1_" .int .assertEq({::}, {})}
  .check{"+1__0" .int .assertEq({::},  Opts# +1__0)}
  .check{"+01__0" .int .assertEq({::}, Opts# +01__0)}
  .check{"+0__10" .int .assertEq({::}, Opts# +0__10)}
  .check{" +1" .int .assertEq({::}, {})}
  .check{"+1 " .int .assertEq({::}, {})}
  }

StrParseNatTests: Test {::
  .check{"" .nat .assertEq({::}, {})}
  .check{"0" .nat .assertEq({::}, Opts#(0))}
  .check{"1" .nat .assertEq({::}, Opts#(1))}
  .check{"1_000_000" .nat .assertEq({::}, Opts#(1000000))}
  .check{"18_446_744_073_709_551_615" .nat .assertEq({::}, Opts#(Math.maxNat))}
  .check{"18_446_744_073_709_551_616" .nat .assertEq({::}, {})}
  .check{"000" .nat .assertEq({::}, Opts#(0))}
  .check{"0001" .nat .assertEq({::}, Opts#(1))}
  .check{"+1" .nat .assertEq({::}, {})}
  .check{"-1" .nat .assertEq({::}, {})}
  .check{"_1" .nat .assertEq({::}, {})}
  .check{"1_" .nat .assertEq({::}, {})}
  .check{"1__0" .nat .assertEq({::}, Opts# 1__0)}
  .check{"00_1" .nat .assertEq({::}, Opts# 00_1)}
  .check{" 1" .nat .assertEq({::}, {})}
  .check{"1 " .nat .assertEq({::}, {})}
  }

StrParseByteTests: Test {::
  .check{"" .byte .assertEq({::}, {})}
  .check{"0" .byte .assertEq({::}, Opts#(+0 .getByte))}
  .check{"1" .byte .assertEq({::}, Opts#(+1 .getByte))}
  .check{"10" .byte .assertEq({::}, Opts#(+10 .getByte))}
  .check{"255" .byte .assertEq({::}, Opts#(+255 .getByte))}
  .check{"000" .byte .assertEq({::}, Opts#(+0 .getByte))}
  .check{"001" .byte .assertEq({::}, Opts#(+1 .getByte))}
  .check{"256" .byte .assertEq({::}, {})}
  .check{"4_294_967_295" .byte .assertEq({::}, {})}
  .check{"+1" .byte .assertEq({::}, {})}
  .check{"-1" .byte .assertEq({::}, {})}
  .check{"1_0" .byte .assertEq({::}, Opts#(+10 .getByte))}
  .check{"2_5_5" .byte .assertEq({::}, Opts#(+255 .getByte))}
  .check{"25_5" .byte .assertEq({::}, Opts#(+255 .getByte))}
  .check{"25_6" .byte .assertEq({::}, {})}
  .check{"_1" .byte .assertEq({::}, {})}
  .check{"1_" .byte .assertEq({::}, {})}
  .check{" 1" .byte .assertEq({::}, {})}
  .check{"1 " .byte .assertEq({::}, {})}
  }

StrParseNumTests: Test {::
  .check{"" .num .assertEq({::}, {})}
  .check{"+0" .num .assertEq({::}, {})}
  .check{"-0" .num .assertEq({::}, {})}
  .check{"+1" .num .assertEq({::}, {})}
  .check{"-1" .num .assertEq({::}, {})}
  .check{"+1/2" .num .assertEq({::}, Opts#(+1/2))}
  .check{"-1/2" .num .assertEq({::}, Opts#(-1/2))}
  .check{"+10/20" .num .assertEq({::}, Opts#(+1/2))}
  .check{"-10/20" .num .assertEq({::}, Opts#(-1/2))}
  .check{"+12/2" .num!.str .assertEq("+6/1")}
  .check{"+1/0" .num .assertEq({::}, {})}
  .check{"-1/0" .num .assertEq({::}, {})}
  .check{"+1_0/2_0" .num .assertEq({::}, Opts#(+1/2))}
  .check{"-1_0/2_0" .num .assertEq({::}, Opts#(-1/2))}
  .check{" +1/2" .num .assertEq({::}, {})}
  .check{"+1/2 " .num .assertEq({::}, {})}
  }

StrParseFloatTests: Test {::
  .check{"" .float .assertEq({::}, {})}
  .check{"+0.0" .float .assertEq({::}, Opts#(+0.0))}
  .check{"-0.0" .float .assertEq({::}, Opts#(+0.0))}
  .check{"-0.0" .getFloat .isNegZero .assertFalse}
  .check{Math.negZero .str .assertEq "+0.0"}
  .check{"+0.5" .float .assertEq({::}, Opts#(+0.5))}
  .check{"+1.5" .float .assertEq({::}, Opts#(+1.5))}
  .check{"+2.5" .float .assertEq({::}, Opts#(+2.5))}
  .check{"+1_000.0" .float .assertEq({::}, Opts#(+1000.0))}
  .check{"+0.1" .float .assertEq({::}, {})}
  .check{"+0.2" .float .assertEq({::}, {})}
  .check{"-0.1" .float .assertEq({::}, {})}
  .check{"+000.100" .float .assertEq({::}, {})}
  .check{+0012.str.assertEq "+12"}
  .check{00_12.str.assertEq "12"}
  .check{"+1.0e3" .float .assertEq({::}, Opts#(+1000.0))}
  .check{"+1.0e+3" .float .assertEq({::}, Opts#(+1000.0))}
  .check{"-1.0e3" .float .assertEq({::}, Opts#(-1000.0))}
  .check{"+1.0E3" .float .assertEq({::}, Opts#(+1000.0))}
  .check{"NaN" .float .assertEq({::}, {})}
  .check{"Infinity" .float .assertEq({::}, {})}
  .check{"-Infinity" .float .assertEq({::}, {})}
  .check{"+1.0e309" .float .assertEq({::}, {})}
  .check{"-1.0e309" .float .assertEq({::}, {})}
  .check{"+_1.0" .float .assertEq({::}, {})}
  .check{"+1_.0" .float .assertEq({::}, {})}
  .check{" +1.0" .float .assertEq({::}, {})}
  .check{"+1.0 " .float .assertEq({::}, {})}
  .check{"+1.0_e3" .float .assertEq({::}, {})}
  .check{"1.0" .float .assertEq({::}, Opts#(+1.0))}
  .check{"+1" .float .assertEq({::}, {})}
  .check{"+1." .float .assertEq({::}, {})}
  .check{"+.1" .float .assertEq({::}, {})}
  .check{"+1e0" .float .assertEq({::}, {})}
  .check{"+1.0e-3" .float .assertEq({::}, {})}
  .check{"+01__0.00__1" .float .assertEq({::}, {})}
  .check{"+1.25" .float .assertEq({::}, Opts#(+1.25))}
  .check{"+01__0.2__5" .float .assertEq({::}, Opts#(+10.25))}
  .check{"+1.25e-1" .float .assertEq({::}, Opts#(+0.125))}
  .check{"+0.1soft" .float .assertEq({::}, Opts#(+0.1soft))}
  .check{"+0.1soft" .getFloat .assertEq(+0.1soft)}
  .check{"-0__0.1e1soft" .float .assertEq({::}, Opts#(-1.0))}
  .check{"0.1soft" .float .assertEq({::}, Opts#(+0.1soft))}
  .check{"+1.0e400soft" .float .assertEq({::}, {})}
  .check{"+0.1 soft" .float .assertEq({::}, {})}
  .check{"+0.1SOFT" .float .assertEq({::}, {})}
  .check{"+0.1softsoft" .float .assertEq({::}, {})}
  .check{"+1soft" .float .assertEq({::}, {})}
  .check{"+0.1soft" .softFloat .assertEq({::}, Opts#(+0.1soft))}
  .check{"+0.1soft" .getSoftFloat .assertEq(+0.1soft)}
  }

StrParseSoftFloatTests: Test {::
  .check{"" .softFloat .assertEq({::}, {})}
  .check{"+0.5" .softFloat .assertEq({::}, Opts#(+0.5))}
  .check{"+1_000.0" .softFloat .assertEq({::}, Opts#(+1000.0))}
  .check{"-0.0" .softFloat .assertEq({::}, Opts#(+0.0))}
  .check{"+0.1" .softFloat .assertEq({::}, Opts#(+0.1soft))}
  .check{"+0.2" .softFloat .assertEq({::}, Opts#(+0.2soft))}
  .check{"-0.1" .softFloat .assertEq({::}, Opts#(-0.1soft))}
  .check{"+0.1" .softFloat! .assertEq("+0.1".getSoftFloat)}
  .check{"+1.0e-400" .softFloat .assertEq({::}, Opts#(+0.0))}
  .check{"+1.0e309" .softFloat .assertEq({::}, {})}
  .check{"-1.0e309" .softFloat .assertEq({::}, {})}
  .check{"NaN" .softFloat .assertEq({::}, {})}
  .check{"Infinity" .softFloat .assertEq({::}, {})}
  .check{"-Infinity" .softFloat .assertEq({::}, {})}
  .check{"+1.0" .float .assertEq({::}, "+1.0" .softFloat)}
  .check{" +1.0" .softFloat .assertEq({::}, {})}
  .check{"+1_.0" .softFloat .assertEq({::}, {})}
  .checkDetErr({::.isMsg{::.contains "Str.getSoftFloat"}}, {"+1.0e309".getSoftFloat})
  .checkDetErr({::.isMsg{::.contains "Str.getSoftFloat"}}, {"duck".getSoftFloat})
  }

StrParseIeeeFloatTests: Test {::
  .check{"" .ieeeFloat .isEmpty .assertEq True}
  .check{"0.0" .ieeeFloat .match{ .some f->f .isPosZero; .empty->False } .assertEq True}
  .check{"-0.0" .ieeeFloat .match{ .some f->f .isNegZero; .empty->False } .assertEq True}
  .check{"NaN" .ieeeFloat .match{ .some f->f .isNaN; .empty->False } .assertEq True}
  .check{"Infinity" .ieeeFloat .match{ .some f->f .isPosInfinity; .empty->False } .assertEq True}
  .check{"-Infinity" .ieeeFloat .match{ .some f->f .isNegInfinity; .empty->False } .assertEq True}
  .check{"1.5" .ieeeFloat .assertEq({::}, Opts#(+1.5))}
  .check{"1000.0" .ieeeFloat .assertEq({::}, Opts#(+1000.0))}
  .check{"0.1" .ieeeFloat .isSome .assertEq True}
  .check{"-0.1" .ieeeFloat .isSome .assertEq True}
  .check{"0.1".ieeeFloat!.ieeeStr .assertEq "0.1"}
  .check{"0.100000000000000005".ieeeFloat!.ieeeStr .assertEq "0.1"}
  .check{+0.0 .ieeeStr .ieeeFloat .isSome .assertEq True}
  .check{+0.0 / +0.0 .ieeeStr .ieeeFloat .match{ .some f->f .isNaN; .empty->False } .assertEq True}
  .check{"NaN" .float .isEmpty .assertEq True}
  .check{"Infinity" .float .isEmpty .assertEq True}
  .check{"-Infinity" .float .isEmpty .assertEq True}
  .check{"+0.1".ieeeFloat!.num!.inRange("0.100000000000000005/1".num! =~~= (+2/1)).assertEq True}
  .check{"+0.1".ieeeFloat!.num!.inRange("+0.1/1".num! =~~= ("+0.100000000000000005/1".num!)).assertEq False}
  }

StrParseBoolTests: Test {::
  .check{"" .bool .assertEq({::}, {})}
  .check{"True" .bool .assertEq({::}, Opts# True)}
  .check{"False" .bool .assertEq({::}, Opts# False)}
  .check{"true" .bool .assertEq({::}, {})}
  .check{"false" .bool .assertEq({::}, {})}
  .check{" True" .bool .assertEq({::}, {})}
  .check{"True " .bool .assertEq({::}, {})}
  .check{"TrueFalse" .bool .assertEq({::}, {})}
  .check{"True" .getBool .assertEq True}
  .check{"False" .getBool .assertEq False}
  .check{True .str .getBool .assertEq True}
  .check{False .str .getBool .assertEq False}
  .checkDetErr({::.isMsg{::.contains "Str.getBool"}}, {"duck".getBool})
  }

TestStr: Test {::
  .test StrBasicsTests
  .test StrConcatTests
  .test StrSepOpsTests
  .test StrOrderTests
  .test StrEscapeTests
  .test StrParseIntTests
  .test StrParseNatTests
  .test StrParseByteTests
  .test StrParseNumTests
  .test StrParseFloatTests
  .test StrParseSoftFloatTests
  .test StrParseIeeeFloatTests
  .test StrParseBoolTests
  }
