Float0Imm0Succ0Test: Test {::
    .check{1.0 .getSucc .assertGt 1.0}
    .check{(-0.0) .getSucc .assertEq(0.0.getSucc)}
    .checkDetErr({_ -> True}, {Math.nan .getSucc})
    .checkDetErr({_ -> True}, {Math.inf .getSucc})
  }

Float0Imm0Pred0Test: Test {::
    .check{1.0 .getPred .assertLt 1.0}
    .check{0.0 .getPred .assertEq(0.0.getSucc * -1.0)}
    .checkDetErr({_ -> True}, {Math.nan .getPred})
    .checkDetErr({_ -> True}, {Math.negInf .getPred})
  }

Float0Imm0Plus1Test: Test {::
    .check{(2.0 + 3.0) .assertEq 5.0}
    .check{(Math.inf + 1.0) .assertEq(Math.inf)}
    .check{(Math.nan + 1.0) .isNaN .assertTrue}
  }

Float0Imm0Dash1Test: Test {::
    .check{(5.0 - 3.0) .assertEq 2.0}
    .check{(Math.inf - (Math.inf)) .isNaN .assertTrue}
  }

Float0Imm0Star1Test: Test {::
    .check{(2.0 * 3.0) .assertEq 6.0}
    .check{(0.0 * (Math.inf)) .isNaN .assertTrue}
  }

Float0Imm0Slash1Test: Test {::
    .check{(6.0 / 3.0) .assertEq 2.0}
    .check{(1.0 / 0.0) .assertEq(Math.inf)}
    .check{(-1.0 / 0.0) .assertEq(Math.negInf)}
    .check{(0.0 / 0.0) .isNaN .assertTrue}
  }

Float0Imm0StarStar1Test: Test {::
    .check{2.0 ** 3.0 .assertEq 8.0}
    .check{Math.nan ** 0.0 .isNaN .assertTrue} // not true of ieee
    .check{0.0 ** -0.0 .isNaN .assertTrue}  // not true of ieee
  }

Float0Imm0AbsOrNaN0Test: Test {::
    .check{4.75 .absOrNaN .assertEq 4.75}
    .check{(-4.75) .absOrNaN .assertEq 4.75}
    .check{(Math.nan) .absOrNaN .isNaN .assertTrue}
  }

Float0Imm0Abs0Test: Test {::
    .check{4.75 .abs .assertEq({::}, Opts# 4.75)}
    .check{(-4.75) .abs .assertEq({::}, Opts# 4.75)}
    .check{(Math.nan) .abs .assertEmpty}
  }

Float0Imm0GetAbs0Test: Test {::
    .check{4.75 .getAbs .assertEq 4.75}
    .check{(-4.75) .getAbs .assertEq 4.75}
    .checkDetErr({_ -> True}, {(Math.nan) .getAbs})
  }

Float0Imm0NegAbsOrNaN0Test: Test {::
    .check{4.75 .negAbsOrNaN .assertEq(-4.75)}
    .check{(-4.75) .negAbsOrNaN .assertEq(-4.75)}
    .check{(Math.nan) .negAbsOrNaN .isNaN .assertTrue}
  }

Float0Imm0NegAbs0Test: Test {::
    .check{4.75 .negAbs .assertEq({::}, Opts# (-4.75))}
    .check{(Math.nan) .negAbs .assertEmpty}
  }

Float0Imm0GetNegAbs0Test: Test {::
    .check{4.75 .getNegAbs .assertEq(-4.75)}
    .checkDetErr({_ -> True}, {(Math.nan) .getNegAbs})
  }

Float0Imm0SqrtOrNaN0Test: Test {::
    .check{4.0 .sqrtOrNaN .assertEq 2.0}
    .check{(-0.0) .sqrtOrNaN .assertEq(-0.0)}
    .check{(-4.0) .sqrtOrNaN .isNaN .assertTrue}
    .check{(Math.nan) .sqrtOrNaN .isNaN .assertTrue}
  }

Float0Imm0Sqrt0Test: Test {::
    .check{4.0 .sqrt .assertEq({::}, Opts# 2.0)}
    .check{(-4.0) .sqrt .assertEmpty}
    .check{(Math.nan) .sqrt .assertEmpty}
  }

Float0Imm0GetSqrt0Test: Test {::
    .check{4.0 .getSqrt .assertEq 2.0}
    .checkDetErr({_ -> True}, {(-4.0) .getSqrt})
    .checkDetErr({_ -> True}, {(Math.nan) .getSqrt})
  }

Float0Imm0SignOrNaN0Test: Test {::
    .check{4.75 .signOrNaN .assertEq 1.0}
    .check{(-4.75) .signOrNaN .assertEq(-1.0)}
    .check{0.0 .signOrNaN .isPosZero .assertTrue}
    .check{(-0.0) .signOrNaN .isNegZero .assertTrue}
    .check{(Math.nan) .signOrNaN .isNaN .assertTrue}
  }

Float0Imm0Sign0Test: Test {::
    .check{4.75 .sign .assertEq({::}, Opts# 1.0)}
    .check{(Math.nan) .sign .assertEmpty}
  }

Float0Imm0GetSign0Test: Test {::
    .check{(-4.75) .getSign .assertEq(-1.0)}
    .checkDetErr({_ -> True}, {(Math.nan) .getSign})
  }

Float0Imm0SoftFloor0Test: Test {::
    .check{4.75 .softFloor .assertEq 3.0}
    .check{(-3.25) .softFloor .assertEq(-4.0)}
    .check{(Math.inf) .softFloor .assertEq(Math.inf)}
    .check{(Math.nan) .softFloor .isNaN .assertTrue}
  }

Float0Imm0Floor0Test: Test {::
    .check{4.75 .floor .assertEq({::}, Opts# 3.0)}
    .check{(Math.inf) .floor .assertEmpty}
    .check{(Math.nan) .floor .assertEmpty}
  }

Float0Imm0GetFloor0Test: Test {::
    .check{4.75 .getFloor .assertEq 3.0}
    .checkDetErr({_ -> True}, {(Math.inf) .getFloor})
    .checkDetErr({_ -> True}, {(Math.nan) .getFloor})
  }

Float0Imm0SoftCeil0Test: Test {::
    .check{3.25 .softCeil .assertEq 4.0}
    .check{(-4.75) .softCeil .assertEq(-3.0)}
    .check{(Math.negInf) .softCeil .assertEq(Math.negInf)}
    .check{(Math.nan) .softCeil .isNaN .assertTrue}
  }

Float0Imm0Ceil0Test: Test {::
    .check{3.25 .ceil .assertEq({::}, Opts# 4.0)}
    .check{(Math.negInf) .ceil .assertEmpty}
    .check{(Math.nan) .ceil .assertEmpty}
  }

Float0Imm0GetCeil0Test: Test {::
    .check{3.25 .getCeil .assertEq 4.0}
    .checkDetErr({_ -> True}, {(Math.negInf) .getCeil})
    .checkDetErr({_ -> True}, {(Math.nan) .getCeil})
  }

Float0Imm0SoftTrunc00Test: Test {::
    .check{2.75 .softTrunc0 .assertEq 2.0}
    .check{(-2.75) .softTrunc0 .assertEq(-2.0)}
    .check{(Math.inf) .softTrunc0 .assertEq(Math.inf)}
    .check{(Math.nan) .softTrunc0 .isNaN .assertTrue}
  }

Float0Imm0Trunc00Test: Test {::
    .check{2.75 .trunc0 .assertEq({::}, Opts# 2.0)}
    .check{(-2.75) .trunc0 .assertEq({::}, Opts# (-2.0))}
    .check{(Math.inf) .trunc0 .assertEmpty}
    .check{(Math.nan) .trunc0 .assertEmpty}
  }

Float0Imm0GetTrunc00Test: Test {::
    .check{(-2.75) .getTrunc0 .assertEq(-2.0)}
    .checkDetErr({_ -> True}, {(Math.inf) .getTrunc0})
    .checkDetErr({_ -> True}, {(Math.nan) .getTrunc0})
  }

Float0Imm0SoftRound0Test: Test {::
    .check{2.5 .softRound .assertEq 3.0}
    .check{(-2.5) .softRound .assertEq(-3.0)}
    .check{(Math.inf) .softRound .assertEq(Math.inf)}
    .check{(Math.nan) .softRound .isNaN .assertTrue}
  }

Float0Imm0Round0Test: Test {::
    .check{2.5 .round .assertEq({::}, Opts# 3.0)}
    .check{(-2.5) .round .assertEq({::}, Opts# (-3.0))}
    .check{(Math.inf) .round .assertEmpty}
    .check{(Math.nan) .round .assertEmpty}
  }

Float0Imm0GetRound0Test: Test {::
    .check{(-2.5) .getRound .assertEq(-3.0)}
    .checkDetErr({_ -> True}, {(Math.inf) .getRound})
    .checkDetErr({_ -> True}, {(Math.nan) .getRound})
  }

Float0Imm0SoftRoundTiesEven0Test: Test {::
    .check{2.5 .softRoundTiesEven .assertEq 2.0}
    .check{3.5 .softRoundTiesEven .assertEq 4.0}
    .check{(-2.5) .softRoundTiesEven .assertEq(-2.0)}
    .check{(Math.inf) .softRoundTiesEven .assertEq(Math.inf)}
    .check{(Math.nan) .softRoundTiesEven .isNaN .assertTrue}
  }

Float0Imm0RoundTiesEven0Test: Test {::
    .check{2.5 .roundTiesEven .assertEq({::}, Opts# 2.0)}
    .check{(Math.inf) .roundTiesEven .assertEmpty}
    .check{(Math.nan) .roundTiesEven .assertEmpty}
  }

Float0Imm0GetRoundTiesEven0Test: Test {::
    .check{2.5 .getRoundTiesEven .assertEq 2.0}
    .checkDetErr({_ -> True}, {(Math.inf) .getRoundTiesEven})
    .checkDetErr({_ -> True}, {(Math.nan) .getRoundTiesEven})
  }

Float0Imm0IsNaN0Test: Test {::
    .check{(Math.nan) .isNaN .assertTrue}
    .check{1.0 .isNaN .assertFalse}
  }

Float0Imm0IsInfinite0Test: Test {::
    .check{(Math.inf) .isInfinite .assertTrue}
    .check{(Math.negInf) .isInfinite .assertTrue}
    .check{1.0 .isInfinite .assertFalse}
  }

Float0Imm0IsPosInfinity0Test: Test {::
    .check{(Math.inf) .isPosInfinity .assertTrue}
    .check{(Math.negInf) .isPosInfinity .assertFalse}
  }

Float0Imm0IsNegInfinity0Test: Test {::
    .check{(Math.negInf) .isNegInfinity .assertTrue}
    .check{(Math.inf) .isNegInfinity .assertFalse}
  }

Float0Imm0IsNegZero0Test: Test {::
    .check{(-0.0) .isNegZero .assertTrue}
    .check{0.0 .isNegZero .assertFalse}
  }

Float0Imm0IsPosZero0Test: Test {::
    .check{0.0 .isPosZero .assertTrue}
    .check{(-0.0) .isPosZero .assertFalse}
  }

Float0Imm0IsFinite0Test: Test {::
    .check{1.0 .isFinite .assertTrue}
    .check{0.0 .isFinite .assertTrue}
    .check{(Math.inf) .isFinite .assertFalse}
    .check{(Math.nan) .isFinite .assertFalse}
  }

Float0Imm0IeeeSameBits1Test: Test {::
    .check{(0.0 .ieeeSameBits(-0.0)) .assertFalse}
    .check{(1.0 .ieeeSameBits 1.0) .assertTrue}
  }

Float0Imm0IeeeStr0Test: Test {::
    .check{1.5 .ieeeStr .assertEq "1.5"}
    .check{(Math.nan) .ieeeStr .assertEq((Math.nan.negAbsOrNaN) .ieeeStr)}
  }

Float0Imm0IeeeRemainder1Test: Test {::
    .check{(5.0 .ieeeRemainder 3.0) .assertEq(-1.0)}
  }

Float0Imm0IeeeEq1Test: Test {::
    .check {Math.nan.ieeeEq(Math.nan).assertFalse}
    .check{+0.0 .ieeeEq -0.0  .assertTrue}
  }

Float0Imm0Int0Test: Test {::
    .check{3.0 .int .assertEq({::}, Opts# +3)}
    .check{3.5 .int .assertEmpty}
    .check{(Math.nan) .int .assertEmpty}
  }

Float0Imm0Nat0Test: Test {::
    .check{3.0 .nat .assertEq({::}, Opts# 3)}
    .check{(-1.0) .nat .assertEmpty}
  }

Float0Imm0Byte0Test: Test {::
    .check{3.0 .byte .assertEq({::}, Opts#(3.getByte))}
    .check{300.0 .byte .assertEmpty}
  }

Float0Imm0Num0Test: Test {::
    .check{3.5 .num .assertEq({::}, Opts#(7/2))}
    .check{(Math.inf) .num .assertEmpty}
  }

Float0Imm0SoftInt0Test: Test {::
    .check{4.75 .softInt .assertEq +3}
    .check{(Math.nan) .softInt .assertEq +0}
    .check{(Math.inf) .softInt .assertEq(Math.maxInt)}
  }

Float0Imm0SoftNat0Test: Test {::
    .check{4.75 .softNat .assertEq 3}
    .check{(Math.negInf) .softNat .assertEq 0}
    .check{(Math.inf) .softNat .assertEq(Math.maxNat)}
  }

Float0Imm0SoftByte0Test: Test {::
    .check{4.75 .softByte .assertEq(3.getByte)}
    .check{(Math.inf) .softByte .assertEq(Math.maxByte)}
  }

Float0Imm0GetInt0Test: Test {::
    .check{3.0 .getInt .assertEq +3}
    .checkDetErr({_ -> True}, {3.5 .getInt})
    .checkDetErr({_ -> True}, {(Math.nan) .getInt})
  }

Float0Imm0GetNat0Test: Test {::
    .check{3.0 .getNat .assertEq 3}
    .checkDetErr({_ -> True}, {(-1.0) .getNat})
  }

Float0Imm0GetByte0Test: Test {::
    .check{3.0 .getByte.nat .assertEq 3}
    .checkDetErr({_ -> True}, {300.0 .getByte})
  }

Float0Imm0GetNum0Test: Test {::
    .check{3.5 .getNum .assertEq (7/2)}
    .checkDetErr({_ -> True}, {(Math.inf) .getNum})
    .checkDetErr({_ -> True}, {(Math.nan) .getNum})
  }

Float0Imm1Match1Test: Test {::
    .check{(0.0 .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "pz"}
    .check{(3.5 .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "r"}
    .check{((Math.nan) .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "n"}
  }

Float0Imm0Deg0Test: Test {::
    .check{90.0 .deg .assertEq({::}, Opts#(90.0.getDeg))}
    .check{(Math.nan) .deg .assertEmpty}
    .check{(Math.inf) .deg .assertEmpty}
  }

Float0Imm0GetDeg0Test: Test {::
    .check{90.0 .getDeg# .assertEq(90.0)}
    .checkDetErr({_ -> True}, {(Math.inf) .getDeg})
  }

Float0Imm0Rad0Test: Test {::
    .check{1.5 .rad .assertEq({::}, Opts#(1.5.getRad))}
    .check{(Math.nan) .rad .assertEmpty}
  }

Float0Imm0GetRad0Test: Test {::
    .check{1.5 .getRad# .assertEq 1.5}
    .checkDetErr({_ -> True}, {(Math.nan) .getRad})
  }

Float0Imm0InRange1Test: Test {::
    .check{(2.0 .inRange(1.0=~~=4.0)) .assertTrue}
    .check{(5.0 .inRange(1.0=~~=4.0)) .assertFalse}
  }

Float0Imm0AssertInRange1Test: Test {::
    .check{2.0 .assertInRange(1.0=~~=4.0)}
    .checkDetErr({_ -> True}, {5.0 .assertInRange(1.0=~~=4.0)})
  }

Float0Imm0ClampTo1Test: Test {::
    .check{0.0 .clampTo(1.0=~~=4.0) .assertEq 1.0}
    .check{5.0 .clampTo(1.0=~~=4.0) .assertEq 4.0}
    .check{(Math.nan) .clampTo(1.0=~~=4.0) .assertEq 4.0}
  }

