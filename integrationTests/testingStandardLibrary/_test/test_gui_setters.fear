GuiSetterTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f ->
    Error.msg(f.location(X#(+3), Y#(+4)).locationX.str + " " + (f.locationY.str))
    }}).run{
      .ok _ -> Error.msg "The consumer always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "X[+3] Y[+4]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.resizable(Width#32768, Height#80).content{::}}}).run{
      .ok _ -> Error.msg "A window width over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "window width 32768 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.fixedSize(Width#300, Height#32768).content{::}}}).run{
      .ok _ -> Error.msg "A window height over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "window height 32768 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.location(X#(+32768), Y#(+0)).content{:: .paint{g -> Error.msg "A window location over the limit was accepted"} }}}).run{
      .ok _ -> Error.msg "A window location over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "window x 32768 is out of range; it must be between -32768 and 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.location(X#(+0), Y#(-32769)).content{:: .paint{g -> Error.msg "A window location under the limit was accepted"} }}}).run{
      .ok _ -> Error.msg "A window location under the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "window y -32769 is out of range; it must be between -32768 and 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.fps(0).content{:: .paint{g -> Error.msg "An fps below the limit was accepted"} }}}).run{
      .ok _ -> Error.msg "An fps below the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "fps 0 is out of range; it must be between 1 and 500"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.fps(18446744073709551615).content{:: .paint{g -> Error.msg "An fps over the limit was accepted"} }}}).run{
      .ok _ -> Error.msg "An fps over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "fps 18446744073709551615 is out of range; it must be between 1 and 500"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.modelFps(501, {::}).content{:: .paint{g -> Error.msg "A modelFps over the limit was accepted"} }}}).run{
      .ok _ -> Error.msg "A modelFps over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "modelFps 501 is out of range; it must be between 1 and 500"}}.assertTrue{i};
      }}
  }
