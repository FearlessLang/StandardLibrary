GuiImageTests: Test {::
  .check{base.IconsConflict.consumeImage("imageOk").scale(Width#4, Height#2).scaleToWidth(8).height .assertEq(Height#4)}
  .checkDetErr({::.isMsg{:: == "image width 0 is too small; it must be >= 1"}}, {base.IconsConflict.consumeImage("imageWidth0").scale(Width#0, Height#5)})
  .checkDetErr({::.isMsg{:: == "image height 0 is too small; it must be >= 1"}}, {base.IconsConflict.consumeImage("imageHeight0").scale(Width#5, Height#0)})
  .checkDetErr({::.isMsg{:: == "image width 32768 is too large; it must be <= 32767"}}, {base.IconsConflict.consumeImage("imageWidthBig").scale(Width#32768, Height#5)})
  .checkDetErr({::.isMsg{:: == "image height 32768 is too large; it must be <= 32767"}}, {base.IconsConflict.consumeImage("imageHeightBig").scale(Width#5, Height#32768)})
  .checkDetErr({::.isMsg{:: == "image width 0 is too small; it must be >= 1"}}, {base.IconsConflict.consumeImage("toWidth0").scaleToWidth 0})
  .checkDetErr({::.isMsg{:: == "image height 32768 is too large; it must be <= 32767"}}, {base.IconsConflict.consumeImage("toHeightBig").scaleToHeight 32768})
  .checkDetErr({::.isMsg{:: == "image width 32767000 is too large; it must be <= 32767"}}, {base.IconsConflict.consumeImage("toHeightWide").scale(Width#1000, Height#1).scaleToHeight 32767})
  .checkDetErr({::.isMsg{:: == "image 20000 x 20000 has 400000000 pixels; it must have <= 268435456"}}, {base.IconsConflict.consumeImage("imageAreaBig").scale(Width#20000, Height#20000)})
  .checkDetErr({::.isMsg{:: == "image 32767 x 16384 has 536854528 pixels; it must have <= 268435456"}}, {base.IconsConflict.consumeImage("toWidthAreaBig").scale(Width#2, Height#1).scaleToWidth 32767})
  .check{base.IconsConflict.consumeImage("imageWidthMax").scale(Width#32767, Height#1).width .assertEq(Width#32767)}
  .check{base.Images#(Width#30, Height#20, Color.transparent).paint{g -> g}.width .assertEq(Width#30)}
  .check{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.color(Color.dangerTomato).position(X#(+20), Y#(-10)).oval(Width#40, Height#40)}.height .assertEq(Height#20)}
  .check{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.image(base.IconsConflict.consumeImage("paintImage").scale(Width#10, Height#10)).position(X#(+5), Y#(+5)).line(X#(+25), Y#(+15))}.scale(Width#60, Height#40).width .assertEq(Width#60)}
  .check{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.position(X#(+5), Y#(+5)).image(base.IconsConflict.consumeImage("paintImageScaled"), Width#10, Height#10)}.width .assertEq(Width#30)}
  .checkDetErr({::.isMsg{:: == "image width 32768 is too large; it must be <= 32767"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.image(base.IconsConflict.consumeImage("paintImageWide"), Width#32768, Height#10)}})
  .checkDetErr({::.isMsg{:: == "Width[30] Height[20] Instant[0]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str) + " " + (g.elapsed.str))}})
  .checkDetErr({::.isMsg{:: == "Width[0] Width[47] Height[18] Height[12] Width[93] Height[36] Width[93]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg((g.textRoom("").width.str) + " " + (g.textRoom("Fearless").width.str) + " " + (g.textRoom("Fearless").height.str) + " " + (g.textRoom("Fearless").baseline.str) + " " + (g.textHeight(24).textRoom("Fearless").width.str) + " " + (g.textRoom("Fearless").height.str) + " " + (g.uTextRoom("Fearless".u).width.str))}})
  .checkDetErr({::.isMsg{:: == "TextRatio[+1.0] TextRatio[+0.5] Height[30] Height[24] TextRatio[+2.0]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg((g.aboveBaseline.str) + " " + (g.belowBaseline.str) + " " + (g.aboveBaseline(+2.0).textRoom("Latin").height.str) + " " + (g.textRoom("Latin").baseline.str) + " " + (g.aboveBaseline.str))}})
  .checkDetErr({::.isMsg{:: == "Height[28] Height[17]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg((g.uTextRoom("".u "005A 030D 030D 030D 0316 0316 0316").height.str) + " " + (g.uTextRoom("".u "005A 030D 030D 030D 0316 0316 0316").baseline.str))}})
  .checkDetErr({::.isMsg{:: == "[Fearless Fearless][Fearless][][a]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.textLines("Fearless Fearless Fearless" | "" | "a", Width#100).flow.map{l -> "["+l+"]"}.join "")}})
  .checkDetErr({::.isMsg{:: == "[F][e][a][r][l][e][s][s]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.textLines("Fearless", Width#0).flow.map{l -> "["+l+"]"}.join "")}})
  .checkDetErr({::.isMsg{:: == "Color[Red[245], Green[245], Blue[245], Alpha[255]]"}}, {Error.msg[Str](base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g}.color(X#(+29), Y#(+19)).str)})
  .checkDetErr({::.isMsg{:: == "Color[Red[230], Green[64], Blue[48], Alpha[255]] Color[Red[245], Green[245], Blue[245], Alpha[255]]"}}, {Error.msg[Str](ImagePixels#(base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.color(Color.dangerTomato).position(X#(+2), Y#(+3)).rect(Width#4, Height#5)}))})
  .checkDetErr({::.isMsg{:: == "pixel x 30 is out of range; it must be between 0 and 29"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g}.color(X#(+30), Y#(+0))})
  .checkDetErr({::.isMsg{:: == "pixel y -1 is out of range; it must be between 0 and 19"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g}.color(X#(+0), Y#(-1))})
  .check{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.position(X#(+2), Y#(+2)).text("ab", Width#26, Height#16)}.width .assertEq(Width#30)}
  .checkDetErr({::.isMsg{:: == "Color[Red[0], Green[0], Blue[0], Alpha[255]] Color[Red[230], Green[64], Blue[48], Alpha[255]] X[+0] Y[+0] X[+7] Y[-3] Height[12] Height[24]"}},{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg((g.color).str + " " + ((g.color(Color.dangerTomato).color).str) + " " + ((g.positionX).str) + " " + ((g.positionY).str) + " " + ((g.position(X#(+7), Y#(-3)).positionX).str) + " " + ((g.positionY).str) + " " + ((g.textHeight).str) + " " + ((g.textHeight(24).textHeight).str))}})
  .check{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.textHeight 16 .position(X#(+2), Y#(+2)).text "Fearless" .position(X#(-5), Y#(+15)).uText("ab".u)}.width .assertEq(Width#30)}
  .checkDetErr({::.isMsg{:: == "The text given to Graphics.text has a line break (U+000A) at offset 1: Graphics.text draws one line"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.text("a" | "b")}})
  .checkDetErr({::.isMsg{:: == "The text given to Graphics.textRoom has a line break (U+2029) at offset 3: Graphics.textRoom measures one line"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.uTextRoom("abc".u "2029 0064").width.str)}})
  .checkDetErr({::.isMsg{:: == "text height 32768 is too large; it must be <= 32767"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.textHeight 32768}})
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .label{l -> Error.msg(l.text "Fearless" .pack .width.str)}}}}).run{
      .ok _ -> Error.msg "The scope always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[59]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .pane{:: .width 20 .height 20 .foreground(Color.sleepyBlue) .paint{g -> Error.msg((g.color).str)}}}}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Color[Red[72], Green[120], Blue[210], Alpha[255]]"}}.assertTrue{i};
      }}
  .checkDetErr({::.isMsg{:: == "image width 0 is too small; it must be >= 1"}}, {base.Images#(Width#0, Height#5, Color.transparent)})
  .checkDetErr({::.isMsg{:: == "image height 32768 is too large; it must be <= 32767"}}, {base.Images#(Width#5, Height#32768, Color.transparent)})
  .checkDetErr({::.isMsg{:: == "image 20000 x 20000 has 400000000 pixels; it must have <= 268435456"}}, {base.Images#(Width#20000, Height#20000, Color.transparent)})
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureGrow")))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[52] Height[32]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureWidth").width(92)))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[92] Height[52]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureHeight").height(52)))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[92] Height[52]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureLast").height(52).width(32)))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[32] Height[22]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureStretch").keepAspect(False).width(92)))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[92] Height[32]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"picturePack").width(92).pack))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[52] Height[32]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .picture{p -> p.image(PictureImage#"pictureBig").height(20000)}}}}).run{
      .ok _ -> Error.msg "A keepAspect width over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "keepAspect width 39988 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  }
PictureImage:{#(id: Str): base.Image -> base.IconsConflict.consumeImage(id).scale(Width#40, Height#20)}
PictureSize:{#(p: read base.Picture): Str -> p.width.str + " " + (p.height.str)}
ImagePixels:{#(i: base.Image): Str -> i.color(X#(+5), Y#(+7)).str + " " + (i.color(X#(+6), Y#(+7)).str)}
