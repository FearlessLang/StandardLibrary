GuiImageTests: Test {::
  .check{base.IconsConflict.consumeImage("imageOk").scale(Width#4, Height#2).scaleToWidth(8).height .assertEq(Height#4)}
  .checkDetErr({::.isMsg{:: == "image width 0 is too small; it must be >= 1"}}, {base.IconsConflict.consumeImage("imageWidth0").scale(Width#0, Height#5)})
  .checkDetErr({::.isMsg{:: == "image height 0 is too small; it must be >= 1"}}, {base.IconsConflict.consumeImage("imageHeight0").scale(Width#5, Height#0)})
  .checkDetErr({::.isMsg{:: == "image width 32768 is too large; it must be <= 32767"}}, {base.IconsConflict.consumeImage("imageWidthBig").scale(Width#32768, Height#5)})
  .checkDetErr({::.isMsg{:: == "image height 32768 is too large; it must be <= 32767"}}, {base.IconsConflict.consumeImage("imageHeightBig").scale(Width#5, Height#32768)})
  .checkDetErr({::.isMsg{:: == "image width 0 is too small; it must be >= 1"}}, {base.IconsConflict.consumeImage("toWidth0").scaleToWidth 0})
  .checkDetErr({::.isMsg{:: == "image height 32768 is too large; it must be <= 32767"}}, {base.IconsConflict.consumeImage("toHeightBig").scaleToHeight 32768})
  .checkDetErr({::.isMsg{:: == "image width 32767000 is too large; it must be <= 32767"}}, {base.IconsConflict.consumeImage("toHeightWide").scale(Width#1000, Height#1).scaleToHeight 32767})
  .checkDetErr({::.isMsg{:: == "image 20000 x 20000 has 400000000 pixels; it must have <= 268435456"}}, {base.IconsConflict.consumeImage("imageAreaBig").scale(Width#20000, Height#20000)})
  .checkDetErr({::.isMsg{:: == "image 32767 x 16384 has 536854528 pixels; it must have <= 268435456"}}, {base.IconsConflict.consumeImage("toWidthAreaBig").scale(Width#2, Height#1).scaleToWidth 32767})
  .check{base.IconsConflict.consumeImage("imageWidthMax").scale(Width#32767, Height#1).width .assertEq(Width#32767)}
  .check{base.Images#(Width#30, Height#20, Color.transparent).width .assertEq(Width#30)}
  .check{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.color(Color.dangerTomato).position(X#(+20), Y#(-10)).oval(Width#40, Height#40)}.height .assertEq(Height#20)}
  .check{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.image(base.IconsConflict.consumeImage("paintImage").scale(Width#10, Height#10)).position(X#(+5), Y#(+5)).line(X#(+25), Y#(+15))}.scale(Width#60, Height#40).width .assertEq(Width#60)}
  .checkDetErr({::.isMsg{:: == "Width[30] Height[20] Instant[0]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str) + " " + (g.elapsed.str))}})
  .check{base.TextWidth#("".u, Height#12) .assertEq(Width#0)}
  .check{base.TextWidth#("Fearless".u, Height#12) .assertEq(Width#47)}
  .check{base.TextWidth#("Fearless".u, Height#24) .assertEq(Width#93)}
  .checkDetErr({::.isMsg{:: == "text height 32768 is too large; it must be <= 32767"}}, {base.TextWidth#("Fearless".u, Height#32768)})
  .check{base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.textHeight 16 .position(X#(+2), Y#(+2)).text "Fearless" .position(X#(-5), Y#(+15)).uText("ab".u)}.width .assertEq(Width#30)}
  .checkDetErr({::.isMsg{:: == "text height 32768 is too large; it must be <= 32767"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> g.textHeight 32768}})
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .label{l -> Error.msg(l.text "Fearless" .pack .width.str)}}}}).run{
      .ok _ -> Error.msg "The scope always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[59]"}}.assertTrue{i};
      }}
  .checkDetErr({::.isMsg{:: == "image width 0 is too small; it must be >= 1"}}, {base.Images#(Width#0, Height#5, Color.transparent)})
  .checkDetErr({::.isMsg{:: == "image height 32768 is too large; it must be <= 32767"}}, {base.Images#(Width#5, Height#32768, Color.transparent)})
  .checkDetErr({::.isMsg{:: == "image 20000 x 20000 has 400000000 pixels; it must have <= 268435456"}}, {base.Images#(Width#20000, Height#20000, Color.transparent)})
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureGrow")))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[52] Height[32]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureWidth").width(92)))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[92] Height[52]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureHeight").height(52)))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[92] Height[52]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureLast").height(52).width(32)))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[32] Height[22]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"pictureStretch").keepAspect(False).width(92)))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[92] Height[32]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .picture{p -> Error.msg(PictureSize#(p.image(PictureImage#"picturePack").width(92).pack))}}}}).run{
      .ok _ -> Error.msg "The picture always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[52] Height[32]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .picture{p -> p.image(PictureImage#"pictureBig").height(20000)}}}}).run{
      .ok _ -> Error.msg "A keepAspect width over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "keepAspect width 39988 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  }
PictureImage:{#(id: Str): base.Image -> base.IconsConflict.consumeImage(id).scale(Width#40, Height#20)}
PictureSize:{#(p: read base.Picture): Str -> p.width.str + " " + (p.height.str)}
