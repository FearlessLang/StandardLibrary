// Thank you AI for this large Info
_Infos: {
  .largeNested: imm Info ->
    Maps#[Str,Str,ToInfo]({::},
      "application", Maps#[Str, Str, ToInfo]({::},
        "name", "Example Application",
        "version", "2.4.1",
        "environment", "production",

        "server", Maps#[Str, Str, ToInfo]({::},
          "host", "api.example.com",
          "port", 443,
          "secure", True,

          "timeouts", Maps#({::},
            "connection", 5000,
            "read", 30000,
            "write", 30000
          ).info{::}
        ).info ToInfoBy[ToInfo]{::},

        "database", Maps#[Str, Str, ToInfo]({::},
          "engine", "postgres",
          "host", "db.example.com",
          "port", 5432,
          "pool", Maps#({::},
            "minimum", 5,
            "maximum", 20,
            "timeout", 10000
          ).info{::}
        ).info ToInfoBy[ToInfo]{::},

        "features", Maps#[Str, Str, ToInfo]({::},
          "search", True,
          "recommendations", True,
          "experimental", False,

          "betaFeatures", Lists#[Map[Str,ToInfo]](
            Maps#[Str,Str,ToInfo]({::},
              "name", "newDashboard",
              "enabled", True,
              "rollout", 0.25
            ),
            Maps#[Str,Str,ToInfo]({::},
              "name", "newSearch",
              "enabled", False,
              "rollout", 0.0
            )
          ).info ToInfoBy[Map[Str,ToInfo]]{::.info{::}}
        ).info ToInfoBy[ToInfo]{::}
      ).info ToInfoBy[ToInfo]{::.info}
    ).info ToInfoBy[ToInfo]{::.info};

  /// many siblings, no nesting: stresses sibling-by-sibling scanning
  /// (as opposed to .largeNested, which stresses recursion into nested values)
  .wideFlat: imm Info -> (0=~~5000).flow.map{n->Infos.msg(n.str)}.list.info{::};
  }

InfoTests: Test {::
  .check{_Infos.largeNested.validate{::.isMap} .assertTrue}
  .check{_Infos.largeNested.validate{:: > "application" > "name".isMsg{:: == "Example Application"}} .assertTrue}
  .check{Infos.msg "A".validate{::.isMsg{::.contains "A"}}.assertTrue}
  .check{Infos.msg "B".validate{::.isMsg{::.contains "B"}}.assertTrue}
  .check{Infos.msg "A".validate{::.isMsg{::.contains "B"}}.assertFalse}
  .check{Infos.msg "A".validate{::.isMsg{::.contains "A"} | .isMsg{::.contains "B"}}.assertTrue}
  .check{Infos.msg "B".validate{::.isMsg{::.contains "A"} | .isMsg{::.contains "B"}}.assertTrue}

  .check{Infos.msg "A".validate{::.isMsg{::.contains "A"} & .isMsg{::.contains "B"}}.assertFalse}
  .check{Infos.msg "B".validate{::.isMsg{::.contains "A"}& .isMsg{::.contains "B"}}.assertFalse}
  .check{Infos.msg "B".extract{:: > 0}.assertEmpty{::}}
  }

