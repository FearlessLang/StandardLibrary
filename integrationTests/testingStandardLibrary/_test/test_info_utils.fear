// Thank you AI for this large Info
_Infos: {
  .largeNested: imm Info ->
    Maps#[Str,Str,ToInfo]({::},
      "application", Maps#[Str, Str, ToInfo]({::},
        "name", "Example Application",
        "version", "2.4.1",
        "environment", "production",

        "server", Maps#[Str, Str, ToInfo]({::},
          "host", "api.example.com",
          "port", 443,
          "secure", True,

          "timeouts", Maps#({::},
            "connection", 5000,
            "read", 30000,
            "write", 30000
          ).info{::}
        ).info ToInfoBy[ToInfo]{::},

        "database", Maps#[Str, Str, ToInfo]({::},
          "engine", "postgres",
          "host", "db.example.com",
          "port", 5432,
          "pool", Maps#({::},
            "minimum", 5,
            "maximum", 20,
            "timeout", 10000
          ).info{::}
        ).info ToInfoBy[ToInfo]{::},

        "features", Maps#[Str, Str, ToInfo]({::},
          "search", True,
          "recommendations", True,
          "experimental", False,

          "betaFeatures", Lists#[Map[Str,ToInfo]](
            Maps#[Str,Str,ToInfo]({::},
              "name", "newDashboard",
              "enabled", True,
              "rollout", 0.25
            ),
            Maps#[Str,Str,ToInfo]({::},
              "name", "newSearch",
              "enabled", False,
              "rollout", 0.0
            )
          ).info ToInfoBy[Map[Str,ToInfo]]{::.info{::}}
        ).info ToInfoBy[ToInfo]{::}
      ).info ToInfoBy[ToInfo]{::.info}
    ).info ToInfoBy[ToInfo]{::.info};

  /// many siblings, no nesting: stresses sibling-by-sibling scanning
  /// (as opposed to .largeNested, which stresses recursion into nested values)
  .wideFlat: imm Info -> (0=~~5000).flow.map{n->Infos.msg(n.str)}.list.info{::};
  }

InfoTests: Test {::
  .check{_Infos.largeNested.validate{::.isMap} .assertTrue}
  .check{_Infos.largeNested.validate{:: > "application" > "name".isMsg{:: == "Example Application"}} .assertTrue}
  .check{Infos.msg "A".validate{::.isMsg{::.contains "A"}}.assertTrue}
  .check{Infos.msg "B".validate{::.isMsg{::.contains "B"}}.assertTrue}
  .check{Infos.msg "A".validate{::.isMsg{::.contains "B"}}.assertFalse}
  .check{Infos.msg "A".validate{::.isMsg{::.contains "A"} | .isMsg{::.contains "B"}}.assertTrue}
  .check{Infos.msg "B".validate{::.isMsg{::.contains "A"} | .isMsg{::.contains "B"}}.assertTrue}

  .check{Infos.msg "A".validate{::.isMsg{::.contains "A"} & .isMsg{::.contains "B"}}.assertFalse}
  .check{Infos.msg "B".validate{::.isMsg{::.contains "A"}& .isMsg{::.contains "B"}}.assertFalse}
  .check{Infos.msg "B".extract{:: > 0}.assertEmpty{::}}
  .checkEq(`"hi"`, {Infos.msg "hi" .prettyStr})
  .checkEq(`"a\"b"`, {Infos.msg `a"b` .prettyStr})
  .checkEq("null", {Infos.msg "" .prettyStr})
  .checkEq("{" | `  "a": [` | `    "x",` | `    "y"` | "  ]" | "}", {Infos.map("a", Infos.list("x", "y")).prettyStr})
  }

InfoValidatorTests: Test {::
  .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
  .checkTrue{info.validate{::}}
  .checkTrue{info.validate{:: > "friends" > 0 > "name" .isMsg{:: == "Bob"}}}
  .checkTrue{info.validate{::
    & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
    & > "friends" > 1 > "name" .isMsg{:: == "Alice"}
    }}
  .checkTrue{info.validate{:: > "friends" .isList{::.size == 2}}}
  .checkFalse{info.validate{::
    & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
    | > "friends" > 1 > "name" .isMsg{:: == "Alice"}
    & > "friends" > 2 > "name" .isMsg{:: == "David"}}}
  .checkFalse{info.validate{:: > "friends" .where{::
    & > 0 > "name" .isMsg{:: == "Bob"}
    | > 1 > "name" .isMsg{:: == "Alice"}
    & > 2 > "name" .isMsg{:: == "David"}}}}
  .checkTrue{info.validate{::
    & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
    | > "friends" .where{::
      & > 1 > "name" .isMsg{:: == "Alice"}
      & > 2 > "name" .isMsg{:: == "David"}}}}
  .checkTrue{info.validate{::
    & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
    & > "friends" > 1 > "name" .isMsg{:: == "David"} .not}}
  .checkFalse{info.validate{:: > "friends" > 1 > "name" .isMsg{:: == "Alice"} .not}}
  .checkTrue{info.extract{:: > "friends" .extractList .where{:: > 1 > "name" .isMsg{:: == "Alice"}}}.isSome}
  .checkTrue{info.extract{:: > "friends" .extractList .where{:: > 1 > "name" .isMsg{:: == "David"}}}.isEmpty}
  .checkTrue{info.extract{:: .extractMap .where{:: > "friends" .isList}}.isSome}
  .checkTrue{info.extract{:: .extractMap .where{:: > "enemies" .isList}}.isEmpty}
  .checkDetErr({::.isMsg{::.startsWith "Info.getList:"}}, {Infos.msg "hi" .getList})
  .check{Infos.msg "hi" .tryGetList .assertInfo{::.isMsg{::.startsWith "Info.getList:"}}}
  }

InfoExtractorTests: Test {::
  .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
  .checkEq(info, {info.extract{::}!})
  .checkEq("bob", {info.extract{:: > "friends" > 0 > "name" .extractMsg}.mapSome{::.lower}!})
  .checkEq("Bob, Alice", {info.extract{:: > "friends" .extractList .where{::
      & > 0 > "name" .isMsg{:: == "Bob"}
      & > 1 > "name" .isMsg{:: == "Alice"}
      }}
    .mapSome{::.flow.map{::.extract{:: > "name" .extractMsg}!}.join ", "}!})
  .checkTrue{info.extract{:: > "friends" .extractList .where{::
      & > 0 > "name" .isMsg{:: == "Bob"}
      & > 1 > "name" .isMsg{:: == "David"}
      }}.isEmpty}
  .checkTrue{info.extract{:: > "friends" > 2}.isEmpty}
  .checkTrue{info.extract{:: > "friends" > 0 > "name" .extractMsg{:: == "Alice"}}.isEmpty}
  .checkEq({::}, Opts# "Alice", {info.extract{:: .extractMap > "friends" .extractList > 1 > "name" .extractMsg}})
  .checkTrue{info.extract{:: > "friends" .extractMsg}.isEmpty}
  .checkTrue{Infos.msg "" .extract{::.extractEmpty}.isSome}
  .checkTrue{info.extract{::.extractEmpty}.isEmpty}
  .checkTrue{(InfoValidators#info > "enemies").extract{::}.isEmpty}
  .checkEq("Bob", {(InfoValidators#info > "friends").extract{:: > "friends" > 0 > "name" .extractMsg}!})
  }

