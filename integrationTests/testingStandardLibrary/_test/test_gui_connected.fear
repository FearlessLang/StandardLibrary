GuiConnectedTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .let[mut Slot[mut Pane]] p = {Slots#[mut Pane]}
    .let[mut Slot[mut Label]] l = {Slots#[mut Label]}
    .do{f.content.pane{:: .save p .label{:: .text "a" .save l}}}
    .do{Block#(p!.clear, Void)}
    .return{Block#(l!.text "b", Void)}
    }}).run{
      .ok _ -> Error.msg "Changing a removed widget always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This Label is not in the window any more: .clear, a replaced Border slot or a new .content removed it, so changing it would have no visible effect. Change a widget that is not in the window inside .changeDetached{...}"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .let[mut Slot[mut Pane]] p = {Slots#[mut Pane]}
    .let[mut Slot[mut Label]] l = {Slots#[mut Label]}
    .do{f.content.pane{:: .save p .label{:: .text "a" .save l}}}
    .do{Block#(p!.clear, Void)}
    .do{Block#(l!.changeDetached{:: .text "b"}, Void)}
    .return{Error.msg(l!.text)}
    }}).run{
      .ok _ -> Error.msg "The label text always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "b"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .let[mut Slot[mut Pane]] p = {Slots#[mut Pane]}
    .let[mut Slot[mut Label]] l = {Slots#[mut Label]}
    .do{f.content.pane{:: .save p .label{:: .text "a" .save l}}}
    .do{Block#(p!.clear, Void)}
    .do{Block#(l!.changeDetached{:: .text "b"}, Void)}
    .return{Block#(l!.text "c", Void)}
    }}).run{
      .ok _ -> Error.msg "Changing a removed widget after .changeDetached always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This Label is not in the window any more: .clear, a replaced Border slot or a new .content removed it, so changing it would have no visible effect. Change a widget that is not in the window inside .changeDetached{...}"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .let[mut Slot[mut Pane]] outer = {Slots#[mut Pane]}
    .let[mut Slot[mut Pane]] inner = {Slots#[mut Pane]}
    .let[mut Slot[mut Label]] l = {Slots#[mut Label]}
    .do{f.content.pane{:: .save outer .pane{:: .save inner .label{:: .text "a" .save l}}}}
    .do{Block#(outer!.clear, Void)}
    .do{Block#(inner!.changeDetached{q -> Block#(l!.text "d", q)}, Void)}
    .return{Error.msg(l!.text)}
    }}).run{
      .ok _ -> Error.msg "The label text always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "d"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .let[mut Slot[mut Label]] l = {Slots#[mut Label]}
    .do{f.content.pane{:: .label{:: .text "a" .save l}}}
    .do{f.content.pane{::}}
    .return{Block#(l!.text "b", Void)}
    }}).run{
      .ok _ -> Error.msg "Changing a widget of a replaced content always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This Label is not in the window any more: .clear, a replaced Border slot or a new .content removed it, so changing it would have no visible effect. Change a widget that is not in the window inside .changeDetached{...}"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .let[mut Slot[mut Mouse]] m = {Slots#[mut Mouse]}
    .do{f.content.pane{:: .mouse{:: .save m} .mouse{::}}}
    .return{Block#(m!.clicked{_, _, _, _, _ -> Void}, Void)}
    }}).run{
      .ok _ -> Error.msg "Changing a replaced Mouse always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This Mouse was replaced by a later .mouse, or its widget is not in the window any more, so a handler set now would never run"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> Block#
    .let[mut Slot[mut Keys]] k = {Slots#[mut Keys]}
    .do{Block#(f.onKey{:: .save k}.onKey{::}, Void)}
    .do{Block#(k!.pressed{:: .matchOnly(Key#"A")}, Void)}
    .return{f.content.pane{::}}
    }}).run{
      .ok _ -> Error.msg "Changing a replaced Keys always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This Keys was replaced by a later .onKey, so a key action added now would never run"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> ClosedLabel#(s.gui)}).run{
      .ok _ -> Error.msg "Changing a widget of a closed window always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This Label is in a closed window: the CapGui.run that showed the window has returned, so changing it would have no visible effect"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> ClosedMouse#(s.gui)}).run{
      .ok _ -> Error.msg "Changing a Mouse of a closed window always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This Mouse belongs to a closed window: the CapGui.run that showed the window has returned, so a handler set now would never run"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> ClosedKeys#(s.gui)}).run{
      .ok _ -> Error.msg "Changing a Keys of a closed window always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This Keys belongs to a closed window: the CapGui.run that showed the window has returned, so a key action added now would never run"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> ClosedModelFps#(s.gui)}).run{
      .ok _ -> Error.msg "Changing a ModelFps of a closed window always fails";
      .info i -> i.validate{:: > "info" .isMsg{:: == "This ModelFps belongs to a closed window: the CapGui.run that showed the window has returned, so an action set now would never run"}}.assertTrue{i};
      }}
  }
ClosedLabel: {#(gui: mut base.CapGui): Void -> Block#
  .let[mut Slot[mut Label]] l = {Slots#[mut Label]}
  .do{gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{f.close}}), Void)}
    .return{f.content.pane{:: .label{:: .text "a" .save l}}}
    }}
  .return{Block#(l!.text "b", Void)}
  }
ClosedMouse: {#(gui: mut base.CapGui): Void -> Block#
  .let[mut Slot[mut Mouse]] m = {Slots#[mut Mouse]}
  .do{gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{f.close}}), Void)}
    .return{f.content.pane{:: .mouse{:: .save m}}}
    }}
  .return{Block#(m!.clicked{_, _, _, _, _ -> Void}, Void)}
  }
ClosedKeys: {#(gui: mut base.CapGui): Void -> Block#
  .let[mut Slot[mut Keys]] k = {Slots#[mut Keys]}
  .do{gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .action{f.close}}).onKey{:: .save k}, Void)}
    .return{f.content.pane{::}}
    }}
  .return{Block#(k!.pressed{:: .matchOnly(Key#"A")}, Void)}
  }
ClosedModelFps: {#(gui: mut base.CapGui): Void -> Block#
  .let[mut Slot[mut ModelFps]] old = {Slots#[mut ModelFps]}
  .do{gui.run{f -> Block#
    .do{Block#(f.modelFps(100, {:: .save old .action{f.close}}), Void)}
    .return{f.content.pane{::}}
    }}
  .return{Block#(old!.action{Void}, Void)}
  }
