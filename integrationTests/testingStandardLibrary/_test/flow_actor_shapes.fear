/// The shapes the actor family of flow stages is meant to be written in.
/// Nothing here runs: ``Flow.actor`` and ``Flow.actorMut`` have no body yet, so
/// this file is a compile time check that the declared signatures can express
/// the operations they are supposed to express.

ScanViaActor: {
  #[E:*,S:imm](es: mut Flow[E], acc: S, f: read F[S,E,S]): mut Flow[S] ->
    es.actor[mut base.Var[S], S](Vars#[S](acc), {down, s, e -> Block#(
      s.set(f#(s.get, e)),
      down.push#(down, s.get),
      Continue#)});
  }

/// The sink of `ActorImpl` is ``mut``, so it also takes the direct push.
ScanViaActorDirectPush: {
  #[E:*,S:imm](es: mut Flow[E], acc: S, f: read F[S,E,S]): mut Flow[S] ->
    es.actor[mut base.Var[S], S](Vars#[S](acc), {down, s, e -> Block#(
      s.set(f#(s.get, e)),
      down#(s.get),
      Continue#)});
  }

LimitViaActorMut: {
  #[E:*](es: mut Flow[E], n: Nat): mut Flow[E] -> n == 0 ? {
    .then -> Error.msg`.limit 0 asks a whole chain of stages for no elements`;
    .else -> es.actorMut[mut base.Count[Nat], E](base.Count.nat n, {down, s, e -> Block#(
      down.push#(down, e),
      s--,
      s.get == 0 ? { .then -> Break#; .else -> Continue# })});
    };
  }

/// The sink and the state of `ActorImpl` are ordinary ``mut`` values, so the
/// lambdas of ``Block#`` may capture them.
Trim: { #(w: List[Nat], width: Nat): List[Nat] -> w.size > width ? { .then -> w.subList(1); .else -> w } }
WindowsViaActor: {
  #(es: mut Flow[Nat], width: Nat): mut Flow[List[Nat]] ->
    es.actor[mut base.Var[List[Nat]], List[Nat]](Vars#[List[Nat]]({}), {down, s, e -> Block#
      .do{s.set(Trim#(s.get +> e, width))}
      .do{s.get.size == width ? { .then -> down.push#(down, s.get); .else -> Void }}
      .return{Continue#}
      });
  }

Treasure: { read .value: Nat }
Hero: {
  mut .take(t: iso Treasure): Void;
  read .purse: Nat;
  }
/// A room hands out an ``iso`` treasure rather than being handed the hero:
/// the room is the ``mutH`` actor state, and a ``mut`` method of a ``mutH``
/// receiver accepts only ``iso`` arguments, so ``s.visit(h)`` is not a shape
/// that exists. The hero and the room meet in the lambda instead.
Room: {
  mut .takeTreasure: iso Treasure;
  read .killsHeroesPoorerThan: Nat;
  }
/// The branch that decides whether the hero goes on can not push, since it is a
/// lambda and the sink is hygienic. It answers an `Opt` instead, and ``.pushOpt``
/// commits it where the sink is in scope.
Survivor: { #(dies: Bool, h: mut Hero): mut Opt[mut Hero] ->
  dies.if[mut Opt[mut Hero]]{ .then -> {}; .else -> Opts#h } }
DungeonRoomViaActorMut: {
  #(heroes: mut Flow[mut Hero], room: iso Room): mut Flow[mut Hero] ->
    heroes.actorMut[Room, mut Hero](room, {down, s, h -> Block#(
      h.take(s.takeTreasure),
      down.pushOpt#(down, Survivor#(s.killsHeroesPoorerThan > (h.purse), h)),
      Continue#)});
  }

/// Draining an inner flow one element at a time is ``inner.forEach{x -> ..}``,
/// a lambda capturing the sink, so it is a shape for `ActorImpl` only.
FlatMapViaActor: {
  #[E:*,R](es: mut Flow[E], f: read F[E, mut Flow[R]]): mut Flow[R] ->
    es.actor[mut base.Var[Nat], R](Vars#[Nat](0), {down, s, e -> Block#(
      f#e .forEach{x -> down#x},
      Continue#)});
  }

/// What `ActorImplMut` can do instead: materialise the inner flow and walk it with
/// the loop that hands the sink to every iteration. The cost is in the
/// materialisation, which fences the inner flow.
/// ``Block#.var`` is not available here: its continuation is a lambda and it would
/// capture the sink, so the loop counter arrives as a parameter instead. A method
/// call is what binds a name next to a hygienic one.
Drain: { #[E:*](down: mutH base.ActorSink[E], xs: mut List[E]): Void ->
  DrainFrom#[E](down, xs, Vars#[Nat](0)) }
DrainFrom: { #[E:*](down: mutH base.ActorSink[E], xs: mut List[E], i: mut base.Var[Nat]): Void ->
  Block#[Void].loop(down, {d -> Block#(
    d.pushOpt#(d, xs.opt(i.get)),
    i.set(i.get + 1),
    i.get >= (xs.size) ? { .then -> Break#; .else -> Continue# })})
    .done }

FlatMapViaActorMut: {
  #[E:*,R:*](es: mut Flow[E], f: read F[E, mut Flow[R]]): mut Flow[R] ->
    es.actorMut[mut base.Var[Nat], R](Vars#[Nat](0), {down, s, e -> Block#(
      Drain#[R](down, f#e .list),
      Continue#)});
  }

MapWithContextViaActorMut: {
  #[C,E:*,R:*](es: mut Flow[E], ctx: iso base.ToIso[C], g: read F[iso C,E,R]): mut Flow[R] ->
    es.actorMut[base.ToIso[C], R](ctx, {down, s, e -> Block#(
      down.push#(down, g#(s.iso.close, e)),
      Continue#)});
  }

/// The state holds two lists of the same size. For every incoming string, the
/// actor walks the indexes and emits that string joined with the two items at the
/// index, wherever those two items have the same size.
/// Everything the loop needs from the hygienic state is read at the call site, where
/// the state is in scope, and arrives as an ordinary parameter, so the loop body
/// captures only ordinary values and receives the sink as its argument.
Pairs: { read .a: List[Str]; read .b: List[Str]; }
SameSize: { #(pre: Str, x: Str, y: Str): mut Opt[Str] ->
  x.size == (y.size) ?[mut Opt[Str]]{ .then -> Opts#(pre + x + y); .else -> {} } }
JoinAt: { #(pre: Str, a: List[Str], b: List[Str], i: Nat): mut Opt[Str] ->
  i >= (a.size) ?[mut Opt[Str]]{ .then -> {}; .else -> SameSize#(pre, a.get i, b.get i) } }
JoinFrom: { #(down: mutH base.ActorSink[Str], pre: Str, a: List[Str], b: List[Str], i: mut base.Var[Nat]): Void ->
  Block#[Void].loop(down, {d -> Block#(
    d.pushOpt#(d, JoinAt#(pre, a, b, i.get)),
    i.set(i.get + 1),
    i.get >= (a.size) ? { .then -> Break#; .else -> Continue# })})
    .done }
JoinEqualSizesViaActorMut: {
  #(es: mut Flow[Str], lists: iso Pairs): mut Flow[Str] ->
    es.actorMut[Pairs, Str](lists, {down, s, e -> Block#(
      JoinFrom#(down, e, s.a, s.b, Vars#[Nat](0)),
      Continue#)});
  }
