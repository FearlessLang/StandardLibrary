FontRooms:{ #(t: base.UStr): base.Image -> base.Images#(Width#1, Height#1, Color.ghostWhite).paint{g -> Error.msg(FontRoom#(g.textHeight 1, t) + " " + (FontRoom#(g.textHeight 7, t)) + " " + (FontRoom#(g.textHeight 12, t)) + " " + (FontRoom#(g.textHeight 31, t)) + " " + (FontRoom#(g.textHeight 500, t)))} }
FontRoom:{ #(g: mut base.Graphics, t: base.UStr): Str -> FontRoomStr#(g.uTextRoom t) }
FontRoomStr:{ #(r: base.TextRoom): Str -> r.width.get.str + "x" + (r.height.get.str) + "^" + (r.baseline.get.str) }
FontInk:{ #(t: base.UStr): Str -> FontSum#(base.Images#(Width#400, Height#100, Color.ghostWhite).paint{g -> g.textHeight 9 .uText(t, Width#400, Height#30) .position(X#(+0), Y#(+30)) .textHeight 24 .uText(t, Width#400, Height#70)}) }
FontSum:{ #(i: base.Image): Str -> (+0 =~~ +400).flow.map{x -> (+0 =~~ +100).flow.map{y -> FontPx#(i.color(X#x, Y#y))}.sum(0)}.sum(0).str }
FontPx:{ #(c: Color): Nat -> c.red.get.nat + (c.green.get.nat * 256) + (c.blue.get.nat * 65536) }
FontPattern:{ #: base.Image -> base.Images#(Width#3, Height#3, Color.sleepyBlue).paint{g -> g.color(Color.rubberDuck).position(X#(+1), Y#(+0)).rect(Width#1, Height#3).color(Color.goblinGreen).position(X#(+0), Y#(+1)).rect(Width#3, Height#1)} }
