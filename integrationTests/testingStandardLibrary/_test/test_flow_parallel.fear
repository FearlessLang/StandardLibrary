Nats: { #: mut List[Nat] -> (0 =~~= 199).flow.list }

FlowParallelOrderTests: Test {::
  .check{Nats#.flow.list .assertEq({::}, Nats#)}
  .check{Nats#.flow.eList.list .assertEq({::}, Nats#)}
  .check{Nats#.flow.map{e -> e + 1}.list .assertEq({::}, (1 =~~= 200).flow.list)}
  .check{Nats#.flow.filter{e -> e > 99}.list .assertEq({::}, (100 =~~= 199).flow.list)}
  .check{Nats#.flow.flatMap{e -> Flows#(e, e)}.list .assertEq({::}, Nats#.seqFlow.flatMap{e -> Flows#(e, e)}.list)}
  .check{(Nats#.flow ++ (Nats#.flow)).list .assertEq({::}, Nats# ++ (Nats#))}
  .check{Nats#.flow.limit 10 .list .assertEq({::}, (0 =~~= 9).flow.list)}
  .check{Nats#.flow.size .assertEq 200}
  .check{Nats#.flow.isEmpty .assertFalse}
  .check{Flows#[Nat].isEmpty .assertTrue}
  .check{Nats#.flow.first! .assertEq 0}
  .check{Nats#.flow.last! .assertEq 199}
  .check{Nats#.flow.filter{e -> e == 100}.get .assertEq 100}
  .check{Nats#.flow.filter{e -> e == 100}.getOpt! .assertEq 100}
  .check{Nats#.flow.min{::}.get .assertEq 0}
  .check{Nats#.flow.max{::}.get .assertEq 199}
  .check{Nats#.flow.any{e -> e == 100} .assertTrue}
  .check{Nats#.flow.all{e -> e < 200} .assertTrue}
  .check{Nats#.flow.none{e -> e > 199} .assertTrue}
  .check{Nats#.flow.fold({0}, {acc, e -> acc.hashWith e}) .assertEq(Nats#.seqFlow.fold({0}, {acc, e -> acc.hashWith e}))}
  .check{Nats#.flow.scan(0, {acc, e -> acc.hashWith e}).list .assertEq({::}, Nats#.seqFlow.scan(0, {acc, e -> acc.hashWith e}).list)}
  .check{Nats#.flow.map{e -> e.str}.join `,` .assertEq(Nats#.seqFlow.map{e -> e.str}.join `,`)}
  .check{Nats#.reverse.flow.sort{::}.list .assertEq({::}, Nats#)}
  .check{Nats#.flow.mapping({::}, {.key k -> k; .elem k -> k}).flow.map{::.key}.list .assertEq({::}, Nats#)}
  .check{Nats#.flow.findMap{e -> Block#[mut Opt[Str]].if{e == 100}.return{Opts#(e.str)}.return{{}}}! .assertEq `100`}
  .check{Nats#.flow.findFirst{e -> e > 150}! .assertEq 151}
  .check{Nats#.flow.findFirst{e -> e > 1500}.isEmpty .assertTrue}
  .check{Block#
    .let acc= {ELists#[Nat]}
    .do{Nats#.flow.forEach{e -> acc.add e}}
    .return{acc.list .assertEq({::}, Nats#)}
    }
  .check{Block#
    .let acc= {ELists#[Nat]}
    .let es= {Nats#.flow.eSet({e -> Block#(acc.add e, e)}, {::})}
    .do{acc.list .assertEq({::}, Nats#)}
    .return{es.seqFlow.list .assertEq({::}, Nats#)}
    }
  .check{Block#
    .let acc= {ELists#[Nat]}
    .let s= {Nats#.flow.set({e -> Block#(acc.add e, e)}, {::})}
    .do{acc.list .assertEq({::}, Nats#)}
    .return{s.list .assertEq({::}, Nats#)}
    }
  }

ErrIf: { #(b: Bool, msg: Str, e: Nat): Nat -> Block#[Nat].if{b}.error{msg}.return{e} }
LoopIf: { #(b: Bool, e: Nat): Nat -> Block#[Nat].if{b}.return{Block#[Nat].loop{Block#(Yield#, Continue#)}.return{e}}.return{e} }

FlowParallelErrorTests: Test {::
  .checkDetErr({::.isMsg{::.contains `boom100`}}, {Nats#.flow.map{e -> ErrIf#(e == 100, `boom100`, ErrIf#(e == 150, `boom150`, e))}.list})
  .checkDetErr({::.isMsg{::.contains `boom100`}}, {Nats#.flow.map{e -> ErrIf#(e == 100, `boom100`, ErrIf#(e == 150, `boom150`, e))}.fold({0}, {acc, e -> acc + e})})
  .checkDetErr({::.isMsg{::.contains `boom100`}}, {Nats#.flow.filter{e -> ErrIf#(e == 100, `boom100`, e) > 150}.size})
  .checkDetErr({::.isMsg{::.contains `boom100`}}, {Nats#.flow.map{e -> ErrIf#(e == 100, `boom100`, e)}.size})
  .checkDetErr({::.isMsg{::.contains `boom100`}}, {Nats#.seqFlow.map{e -> ErrIf#(e == 100, `boom100`, e)}.size})
  .checkDetErr({::.isMsg{::.contains `boom100`}}, {Nats#.flow.flatMap{e -> Flows#(ErrIf#(e == 100, `boom100`, e))}.list})
  .check{Nats#.flow.map{e -> ErrIf#(e > 100, `late`, e)}.any{e -> e == 100} .assertTrue}
  .check{Nats#.flow.map{e -> ErrIf#(e > 100, `late`, e)}.all{e -> e < 100} .assertFalse}
  .check{Nats#.flow.map{e -> ErrIf#(e > 100, `late`, e)}.first! .assertEq 0}
  .check{Nats#.flow.map{e -> ErrIf#(e > 0, `late`, e)}.isEmpty .assertFalse}
  .check{Nats#.seqFlow.map{e -> ErrIf#(e > 0, `late`, e)}.isEmpty .assertFalse}
  .check{Nats#.flow.map{e -> ErrIf#(e > 100, `late`, e)}.limit 50 .list .assertEq({::}, (0 =~~= 49).flow.list)}
  .check{Nats#.flow.map{e -> ErrIf#(e > 100, `late`, e)}.scan(0, {acc, e -> acc + e}).limit 3 .list .assertEq({::}, Lists#(0, 1, 3))}
  .check{Nats#.flow.map{e -> ErrIf#(e > 100, `late`, e)}.findFirst{e -> e == 7}! .assertEq 7}
  .check{Nats#.flow.map{e -> LoopIf#(e > 0, e)}.first! .assertEq 0}
  .check{Nats#.flow.map{e -> LoopIf#(e > 0, e)}.any{e -> e == 0} .assertTrue}
  .checkDetErr({::.isMsg{::.contains `boom5`}}, {Nats#.flow.map{e -> ErrIf#(e == 5, `boom5`, LoopIf#(e > 5, e))}.list})
  .check{(0 =~~= 1999).flow.list.flow.map{e -> LoopIf#(e == 6, e)}.filter{e -> e == 5}.first! .assertEq 5}
  }

Add: { #(state: mut Var[Nat], n: Nat): Nat -> Block#(state.set(state.get + n), state.get) }
SendUnless: { #(downstream: mut ActorSink[Nat], n: Nat, skip: Bool): Void -> skip.if {.then -> Void; .else -> downstream#n} }
Choose: { #(stop: Bool, m: mut ActorMatch[Nat]): Nat -> stop.if {.then -> m.stop; .else -> m.continue} }
Ctxs: F[Nat, mut Ctx]{ n -> mut Ctx: ToIso[Ctx]{'ctx
  .iso -> Ctxs#(n + 1);
  .close -> ctx;
  read .n: Nat -> n;
  }}
FlowStatefulTests: Test {::
  .check{Flows#(+5, +10, +15)
    .actor[mut Var[Int], Int](Vars#[Int]+1, {downstream, state, n, m -> Block#
      .do {state.set(state.get + n)}
      .if {state.get > +16} .return{Block#(downstream#(+500), m.stop)}
      .do {downstream#(+42)}
      .do {downstream#n}
      .return {m.continue}})
    .map{n -> n.str}.join ` ` .assertEq `+42 +5 +42 +10 +500`}
  .check{Flows#(5, 10, 15)
    .actor[mut Var[Nat], Nat](Vars#[Nat]1, {downstream, state, n, m -> Block#
      .do {state.set(state.get + n)}
      .if {state.get > 16} .return{Block#(downstream#500, m.stop)}
      .do {downstream#42}
      .do {downstream#n}
      .return {m.continue}})
    .limit 2 .map{n -> n.str}.join ` ` .assertEq `42 5`}
  .check{Flows#(+5, +10, +15).limit 2
    .actor[mut Var[Int], Int](Vars#[Int]+1, {downstream, state, n, m -> Block#
      .do {state.set(state.get + n)}
      .if {state.get > +16} .return{Block#(downstream#(+500), m.stop)}
      .do {downstream#(+42)}
      .do {downstream#n}
      .return {m.continue}})
    .map{n -> n.str}.join ` ` .assertEq `+42 +5 +42 +10`}
  .check{Nats#.flow
    .actor[mut Var[Nat], Nat](Vars#[Nat]0, {downstream, state, n, m -> Block#
      .do {state.set(state.get + n)}
      .do {downstream#(state.get)}
      .return {m.continue}})
    .list .assertEq({::}, Nats#.seqFlow.scan(0, {acc, e -> acc + e}).list)}
  .check{Nats#.flow
    .actorMut[mut Var[Nat], Nat](Vars#[Nat]0, {downstream, state, n, m -> Block#(
      SendUnless#(downstream, n, Add#(state, n) > 100),
      Choose#(state.get > 100, m)
      )})
    .list .assertEq({::}, (0 =~~= 13).flow.list)}
  .check{Flows#(5, 10, 15).scan(`!`, {acc, n -> acc + (n.str)}).join ` ` .assertEq `!5 !510 !51015`}
  .check{Flows#(+5, +10, +15).scan(+0, {acc, n -> acc + n}).scan(+0, {acc, n -> acc + n}).map{::.str}.join ` ` .assertEq `+5 +20 +50`}
  .check{Flows#(1, 2, 3, 4).map[Ctx, Str](Ctxs#0, {ctx, x -> ctx.n.str + (x.str)}).join ` ` .assertEq `11 12 13 14`}
  .check{Nats#.flow.map[Ctx, Str](Ctxs#0, {ctx, x -> ctx.n.str + (x.str)}).limit 4 .join ` ` .assertEq `10 11 12 13`}
  .check{Flows#(+5, +10, +15)
    .let[Int, Void] total = {f -> f#.sum +0}
    .map{n -> n + total}.map{n -> n.str}.join ` ` .assertEq `+35 +40 +45`}
  .check{Flows#(+5, +10, +15)
    .let[Int, Void] total = {f -> (f#.sum +0) + (f#.sum +0)}
    .map{n -> n + total}.map{n -> n.str}.join ` ` .assertEq `+65 +70 +75`}
  .check{Flows#(+5, +10, +15)
    .let[Int, Void] hundred = {_ -> +100}
    .map{n -> n + hundred}.map{n -> n.str}.join ` ` .assertEq `+105 +110 +115`}
  .check{Nats#.flow
    .let[Nat, Void] total = {f -> f#.sum 0}
    .map{n -> n + total}.first! .assertEq 19900}
  .checkDetErr({::.isMsg{::.contains `Flow consumed`}}, {Block#
    .let f= {Nats#.flow.map{e -> e + 1}}
    .do {f.size .assertEq 200}
    .return {f.size}
    })
  }

Spin: { #(n: Nat): Void -> Block#[Void]
  .var[Nat] i = {0}
  .loop {Block#
    .if {i.get == n} .return {Break#}
    .do {Yield#}
    .do {i.set(i.get + 1)}
    .return {Continue#}
    }
  .return {Void}
  }
EvenReprs: { #(n: Nat): mut List[mut Repr[Count[Nat]]] -> (1 =~~= n).flow.map{_ -> Reprs#(Count.nat 0, {c -> c.get.aluRem 2 == 0})}.list }
/// A cancelled chunk stops at its next Yield#, which must never leave a mutation half done.
FlowCancellationTests: Test {::
  .check{Block#
    .let rs= {EvenReprs#2000}
    .do{Block#(rs.flow(ParRepr[Count[Nat]]).map{r -> Block#(r.mutate{c -> Block#(c++, Spin#20000, c++, Void)}, 1)}.first, Void)}
    .return{rs.seqFlow.all{r -> r.look{c -> c.get.aluRem 2 == 0}} .assertTrue}
    }
  }

TestFlowParallel: Test {::
  .test FlowParallelOrderTests
  .test FlowParallelErrorTests
  .test FlowStatefulTests
  .test FlowCancellationTests
  }
