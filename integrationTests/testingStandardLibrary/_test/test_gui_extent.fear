GuiExtentTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .paint{g -> Error.msg(g
      .color(Color.goblinGreen)
      .position(X#(-32768), Y#(-32768))
      .rect(Width#32767, Height#32767)
      .oval(Width#32767, Height#32767)
      .line(X#(+32767), Y#(+32767))
      .position(X#(+32767), Y#(+32767))
      .rect(Width#10, Height#10)
      .panelWidth.str)}
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[300]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .pane{::
      .width 32767
      .height 32767
      .topInset 32767
      .bottomInset 32767
      .leftInset 32767
      .rightInset 32767
      .widthGap 32767
      .heightGap 32767
      .radius 32767
      .background(Color.goblinGreen)
      .label{:: .text "big" .textHeight 32767 .radius 32767 .background(Color.rubberDuck) }
      .button{:: .text "big" .textHeight 32767 .radius 32767 }
      }
    .pane{:: .width 1 .height 1 .paint{g -> Error.msg "painted after the big widgets"} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "painted after the big widgets"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .pane{:: .width 32768 }}}}).run{
      .ok _ -> Error.msg "A widget width over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "widget width 32768 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .pane{:: .radius 18446744073709551615 } .paint{g -> Error.msg "A radius over the limit was accepted"} }}}).run{
      .ok _ -> Error.msg "A radius over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "radius 18446744073709551615 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .label{:: .textHeight 32768 } .paint{g -> Error.msg "A text height over the limit was accepted"} }}}).run{
      .ok _ -> Error.msg "A text height over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "text height 32768 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .minPerLine 0 .paint{g -> Error.msg "A minPerLine of 0 was accepted"} }}}).run{
      .ok _ -> Error.msg "A minPerLine of 0 always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "minPerLine 0 is too small; it must be >= 1: every line holds at least one child"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .maxPerLine 0 .paint{g -> Error.msg "A maxPerLine of 0 was accepted"} }}}).run{
      .ok _ -> Error.msg "A maxPerLine of 0 always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "maxPerLine 0 is too small; it must be >= 1: every line holds at least one child"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .maxPerLine 2 .minPerLine 3 .paint{g -> Error.msg "A minPerLine more than the maxPerLine was accepted"} }}}).run{
      .ok _ -> Error.msg "A minPerLine more than the maxPerLine always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "minPerLine 3 is more than maxPerLine 2 of this Pane: no line can hold at least 3 children and at most 2"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{:: .minPerLine 3 .maxPerLine 2 .paint{g -> Error.msg "A maxPerLine less than the minPerLine was accepted"} }}}).run{
      .ok _ -> Error.msg "A maxPerLine less than the minPerLine always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "maxPerLine 2 is less than minPerLine 3 of this Pane: no line can hold at least 3 children and at most 2"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .paint{g -> g.rect(Width#3000000000, Height#1)}
    }}}).run{
      .ok _ -> Error.msg "A rect width over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "rect width 3000000000 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .paint{g -> Error.msg(g.oval(Width#10, Height#32768).panelWidth.str + " An oval height over the limit was accepted")}
    }}}).run{
      .ok _ -> Error.msg "An oval height over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "oval height 32768 is too large; it must be <= 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .paint{g -> Error.msg(g.position(X#(+32768), Y#(+0)).panelWidth.str + " A position over the limit was accepted")}
    }}}).run{
      .ok _ -> Error.msg "A position over the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "position x 32768 is out of range; it must be between -32768 and 32767"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .paint{g -> Error.msg(g.line(X#(+0), Y#(-32769)).panelWidth.str + " A line end under the limit was accepted")}
    }}}).run{
      .ok _ -> Error.msg "A line end under the limit always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "line y -32769 is out of range; it must be between -32768 and 32767"}}.assertTrue{i};
      }}
  }
