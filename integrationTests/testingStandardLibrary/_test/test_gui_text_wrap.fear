GuiTextWrapTests: Test {::
  .checkDetErr({::.isMsg{:: == "[0061 0061 0061 0061][0062 0062 0062 0062]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.uTextLines("aaaa".u "3000 0062 0062 0062 0062", Width#30).flow.map{l -> "["+(l.scalarHex)+"]"}.join "")}})
  .checkDetErr({::.isMsg{:: == "[0061 0061 0061 0061][0062 0062 0062 0062]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.uTextLines("aaaa".u "2002 0062 0062 0062 0062", Width#60).flow.map{l -> "["+(l.scalarHex)+"]"}.join "")}})
  .checkDetErr({::.isMsg{:: == "[a][b]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.textLines("a b", Width#1).flow.map{l -> "["+l+"]"}.join "")}})
  .checkDetErr({::.isMsg{:: == "[0061 2028 0062]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.uTextLines("a".u "2028 0062", Width#1000).flow.map{l -> "["+(l.scalarHex)+"]"}.join "")}})
  .checkDetErr({::.isMsg{:: == "[0061 000D][0062 2028]"}}, {base.Images#(Width#30, Height#20, Color.ghostWhite).paint{g -> Error.msg(g.uTextLines("a".u "000D 000A 0062 2028", Width#1000).flow.map{l -> "["+(l.scalarHex)+"]"}.join "")}})
  .checkDetErr({::.isMsg{:: == "[0061 0020 05D0 05D1 05D2][05D3 05D4 05D5][05D6 05D7 05D8]"}}, {base.Images#(Width#1, Height#1, Color.ghostWhite).paint{g -> Error.msg(g.uTextLines("a ".u "05D0 05D1 05D2 0020 05D3 05D4 05D5 0020 05D6 05D7 05D8", g.uTextRoom("a ".u "05D0 05D1 05D2").width).flow.map{l -> "["+(l.scalarHex)+"]"}.join "")}})
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .uTextArea{a -> Error.msg(a.uText("a".u "2028 0062").pack.height.str + " " + (a.uText(("a" | "b").u).pack.height.str))}}}}).run{
      .ok _ -> Error.msg "The scope always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Height[48] Height[48]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .uTextArea{a -> Error.msg(a.uText("a".u "000D 000A 0062").pack.width.str + " " + (a.uText(("a" | "b").u).pack.width.str))}}}}).run{
      .ok _ -> Error.msg "The scope always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "Width[27] Width[27]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content.pane{:: .uTextArea{a -> Error.msg((a.cleaner(base.UStrCleaners.utf8).uText("a".u "2028 000D 0062").pack.height.str == (a.uText("ab".u).pack.height.str)).str)}}}}).run{
      .ok _ -> Error.msg "The scope always stops the Gui";
      .info i -> i.validate{:: > "info" .isMsg{:: == "True"}}.assertTrue{i};
      }}
  }
