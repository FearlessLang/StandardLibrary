GuiPaintTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.undecorated(Alpha.opaque).fixedSize(300, 80).content{::
    .foreground(Color.dangerTomato)
    .paint{g -> Error.msg(g.position(+10, +10).rect(40, 40).pixel(+30, +30).str)}
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == (Color.dangerTomato.str)}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.undecorated(Alpha.opaque).fixedSize(300, 80).contentB{::
    .foreground(Color.goblinGreen)
    .paint{g -> Error.msg(g.position(+10, +10).rect(40, 40).pixel(+30, +30).str)}
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == (Color.goblinGreen.str)}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.undecorated(Alpha.opaque).fixedSize(300, 80).content{::
    .paint{g -> Error.msg(g.position(+10, +10).rect(40, 40).pixel(+30, +30).str)}
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == (Color.voidBlack.str)}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.undecorated(Alpha.opaque).fixedSize(300, 80).content{::
    .paint{g -> Error.msg(g.pixel(+300, +5).str)}
    }}}).run{
      .ok _ -> Error.msg "A pixel outside the panel always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Pixel position puts pixel outside the visible panel: position=300,5, panel=300x80"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.undecorated(Alpha.opaque).fixedSize(300, 80).content{::
    .pane{:: .width 400 .height 20 .paint{g -> Error.msg(g.pixel(+350, +5).str)} }
    }}}).run{
      .ok _ -> Error.msg "A pixel outside the window always stops the Gui";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Pixel position puts pixel outside the visible panel: position=350,5, panel=400x20"}}.assertTrue{i};
      }}
  }
