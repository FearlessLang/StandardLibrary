Directions: Enums[Direction]{
  .list -> Lists#(North,East,South,West).as{::};
  }

DirectionMatch[R:**]: { mut .north: R; mut .east: R; mut .south: R; mut .west: R; }

Direction: Enum[Direction]{
  .enums->Directions;
  read .match[R:**](m: mut DirectionMatch[R]): R;
  read .close->this; .close->::;
  }

North: Direction{::.north}
East:  Direction{::.east}
South: Direction{::.south}
West:  Direction{::.west}

EnumTests: Test {::
  .check{Directions.list.size.assertEq 4}
  .check{Directions.list.get(0).assertEq North}
  .check{Directions.list.get(3).assertEq West}

  .check{North.str.assertEq "North"}
  .check{West.str.assertEq "West"}

  .check{North.index.assertEq 0}
  .check{East.index.assertEq 1}
  .check{South.index.assertEq 2}
  .check{West.index.assertEq 3}

  .check{Directions.map.get("North").assertEq North}
  .check{Directions.map.get("West").assertEq West}
  .check{Directions.map.size.assertEq 4}

  .check{Directions.fromInfo(Infos.msg "East").assertEq East}
  .check{Directions.fromInfo(North.info).assertEq North}

  .check{North == North .assertTrue}
  .check{North == East .assertFalse}
  .check{North < East .assertTrue}
  .check{West > South .assertTrue}
  .check{North.hash.assertNotEq(East.hash)}
  .check{North.hash.assertEq 0}

  .check{North.match(DirectionMatch[Str]{ .north->"n"; .east->"e"; .south->"s"; .west->"w"; }).assertEq "n"}
  .check{West.match(DirectionMatch[Str]{ .north->"n"; .east->"e"; .south->"s"; .west->"w"; }).assertEq "w"}

  .check{North.info.assertEq(Infos.msg "North")}
  .check{North.imm.assertEq North}
  }

TestEnum: Test {::
  .test EnumTests
  }
