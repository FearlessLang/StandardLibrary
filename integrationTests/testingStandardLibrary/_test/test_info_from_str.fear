InfoFromStrFormatTests: Test {::
  .check{Info.str .assertEq "null"}
  .check{Infos.msg("hello").str .assertEq `"hello"`}
  .check{Infos.list(Infos.msg "a", Infos.msg "b").str .assertEq `["a","b"]`}
  .check{Infos.map("k1", Infos.msg "v1", "k2", Infos.msg "v2").str .assertEq `{"k1":"v1","k2":"v2"}`}
  .check{Infos.fromStr("null") .assertEq Info}
  .check{Infos.fromStr(`"hello"`) .assertEq(Infos.msg "hello")}
  .check{Infos.fromStr(`["a","b"]`) .assertEq(Infos.list(Infos.msg "a", Infos.msg "b"))}
  .check{Infos.fromStr(`{"k1":"v1","k2":"v2"}`) .assertEq(Infos.map("k1", Infos.msg "v1", "k2", Infos.msg "v2"))}
  .check{Infos.map("b", Infos.msg "1", "a", Infos.msg "2").str .assertEq `{"a":"2","b":"1"}`}
  .check{Infos.fromStr(`{"b":"1","a":"2"}`).str .assertEq `{"a":"2","b":"1"}`}
  .check{(Infos.msg "a" + (Infos.list(Infos.msg "x"))).str .assertEq `{"list":["x"],"msg":"a"}`}
  .check{(Infos.list(Infos.msg "x") + (Infos.msg "a")).str .assertEq `{"list":["x"],"msg":"a"}`}
  .check{(Infos.map("k", "v") + (Infos.map("k", "w", "j", "z"))).str .assertEq `{"j":"z","k":"v\nw"}`}
  .check{Infos.fromStr("[]") .assertEq Info}
  .check{Infos.fromStr("{}") .assertEq Info}
  }

InfoFromStrRoundTripTests: Test {::
  .check{Infos.fromStr(Info.str) .assertEq Info}
  .check{Infos.fromStr(Infos.msg("").str) .assertEq(Infos.msg "")}
  .check{Infos.fromStr(Infos.msg("hello").str) .assertEq(Infos.msg "hello")}
  .check{Infos.fromStr(Infos.msg(`with "quotes" and \ backslash`).str) .assertEq(Infos.msg(`with "quotes" and \ backslash`))}
  .check{Infos.fromStr(Infos.msg("line1" | "line2").str) .assertEq(Infos.msg("line1" | "line2"))}
  .check{Infos.fromStr(Infos.msg("null").str) .assertEq(Infos.msg "null")}
  .check{Infos.fromStr(Infos.list(Infos.msg "a", Infos.msg "b").str) .assertEq(Infos.list(Infos.msg "a", Infos.msg "b"))}
  .check{Infos.fromStr(Infos.map("k1", Infos.msg "v1", "k2", Infos.msg "v2").str) .assertEq(Infos.map("k1", Infos.msg "v1", "k2", Infos.msg "v2"))}
  .check{Infos.fromStr(Infos.list(Infos.map("a", 1), Infos.list(2, 3)).str) .assertEq(Infos.list(Infos.map("a", 1), Infos.list(2, 3)))}
  .check{Infos.fromStr(Infos.list(Info, Infos.msg "x").str) .assertEq(Infos.list(Info, Infos.msg "x"))}
  .check{Infos.fromStr(Infos.map("empty", Info, "full", Infos.msg "x").str) .assertEq(Infos.map("empty", Info, "full", Infos.msg "x"))}
  .check{Infos.fromStr(_Infos.largeNested.str) .assertEq(_Infos.largeNested)}
  .check{Infos.fromStr(_Infos.wideFlat.str) .assertEq(_Infos.wideFlat)}
  .check{Infos.fromStr(Infos.map("", Infos.msg "x").str) .assertEq(Infos.map("", Infos.msg "x"))}
  .check{Infos.fromStr(_Infos.largeNested.prettyStr) .assertEq(_Infos.largeNested)}
  .check{Infos.fromStr(` { "k" : [ "a" , null ] } `) .assertEq(Infos.map("k", Infos.list(Infos.msg "a", Info)))}
  .check{Infos.fromStr("[" | `"a",` | `"b"` | "]") .assertEq(Infos.list(Infos.msg "a", Infos.msg "b"))}
  .check{Infos.fromStr(`" a "`) .assertEq(Infos.msg " a ")}
  }

InfoFromStrErrorTests: Test {::
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr ""})
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr "nonsense"})
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr `"unterminated`})
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr `["a"`})
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr `{"a":"1"`})
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr `{"a":1}`})
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr `"hi"trailing`})
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr `{"a""b"}`})
  .checkDetErr({::.isMsg{::.contains "Infos.fromStr"}}, {Infos.fromStr `{ab":"c"}`})
  .checkDetErr({::.isMsg{:: == (`Infos.fromStr: invalid escape; the escapes are \\, \" and \n.` | "" | `001| "a\tb"` | "   |   ^")}}, {Infos.fromStr `"a\tb"`})
  .checkDetErr({::.isMsg{:: == (`Infos.fromStr: invalid escape; the escapes are \\, \" and \n.` | "" | `001| "\u0009"` | "   |  ^")}}, {Infos.fromStr `"\u0009"`})
  .checkDetErr({::.isMsg{:: == (`Infos.fromStr: repeated key "a".` | "" | `001| {"a":"1","a":"2"}` | "   |          ^")}}, {Infos.fromStr `{"a":"1","a":"2"}`})
  .checkDetErr({::.isMsg{:: == ("Infos.fromStr: unterminated string." | "" | `003| "b` | "   | ^")}}, {Infos.fromStr("[" | `"a",` | `"b`)})
  .checkDetErr({::.isMsg{:: == ("Infos.fromStr: unexpected end of the text; a value is expected." | "" | `001| {"a":` | "   |      ^")}}, {Infos.fromStr `{"a":`})
  }

TestInfoFromStr: Test {::
  .test InfoFromStrFormatTests
  .test InfoFromStrRoundTripTests
  .test InfoFromStrErrorTests
  }
