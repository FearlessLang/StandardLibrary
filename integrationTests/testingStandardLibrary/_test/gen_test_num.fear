  .test Num0Imm0IsInteger0Test
  .test Num0Imm0Int0Test
  .test Num0Imm0Nat0Test
  .test Num0Imm0Byte0Test
  .test Num0Imm0Float0Test
  .test Num0Imm0GetInt0Test
  .test Num0Imm0GetNat0Test
  .test Num0Imm0GetByte0Test
  .test Num0Imm0GetFloat0Test
  .test Num0Imm0SoftInt0Test
  .test Num0Imm0SoftNat0Test
  .test Num0Imm0SoftByte0Test
  .test Num0Imm0SoftFloat0Test
  .test Num0Imm0InRange1Test
  .test Num0Imm0AssertInRange1Test
