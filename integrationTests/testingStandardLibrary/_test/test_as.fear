AsPerson: { .name: Str }
AsCustomer: AsPerson { .name -> `c` }

AsWiden: {
  .list(cs: List[AsCustomer]): List[AsPerson] -> cs.as{::};
  .nested(css: List[List[AsCustomer]]): List[List[AsPerson]] -> css.as{::.as{::}};
  .map(m: Map[Str,AsCustomer]): Map[Str,AsPerson] -> m.as{::};
  .mapInList(ms: List[Map[Str,AsCustomer]]): List[Map[Str,AsPerson]] -> ms.as{::.as{::}};
  .opt(o: Opt[AsCustomer]): Opt[AsPerson] -> o.as{::};
  .optOfList(o: Opt[List[AsCustomer]]): Opt[List[AsPerson]] -> o.as{::.as{::}};
  .norm(n: Norm[AsCustomer]): Norm[AsPerson] -> n.as{::};
  .normTwice(n: Norm[AsCustomer]): Norm[AsPerson] -> n.as{::}.as{::};
  .normInList(ns: Norm[List[Norm[AsCustomer]]]): Norm[List[Norm[AsPerson]]] -> ns.as{::.as{::.as{::}}};
  .same(cs: List[AsCustomer]): List[AsCustomer] -> cs.as{::};
  }

AsCustomerNorm: { #(s: Norm[Str]): Norm[AsCustomer] -> Cache.ofMemo(s, {_ -> AsCustomer}) }

/// Keyed on the widened Norm[AsPerson], so it can only be reached through .as.
AsPersonName: { #(p: Norm[AsPerson]): Str -> Cache#(p, {p2 -> p2.get.name}) }

AsTests: Test {::
  .check{AsWiden.list(Lists#(AsCustomer)) .size .assertEq 1}
  .check{AsWiden.list(Lists#(AsCustomer)) .get 0 .name .assertEq `c`}
  .check{AsWiden.same(Lists#(AsCustomer)) .get 0 .name .assertEq `c`}
  .check{AsWiden.nested(Lists#(Lists#(AsCustomer))) .get 0 .get 0 .name .assertEq `c`}
  .check{AsWiden.map(Maps#({::}, `k`, AsCustomer)) .get `k` .name .assertEq `c`}
  .check{AsWiden.map(Maps#({::}, `k`, AsCustomer)) .size .assertEq 1}
  .check{AsWiden.mapInList(Lists#(Maps#({::}, `k`, AsCustomer))) .get 0 .get `k` .name .assertEq `c`}
  .check{AsWiden.opt(Opts#AsCustomer) ! .name .assertEq `c`}
  .check{AsWiden.optOfList(Opts#(Lists#(AsCustomer))) ! .get 0 .name .assertEq `c`}
  .check{AsWiden.norm(AsCustomerNorm#(`k`.norm)) .get .name .assertEq `c`}
  .check{AsWiden.normTwice(AsCustomerNorm#(`k`.norm)) .get .name .assertEq `c`}
  .check{AsWiden.normInList(Lists#(AsCustomerNorm#(`k`.norm)).norm{::}) .get .size .assertEq 1}
  .check{AsWiden.normInList(Lists#(AsCustomerNorm#(`k`.norm)).norm{::}) .get .get 0 .get .name .assertEq `c`}
  // A Norm widened by .as is the same Norm, so it is usable as a cache key and
  // lands on the entry of the Norm it came from, however many times it is widened.
  .check{AsPersonName#(AsWiden.norm(AsCustomerNorm#(`k`.norm))) .assertEq `c`}
  .check{AsPersonName#(AsWiden.normTwice(AsCustomerNorm#(`k`.norm))) .assertEq `c`}
  }

/// The empty cases go through the fearless level implementations of .as,
/// not through the magically created non empty ones.
AsEmptyTests: Test {::
  .check{AsWiden.list({}) .size .assertEq 0}
  .check{AsWiden.list(List[AsCustomer]) .isEmpty .assertEq True}
  .check{AsWiden.nested({}) .size .assertEq 0}
  .check{AsWiden.nested(Lists#(List[AsCustomer])) .get 0 .size .assertEq 0}
  .check{AsWiden.map(Maps#[Str,Str,AsCustomer]{::}) .size .assertEq 0}
  .check{AsWiden.opt({}) .isEmpty .assertEq True}
  .check{AsWiden.optOfList({}) .isEmpty .assertEq True}
  .check{AsWiden.optOfList(Opts#({})) ! .size .assertEq 0}
  }

TestAs: Test {::
  .test AsTests
  .test AsEmptyTests
  }
