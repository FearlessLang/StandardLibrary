BlockLoopTests: Test {::
  .check{(Block#
    .var[Nat] i = {0}
    .loop { Block#
      .if {(i.get) >= 10} .return {OuterReturn#(i.get)}
      .do {i.set((i.get) + 1)}
      .return {Continue#}
      }
    .return {Unreachable!}
    ) .assertEq 10}

  .check{(Block#
    .var[Nat] i = {0}
    .var[Nat] sum = {0}
    .loop { Block#
      .if {(i.get) >= 5} .return {Break#}
      .do {sum.set((sum.get) + (i.get))}
      .do {i.set((i.get) + 1)}
      .return {Continue#}
      }
    .return {sum.get}
    ) .assertEq 10}

  // many iterations: proves .loop does not grow the call stack per iteration
  .check{(Block#
    .var[Nat] i = {0}
    .loop { Block#
      .if {(i.get) >= 500000} .return {OuterReturn#(i.get)}
      .do {i.set((i.get) + 1)}
      .return {Continue#}
      }
    .return {Unreachable!}
    ) .assertEq 500000}
  }

TenTimesAt: { #(n: Nat, limit: Nat): mut ControlFlow[Nat] ->
  n >= limit ? { .then -> OuterReturn#(n * 10); .else -> Continue# } }

// the loop handing its argument to every iteration: what a hygienic value needs,
// exercised here with an ordinary mut one, since mut is a subtype of mutH
BlockArgLoopTests: Test {::
  .check{(Block#
    .var[Nat] i = {0}
    .loop(i, {c -> Block#(
      c.set((c.get) + 1),
      (c.get) >= 5 ? { .then -> Break#; .else -> Continue# })})
    .return {i.get}
    ) .assertEq 5}

  // the branch can not read `c`, it is a lambda and `c` is hygienic, so what the
  // branch needs is read where `c` is in scope and arrives as an argument
  .check{(Block#
    .var[Nat] i = {0}
    .loop(i, {c -> Block#(
      c.set((c.get) + 1),
      TenTimesAt#(c.get, 3))})
    .return {Unreachable!}
    ) .assertEq 30}

  .check{(Block#
    .var[Nat] i = {0}
    .loop(i, {c -> Block#(
      c.set((c.get) + 1),
      (c.get) >= 500000 ? { .then -> Break#; .else -> Continue# })})
    .return {i.get}
    ) .assertEq 500000}
  }

TestBlock: Test {::
  .test BlockLoopTests
  .test BlockArgLoopTests
  }
