GuiLineSpacingTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .pane{:: .label{:: .text "Latin" } .paint{g -> Error.msg(g.panelHeight.str)} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Height[58]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .pane{:: .label{:: .uText ("".u "1781 17D2 1789 17BB 17C6") } .paint{g -> Error.msg(g.panelHeight.str)} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Height[58]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .pane{:: .button{:: .uText ("".u "1781 17D2 1789 17BB 17C6 0020 1019 103C 1014 103A 1019 102C 0020 0C95 0CA8 0CCD 0CA8 0CA1 0020 0628 0650 0633 0652 0645 0650") } .paint{g -> Error.msg(g.panelHeight.str)} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Height[58]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .pane{:: .label{:: .text "Latin" .lineSpacing UsedFontsSpacing } .paint{g -> Error.msg(g.panelHeight.str)} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Height[41]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .pane{:: .label{:: .uText ("".u "1781 17D2 1789 17BB 17C6") .lineSpacing UsedFontsSpacing } .paint{g -> Error.msg(g.panelHeight.str)} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Height[41]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .pane{:: .button{:: .uText ("".u "1781 17D2 1789 17BB 17C6 0020 1019 103C 1014 103A 1019 102C 0020 0C95 0CA8 0CCD 0CA8 0CA1 0020 0628 0650 0633 0652 0645 0650") .lineSpacing UsedFontsSpacing } .paint{g -> Error.msg(g.panelHeight.str)} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Height[51]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.content{::
    .label{l -> Error.msg(l.lineSpacing.str + " " + (l.lineSpacing(UsedFontsSpacing).lineSpacing.str) + " " + (l.lineSpacing(AllFontsSpacing).lineSpacing.str))}
    }}}).run{
      .ok _ -> Error.msg "The scope always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "AllFontsSpacing UsedFontsSpacing AllFontsSpacing"}}.assertTrue{i};
      }}
  }
