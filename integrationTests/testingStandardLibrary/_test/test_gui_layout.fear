  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).contentB{:: .westB{:: .center{::
      .vertical
      .button{:: .width 60 .height 30 }
