GuiLayoutTests: Test {::
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .pane{:: .width 100 .height 40 .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[100] Height[40]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .pane{:: .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[24] Height[24]"}}.assertTrue{i};
      }}
  .checkWithSys{sys -> sys.try#(sys.iso.close, {s -> s.gui.run{f -> f.virtualPixelSpace(Width#300, Height#80).content{::
    .pane{:: .fill .paint{g -> Error.msg(g.panelWidth.str + " " + (g.panelHeight.str))} }
    }}}).run{
      .ok _ -> Error.msg "The painter always stops the Gui before its window is shown";
      .info i -> i.validate{:: > "msg" .isMsg{:: == "Width[288] Height[24]"}}.assertTrue{i};
      }}
