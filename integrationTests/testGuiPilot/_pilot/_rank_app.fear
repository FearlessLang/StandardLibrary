use base.Main as Main;
use base.Void as Void;
use base.Str as Str;
use base.Nat as Nat;
use base.Block as Block;
use base.Error as Error;
use base.Color as Color;
use base.Label as Label;
use base.Pane as Pane;
use base.Border as Border;
use base.KeyAction as KeyAction;
use base.Scope as Scope;
use base.Slot as Slot;
use base.Slots as Slots;
use base.KeyStroke as Key;
use base.XInt as X;
use base.YInt as Y;
use base.WidthNat as Width;
use base.HeightNat as Height;
use base.Frame as Frame;
use base.Duration as Duration;
use base.Instant as Instant;
use base.Break as Break;
use base.Continue as Continue;

Pilot:Main{sys -> sys.gui.run{f -> Block#
  .var[Str] seen = {"nothing seen"}
  .var[Nat] pressed = {0}
  .var[Nat] released = {0}
  .let[mut Scope[KeyAction]] escape = {mut Scope[KeyAction]{:: .matchOnly(Key#"ESCAPE") .doOnly{e -> Error.msg(seen.get)}}}
  .let[mut Slot[mut Label]] grown = {Slots#[mut Label]}
  .let[mut Slot[mut Pane]] cleared = {Slots#[mut Pane]}
  .let[mut Slot[mut Border]] replaced = {Slots#[mut Border]}
  .let[mut Slot[mut Pane]] shifted = {Slots#[mut Pane]}
  .let[mut Slot[mut Pane]] stage = {Slots#[mut Pane]}
  .let[mut Slot[mut Label]] longer = {Slots#[mut Label]}
  .var[Nat] lost = {0}
  .return{f
    .title "GuiPilot"
    .resizable
    .onKey{::
      .pressed escape
      .pressed{:: .matchOnly(Key#"SPACE") .doOnly{e -> Block#
        .do{pressed.set(pressed.get + 1)}
        .return{Block#(seen.set("SPACE pressed "+(pressed.get.str)+", released "+(released.get.str)), Void)}
        }}
      .released{:: .matchOnly(Key#"SPACE") .doOnly{e -> Block#
        .do{released.set(released.get + 1)}
        .return{Block#(seen.set("SPACE pressed "+(pressed.get.str)+", released "+(released.get.str)), Void)}
        }}
      .released{:: .matchOnly(Key#"Q") .matchAlso(Key#"W") .doOnly{e -> Block#
        .do{lost.set(lost.get + 1)}
        .if{lost.get == 1} .return{Block#(stage!.paint{g -> Error.msg "A frame showed one key let go by a key map swap without the other"}, Void)}
        .do{Wait#(f, Duration.milliSeconds 500)}
        .do{Block#(stage!.paint{g -> g}, Void)}
        .return{Block#(seen.set "Q and W released", Void)}
        }}
      }
    .content{::
      .vertical
      .background(Color.rgb(250, 236, 214))
      .pane{::
        .button{:: .text "Swap keys" .background(Color.rgb(96, 200, 250)) .action{Block#(f.onKey{:: .pressed escape}, Void)}}
        .button{:: .text "Fix" .background(Color.rgb(250, 150, 90)) .action{Block#
          .do{Block#(f.fixedSize(f.screenWidth.getTruncDiv 2, f.screenHeight.getTruncDiv 2), Void)}
          .return{Block#(seen.set "Fix ran", Void)}
          }}
        .button{:: .text "Corner" .background(Color.rgb(170, 110, 240)) .action{Block#
          .do{Block#(f.location(X.origin + (f.screenWidth.getTruncDiv 4), Y.origin + (f.screenHeight.getTruncDiv 4)), Void)}
          .return{Block#(seen.set "Corner ran", Void)}
          }}
        .button{:: .text "Swap content" .background(Color.rgb(240, 90, 170)) .action{f.content{::
          .background(Color.ghostWhite)
          .mouse{:: .entered{e -> Block#(seen.set "hover: new content", Void)}}
          .label{:: .text "new content"}
          }}}
        }
      .pane{::
        .pane{:: .mouse{:: .entered{e -> Block#(seen.set "hover: label I", Void)}} .label{:: .text "I" .save grown}}
        .pane{:: .mouse{:: .entered{e -> Block#(seen.set "hover: Grow", Void)}} .button{:: .text "Grow" .background(Color.rgb(120, 220, 120)) .action{Block#(grown!.text(grown!.text + " WWWWWWWWWW"), Void)}}}
        }
      .pane{::
        .width 300 .height 40
        .background(Color.rgb(200, 190, 110))
        .mouse{:: .entered{e -> Block#(seen.set "hover: area J", Void)}}
        .save cleared
        .button{:: .text "Clear" .background(Color.rgb(90, 130, 250)) .action{Block#(cleared!.clear.pane{::
          .width 200 .height 30
          .background(Color.goblinGreen)
          .mouse{:: .entered{e -> Block#(seen.set "hover: box J", Void)}}
          }, Void)}}
        }
      .border{::
        .width 300 .height 40
        .background(Color.rgb(200, 190, 110))
        .mouse{:: .entered{e -> Block#(seen.set "hover: area K", Void)}}
        .save replaced
        .center{:: .button{:: .text "Replace" .background(Color.rgb(250, 220, 60)) .action{Block#(replaced!.center{::
          .background(Color.sleepyBlue)
          .mouse{:: .entered{e -> Block#(seen.set "hover: box K", Void)}}
          }, Void)}}}
        }
      .pane{::
        .pane{:: .width 100 .height 30 .background(Color.dustyRose) .mouse{:: .entered{e -> Block#(seen.set "hover: left box L", Void)}}}
        .pane{:: .mouse{:: .entered{e -> Block#(seen.set "hover: Nudge", Void)}} .button{:: .text "Nudge" .background(Color.rgb(60, 210, 200)) .action{Block#
          .let[X] x = {f.locationX}
          .let[X] to = {(x >= (X#(+100))).if{.then -> x - (Width#100); .else -> x + (Width#100)}}
          .return{Block#(f.location(to, f.locationY), Void)}
          }}}
        .pane{:: .width 100 .height 30 .background(Color.dustyRose) .mouse{:: .entered{e -> Block#(seen.set "hover: right box L", Void)}}}
        }
      .pane{::
        .width 300 .height 40
        .widthGap 40
        .background(Color.rgb(180, 220, 200))
        .save shifted
        .button{:: .text "Shift" .background(Color.rgb(140, 100, 60)) .action{Block#
          .do{Block#(seen.set "Shift ran", Void)}
          .do{Block#(shifted!.clear.pane{::
            .width 60 .height 30
            .background(Color.dustyRose)
            .mouse{:: .entered{e -> Block#(seen.set "hover: box M", Void)}}
            }, Void)}
          .do{Wait#(f, Duration.milliSeconds 500)}
          .return{Block#(shifted!.pane{:: .width 60 .height 30 .background(Color.dustyRose)}, Void)}
          }}
        }
      .pane{::
        .width 60 .height 30
        .background(Color.rgb(230, 230, 60))
        .foreground(Color.rgb(20, 90, 200))
        .paint{g -> g.position(X#(+20), Y#(+10)).rect(Width#20, Height#10)}
        }
      .pane{::
        .width 60 .height 30
        .background(Color.rgb(200, 120, 40))
        .paint{g -> Block#(g.position(X#(+20), Y#(+10)), g.color(Color.rgb(40, 200, 120)).rect(Width#20, Height#10))}
        }
      .pane{::
        .widthGap 0
        .save stage
        .button{:: .text "Twice" .background(Color.rgb(220, 80, 220))
          .action{Block#(stage!.paint{g -> Error.msg "A frame showed the first action of a click without the second"}, Void)}
          .action{Block#
            .do{Wait#(f, Duration.milliSeconds 500)}
            .do{Block#(stage!.paint{g -> g}, Void)}
            .return{Block#(seen.set "Twice ran", Void)}
            }}
        .pane{:: .width 60 .height 30 .background(Color.rgb(100, 160, 60)) .mouse{::
          .pressed{e -> Block#(stage!.paint{g -> Error.msg "A frame showed the first handler of a press without the second"}, Void)}
          .pressed{e -> Block#
            .do{Wait#(f, Duration.milliSeconds 500)}
            .do{Block#(stage!.paint{g -> g}, Void)}
            .return{Block#(seen.set "pressed box P", Void)}
            }
          }}
        .pane{:: .width 60 .height 30 .background(Color.rgb(60, 60, 180)) .mouse{::
          .exited{e -> Block#(stage!.paint{g -> Error.msg "A frame showed the pointer leaving box Q without entering box R"}, Void)}
          }}
        .pane{:: .width 60 .height 30 .background(Color.rgb(180, 60, 60)) .mouse{::
          .entered{e -> Block#
            .do{Wait#(f, Duration.milliSeconds 500)}
            .do{Block#(stage!.paint{g -> g}, Void)}
            .return{Block#(seen.set "hover: box R", Void)}
            }
          }}
        }
      .pane{::
        .pane{:: .width 60 .height 30 .background(Color.rgb(90, 60, 140)) .mouse{::
          .pressed{e -> Block#
            .do{Block#(longer!.text "S WWWWWWWWWW", Void)}
            .return{Block#(seen.set "pressed box S", Void)}
            }
          }}
        .label{:: .text "S" .background(Color.rgb(250, 180, 200)) .save longer}
        }
      }
    }
  }}
Wait: {#(f: read Frame, d: Duration): Void -> Block#
  .let[Instant] end = {f.elapsed + d}
  .var[Nat] spins = {0}
  .loop{Block#
    .if{f.elapsed >= end || {spins.get >= 1000000000}} .return{Break#}
    .do{spins.set(spins.get + 1)}
    .return{Continue#}
    }
  .done
  }
