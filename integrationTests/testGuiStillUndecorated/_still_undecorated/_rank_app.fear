use base.Main as Main;
use base.Color as Color;
use base.WidthNat as WidthNat;
use base.HeightNat as HeightNat;

StillUndecorated: Main{ sys -> sys.gui.startUndecorated(+0.125).run{f -> f
  .title "GuiStillUndecorated: nothing on this window changes"
  .virtualPixelSpace(WidthNat#400, HeightNat#200)
  .content.pane{::
    .background(Color.ghostWhite)
    .label{:: .text "A still label" }
    .button{:: .text "A still button" }
    }
  }}
