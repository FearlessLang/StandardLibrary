use base.Main as Main;
use base.Void as Void;
use base.Str as Str;
use base.Nat as Nat;
use base.Int as Int;
use base.Bool as Bool;
use base.True as True;
use base.False as False;
use base.Block as Block;
use base.Color as Color;
use base.Red as Red;
use base.Green as Green;
use base.Blue as Blue;
use base.Alpha as Alpha;
use base.WidthNat as Width;
use base.HeightNat as Height;
use base.XInt as X;
use base.YInt as Y;
use base.Instant as Instant;
use base.Duration as Duration;
use base.Image as Image;
use base.Images as Images;
use base.Painter as Painter;
use base.Graphics as Graphics;
use base.Label as Label;
use base.Menu as Menu;
use base.Frame as Frame;
use base.Pane as Pane;
use base.Slot as Slot;
use base.Slots as Slots;
use base.List as List;
use base.Lists as Lists;
use base.Opt as Opt;
use base.Opts as Opts;

TileGrid:Main{sys -> Block#
  .let grid= {Slots#[mut Pane]}
  .let status= {Slots#[mut Label]}
  .let frame= {Slots#[mut Frame]}
  .let m= {Managers#(grid, status, frame, base.IconsFearless.consumeImage "tour")}
  .return{sys.gui.name "Tiles" .run{f -> Block#(f
    .save frame
    .virtualPixelSpace(Width#660, Height#420)
    .content.border{::
      .background(Color.ghostWhite)
      .north.pane{:: .fill
        .button{b -> b .text "Manager" .action{b.openMenu{mm -> m.managerMenu mm}}}
        .button{b -> b .text "Run" .action{b.openMenu{mm -> m.runMenu mm}}}
        .label{:: .text "Click a tile to select it, double click a compiled one to run it, right click it for its menu" .save status}
        }
      .center.pane{:: .fill .centered(False) .stackScroll(True) .widthGap 0 .heightGap 0 .save grid}
      },
    m.render)}}
  }

State:{ .text: Str; .flag: Painter; .runs: Bool -> False; .at(now: Instant): State -> this; }
States:{
  .idle: State -> { .text -> "idle"; .flag -> Dot#(Color.rgb(117, 117, 117), ""); };
  .dataReadOnly: State -> { .text -> "data: read only"; .flag -> Dot#(Color.rgb(21, 101, 192), "R"); };
  .dataReadWrite: State -> { .text -> "data: read write"; .flag -> Dot#(Color.rgb(106, 27, 154), "W"); };
  .codeNoCache: State -> { .text -> "code: not compiled (no cache)"; .flag -> Dot#(Color.rgb(239, 108, 0), "!"); };
  .codeOutdated: State -> { .text -> "code: not compiled (cache out of date)"; .flag -> Dot#(Color.rgb(239, 108, 0), "!"); };
  .codeInvalid: State -> { .text -> "code: invalid content"; .flag -> Dot#(Color.rgb(198, 40, 40), "X"); };
  .dataInvalid: State -> { .text -> "data: invalid content"; .flag -> Dot#(Color.rgb(198, 40, 40), "X"); };
  .codeCompiled: State -> { .text -> "code: compiled"; .flag -> Dot#(Color.rgb(46, 125, 50), ">"); .runs -> True; };
  .busy(end: Instant): State -> { 'self
    .text -> "code: busy";
    .flag -> Busy#(end, States.codeCompiled.flag);
    .at(now) -> (now < end) ? { .then -> self; .else -> States.codeCompiled };
    };
  .all: List[State] -> Lists#(this.idle, this.dataReadOnly, this.dataReadWrite, this.codeNoCache, this.codeOutdated, this.codeInvalid, this.dataInvalid, this.codeCompiled);
  }

Project:{ read .name: Str; .state: State; .image: Image;
  .folder: Str -> "/projects/"+(this.name);
  .with(s: State): Project -> Projects#(this.name, s, this.image);
  }
ProjectTiles:{ #(p: Project): Tile -> { .name -> p.name; .tooltip -> p.folder+" - "+(p.state.text); .image -> p.image; .flag -> p.state.flag; } }
Projects:{
  #(name: Str, state: State, image: Image): Project -> { .name -> name; .state -> state; .image -> image; };
  #(name: Str, state: State): Project -> this#(name, state, GeneratedIcons#name);
  }
Names:{ #(i: Nat): Str -> Block#
  .let[Str] name= {Lists#("alpha", "beta", "gamma", "delta", "basketball", "a project with a very long name", "zero to hero", "hello world").get(i.getRem 8)}
  .if{i < 8} .return{name}
  .return{name+" "+((i.getTruncDiv 8) + 1)}
  }
Sorted:{ #(ps: List[Project]): List[Project] -> ps.flow.sort{::.name}.list }
IndexOf:{ #(ps: List[Project], name: Str, i: Nat): Opt[Nat] -> Block#[Opt[Nat]]
  .if{i >= (ps.size)} .return{{}}
  .if{(ps.get i).name == name} .return{Opts#i}
  .return{IndexOf#(ps, name, i + 1)}
  }

Managers:{ #(grid: mut Slot[mut Pane], status: mut Slot[mut Label], frame: mut Slot[mut Frame], fearless: Image): mut Manager -> Block#
  .var[List[Project]] projects= {Sorted#(Lists#(
    Projects#(Names#0, States.idle), Projects#(Names#1, States.dataReadOnly), Projects#(Names#2, States.dataReadWrite),
    Projects#(Names#3, States.codeOutdated), Projects#(Names#4, States.codeInvalid), Projects#(Names#5, States.codeCompiled),
    Projects#(Names#6, States.codeCompiled), Projects#(Names#7, States.codeNoCache), Projects#("tour", States.codeCompiled, fearless)))}
  .var[Str] selected= {Names#0}
  .var[Nat] count= {8}
  .var[Nat] cycle= {0}
  .var[List[Bool]] ticks= {Lists#(True, False, False)}
  .return{mut Manager:{'self
    mut .render: Void -> TileGrids#(grid!, projects.get.flow.map{p -> ProjectTiles#p}.list, IndexOf#(projects.get, selected.get, 0), {i -> self.click i}, {i -> self.open i}, {mm, i -> self.tileMenu(mm, i)});
    mut .managerMenu(mm: mut Menu): mut Menu -> mm
      .item{:: .text "Add project" .action{self.add}}
      .item{:: .text "Next state" .action{self.next}}
      .item{:: .text "Select" .submenu{s -> SelectItems#(s, projects.get, selected.get, self, 0)}}
      .separator
      .item{:: .text "Close the window" .action{frame!.close}};
    mut .runMenu(mm: mut Menu): mut Menu -> RunItems#(mm, ticks.get, self, 0)
      .separator
      .item{:: .text "Run the ticked mains" .enabled(Ticked#(ticks.get, 0) && {self.runs(self.current)}) .action{self.open(self.current)}};
    mut .tileMenu(mm: mut Menu, i: Nat): mut Menu -> mm
      .item{:: .text("Run " + ((projects.get.get i).name)) .enabled(self.runs i) .action{self.open i}}
      .item{:: .text "Select" .enabled((projects.get.get i).name != (selected.get)) .action{self.click i}}
      .separator
      .item{:: .text "Forget" .enabled(projects.get.size > 1) .action{self.forget i}};
    mut .current: Nat -> IndexOf#(projects.get, selected.get, 0)!;
    mut .runs(i: Nat): Bool -> (projects.get.get i).state.at(frame!.elapsed).runs;
    mut .say(text: Str): Void -> Block#(status!.text text, Void);
    mut .set(i: Nat, s: State): Void -> projects.set(projects.get.with(i, (projects.get.get i).with s));
    mut .tick(i: Nat): Void -> Block#
      .do{ticks.set(ticks.get.with(i, ticks.get.get(i).not))}
      .return{self.say("Ticked: "+(Mains#i))};
    mut .forget(i: Nat): Void -> Block#
      .let[Str] name= {(projects.get.get i).name}
      .do{projects.set(projects.get.without i)}
      .if{name == (selected.get)} .do{selected.set((projects.get.get 0).name)}
      .do{self.say("Forgot: "+name)}
      .return{self.render};
    mut .add: Void -> Block#
      .let[Str] name= {Names#(count.get)}
      .do{count.set(count.get + 1)}
      .do{projects.set(Sorted#(projects.get ++ (Lists#(Projects#(name, States.idle)))))}
      .do{selected.set name}
      .do{self.say("Added: "+name)}
      .return{self.render};
    mut .next: Void -> Block#
      .let[Nat] i= {self.current}
      .do{cycle.set(cycle.get + 1)}
      .do{self.set(i, States.all.get(cycle.get.getRem 8))}
      .do{self.say((projects.get.get i).name+": "+((projects.get.get i).state.text))}
      .return{self.render};
    mut .click(i: Nat): Void -> Block#
      .let[Instant] now= {frame!.elapsed}
      .do{projects.set(projects.get.flow.map{p -> p.with(p.state.at now)}.list)}
      .do{selected.set((projects.get.get i).name)}
      .do{self.say((projects.get.get i).name+": "+((projects.get.get i).state.text))}
      .return{self.render};
    mut .open(i: Nat): Void -> Block#
      .do{self.click i}
      .if{(projects.get.get i).state.runs.not} .return{Void}
      .do{self.set(i, States.busy(frame!.elapsed + (Duration.seconds 3)))}
      .do{self.say("Running: "+((projects.get.get i).name))}
      .return{self.render};
    }}
  }
Mains:{ #(i: Nat): Str -> Lists#("main", "test", "bench").get i }
RunItems:{ #(menu: mut Menu, ticks: List[Bool], m: mut Manager, i: Nat): mut Menu -> Block#
  .if{i >= (ticks.size)} .return{menu}
  .return{RunItems#(menu.item{:: .text(Mains#i) .check(ticks.get i) .action{m.tick i}}, ticks, m, i + 1)}
  }
Ticked:{ #(ticks: List[Bool], i: Nat): Bool -> (i >= (ticks.size)) ? { .then -> False; .else -> ticks.get i || {Ticked#(ticks, i + 1)} } }
SelectItems:{ #(menu: mut Menu, ps: List[Project], selected: Str, m: mut Manager, i: Nat): mut Menu -> Block#
  .if{i >= (ps.size)} .return{menu}
  .return{SelectItems#(menu.item{:: .text((ps.get i).name) .radio((ps.get i).name == selected) .action{m.click i}}, ps, selected, m, i + 1)}
  }
