use base.Main as Main;
use base.Lists as Lists;
use base.List as List;
use base.Error as Error;
use base.Void as Void;
use base.Norm as Norm;
use base.Cache as Cache;
use base.Block as Block;
use base.Debug as Debug;
use base.Nat as Nat;
use base.Str as Str;
use base.Info as Info;
use base.Repr as Repr;
use base.Var as Var;
use base.Vars as Vars;
use base.CacheF as CacheF;
use base.CacheMemo as CacheMemo;
use base.CaptureFree as CaptureFree;

CacheSum:{ #(a:Nat,b:Nat):Nat->Cache#(a.norm,b.norm,{
  a',b'->Block#(Debug#("Summing "+(a'.get)+" and "+(b'.get)),a'.get + (b'.get))
  })}

CacheInfo:{ #(str:Norm[Str]):Norm[Info]->Cache.ofMemo(str,{
  s->Block#(Debug#("ToInfo "+(s.get)),s.get.info)
  })}

UseInfo:{ #(i:Norm[Info]):Str->Cache#(i,{
  i'->Block#(Debug#("OutInfo "+(i'.get)),i'.get.str)
  })}

NormL:{#(ns:List[Nat]):Norm[List[Norm[Nat]]]->ns.norm{::.norm}}
SumAll:{#(ns:Norm[List[Norm[Nat]]]):Nat->Cache#(ns,{::.get.flow.map{::.get}.sum 0})}
HelloNormList:Main{s->Block#
  .let nl1={NormL#(Lists#(1,2,3))}
  .do{Debug#(SumAll#nl1)}
  .done
}

ReprStr:{#(r: mut Repr[Var[Nat]]):Str->r.cachableLook{n->Block#(
  Debug#("InReprStr"+(n.get)),
  "!"+(n.get.str)+"!"
  )}}

ReprStr2:{#(r: mut Repr[Var[Nat]], i: Norm[Nat]):Str->r.cachableLook(i,{n,i'->Block#(
  Debug#("InReprStr2"+(n.get)),
  "!"+(n.get.str)+" - "+(i'.get.str)+"!"
  )}
  )}


HelloRepr:Main{s->Block#
  .repr x={ Vars#10; .invariant->{::.get > 5} }
  .do{ Debug#(ReprStr#x) }
  .do{ x.mutate{v->v.set(20)}}
  .do{ Debug#(ReprStr#x) }
  .do{ Debug#(ReprStr2#(x,10.norm))}
  .do{ Debug#(ReprStr2#(x,10.norm))}
  .do{ x.mutate{v->v.set(30)}}
  .do{ Debug#(ReprStr2#(x,10.norm))}
  .do{ Debug#(ReprStr#x) }
  .done
  }
Hello2:Main{s->Block#
  .let[Norm[Info]] i1= {CacheInfo#("HelloStringInfo".norm)}
  .let[Norm[Info]] i2= {CacheInfo#("AnotherInfo".norm)}
  .let[Norm[Info]] i3= {CacheInfo#("HelloStringInfo".norm)}
  .let[Str] s11= {UseInfo#(i1)}
  .let[Str] s12= {UseInfo#(i2)}
  .let[Str] s13= {UseInfo#(i3)}
  .let[Str] s21= {UseInfo#(i1)}
  .let[Str] s22= {UseInfo#(i2)}
  .let[Str] s23= {UseInfo#(i3)}
  .do{ Debug#(s11+s12+s13+s21+s22+s23)}
  .done
  }

Hello:Main{s->Block#(
  Debug#(CacheSum#(1,2)),
  Debug#(CacheSum#(3,4)),
  Debug#(CacheSum#(1,2)),
  Debug#(CacheSum#(1,2)),
  Debug#(CacheSum#(3,4)),
  )}

Bar:{ .baz(a:Norm[Str],b:Norm[List[Norm[Str]]]):Nat->Block#(
  Debug#("Bar.baz called"),
  a.get.size+(b.get.size)); }
Cache_27Out:{
  .methName(a:Norm[Str],b:Norm[List[Norm[Str]]]):Nat->
  Cache.of(a,b,Cache27:CacheF[Str,List[Norm[Str]],Nat]{ aa,bb->Bar.baz(aa,bb)})
  }
MainFlushCache:Main{s->Block#
  .let x= {Cache_27Out.methName("foo".norm,Lists#("b").norm{::.norm})}
  .let y= {Cache_27Out.methName("foo".norm,Lists#("b").norm{::.norm})}
  .let z= {Cache_27Out.methName("foo".norm,Lists#("b").norm{::.norm})}
  .do{ Debug#("cleaned") }
  .do {Cache.flush(Cache27)}
  .let w= {Cache_27Out.methName("foo".norm,Lists#("b").norm{::.norm})}
  .done
  }
///Caching is invisible to the values a program computes: a hit and a
///recomputation return the very same result. What tells them apart is whether
///the cached body ran at all, so the Mains below print a line from inside each
///cached body and the expected Debug trace is what the Java side asserts.

NormAnimal: { .name: Str }
NormCat: NormAnimal { .name -> `cat` }

///Memoized production of a Norm[NormCat]. Equal keys must hand back the very
///same Norm, since caches keyed on a Norm key it by identity, not by content.
CatMemo:{ #(k: Norm[Str]): Norm[NormCat] -> Cache.ofMemo(k,
  CatMemoF: CacheMemo[Str,NormCat]{_->Block#(Debug#("memoCat"),NormCat)})}

///Keyed on Norm[NormAnimal], but reached with a Norm[NormCat] widened by .as.
AnimalName:{ #(a: Norm[NormAnimal]): Str -> Cache.of(a,
  AnimalNameF: CacheF[NormAnimal,Str]{a'->Block#(Debug#("naming"),a'.get.name)})}

///.as widens the type of a Norm without making a new one, so a widened Norm
///must land on the cache entry of the Norm it was widened from.
MainAsKeepsCacheKey:Main{s->Block#
  .let c1= {CatMemo#("c".norm)}
  .let c2= {CatMemo#("c".norm)}
  .do{ Debug#(AnimalName#(c1.as{::})) }
  .do{ Debug#(AnimalName#(c2.as{::})) }
  .do{ Debug#(AnimalName#(c1.as{::}.as{::})) }
  .done
  }

///Flushing a memo does not only force the body to run again: it also hands out
///a Norm that is a different object, so caches keyed on that Norm miss too.
MainFlushMemo:Main{s->Block#
  .let c1= {CatMemo#("f".norm)}
  .do{ Debug#(AnimalName#(c1.as{::})) }
  .do{ Cache.flush CatMemoF }
  .let c2= {CatMemo#("f".norm)}
  .do{ Debug#(AnimalName#(c2.as{::})) }
  .do{ Cache.flush AnimalNameF }
  .do{ Debug#(AnimalName#(c2.as{::})) }
  .done
  }

ZeroF:{ #: Nat -> Cache#{Block#(Debug#("zeroF"),42)} }
ZeroMemo:{ #: Norm[Nat] -> Cache.ofMemo{Block#(Debug#("zeroMemo"),7)} }
MainZeroArity:Main{s->Block#
  .do{ Debug#(ZeroF#) }
  .do{ Debug#(ZeroF#) }
  .do{ Debug#(ZeroMemo#.get) }
  .do{ Debug#(ZeroMemo#.get) }
  .done
  }

///Strings long enough to be interned by .norm: two equal ones built apart are
///the same Norm, so they share a cache entry, while a different one does not.
LongStr:{ #(pre: Str): Str -> pre+"0123456789012345678901234567890123456789012345678901234567890123456789" }
LongSize:{ #(s: Norm[Str]): Nat -> Cache#(s,{s'->Block#(Debug#("sizing"),s'.get.size)})}
MainStrNormInterning:Main{s->Block#
  .do{ Debug#(LongSize#(LongStr#("x").norm)) }
  .do{ Debug#(LongSize#(LongStr#("x").norm)) }
  .do{ Debug#(LongSize#(LongStr#("y").norm)) }
  .done
  }

///Same for lists: .norm interns a list of Norms, so two equal lists built apart
///share the cache entry keyed on the resulting Norm.
SumAllTraced:{#(ns: Norm[List[Norm[Nat]]]):Nat->Cache#(ns,
  {n->Block#(Debug#("summingList"),n.get.flow.map{::.get}.sum 0)})}
MainListNormInterning:Main{s->Block#
  .do{ Debug#(SumAllTraced#(NormL#(Lists#(1,2,3)))) }
  .do{ Debug#(SumAllTraced#(NormL#(Lists#(1,2,3)))) }
  .do{ Debug#(SumAllTraced#(NormL#(Lists#(1,2,4)))) }
  .done
  }
