Guis: { #(model: mut Slot[mut Model], canvas: mut Slot[mut Pane], width: Nat,  height: Nat): mut Gui -> Block#
  .let lightGrey = { Color#(Red#(83.getByte),Green#(81.getByte),Blue#(81.getByte),Alpha.opaque) }
  .return { mut Gui: Consumer[mut Frame] {::
    .title "Basketball"
    .undecorated(Alpha.opaque)
    .fps 30
    .onKey {::
      .pressed  {:: .matchOnly(Key#`W`) .doOnly { e -> model!.player.jump } }
      .pressed  {:: .matchOnly(Key#`A`) .doOnly { e -> model!.player.left True } }
      .released {:: .matchOnly(Key#`A`) .doOnly { e -> model!.player.left False } }
      .pressed  {:: .matchOnly(Key#`D`) .doOnly { e -> model!.player.right True } }
      .released {:: .matchOnly(Key#`D`) .doOnly { e -> model!.player.right False } }
      }
    .modelFps(30, {:: .action { model!.tick } })
    .content {::
      .width width
      .height height
      .save canvas 
      .paint Menu
      .mouse {:: .clicked { e -> Block# 
        .if { MenuBounds#(e.panelWidth, e.panelHeight).contains(e.mouseX, e.mouseY) }
          .do { model!.play }
        .done
        }}};
    mut .set(p: Painter): Void -> Block#(canvas!.paint(p), Void);
    }}}

Menu: Painter { g -> Block#
  .let lightGrey = { Color#(Red#(83.getByte),Green#(81.getByte),Blue#(81.getByte),Alpha#(150.getByte)) }
  .let menuBounds = { MenuBounds#(g.panelWidth, g.panelHeight) }
  .return {g
  .color lightGrey
    .position(X.origin, Y.origin)
    .image(Court#(g.panelHeight.get))
    .position(menuBounds.x, menuBounds.y)
    .image(ButtonImg#(menuBounds.width.get))
    }}

Game: Painter { g -> Block#
  .let squareBounds = { SquareBounds#(this.state.sx, this.state.sy, g.panelWidth) }
  .let playerBounds = { PlayerBounds#(this.state.px, this.state.py, g.panelWidth) }
  .let ballBounds   = { BallBounds#(this.state.bx, this.state.by, g.panelWidth, g.panelHeight) }
  .return {g
    .position(X.origin, Y.origin)
    .image(Court#(g.panelHeight.get))
    .position(squareBounds.x - (squareBounds.width .getTruncDiv 7), squareBounds.y) 
    .image(Hoop#((squareBounds.width * 9 .getTruncDiv 7).get))
    .position(squareBounds.x, squareBounds.y)
    .position(playerBounds.x, playerBounds.y)
    .image(PlayerImg#(playerBounds.width.get))
    .position(ballBounds.x, ballBounds.y)
    .image(BallImg#(ballBounds.width.get))
    };
  .state: State;
  }

Court:F[Nat,Image]{h->Cache.of(h.norm,
  {ImgCourt.consumeImage("A") .scaleToHeight(::.get)})}
Hoop:F[Nat,Image]{h->Cache.of(h.norm,
  {ImgHoop.consumeImage("A") .scaleToHeight(::.get)})}
BallImg:F[Nat,Image]{h->Cache.of(h.norm,
  {ImgBall.consumeImage("A") .scaleToHeight(::.get)})}
PlayerImg:F[Nat,Image]{h->Cache.of(h.norm,
  {ImgPlayer.consumeImage("A") .scaleToHeight(::.get)})}
ButtonImg:F[Nat,Image]{h->Cache.of(h.norm,
  {ImgMenu.consumeImage("A") .scaleToWidth(::.get)})}
