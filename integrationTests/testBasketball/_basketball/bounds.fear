MenuBounds: { #(width: Width, height: Height): Rect -> Block#
  .let w = { width * 2 .getTruncDiv 5 }
  .let h = { height .getTruncDiv 5 }
  .let x = { X.origin + ((width - w) .getTruncDiv 2) }
  .let y = { Y.origin + ((height - h) .getTruncDiv 2) }
  .return { Rects#(x, y, w, h) }
}

PlayerSize:F[Width,Width]{:: .getTruncDiv 12}
BallSize:F[Width,Width]{:: .getTruncDiv 16}
SquareWidth:F[Width,Width]{:: .getTruncDiv 10}
SquareHeight:F[Width,Height]{Height#((::.getTruncDiv 12).get)}

SquareBounds: { #(x: Nat, y: Nat, width: Width): Rect ->
  Rects#(X#(x.getInt), Y#(y.getInt), SquareWidth#width, SquareHeight#width)
}

PlayerBounds: { #(x: Nat, y: Nat, width: Width): Rect -> Block#
  .let size = { PlayerSize#width }
  .return { Rects#(X#(x.getInt), Y#(y.getInt), size, Height#(size.get)) }
}

BallBounds: { #(x: Nat, y: Nat, width: Width): BallBound -> Block#
  .let size = { BallSize#width }
  .return {{
    .x -> X#(x.getInt); .y -> Y#(y.getInt);
    .width -> size; .height -> Height#(size.get);
    .screenWidth -> width;
    }}}

BallBound: Rect {
    .screenWidth: Width;
    .overlapsRect(bx: Float, by: Float, bounds: Rect): Bool -> Block#
      .let[Float] px          = { bounds.x.get.softFloat }//somehow infers read Float
      .let[Float] py          = { bounds.y.get.softFloat }
      .let[Float] boundW      = { bounds.width.get.softFloat }
      .let[Float] boundH      = { bounds.height.get.softFloat }
      .let[Float] ballW       = { this.width.get.softFloat }
      .let[Float] ballH       = { this.height.get.softFloat }
      .let ballRight   = { bx + ballW }
      .let ballBottom  = { by + ballH }
      .let boundRight  = { px + boundW }
      .let boundBottom = { py + boundH }
      .return {
        ballRight > px
        && { bx < boundRight }
        && { ballBottom > py }
        && { by < boundBottom }
        };
    .bounceOffPlayer(bx: Float, player: read Player): Float -> Block#
      .let playerBounds          = { PlayerBounds#(player.x, player.y, this.screenWidth) }
      .let px           = { playerBounds.x.get.softFloat }
      .let playerW      = { playerBounds.width.get.softFloat }
      .let playerCenter = { px + (playerW / +2.0) }
      .let ballCenter   = { bx + (this.width.get.softFloat / +2.0) }
      .return { (ballCenter - playerCenter) / playerW * +16.0 }}
