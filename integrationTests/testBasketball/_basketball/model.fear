Bouncers: { #(start: Float, initialVel: Float): mut Bouncer -> Block#
  .var p = { start }
  .var v = { initialVel }
  .return { mut Bouncer: {
    read .pos: Float -> p.get;
    read .vel: Float -> v.get;
    mut .setVel(newVel: Float): Void -> v.set newVel;
    mut .tick(accel: Float, maxSpeed: Float, min: Float, max: Float): Void -> Block#
      .do { v.set((v.get + accel).clampTo(0.0 - maxSpeed =~~= maxSpeed)) }
      .do { p.set(p.get + (v.get)) }
      .if { p.get < min } .do { Block#(p.set min, v.set(v.get.getAbs)) }
      .if { p.get > max } .do { Block#(p.set max, v.set(0.0 - (v.get.getAbs))) }
      .done;
    }}}

Balls: { #(startX: Nat, startY: Nat, width: Nat, height: Nat): mut Ball -> Block#
  .var alive      = { True }
  .let ballBounds = { BallBounds#(0, 0, Width#width, Height#height) }
  .let gravity    = { 0.4soft }
  .let maxVel     = { 12.0 }
  .let ballW      = { ballBounds.width.get.softFloat }
  .let xAxis      = { Bouncers#(startX.softFloat, 0.0) }
  .let yAxis      = { Bouncers#(startY.softFloat, 0.0) }
  .return { mut Ball: {
    read .x: Nat -> xAxis.pos.softNat;
    read .y: Nat -> yAxis.pos.softNat;
    read .alive: Bool -> alive.get;
     mut .tick(player: mut Player, square: mut Square): Void -> Block#
    .do { xAxis.tick(0.0, Math.inf, 0.0, width.softFloat - ballW) }
    .do { yAxis.tick(gravity, maxVel, 0.0, height.softFloat - ballW) }
    .if { ballBounds.overlapsRect(xAxis.pos, yAxis.pos, PlayerBounds#(player.x, player.y, Width#width)) }
        .do { Block#(
          xAxis.setVel(ballBounds.bounceOffPlayer(xAxis.pos, player)),
          yAxis.setVel(0.0 - (yAxis.vel.getAbs + 1.0))
        )}
    .if { ballBounds.overlapsRect(xAxis.pos, yAxis.pos, SquareBounds#(square.x, square.y, Width#width)) }
        .do { alive.set False }
    .done;
    }}}

Players: { #(startX: Nat, startY: Nat, width: Nat, height: Nat): mut Player -> Block#
  .var px                = { startX.softFloat }
  .var py                = { startY.softFloat }
  .var vy                = { 0.0 }
  .var left                   = { False }
  .var right                  = { False }
  .let speed         = { 8.0 }
  .let gravity       = { 0.4soft }
  .let jumpStrength  = { -12.0 }
  .let groundY       = { startY.softFloat }
  .let playerW       = { PlayerSize#(Width#width).get.softFloat }
  .return { mut Player: {
    read .x: Nat -> px.get.softNat;
    read .y: Nat -> py.get.softNat;
    mut .left(b: Bool): Void -> left.set b;
    mut .right(b: Bool): Void -> right.set b;
    mut .jump: Void -> Block#.if { py.get >= groundY }.do { vy.set jumpStrength }.done;
    mut .tick: Void -> Block#
      .let curVy = { vy.get + gravity }
      .do { vy.set curVy }
      .if { left.get }
          .do { px.set((px.get - speed).clampTo(0.0 =~~= ( width.softFloat - playerW))) }
      .if { right.get }
          .do { px.set((px.get + speed).clampTo(0.0 =~~= ( width.softFloat - playerW))) }
      .do { py.set(py.get + curVy) }
      .if { (py.get + curVy) > groundY }
          .do { Block#(py.set groundY, vy.set(0.0)) }
      .done;
    }}}
Squares: { #(startX: Nat, startY: Nat, width: Nat, height: Nat): mut Square -> Block#
  .let speed   = { 5.0 }
  .let squareW = { SquareWidth#(Width#width).get.softFloat }
  .let minX    = { width.softFloat / 10.0 }
  .let maxX    = { width.softFloat * 9.0 / 10.0 - squareW }
  .let xAxis   = { Bouncers#(startX.softFloat, 0.0 - speed) }
  .return { mut Square: {
    read .x: Nat -> xAxis.pos.softNat;
    read .y: Nat -> startY;
    mut .tick: Void -> xAxis.tick(0.0, speed, minX, maxX);
    }}}
Models: { #(gui: mut Gui, width: Nat, height: Nat): mut Model -> Block#
  .var playing      = { False }
  .let playerW      = { PlayerSize#(Width#width).get }
  .let playerH      = { playerW }
  .let playerX      = { (width.aluDiv 2) - (playerW.aluDiv 2) }
  .let playerY      = { height - playerH }
  .let player       = { Players#(playerX, playerY, width, height) }
  .let ballW        = { BallSize#(Width#width).get }
  .let ballH        = { ballW }
  .let ballX        = { (width.aluDiv 2) - (ballW.aluDiv 2) }
  .let ballY        = { (height.aluDiv 4) - (ballH.aluDiv 2) }
  .let ball         = { Balls#(ballX, ballY, width, height) }
  .let squareW      = { SquareWidth#(Width#width).get }
  .let squareH      = { SquareHeight#(Width#width).get }
  .let squareX      = { (width.aluDiv 4) - (squareW.aluDiv 2) }
  .let squareY      = { (height.aluDiv 4) - ((squareH * 3) .aluDiv 4) }
  .let square       = { Squares#(squareX, squareY, width, height) }
  .return { mut Model: {
    mut .player: mut Player -> player;
    mut .square: mut Square -> square;
    mut .play: Void -> playing.set True;
    mut .tick: Void -> Block#
      .let state = { States#(player.x, player.y, ball.x, ball.y, square.x, square.y) }
      .if { playing.get } .do { Block#(
        player.tick,
        ball.tick(player, square),
        square.tick,
        gui.set Game{ state }) }
      .if { ball.alive.not }
        .do { playing.set False }
      .done;
    }}}
States: { #(px: Nat, py: Nat, bx: Nat, by: Nat, sx: Nat, sy: Nat): State ->
  State: {
    .px: Nat -> px;
    .py: Nat -> py;
    .bx: Nat -> bx;
    .by: Nat -> by;
    .sx: Nat -> sx;
    .sy: Nat -> sy;
    }}
