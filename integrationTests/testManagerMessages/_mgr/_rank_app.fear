use base.UnitTests as UnitTests;
use base.Test as Test;
use base.Lists as L;

Pub: base.DataRead{}
Path: { #(s: mut base.System): base.List[base.Byte] -> s.dataRead(Pub).read(L#("path.bin")).readBytes }
Relative: { #(s: mut base.System): base.List[base.Byte] -> s.dataRead(Pub).read(L#("relative.bin")).readBytes }
Root: { #(s: mut base.System): base.List[base.Byte] -> s.dataRead(Pub).read(L#("root.bin")).readBytes }

ManagerMessageTests: UnitTests{::
  .test ManagerMessages
  .test ManagerMessagesRefused
  .test ManagerMessagesRoot
  }

ManagerMessages: Test{::
  .checkWithSys{s -> s.manager.register(Path#s)}
  .checkWithSys{s -> s.manager.show}
  .checkWithSys{s -> s.manager.show "hello"}
  .checkWithSys{s -> s.manager.selectMains("hello", L#("hello.B", "hello.A"))}
  .checkWithSys{s -> s.manager.selectMains("hello", {})}
  .checkWithSys{s -> s.manager.run "hello" .getStr.assertEq "Output of FearlessCommandRun"}
  .checkWithSys{s -> s.manager.compile "hello" .getStr.assertEq "Output of FearlessCommandCompile"}
  .checkWithSys{s -> s.manager.check "hello" .getStr.assertEq "Output of FearlessCommandCheck"}
  .checkWithSys{s -> s.manager.fix "hello" .getStr.assertEq "Output of FearlessCommandFix"}
  .checkWithSys{s -> s.manager.kindDataRead "hello"}
  .checkWithSys{s -> s.manager.mount("hello", "hello.Notes", "notes")}
  .checkWithSys{s -> s.manager.unmount("hello", "hello.Pub")}
  .checkWithSys{s -> s.manager.attenuate("hello", "hello.A", L#("base.NoManagerQuit", "hello.NoGui"))}
  .checkWithSys{s -> s.manager.attenuate("hello", "hello.B", {})}
  .checkWithSys{s -> s.manager.openWithOrShortcut(Path#s, "hello", "hello.A")}
  }

ManagerMessagesRefused: Test{::
  .checkDetErrWithSys({::.isMsg{:: == (
     "The manager refuses to forget nope."
    )}}, {t -> t.manager.forget "nope"})
  .checkDetErrWithSys({::.isMsg{:: == (
     `The message "Register" is not sent: the path "relative"`
    |`is not an absolute path of this system other than the root of a drive.`
    )}}, {t -> base.Block#
      .openIso s = t
      .return{s.manager.register(Relative#s)}
      })
  .checkDetErrWithSys({::.isMsg{:: == (
     `The message "Show" is not sent: "Hello" is not a project name.`
    )}}, {t -> t.manager.show "Hello"})
  .checkDetErrWithSys({::.isMsg{:: == (
     `The message "Unmount" is not sent: "Pub" is not a qualified type name, like "hello.Main".`
    )}}, {t -> t.manager.unmount("hello", "Pub")})
  .checkDetErrWithSys({::.isMsg{:: == (
     `The message "SelectMains" is not sent: the mains are all different, and "hello.A" is named twice.`
    )}}, {t -> t.manager.selectMains("hello", L#("hello.A", "hello.A"))})
  }

ManagerMessagesRoot: Test{::
  .checkDetErrWithSys({::.isMsg{::.startsWith `The message "Register" is not sent: the path "`}}, {t -> base.Block#
      .openIso s = t
      .return{s.manager.register(Root#s)}
      })
  }
