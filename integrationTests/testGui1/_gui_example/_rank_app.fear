use base.Void as Void;
use base.Str as Str;
use base.Gui as Gui;
use base.Block as Block;
use base.Consumer as Consumer;
use base.Frame as Frame;
use base.Debug as Debug;
use base.Color as Color;
use base.KeyStroke as Key;
use base.Label as Label;
use base.Slot as Slot;
use base.Slots as Slots;
use base.Pane as Pane;
use base.True as True;
use base.False as False;
use base.WidthNat as Width;
use base.HeightNat as Height;
use base.XInt as X;
use base.YInt as Y;


Foo:base.Main{s->Block#
  .let g={s.gui}
  .do{ g.run Gui01 }
  .do{ g.run Gui02 }
  .do{ g.run Gui03 }
  .do{ g.run Gui04 }
  .do{ g.run Gui05 }
  .do{ g.run Gui06 }
  .do{ g.run Gui07 }
  .let label={Slots#[mut Label]}
  .do{ g.run mut Gui08{label} }
  .do{ g.run Gui09 }
  .do{ g.run Gui10 }
  .do{ g.run Gui11 }
  .do{ g.run Gui12 }
  .do{ g.run Gui13 }
  .let log={Slots#[mut Pane]}
  .do{ g.run mut Gui14{log} }
  .do{ g.run Gui15 }
  .do{ g.run Gui16 }
  .do{ g.run Gui17 }
  .do{ g.run Gui18 }
  .do{ g.run Gui19 }
  .do{ g.run Gui20 }
  .done
  }
Gui01:Consumer[mut Frame]{::
  .title "Gui01: two labels"
  .content.pane{::
    .label{:: .text "Hello" }
    .label{:: .text "World" }
    }
  }
