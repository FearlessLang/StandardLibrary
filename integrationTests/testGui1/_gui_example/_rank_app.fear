Gui18:Consumer[mut Frame]{::
  .title "Gui18: drag the dividers"
  .virtualPixelSpace(Width#600, Height#400)
  .content.border{::
    .background (Color.ghostWhite)
    .north.pane{:: .fill .background (Color.rubberDuck) .label{:: .text "Drag the dividers" } }
    .center.split
      .pane{:: .fill .width 120 .maxPerLine 1 .stackScroll(True) .background (Color.alienMint)
        .button{:: .text "Tile 1" }
        .button{:: .text "Tile 2" }
        .button{:: .text "Tile 3" }
        .button{:: .text "Tile 4" }
        .button{:: .text "Tile 5" }
        .button{:: .text "Tile 6" }
        .button{:: .text "Tile 7" }
        .button{:: .text "Tile 8" }
        .button{:: .text "Tile 9" }
        .button{:: .text "Tile 10" }
        }
      .and.split
        .pane{:: .fill .width 200 .background (Color.moonCheese) .label{:: .text "The data of the selected tile" } }
        .and.pane{:: .fill .width 200 .background (Color.dustyRose) .label{:: .text "The output of the selected tile" } }
        .with{:: .fill .vertical .dividerPosition 150}
      .with{:: .fill .dividerPosition 200}
    }
  }
Gui19:Consumer[mut Frame]{::
  .title "Gui19: tabs, the x asks to close a tab"
  .virtualPixelSpace(Width#600, Height#400)
  .content.border{::
    .background (Color.ghostWhite)
    .center.sections{:: .fill .tabs .onClose{s, n -> Block#(s.remove n, Void)}
      .section.label{:: .text "readme.txt" } .and.pane{:: .fill .background (Color.moonCheese) .label{:: .text "Click a tab to expand it, click it again to collapse it" }}
      .section.label{:: .text "main.fear" } .and.pane{:: .fill .background (Color.alienMint) .textArea{:: .width 400 .height 200 .text "A text area keeps its text while its tab is collapsed" }}
      .section.label{:: .text "notes" } .and.pane{:: .fill .background (Color.dustyRose) .label{:: .text "With every tab closed, the space below the row is empty" }}
      .expand 0
      }
    }
  }
Gui20:Consumer[mut Frame]{::
  .title "Gui20: sections in a column, more than one expanded"
  .virtualPixelSpace(Width#600, Height#400)
  .content.border{::
    .background (Color.ghostWhite)
    .center.split
      .pane{:: .fill .maxPerLine 1 .stackScroll(True) .background (Color.alienMint)
        .button{:: .text "Tile 1" }
        .button{:: .text "Tile 2" }
        }
      .and.sections{:: .fill .autoCollapse(False) .scroll(True)
        .section.pane{:: .label{:: .text "Output" } .button{:: .text "Clear" } .pack} .and.pane{:: .textArea{:: .width 400 .height 150 .text "The button in the title has no action: a click on it expands or collapses Output" }}
        .section.label{:: .text "Extensions" } .and.pane{:: .maxPerLine 1 .label{:: .text "extension a" } .label{:: .text "extension b" } .pack}
        .section.pane{:: .tooltip "The links of this project" .label{:: .text "Links" }} .and.pane{:: .maxPerLine 1 .textField{:: .width 300 .height 30 .text "link one" } .textField{:: .width 300 .height 30 .text "link two" } .pack}
        .section.label{:: .text "Logs" } .and.pane{:: .maxPerLine 1 .label{:: .text "log 1" } .label{:: .text "log 2" } .label{:: .text "log 3" } .pack}
        .expand 0 .expand 1
        }
      .with{:: .fill .dividerPosition 140}
    }
  }
