Gui11:Consumer[mut Frame]{f -> f
  .title "Gui11: north border wraps when narrowed"
  .virtualPixelSpace(Width#400, Height#300)
  .onResize{r -> Block#(f.virtualPixelSpace(Width#((+300.0 * (r.aspectRatio)).softRound.getNat), Height#300), Void)}
  .content.border{::
    .background (Color.ghostWhite)
    .north.border{:: .fill
      .background (Color.rubberDuck)
      .center.pane{:: .fill
        .button{:: .text "Open file".action{Debug#"Open file pressed"} }
        .button{:: .text "Save file".action{Debug#"Save file pressed"} }
        .button{:: .text "Export as image".action{Debug#"Export as image pressed"} }
        .button{:: .text "Quit".action{Debug#"Quit pressed"} }
        }
      }
    .center.pane{:: .fill
      .background (Color.sleepyBlue)
      .label{:: .text "Narrow the window".foreground (Color.ghostWhite) }
      }
    }
  }

Gui12:Consumer[mut Frame]{::
  .title "Gui12: sizes and drawing beyond any screen"
  .virtualPixelSpace(Width#400, Height#300)
  .content.pane{::
    .paint{g -> g
      .color(Color.sleepyBlue)
      .position(X.origin, Y.origin)
      .rect(g.panelWidth, g.panelHeight)
      .color(Color.rubberDuck)
      .position(X#(-5000), Y#(+60))
      .rect(Width#5100, Height#40)
      .position(X#(-5000), Y#(-5000))
      .line(X#(+5000), Y#(+5000))
      }
    .label{:: .text "Blue fills the window at any size" .foreground(Color.ghostWhite) }
    .pane{:: .width 5000 .height 30 .background(Color.dangerTomato) }
    }
  }

