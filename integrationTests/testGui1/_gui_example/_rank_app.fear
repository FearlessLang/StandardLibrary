    .label{:: .uText ("".u "0645 0631 062D 0628 0627 0020 05E9 05DC 05D5 05DD 0020 0928 092E 0938 094D 0924 0947 0020 0E2A 0E27 0E31 0E2A 0E14 0E35") }
    .label{:: .uText ("".u "4F60 597D 4E16 754C 0020 3053 3093 306B 3061 306F 0020 D55C AD6D C5B4") }
    .label{:: .uText ("".u "2200 0078 2208 211D 003A 0020 2211 222B 0020 2192 0020 25A0 25B2 25CF 0020 2660 2665") }
    .label{:: .uText ("".u "1F600 0020 2764 FE0F 0020 1F468 200D 1F469 200D 1F467 0020 1F1F3 1F1FF 0020 1F44D 1F3FD").textHeight 32 }
    .label{:: .uText ("".u "1781 17D2 1789 17BB 17C6 0020 1019 103C 1014 103A 1019 102C 0020 0C95 0CA8 0CCD 0CA8 0CA1 0020 0628 0650 0633 0652 0645 0650").textHeight 32 .aboveBaseline(+1.25) .belowBaseline(0.75) .background (Color.rubberDuck) }
