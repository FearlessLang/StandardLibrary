TxtFile:{
  .path: Str;
  .diskPath: Str;
  .zipSteps: Str;
  .zipEntry: Str;
  .originalFileName: Str;

  .readStr(cap: mut CapAssetRead, cleaner: F[Str, mut StrCleaner]): Str ->
    cap.readStr(this.path,this.diskPath,this.zipSteps,this.zipEntry,cleaner);
  .readUStr(cap: mut CapAssetRead, cleaner: F[UStr, mut UStrCleaner]): UStr ->
    cap.readUStr(this.path,this.diskPath,this.zipSteps,this.zipEntry,cleaner);
  .consumeStr(requestId: Str, cleaner: F[Str, mut StrCleaner]): Str ->
    _TxtRead.consumeStr(requestId,this.path,this.diskPath,this.zipSteps,this.zipEntry,cleaner);
  .consumeUStr(requestId: Str, cleaner: F[UStr, mut UStrCleaner]): UStr ->
    _TxtRead.consumeUStr(requestId,this.path,this.diskPath,this.zipSteps,this.zipEntry,cleaner);
}
CapAssetRead: ToIso[CapAssetRead], WidenTo[CapAssetRead]{
  mut .readStr(path: Str,diskPath: Str,zipSteps: Str,zipEntry: Str,cleaner: F[Str, mut StrCleaner]): Str;
  mut .readUStr(path: Str,diskPath: Str,zipSteps: Str,zipEntry: Str,cleaner: F[UStr, mut UStrCleaner]): UStr;
  mut .readImage(path: Str,diskPath: Str,zipSteps: Str,zipEntry: Str,maxPixels: Nat): Image;
  }
_TxtRead:{
  .consumeStr(requestId: Str, path: Str,diskPath: Str,zipSteps: Str,zipEntry: Str,cleaner: F[Str, mut StrCleaner]): Str -> _Magic!;
  .consumeUStr(requestId: Str, path: Str,diskPath: Str,zipSteps: Str,zipEntry: Str,cleaner: F[UStr, mut UStrCleaner]): UStr -> _Magic!;
  }
_ImageRead:{
  .consumeImage(requestId: Str, path: Str,diskPath: Str,zipSteps: Str,zipEntry: Str,maxPixels: Nat): Image -> _Magic!;
  }

ImageFile:{
  .path: Str;
  .diskPath: Str;
  .zipSteps: Str;
  .zipEntry: Str;
  .originalFileName: Str;
  .readImage(cap: mut CapAssetRead, maxPixels: Nat): Image ->
    cap.readImage(this.path,this.diskPath,this.zipSteps,this.zipEntry,maxPixels);
  .consumeImage(requestId: Str, maxPixels: Nat): Image ->
    _ImageRead.consumeImage(requestId,this.path,this.diskPath,this.zipSteps,this.zipEntry,maxPixels);
  .consumeImage(requestId: Str): Image -> this.consumeImage(requestId, Math.maxNat);
  }
Image:{
  read .width: WidthNat;
  read .height: HeightNat;
  .scale(width: WidthNat, height: HeightNat): Image;
  .scaleToWidth'(width: WidthNat): Image;
  .scaleToHeight'(height: HeightNat): Image;
  .scaleToWidth(width: Nat): Image -> this.scaleToWidth'(WidthNat#width);
  .scaleToHeight(height: Nat): Image -> this.scaleToHeight'(HeightNat#height);
  ///A copy of this image with ``painter`` drawn over it, by the `Graphics` that paints a widget.
  ///Here ``.panelWidth`` and ``.panelHeight`` are the size of this image, and ``.elapsed`` is ``Instant.origin``.
  ///The color starts as opaque black, and the position at (0, 0).
  ///What ``painter`` draws past the edges of this image is clipped, with a warning, as for the painter of a widget.
  .paint(painter: Painter): Image;
  ///The color of the pixel at (``x``, ``y``) of this image; (0, 0) is the top left pixel.
  ///``x`` is between 0 and ``.width`` - 1, and ``y`` is between 0 and ``.height`` - 1.
  read .color(x: XInt, y: YInt): Color;
  }
///``Images#(width, height, background)`` is a builder of images of ``width`` x ``height`` pixels, each of the color ``background``.
///Each side is between 1 and 32767, and the image has at most 268435456 pixels.
Images:{ #(width: WidthNat, height: HeightNat, background: Color): ImageBuilder -> _Magic!; }
///An `ImageBuilder` holds no pixels: each `.paint` makes the pixels of one image.
ImageBuilder:{
  ///An image of the size of this builder, each pixel of its background color, with ``painter`` drawn over it as `Image.paint` draws.
  .paint(painter: Painter): Image;
  }