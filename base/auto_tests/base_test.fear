_Str_Examples: Test {::
  .test Test{::
  .check{"aaaa".count "aa" .assertEq 2}
  .check{"abc".count "" .assertEq 3}
  .check{"abc".count "d" .assertEq 0}
  }
  .test Test{::
  .check{"abc".endsWith "bc" .assertTrue}
  .check{"abc".endsWith "ab" .assertFalse}
  }
  .test Test{::
  .check{"aaa".indicesOf "aa" .list .assertEq({::}, Lists#(0, 1))}
  .check{"ab".indicesOf "" .list .assertEq({::}, Lists#(0, 1, 2))}
  .check{"ab".indicesOf "c" .list .assertEq({::}, List[Nat])}
  }
  .test Test{::
  .check{"abab".lastIndexOf "ab" .assertEq({::}, Opts# 2)}
  .check{"abab".lastIndexOf "" .assertEq({::}, Opts# 4)}
  .check{"abab".lastIndexOf "c" .assertEmpty{::}}
  }
  .test Test{::
  .check{"a,b,,c,".split "," .assertEq({::}, Lists#("a", "b", "", "c", ""))}
  .check{"abc".split "," .assertEq({::}, Lists#"abc")}
  .checkDetErr({::.isMsg{::.startsWith "Str.split:"}}, {"abc".split ""})
  }
  .test Test{::
  .check{" a b ".trim .assertEq "a b"}
  }
  .test Test{::
  .check{("True".tryGetBool).ok.assertEq({::}, Opts# True)}
  .check{"maybe".tryGetBool .assertInfo{::.isMsg{::.startsWith "Str.getBool:"}}}
  }
  .test Test{::
  .check{("42".tryGetByte).ok.assertEq({::}, Opts#(42.getByte))}
  .check{"300".tryGetByte .assertInfo{::.isMsg{::.startsWith "Str.getByte:"}}}
  }
  .test Test{::
  .check{("1.5".tryGetFloat).ok.assertEq({::}, Opts# 1.5)}
  .check{"nope".tryGetFloat .assertInfo{::.isMsg{::.startsWith "Str.getFloat:"}}}
  }
  .test Test{::
  .check{("1.5".tryGetIeeeFloat).ok.assertEq({::}, Opts# 1.5)}
  .check{"nope".tryGetIeeeFloat .assertInfo{::.isMsg{::.startsWith "Str.getIeeeFloat:"}}}
  }
  .test Test{::
  .check{("+42".tryGetInt).ok.assertEq({::}, Opts# +42)}
  .check{"nope".tryGetInt .assertInfo{::.isMsg{::.startsWith "Str.getInt:"}}}
  }
  .test Test{::
  .check{("42".tryGetNat).ok.assertEq({::}, Opts# 42)}
  .check{"nope".tryGetNat .assertInfo{::.isMsg{::.startsWith "Str.getNat:"}}}
  .check{("18_446_744_073_709_551_615".tryGetNat).ok.assertEq({::}, Opts# 18_446_744_073_709_551_615)}
  .check{"18_446_744_073_709_551_616".tryGetNat .assertInfo{::.isMsg{::.startsWith "Str.getNat:"}}}
  }
  .test Test{::
  .check{("1/2".tryGetNum).ok.assertEq({::}, Opts#(1/2))}
  .check{"nope".tryGetNum .assertInfo{::.isMsg{::.startsWith "Str.getNum:"}}}
  }
  .test Test{::
  .check{("1.5".tryGetSoftFloat).ok.assertEq({::}, Opts# 1.5)}
  .check{"nope".tryGetSoftFloat .assertInfo{::.isMsg{::.startsWith "Str.getSoftFloat:"}}}
  }
  .test Test{::
  .check{"a" ^ "b" .assertEq `a"b`}
  }
  }

_TriFlow_Examples_3: Test {::
  .test Test{::
  .check{Flows#(10, 20).with(Flows#(1, 2)).with(Flows#(100, 200)).enumerate.getMerge{i, a, b, c -> i + a + b + c}.list .assertEq({::}, Lists#(111, 223))}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10, 20)).with(Flows#(100, 200)).getFold({0}, {acc, a, b, c -> acc + a + b + c}) .assertEq 333}
  }
  .test Test{::
  .checkDetErr({::.isMsg{:: == "TriFlow.getMerge: the channels have different sizes, 2, 1 and 2"}}, {Flows#(1, 2).with(Flows#(10)).with(Flows#(1, 2)).getMerge{a, b, c -> a + b + c}})
  }
  }

_UStr_Examples: Test {::
  .test Test{::
  .check{("hi".u.tryGetStr).ok.assertEq({::}, Opts# "hi")}
  .check{"a".u("00E9").tryGetStr .assertInfo{::.isMsg{::.startsWith "UStr.getStr:"}}}
  }
  .test Test{::
  .check{"a".u("00E9").utf16Be .assertEq({::}, Lists#(0.getByte, 97.getByte, 0.getByte, 233.getByte))}
  }
  .test Test{::
  .check{"a".u("1F600").utf16Le .assertEq({::}, Lists#(97.getByte, 0.getByte, 61.getByte, 216.getByte, 0.getByte, 222.getByte))}
  }
  .test Test{::
  .check{"a".u.utf32Be .assertEq({::}, Lists#(0.getByte, 0.getByte, 0.getByte, 97.getByte))}
  }
  .test Test{::
  .check{"a".u.utf32Le .assertEq({::}, Lists#(97.getByte, 0.getByte, 0.getByte, 0.getByte))}
  }
  .test Test{::
  .check{"a".u("00E9").utf8 .assertEq({::}, Lists#(97.getByte, 195.getByte, 169.getByte))}
  }
  }

__EditableList_Examples_2: Test {::
  .test Test{::
.check{ELists#(2, 4).all{e -> (e.getRem 2) == 0} .assertTrue}
.check{ELists#(2, 3).all{e -> (e.getRem 2) == 0} .assertFalse}
.check{ELists#[Nat].all{_ -> False} .assertTrue}
  }
  .test Test{::
.check{ELists#(1, 4).any{e -> (e.getRem 2) == 0} .assertTrue}
.check{ELists#(1, 3).any{e -> (e.getRem 2) == 0} .assertFalse}
.check{ELists#[Nat].any{_ -> True} .assertFalse}
  }
  .test Test{::
.check{ELists#(1, 2, 3, 4).firstIndexWhere{e -> (e.getRem 2) == 0} .assertEq({::}, Opts# 1)}
.check{ELists#(1, 3).firstIndexWhere{e -> (e.getRem 2) == 0} .assertEmpty{::}}
  }
  .test Test{::
.check{ELists#(1, 2, 3, 4).indicesWhere{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 3))}
  }
  .test Test{::
.check{ELists#(1, 2, 3, 4).lastIndexWhere{e -> (e.getRem 2) == 0} .assertEq({::}, Opts# 3)}
  }
  .test Test{::
.check{ELists#(1, 2, 3).mapInPlace{e -> e * 10}.list .assertEq({::}, Lists#(10, 20, 30))}
  }
  .test Test{::
.check{ELists#(1, 3).none{e -> (e.getRem 2) == 0} .assertTrue}
.check{ELists#(1, 4).none{e -> (e.getRem 2) == 0} .assertFalse}
  }
  .test Test{::
.check{Block#
  .let l={ELists#(1, 2)}
  .let c={l.shallowClone}
  .do{l.add(3).void}
  .return{c.list .assertEq({::}, Lists#(1, 2))}}
  }
  }

__List_Examples_1: Test {::
  .test Test{::
  .check{(Lists#(1,2,3).tryGet 1).ok.assertEq({::}, Opts# 2)}
  .check{Lists#(1,2,3).tryGet 5 .assertInfo{::.isMsg{::.startsWith "List.get:"}}}
  }
  .test Test{::
  .check{(Lists#(1,2,3).tryGetFirst).ok.assertEq({::}, Opts# 1)}
  .check{List[Nat].tryGetFirst .assertInfo{::.isMsg{::.startsWith "List.getFirst:"}}}
  }
  .test Test{::
  .check{(Lists#(1,2,3).tryGetLast).ok.assertEq({::}, Opts# 3)}
  .check{List[Nat].tryGetLast .assertInfo{::.isMsg{::.startsWith "List.getLast:"}}}
  }
  }

