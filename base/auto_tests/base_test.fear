  }
  .test Test{::
  .check{Flows#(1).withAll(Flows#(10).with(Flows#(100)).with(Flows#(1000))).getMerge{a, b, c, d -> a + b + c + d}.list .assertEq({::}, Lists#(1111))}
  }
  .test Test{::
  .check{Flows#(1).withBoth(Flows#(10).with(Flows#(100))).getMerge{a, b, c -> a + b + c}.list .assertEq({::}, Lists#(111))}
  }
  }

