_BiFlow_Examples_2: Test {::
  .test Test{::
  .check{Flows#(1, 2, 3).with(Flows#(10)).cutToSmallest.getMerge{a, b -> a + b}.list .assertEq({::}, Lists#(11))}
  }
  .test Test{::
  .check{Flows#(10, 20).with(Flows#(1, 2)).enumerate.getMerge{i, a, b -> i + a + b}.list .assertEq({::}, Lists#(11, 23))}
  }
  .test Test{::
  .check{Flows#(1).with(Flows#(10, 20)).fillA{i -> i * 100}.getMerge{a, b -> a + b}.list .assertEq({::}, Lists#(11, 120))}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10)).fillB{i -> i * 100}.getMerge{a, b -> a + b}.list .assertEq({::}, Lists#(11, 102))}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10, 20)).fold({0}, {acc, a, b -> acc + a + b}) .assertEq({::}, Opts# 33)}
  .check{Flows#(1, 2).with(Flows#(10)).fold({0}, {acc, a, b -> acc + a + b}) .assertEmpty{::}}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10)).foldOpts({0}, {acc, a, b -> acc + (a.orValue 0) + (b.orValue 0)}) .assertEq 13}
  }
  .test Test{::
  .check{Flows#(1, 2, 3).with(Flows#(10)).foldOptsUntil({0}, {acc, a, b -> acc + (a.orValue 0) + (b.orValue 0)}, {acc -> acc > 11}) .assertEq 13}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10, 20)).getFold({0}, {acc, a, b -> acc + a + b}) .assertEq 33}
  .checkDetErr({::.isMsg{:: == "BiFlow.getFold: the channels have different sizes, 1 and 2"}}, {Flows#(1).with(Flows#(10, 20)).getFold({0}, {acc, a, b -> acc + a + b})})
  }
  .test Test{::
  .check{Flows#(1, 2, 3).with(Flows#(10, 20, 30)).getFoldUntil({0}, {acc, a, b -> acc + a + b}, {acc -> acc > 10}) .assertEq 11}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10, 20)).getMerge{a, b -> a + b}.list .assertEq({::}, Lists#(11, 22))}
  .checkDetErr({::.isMsg{:: == "BiFlow.getMerge: the channels have different sizes, 2 and 1"}}, {Flows#(1, 2).with(Flows#(10)).getMerge{a, b -> a + b}})
  }
  .test Test{::
  .check{Flows#(1, 2, 3).with(Flows#(10, 20)).limit 1 .getMerge{a, b -> a + b}.list .assertEq({::}, Lists#(11))}
  .checkDetErr({::.isMsg{::.startsWith "BiFlow.limit: .limit 0"}}, {Flows#(1).with(Flows#(10)).limit 0})
  }
  .test Test{::
  .check{Flows#("a", "b").with(Flows#(1, 2)).mapping({::}, {.key k, _ -> k; .elem _, e -> e}).get "b" .assertEq 2}
  .checkDetErr({::.isMsg{:: == "BiFlow.mapping: two pairs have the same key"}}, {Flows#("a", "a").with(Flows#(1, 2)).mapping({::}, {.key k, _ -> k; .elem _, e -> e})})
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10, 20)).merge{a, b -> a + b}!.list .assertEq({::}, Lists#(11, 22))}
  .check{Flows#(1, 2).with(Flows#(10)).merge{a, b -> a + b}.isEmpty .assertTrue}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10)).mergeOpts{a, b -> a.orValue 0 + (b.orValue 0)}.list .assertEq({::}, Lists#(11, 2))}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10)).tryGetMerge{a, b -> a + b}.assertInfo{::.isMsg{::.startsWith "BiFlow.getMerge:"}}}
  }
  .test Test{::
  .check{Flows#(1, 2).with(Flows#(10, 20)).with(Flows#(100, 200)).getMerge{a, b, c -> a + b + c}.list .assertEq({::}, Lists#(111, 222))}
  }
  .test Test{::
  .check{Flows#(1).with(Flows#(10)).withBoth(Flows#(100).with(Flows#(1000))).getMerge{a, b, c, d -> a + b + c + d}.list .assertEq({::}, Lists#(1111))}
  }
  }

_Byte_Examples: Test {::
  .test Test{::
  .check{2.getByte ** (6.getByte) .assertEq(64.getByte)}
  .checkNonDetErr({::}, {2.getByte ** (8.getByte)})
  }
  .test Test{::
  .check{10.getByte * (5.getByte) .assertEq(50.getByte)}
  .checkNonDetErr({::}, {100.getByte * (3.getByte)})
  }
  .test Test{::
  .check{(2.getByte + (3.getByte)) .assertEq(5.getByte)}
  .checkNonDetErr({::}, {(255.getByte) + (1.getByte)})
  }
  .test Test{::
  .check{5.getByte - (3.getByte) .assertEq(2.getByte)}
  .checkNonDetErr({::}, {0.getByte - (1.getByte)})
  }
  .test Test{::
  .check{250.getByte .aluAddWrap(10.getByte) .assertEq(4.getByte)}
  }
  .test Test{::
  .check{5.getByte .aluAnd(3.getByte) .assertEq(1.getByte)}
  }
  .test Test{::
  .check{7.getByte .aluDiv(2.getByte) .assertEq(3.getByte)}
  .checkDetErr({::}, {(7.getByte) .aluDiv(0.getByte)})
  }
  .test Test{::
  .check{(200.getByte) .aluMulWrap(2.getByte) .assertEq(144.getByte)}
  }
  .test Test{::
  .check{(5.getByte) .aluOr(2.getByte) .assertEq(7.getByte)}
  }
  .test Test{::
  .check{7.getByte .aluRem(2.getByte) .assertEq(1.getByte)}
  .checkDetErr({::}, {7.getByte .aluRem(0.getByte)})
  }
  .test Test{::
  .check{1.getByte .aluShiftLeft 3 .assertEq(8.getByte)}
  .check{1.getByte .aluShiftLeft 8 .assertEq(1.getByte)}
  }
  .test Test{::
  .check{8.getByte .aluShiftRight 3 .assertEq(1.getByte)}
  }
  .test Test{::
  .check{1.getByte .aluSubWrap(2.getByte) .assertEq(255.getByte)}
  }
  .test Test{::
  .check{5.getByte .aluXor(3.getByte) .assertEq(6.getByte)}
  }
  .test Test{::
  .check{2.getByte .assertInRange(1.getByte=~~=(4.getByte))}
  .checkNonDetErr({::}, {5.getByte .assertInRange(1.getByte=~~=(4.getByte))})
  }
  .test Test{::
  .check{0.getByte .clampTo(1.getByte=~~=(4.getByte)) .assertEq(1.getByte)}
  .check{9.getByte .clampTo(1.getByte=~~=(4.getByte)) .assertEq(4.getByte)}
  }
  .test Test{::
  .check{6.getByte .div(2) .assertEq({::}, Opts#(3.getByte))}
  .check{7.getByte .div(2) .assertEmpty {::}}
  .check{7.getByte .div(0) .assertEmpty {::}}
  }
  .test Test{::
  .check{200.getByte .float .assertEq 200.0}
  }
  .test Test{::
  .check{(6.getByte) .getDiv 2 .assertEq(3.getByte)}
  .checkDetErr({::}, {7.getByte .getDiv 3})
  .checkDetErr({::}, {7.getByte .getDiv 0})
  }
  .test Test{::
  .check{7.getByte .getRem 2 .assertEq(1.getByte)}
  .checkDetErr({::}, {7.getByte .getRem 0})
  }
  .test Test{::
  .check{(7.getByte) .getTruncDiv 2 .assertEq(3.getByte)}
  .checkDetErr({::}, {7.getByte .getDiv 0})
  }
  .test Test{::
  .check{2.getByte .inRange(1.getByte=~~=(4.getByte)) .assertTrue}
  .check{5.getByte .inRange(1.getByte=~~=(4.getByte)) .assertFalse}
  }
  .test Test{::
  .check{Math.maxByte .int .assertEq +255}
  }
  .test Test{::
  .check{Math.maxByte .nat .assertEq 255}
  }
  .test Test{::
  .check{200.getByte .num .assertEq(200 / 1)}
  }
  .test Test{::
  .check{5.getByte .pred .assertEq(4.getByte)}
  .checkNonDetErr({::}, {(0.getByte) .pred})
  }
  .test Test{::
  .check{7.getByte .rem 2 .assertEq({::}, Opts# (1.getByte))}
  .check{7.getByte .rem 0 .assertEmpty {::}}
  }
  .test Test{::
  .check{9.getByte .softSqrt .assertEq 3.0}
  .check{0.getByte .softSqrt .assertEq 0.0}
  }
  .test Test{::
  .check{5.getByte .succ .assertEq(6.getByte)}
  .checkNonDetErr({::}, {(255.getByte) .succ})
  }
  .test Test{::
  .check{7.getByte .truncDiv 2 .assertEq({::}, Opts# (3.getByte))}
  .check{7.getByte .truncDiv 0 .assertEmpty {::}}
  }
  .test Test{::
  .check{(6.getByte .tryGetDiv 2).ok.assertEq({::}, Opts#(3.getByte))}
  .check{7.getByte .tryGetDiv 3 .assertInfo{::.isMsg{::.startsWith "Byte.getDiv:"}}}
  }
  .test Test{::
  .check{(7.getByte .tryGetRem 2).ok.assertEq({::}, Opts#(1.getByte))}
  .check{7.getByte .tryGetRem 0 .assertInfo{::.isMsg{::.startsWith "Byte.getRem:"}}}
  }
  .test Test{::
  .check{(7.getByte .tryGetTruncDiv 2).ok.assertEq({::}, Opts#(3.getByte))}
  .check{7.getByte .tryGetTruncDiv 0 .assertInfo{::.isMsg{::.startsWith "Byte.getTruncDiv:"}}}
  }
  .test Test{::
  .check{7.getByte / 2 .getFloat .assertEq 3.5}
  .checkDetErr({:: .isMsg{::.startsWith("Byte/: ")}}, {7.getByte / 0})
  }
  .test Test{::
  .check{1.getByte=~~(4.getByte).list .assertEq({::}, Lists#(1.getByte, 2.getByte, 3.getByte))}
  .checkDetErr({::}, {(1.getByte)=~~(1.getByte)})
  }
  .test Test{::
  .check{1.getByte=~~=(4.getByte) .list .assertEq({::}, Lists#(1.getByte, 2.getByte, 3.getByte, 4.getByte))}
  .checkDetErr({::}, {(4.getByte)=~~=(1.getByte)})
  }
  .test Test{::
  .check{1.getByte~~(4.getByte) .list .assertEq({::}, Lists#(2.getByte, 3.getByte))}
  .checkDetErr({::}, {(1.getByte)~~(2.getByte)})
  }
  .test Test{::
  .check{1.getByte~~=(4.getByte) .list .assertEq({::}, Lists#(2.getByte, 3.getByte, 4.getByte))}
  .checkDetErr({::}, {1.getByte~~=(1.getByte)})
  }
  }

_Degree_Examples: Test {::
  .test Test{::
  .check{ -45.0.getDeg.normalize .assertEq(315.0.getDeg) }
  .check{ 40.0.getDeg.normalize .assertEq(40.0.getDeg) }
  }
  }

_EList_Examples_1: Test {::
  .test Test{::
.check{ELists#(1,2,3,4,5).accumulateInPlace{acc, e -> acc + e}.list.assertEq({::}, Lists#(1, 3, 6, 10, 15))}
  }
  .test Test{::
.check{ELists#(1,2,3,4,5).accumulateRightInPlace{acc, e -> acc + e}.list.assertEq({::}, Lists#(15, 14, 12, 9, 5))}
  }
  .test Test{::
.check{ELists#[Nat].add(1).add(2).list .assertEq({::}, Lists#(1, 2))}
  }
  .test Test{::
.check{Block#
  .let l={ELists#[Nat] 3}
  .do{l.addAll(ELists#(1,2,3,4)).size .assertEq 5}
  .do{l.list .assertEq({::}, Lists#(3,1,2,3,4))}
  .done}
  }
  .test Test{::
.check{Flows#(1,2,3,4).eList.addFirst(0).list.assertEq({::}, Lists#(0,1,2,3,4))}
.check{ELists#[Nat].addFirst(0).list.assertEq({::}, Lists#(0))}
  }
  .test Test{::
.check{ELists#(1, 2, 3).clear.isEmpty .assertTrue}
  }
  .test Test{::
.check{ELists#(-2,+1,-1,-3,+2,-1).distinct{::.imm.abs}.list.assertEq({::}, Lists#(-2,+1,-3))}
  }
  .test Test{::
.check{Block#
  .let elist={ELists#(1,2,3,4,5)}
  .do{elist.eView(1, 4).list .assertEq({::}, Lists#(2,3,4))}
  .do{elist.list.assertEq({::}, Lists#(1,5))}
  .done}
.check{Block#
  .let elist={ELists#(1,2,3)}
  .do{elist.eView(1, 3).set(0, 9).void}
  .do{elist.eView(3, 3).add(4).void}
  .return{elist.list.assertEq({::}, Lists#(1,9,3,4))}}
.checkDetErr({::.isMsg{:: == "EList.eView: Index 4 out of bounds for EList of length 3"}}, {ELists#(1,2,3).eView(1, 4)})
  }
  .test Test{::
.check{ELists#(1,2).expandCapacity(100).add(3).list .assertEq({::}, Lists#(1,2,3))}
  }
  .test Test{::
.check{Flows#(1,2,3).eList.first .assertEq({::}, Opts# 1)}
.check{ELists#[Nat] .first .assertEmpty {::}}
  }
  .test Test{::
.check{Block#
  .let[mut EList[Nat]] elist={ELists#(1,2,3,4)}
  .do{elist.flow(ParImm#).list .assertEq({::}, Lists#(1,2,3,4))}
  .do{elist.isEmpty.assertTrue}.done}
  }
  .test Test{::
.check{Block#
  .let l={ELists#(1,2,3,4,5)}
  .do{l.fold({0}, {a,_,b -> a+b}) .assertEq 15}
  .do{l.fold({1}, {a,_,b -> a*b}) .assertEq 120}
  .done}
  }
  .test Test{::
.check{Block#
  .let l={ELists#(1,2,3,4,5)}
  .do{l.foldRight({List[Nat]}, {a,_,b -> a +> b}) .assertEq({::}, Lists#(5,4,3,2,1))}
  .do{l.foldRight({1}, {a,_,b -> a*b}) .assertEq 120}
  .done}
  }
  .test Test{::
.check{ELists#(1,2,3,4,5).foldRightUntil({0}, {a,_,b -> a+b}, {a -> a >= 9}) .assertEq 9}
  }
  .test Test{::
.check{Block#
  .let l={ELists#(1,2,3,4,5)}
  .do{l.foldUntil({0}, {a,_,b -> a+b}, {a -> a >= 10}) .assertEq 10}
  .do{l.foldUntil({1}, {a,_,b -> a*b}, {a -> a >= 100}) .assertEq 120}
  .done}
  }
  .test Test{::
.check{ELists# 1 .get(0) .assertEq 1}
.checkDetErr({::.isMsg{:: == "EList.get: Index 1 out of bounds for EList of length 1"}}, {ELists# 1 .get(1)})
  }
  .test Test{::
.check{ELists#(1,2,3).getFirst .assertEq 1}
.checkDetErr({::.isMsg{::.startsWith "EList.getFirst:"}}, {ELists#[Nat] .getFirst})
  }
  .test Test{::
.check{ELists#(1,2,3).getLast .assertEq 3}
.checkDetErr({::.isMsg{::.startsWith "EList.getLast:"}}, {ELists#[Nat] .getLast})
  }
  .test Test{::
.check{Flows#(1,2,3,4).eList.insertBefore(1, 0).list.assertEq({::}, Lists#(1,0,2,3,4))}
.check{ELists#(1,2).insertBefore(2, 0).list.assertEq({::}, Lists#(1,2,0))}
.checkDetErr({::.isMsg{:: == "EList.insertBefore: Index 3 out of bounds for EList of length 2"}}, {ELists#(1,2).insertBefore(3, 0)})
  }
  .test Test{::
.check{Block#
  .let l={ELists.withCapacity[Nat] 3}
  .do{l.isEmpty .assertTrue}
  .do{l.add(1).isEmpty .assertFalse}
  .done}
  }
  .test Test{::
.check{Flows#(1,2,3).eList.last .assertEq({::}, Opts#(3))}
.check{ELists.withCapacity[Nat] 3 .last .assertEmpty {::}}
  }
  .test Test{::
.check{Block#
  .let elist ={ELists#(1,2,3,4)}
  .do{elist.list .assertEq({::}, Lists#(1,2,3,4))}
  .do{elist.isEmpty.assertTrue}.done}
  }
  .test Test{::
.check{Block#
  .let l={ELists.withCapacity[Nat] 3}
  .do{l.notEmpty .assertFalse}
  .do{l.add(1).notEmpty .assertTrue}
  .done}
  }
  .test Test{::
.check{ELists# 1 .opt(0) .assertEq({::}, Opts# 1)}
.check{ELists# 1 .opt(1) .assertEmpty{::}}
  }
  .test Test{::
.check{ELists#(1, 2, 3).remove(0).list .assertEq({::}, Lists#(2, 3))}
.checkDetErr({::.isMsg{:: == "EList.remove: Index 3 out of bounds for EList of length 3"}}, {ELists#(1, 2, 3).remove(3)})
  }
  .test Test{::
.check{ELists#(0, 1, 2, 3, 4).removeAll(ELists#(3, 0)).list .assertEq({::}, Lists#(1, 2, 4))}
.checkDetErr({::.isMsg{::.startsWith "EList.removeAll: Index 1 is present twice"}}, {ELists#(0, 1, 2).removeAll(ELists#(1, 1))})
  }
  .test Test{::
.check{ELists#(1, 2, 3, 4).removeFirstWhere{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 3, 4))}
  }
  .test Test{::
.check{ELists#(1, 2, 3, 4).removeIf{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 3))}
  }
  .test Test{::
.check{ELists#(1, 2, 3, 4).removeLastWhere{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 2, 3))}
.check{ELists#(1, 3).removeLastWhere{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 3))}
  }
  .test Test{::
.check{ELists#(1, 2, 3, 4).retainIf{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(2, 4))}
  }
  .test Test{::
.check{ELists#(1, 2, 3).reverse.list .assertEq({::}, Lists#(3, 2, 1))}
  }
  .test Test{::
.check{Block#
  .let elist ={ELists#(1,2,3,4)}
  .do{elist.seqFlow.list .assertEq({::}, Lists#(1,2,3,4))}
  .do{elist.isEmpty.assertTrue}.done}
  }
  .test Test{::
.check{ELists#(1, 2, 3).set(1, 9).list .assertEq({::}, Lists#(1, 9, 3))}
.checkDetErr({::.isMsg{:: == "EList.set: Index 3 out of bounds for EList of length 3"}}, {ELists#(1, 2, 3).set(3, 9)})
  }
  .test Test{::
.check{Block#
  .let l={ELists.withCapacity[Nat] 3}
  .do{l.size .assertEq 0}
  .do{l.add(1).size .assertEq 1}
  .done}
  }
  .test Test{::
.check{ELists#(1,2,3,4).sort{::.imm.getInt * -1}.list.assertEq({::}, Lists#(4,3,2,1))}
  }
  .test Test{::
.check{ELists#(3,1,2,1,3).sortDistinct{::}.list.assertEq({::}, Lists#(1,2,3))}
  }
  .test Test{::
.check{ELists#(1, 2, 3).swap(0, 2).list .assertEq({::}, Lists#(3, 2, 1))}
.checkDetErr({::.isMsg{:: == "EList.swap: Index 5 out of bounds for EList of length 3"}}, {ELists#(1, 2, 3).swap(0, 5)})
  }
  .test Test{::
.check{ELists#(0, 1, 2, 3, 4).trimTo(1, 3).list .assertEq({::}, Lists#(1, 2))}
.check{ELists#(0, 1, 2).trimTo(3, 3).list .assertEq({::}, List[Nat])}
.checkDetErr({::.isMsg{::.startsWith "EList.trimTo:"}}, {ELists#(0, 1, 2).trimTo(2, 1)})
  }
  .test Test{::
.check{ELists#(1,2,3,4,5).trimToSize.size .assertEq 5}
  }
  .test Test{::
  .check{(ELists#[Nat].add(4).tryGet 0).ok.assertEq({::}, Opts# 4)}
  .check{ELists#[Nat].tryGet 0 .assertInfo{::.isMsg{::.startsWith "EList.get:"}}}
  }
  .test Test{::
.check{ELists#[Nat] .tryGetFirst .assertInfo{::.isMsg{:: == "EList.getFirst: called on an empty EList"}}}
  }
  .test Test{::
.check{(ELists#(1,2,3).tryGetLast).ok .assertEq({::}, Opts# 3)}
  }
  }

_ELists_Examples: Test {::
  .test Test{::
  .check{ELists.withCapacity[Nat] 10 .isEmpty .assertTrue}
  .checkDetErr({::.isMsg{::.startsWith "ELists.withCapacity:"}}, {ELists.withCapacity[Nat] 2147483647})
  }
  }

_ESet_Examples_1: Test {::
  .test Test{::
  .check{ESets#{::}.add 1 .add 2 .add 3 .set.str .assertEq "{1, 2, 3}"}
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#[Nat, Nat]{::}.add(1).add(2)}
    .do{(eset.addAll(ESets#[Nat, Nat]{::}.add(2).add(3).add(4)).size == 4) .assertTrue}
    .done}
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#[Nat, Nat]{::}.add(1).add(2)}
    .do{eset.size .assertEq 2}
    .do{eset.clear.isEmpty .assertTrue}
    .do{eset.isEmpty .assertTrue}
    .done}
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#[Nat,Nat]{::}.add(1).add(2)}
    .do{eset.contains(1) .assertTrue}
    .do{eset.contains(3) .assertFalse}
    .done}
  }
  .test Test{::
  .check{ESets#[Nat,Nat]{::}.add(1).add(2).containsAll(ESets#{::}.add(1)) .assertTrue}
  .check{ESets#[Nat,Nat]{::}.add(1).add(2).containsAll(ESets#{::}.add(1).add(3)) .assertFalse}
  }
  .test Test{::
  .check{ESets#[Int, Int]{::}
    .add(+1).add(-2).add(+3)
    .distinctBy({::.imm.sign}).set.str{::} .assertEq "{-2, +1}"}
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#[Int, Int]{::}.add(+1).add(-2).add(+3)}
    .do{eset.flow.list.str{::} .assertEq "[+1, -2, +3]"}
    .do{eset.isEmpty .assertTrue}
    .done}
  }
  .test Test{::
  .check{Sets#({::.imm.abs}, +1, -2).get(-1) .assertEq +1}
  .checkDetErr({::}, {Sets#({::}, 1, 2).get(3)})
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#({::.imm.abs}).add(+1).add(-2)}
    .do{eset.getOrInsert(-1) .assertEq +1}
    .do{eset.getOrInsert(+3) .assertEq +3}
    .do{eset.size .assertEq 3}
    .done}
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#({::.imm.abs}).add(+1).add(-2)}
    .do{eset.getTake(-1) .assertEq +1}
    .do{eset.size .assertEq 1}
    .done}
  }
  .test Test{::
  .check{Block#
    .let s={ESets#[Nat, Nat]{::}}
    .do{s.isEmpty .assertTrue}
    .do{s.add(1).isEmpty .assertFalse}
    .done}
  }
  .test Test{::
  .check{Block#
    .let s={ESets#[Nat, Nat] {::}}
    .do{s.notEmpty .assertFalse}
    .do{s.add(1).notEmpty .assertTrue}
    .done}
  }
  .test Test{::
  .check{Sets#({::.imm.abs}, +1, -2).opt(-1)! .assertEq +1}
  .check{Sets#({::}, 1, 2).opt(3).isEmpty .assertTrue}
  }
  .test Test{::
  .check{ESets#{::} .add 2 .add 3 .remove 2 .remove 3 .isEmpty .assertTrue}
  .check{ESets#{::} .add 1 .remove 2 .contains 1 .assertTrue}
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#[Nat, Nat]{::}.add(1).add(2)}
    .do{(eset.removeAll(ESets#[Nat, Nat]{::}.add(2).add(3).add(4)).size == 1) .assertTrue}
    .done}
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#[Int, Int]{::}.add(+1).add(-2).add(+3)}
    .do{eset.set.str .assertEq "{-2, +1, +3}"}
    .do{eset.isEmpty .assertTrue}
    .done}
  }
  .test Test{::
  .check{ESets#[Nat, Nat]({::}).add(1).add(2).add(3).size .assertEq 3}
  .check{ESets#[Nat, Nat]({::}).size .assertEq 0}
  }
  .test Test{::
  .check{Block#
    .let eset={ESets#({::.imm.abs}).add(+1).add(-2)}
    .do{eset.take(-1)! .assertEq +1}
    .do{eset.take(-1).isEmpty .assertTrue}
    .do{eset.size .assertEq 1}
    .done}
  }
  .test Test{::
  .check{(ESets#[Nat,Nat]{::}.add(1).tryGet 1).ok.assertEq({::}, Opts# 1)}
  .check{ESets#[Nat,Nat]{::}.add(1).tryGet 3 .assertInfo{::.isMsg{::.startsWith "ESet.get:"}}}
  }
  .test Test{::
  .check{(ESets#[Nat,Nat]{::}.add(1).tryGetTake 1).ok.assertEq({::}, Opts# 1)}
  .check{ESets#[Nat,Nat]{::}.add(1).tryGetTake 3 .assertInfo{::.isMsg{::.startsWith "ESet.get:"}}}
  }
  }

_ESparseList_Examples_1: Test {::
  .test Test{::
.checkEq(3, {ESparseLists.backedWithArray[Nat] 3 .capacity})
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7).clear.numHoles .assertEq 2}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .set(0, 1).eList .isEmpty .assertTrue}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 1 .fillAndExpand(ELists#(4,5)).getEList.list
  .assertEq({::}, Lists#(4,5))}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 3 .set(1, 9).fillFrom(ELists#(4,5,6)).getEList.list
  .assertEq({::}, Lists#(4,9,5))}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 3 .set(1, 7).fillHoles{i -> i}.getEList.list
  .assertEq({::}, Lists#(0,7,2))}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 3 .set(0, 1).set(2, 3).flatSeqFlow.list
  .assertEq({::}, Lists#(1,3))}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7) .get 0 .assertEmpty {::}}
.check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7) .get 1 .assertEq({::}, Opts# 7)}
.checkDetErr({::.isMsg{:: == "ESparseList.get: Index 2 out of bounds for ESparseList of capacity 2"}}, {ESparseLists.backedWithArray[Nat] 2 .get 2})
  }
  .test Test{::
.check{Block#
  .let slist = {ESparseLists.backedWithArray[Nat] 3 .fillHoles {::}}
  .do{slist.getEList.list.assertEq({::}, Lists#(0,1,2))}
  .do{slist.isEmpty.assertTrue}.done}
.checkDetErr({::.isMsg{:: == "ESparseList.getEList: 2 of the 3 indices are holes; fill the holes first"}}, {ESparseLists.backedWithArray[Nat] 3 .set(0, 1).getEList})
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .set(0, 1).set(1, 2).getSeqFlow.list
  .assertEq({::}, Lists#(1,2))}
.checkDetErr({::.isMsg{:: == "ESparseList.getSeqFlow: 1 of the 2 indices are holes; fill the holes first"}}, {ESparseLists.backedWithArray[Nat] 2 .set(0, 1).getSeqFlow})
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .increaseCapacity 4 .capacity .assertEq 4}
.checkDetErr({::.isMsg{:: == "ESparseList.increaseCapacity: the capacity 2 is not greater than the current capacity 2"}}, {ESparseLists.backedWithArray[Nat] 2 .increaseCapacity 2})
  }
  .test Test{::
.checkTrue{ESparseLists.backedWithMap[Nat] 3 .isEmpty}
.checkFalse{ESparseLists.backedWithMap[Nat] 3 .set(0, 1).isEmpty}
  }
  .test Test{::
.checkTrue{ESparseLists.backedWithArray[Nat] 3 .set(0, 1).set(1, 2).set(2, 3).isFull}
.checkFalse{ESparseLists.backedWithArray[Nat] 3 .set(0, 1).set(2, 3).isFull}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 3 .set(0, 5).set(1, 6)
  .mapOpts{i, e -> (i == 0).if{ .then -> {}; .else -> Opts#(i)}}.flowOpts(ParImm#).map{o -> o.isSome}.list
  .assertEq({::}, Lists#(False, True, True))}
  }
  .test Test{::
.check{Block#
  .let list={ESparseLists.backedWithArray[Nat] 3}
  .do{list.numHoles.assertEq 3}
  .do{list.set(0, 1).numHoles.assertEq 2}
  .done}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .set(0, 6).set(1, 7).remove 0 .get 1 .assertEq({::}, Opts# 7)}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 3 .fillHoles{i -> i}.removeAll(ELists#(2, 0)).numHoles .assertEq 2}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 3 .fillHoles{i -> i}.removeIf{e -> e > 0}.flatSeqFlow.list .assertEq({::}, Lists#(0))}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 3 .set(0, 7).reverse.get 2 .assertEq({::}, Opts# 7)}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7).seqFlowOpts.map{o -> o.isSome}.list .assertEq({::}, Lists#(False, True))}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7).set(1, 8) .get 1 .assertEq({::}, Opts# 8)}
.checkDetErr({::.isMsg{:: == "ESparseList.set: Index 2 out of bounds for ESparseList of capacity 2"}}, {ESparseLists.backedWithArray[Nat] 2 .set(2, 7)})
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .softIncreaseCapacity 4 .capacity .assertEq 4}
.check{ESparseLists.backedWithArray[Nat] 4 .softIncreaseCapacity 2 .capacity .assertEq 4}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 2 .set(0, 7).swap(0, 1).get 0 .assertEmpty {::}}
  }
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 4 .set(2, 7).trimTo(1, 3).get 1 .assertEq({::}, Opts# 7)}
  }
  }

_ESparseLists_Examples: Test {::
  .test Test{::
.check{ESparseLists.backedWithArray[Nat] 3 .capacity .assertEq 3}
.checkDetErr({::.isMsg{::.startsWith "ESparseLists.backedWithArray:"}}, {ESparseLists.backedWithArray[Nat] 2147483647})
  }
  .test Test{::
.check{ESparseLists.backedWithMap[Nat](Math.maxNat).set(1000000000000, 7) .get(1000000000000) .assertEq({::}, Opts# 7)}
  }
  .test Test{::
.check{ESparseLists.backedWithSparseSegmentTree[Nat](Math.maxNat).set(1000000000000, 7).get(1000000000000) .assertEq({::}, Opts# 7)}
  }
  }

_ExtentNat_Examples_1: Test {::
  .test Test{::
  .check{((WidthNat#6).tryGetTruncDiv 2).assertOk}
  .check{(WidthNat#6).tryGetTruncDiv 0 .assertInfo{::.isMsg{::.startsWith "Nat.getTruncDiv:"}}}
  }
  }

_FilterAny_Examples: Test {::
  .test Test{::
  .check{FilterAny#(+5, {n -> n == +5}, {-1}) .assertEq +5}
  .check{FilterAny#(+3, {n -> n == +5}, {-1}) .assertEq -1}
  }
  }

_Float_Examples: Test {::
  .test Test{::
  .check{2.0 ** 3.0 .assertEq 8.0}
  .check{Math.nan ** 0.0 .isNaN .assertTrue} // not true of ieee
  .check{0.0 ** (Math.negZero) .isNaN .assertTrue}  // not true of ieee
  }
  .test Test{::
  .check{2.0 * 3.0 .assertEq 6.0}
  .check{0.0 * (Math.inf) .isNaN .assertTrue}
  }
  .test Test{::
  .check{2.0 + 3.0 .assertEq 5.0}
  .check{Math.inf + 1.0 .assertEq(Math.inf)}
  .check{Math.nan + 1.0 .isNaN .assertTrue}
  }
  .test Test{::
  .check{5.0 - 3.0 .assertEq 2.0}
  .check{Math.inf - (Math.inf) .isNaN .assertTrue}
  }
  .test Test{::
  .check{4.75 .abs .assertEq({::}, Opts# 4.75)}
  .check{-4.75 .abs .assertEq({::}, Opts# 4.75)}
  .check{Math.nan .abs .assertEmpty {::}}
  }
  .test Test{::
  .check{4.75 .absOrNaN .assertEq 4.75}
  .check{-4.75 .absOrNaN .assertEq 4.75}
  .check{Math.nan .absOrNaN .isNaN .assertTrue}
  }
  .test Test{::
  .check{2.0 .assertInRange(1.0=~~=4.0)}
  .checkNonDetErr({::}, {5.0 .assertInRange(1.0=~~=4.0)})
  }
  .test Test{::
  .check{3.0 .byte .assertEq({::}, Opts#(3.getByte))}
  .check{300.0 .byte .assertEmpty {::}}
  }
  .test Test{::
  .check{3.25 .ceil .assertEq({::}, Opts# 4.0)}
  .check{Math.negInf .ceil .assertEmpty {::}}
  .check{Math.nan .ceil .assertEmpty {::}}
  }
  .test Test{::
  .check{0.0 .clampTo(1.0=~~=4.0) .assertEq 1.0}
  .check{5.0 .clampTo(1.0=~~=4.0) .assertEq 4.0}
  .check{Math.nan .clampTo(1.0=~~=4.0) .assertEq 4.0}
  }
  .test Test{::
  .check{90.0 .deg .assertEq({::}, Opts#(90.0.getDeg))}
  .check{Math.nan .deg .assertEmpty {::}}
  .check{Math.inf .deg .assertEmpty {::}}
  }
  .test Test{::
  .check{4.75 .floor .assertEq({::}, Opts# 4.0)}
  .check{Math.inf .floor .assertEmpty {::}}
  .check{Math.nan .floor .assertEmpty {::}}
  }
  .test Test{::
  .check{4.75 .getAbs .assertEq 4.75}
  .check{-4.75 .getAbs .assertEq 4.75}
  .checkDetErr({::}, {Math.nan .getAbs})
  }
  .test Test{::
  .check{3.0 .getByte.nat .assertEq 3}
  .checkDetErr({::}, {300.0 .getByte})
  }
  .test Test{::
  .check{3.25 .getCeil .assertEq 4.0}
  .checkDetErr({::}, {Math.negInf .getCeil})
  .checkDetErr({::}, {Math.nan .getCeil})
  }
  .test Test{::
  .check{90.0 .getDeg# .assertEq(90.0)}
  .checkDetErr({::}, {(Math.inf) .getDeg})
  }
  .test Test{::
  .check{4.75 .getFloor .assertEq 4.0}
  .checkDetErr({::}, {(Math.inf) .getFloor})
  .checkDetErr({::}, {(Math.nan) .getFloor})
  }
  .test Test{::
  .check{3.0 .getInt .assertEq +3}
  .checkDetErr({::}, {3.5 .getInt})
  .checkDetErr({::}, {(Math.nan) .getInt})
  }
  .test Test{::
  .check{3.0 .getNat .assertEq 3}
  .checkDetErr({::}, {(-1.0) .getNat})
  }
  .test Test{::
  .check{4.75 .getNegAbs .assertEq(-4.75)}
  .checkDetErr({::}, {(Math.nan) .getNegAbs})
  }
  .test Test{::
  .check{3.5 .getNum .assertEq(7/2)}
  .checkDetErr({::}, {(Math.inf) .getNum})
  .checkDetErr({::}, {(Math.nan) .getNum})
  }
  .test Test{::
  .check{1.0 .getPred .assertLt 1.0}
  .check{0.0 .getPred .assertEq(Math.negZero.getPred)}
  .checkDetErr({::}, {Math.nan .getPred})
  .checkDetErr({::}, {Math.negInf .getPred})
  }
  .test Test{::
  .check{1.5 .getRad# .assertEq 1.5}
  .checkDetErr({::}, {(Math.nan) .getRad})
  }
  .test Test{::
  .check{-2.5 .getRound .assertEq(-3.0)}
  .checkDetErr({::}, {(Math.inf) .getRound})
  .checkDetErr({::}, {(Math.nan) .getRound})
  }
  .test Test{::
  .check{2.5 .getRoundTiesEven .assertEq 2.0}
  .checkDetErr({::}, {(Math.inf) .getRoundTiesEven})
  .checkDetErr({::}, {(Math.nan) .getRoundTiesEven})
  }
  .test Test{::
  .check{-4.75 .getSign .assertEq -1.0}
  .checkDetErr({::}, {Math.nan .getSign})
  }
  .test Test{::
  .check{4.0 .getSqrt .assertEq 2.0}
  .checkDetErr({::}, {-4.0 .getSqrt})
  .checkDetErr({::}, {Math.nan .getSqrt})
  }
  .test Test{::
  .check{1.0 .getSucc .assertGt 1.0}
  .check{Math.negZero .getSucc .assertEq(+0.0.getSucc)}
  .checkDetErr({::}, {Math.nan .getSucc})
  .checkDetErr({::}, {Math.inf .getSucc})
  }
  .test Test{::
  .check{-2.75 .getTrunc0 .assertEq -2.0}
  .checkDetErr({::}, {(Math.inf) .getTrunc0})
  .checkDetErr({::}, {(Math.nan) .getTrunc0})
  }
  .test Test{::
  .check{0.0 .hash .assertEq(Math.negZero .hash)}
  .check{Math.nan .hash .assertEq((Math.nan.negAbsOrNaN) .hash)}
  .check{1.0 .hash .assertNotEq(2.0 .hash)}
  }
  .test Test{::
  .check{Math.nan.ieeeEq(Math.nan).assertFalse}
  .check{+0.0 .ieeeEq(Math.negZero) .assertTrue}
  }
  .test Test{::
  .check{5.0 .ieeeRemainder 3.0 .assertEq -1.0}
  }
  .test Test{::
  .check{(0.0 .ieeeSameBits(Math.negZero)) .assertFalse}
  .check{(1.0 .ieeeSameBits 1.0) .assertTrue}
  }
  .test Test{::
  .check{1.5 .ieeeStr .assertEq "1.5"}
  .check{Math.nan .ieeeStr .assertEq `NaN`}
  .check{Math.inf .ieeeStr .assertEq `Infinity`}
  }
  .test Test{::
  .check{(2.0 .inRange(1.0=~~=4.0)) .assertTrue}
  .check{(5.0 .inRange(1.0=~~=4.0)) .assertFalse}
  }
  .test Test{::
  .check{3.0 .int .assertEq({::}, Opts# +3)}
  .check{3.5 .int .assertEmpty {::}}
  .check{Math.nan .int .assertEmpty {::}}
  }
  .test Test{::
  .check{1.0 .isFinite .assertTrue}
  .check{0.0 .isFinite .assertTrue}
  .check{Math.inf .isFinite .assertFalse}
  .check{Math.nan .isFinite .assertFalse}
  }
  .test Test{::
  .check{Math.inf .isInfinite .assertTrue}
  .check{Math.negInf .isInfinite .assertTrue}
  .check{1.0 .isInfinite .assertFalse}
  }
  .test Test{::
  .check{Math.nan .isNaN .assertTrue}
  .check{1.0 .isNaN .assertFalse}
  }
  .test Test{::
  .check{Math.negInf .isNegInfinity .assertTrue}
  .check{Math.inf .isNegInfinity .assertFalse}
  }
  .test Test{::
  .check{Math.negZero .isNegZero .assertTrue}
  .check{-0.0 .isNegZero .assertFalse}
  .check{0.0 .isNegZero .assertFalse}
  }
  .test Test{::
  .check{Math.inf .isPosInfinity .assertTrue}
  .check{Math.negInf .isPosInfinity .assertFalse}
  }
  .test Test{::
  .check{0.0 .isPosZero .assertTrue}
  .check{Math.negZero .isPosZero .assertFalse}
  }
  .test Test{::
  .check{(0.0 .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "pz"}
  .check{(3.5 .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "r"}
  .check{((Math.nan) .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "n"}
  }
  .test Test{::
  .check{3.0 .nat .assertEq({::}, Opts# 3)}
  .check{-1.0 .nat .assertEmpty {::}}
  }
  .test Test{::
  .check{4.75 .negAbs .assertEq({::}, Opts# -4.75)}
  .check{Math.nan .negAbs .assertEmpty {::}}
  }
  .test Test{::
  .check{4.75 .negAbsOrNaN .assertEq -4.75}
  .check{-4.75 .negAbsOrNaN .assertEq -4.75}
  .check{Math.nan .negAbsOrNaN .isNaN .assertTrue}
  }
  .test Test{::
  .check{3.5 .num .assertEq({::}, Opts#(7/2))}
  .check{Math.inf .num .assertEmpty {::}}
  }
  .test Test{::
  .check{1.5 .rad .assertEq({::}, Opts#(1.5.getRad))}
  .check{Math.nan .rad .assertEmpty {::}}
  }
  .test Test{::
  .check{2.5 .round .assertEq({::}, Opts# 3.0)}
  .check{-2.5 .round .assertEq({::}, Opts# (-3.0))}
  .check{Math.inf .round .assertEmpty {::}}
  .check{Math.nan .round .assertEmpty {::}}
  }
  .test Test{::
  .check{2.5 .roundTiesEven .assertEq({::}, Opts# 2.0)}
  .check{Math.inf .roundTiesEven .assertEmpty {::}}
  .check{Math.nan .roundTiesEven .assertEmpty {::}}
  }
  .test Test{::
  .check{4.75 .sign .assertEq({::}, Opts# 1.0)}
  .check{Math.nan .sign .assertEmpty {::}}
  }
  .test Test{::
  .check{4.75 .signOrNaN .assertEq 1.0}
  .check{-4.75 .signOrNaN .assertEq -1.0}
  .check{0.0 .signOrNaN .isPosZero .assertTrue}
  .check{Math.negZero .signOrNaN .isNegZero .assertTrue}
  .check{Math.nan .signOrNaN .isNaN .assertTrue}
  }
  .test Test{::
  .check{4.75 .softByte .assertEq(4.getByte)}
  .check{Math.inf .softByte .assertEq(Math.maxByte)}
  }
  .test Test{::
  .check{3.25 .softCeil .assertEq 4.0}
  .check{-4.75 .softCeil .assertEq -4.0}
  .check{Math.negInf .softCeil .assertEq(Math.negInf)}
  .check{Math.nan .softCeil .isNaN .assertTrue}
  }
  .test Test{::
  .check{4.75 .softFloor .assertEq 4.0}
  .check{-3.25 .softFloor .assertEq -4.0}
  .check{Math.inf .softFloor .assertEq(Math.inf)}
  .check{Math.nan .softFloor .isNaN .assertTrue}
  }
  .test Test{::
  .check{4.75 .softInt .assertEq +4}
  .check{Math.nan .softInt .assertEq +0}
  .check{Math.inf .softInt .assertEq(Math.maxInt)}
  }
  .test Test{::
  .check{4.75 .softNat .assertEq 4}
  .check{Math.negInf .softNat .assertEq 0}
  .check{Math.inf .softNat .assertEq(Math.maxNat)}
  }
  .test Test{::
  .check{2.5 .softRound .assertEq 3.0}
  .check{-2.5 .softRound .assertEq(-3.0)}
  .check{Math.inf .softRound .assertEq(Math.inf)}
  .check{Math.nan .softRound .isNaN .assertTrue}
  }
  .test Test{::
  .check{2.5 .softRoundTiesEven .assertEq 2.0}
  .check{3.5 .softRoundTiesEven .assertEq 4.0}
  .check{-2.5 .softRoundTiesEven .assertEq -2.0}
  .check{Math.inf .softRoundTiesEven .assertEq(Math.inf)}
  .check{Math.nan .softRoundTiesEven .isNaN .assertTrue}
  }
  .test Test{::
  .check{2.75 .softTrunc0 .assertEq 2.0}
  .check{-2.75 .softTrunc0 .assertEq -2.0}
  .check{Math.inf .softTrunc0 .assertEq(Math.inf)}
  .check{Math.nan .softTrunc0 .isNaN .assertTrue}
  }
  .test Test{::
  .check{4.0 .sqrt .assertEq({::}, Opts# 2.0)}
  .check{-4.0 .sqrt .assertEmpty {::}}
  .check{Math.nan .sqrt .assertEmpty {::}}
  }
  .test Test{::
  .check{4.0 .sqrtOrNaN .assertEq 2.0}
  .check{Math.negZero .sqrtOrNaN .isNegZero .assertTrue}
  .check{-4.0 .sqrtOrNaN .isNaN .assertTrue}
  .check{Math.nan .sqrtOrNaN .isNaN .assertTrue}
  }
  .test Test{::
  .check{(0.0 .sumNumber(Flows#(1.0, 2.0, 3.0))) .assertEq 6.0}
  .check{(10.0 .sumNumber(Flows#[Float])) .assertEq 10.0}
  }
  .test Test{::
  .check{2.75 .trunc0 .assertEq({::}, Opts# 2.0)}
  .check{-2.75 .trunc0 .assertEq({::}, Opts# -2.0)}
  .check{Math.inf .trunc0 .assertEmpty {::}}
  .check{Math.nan .trunc0 .assertEmpty {::}}
  }
  .test Test{::
  .check{(-4.75 .tryGetAbs).ok.assertEq({::}, Opts# 4.75)}
  .check{Math.nan .tryGetAbs .assertInfo{::.isMsg{::.startsWith "Float.getAbs:"}}}
  }
  .test Test{::
  .check{(3.0 .tryGetByte).ok.assertEq({::}, Opts#(3.getByte))}
  .check{300.0 .tryGetByte .assertInfo{::.isMsg{::.startsWith "Float.getByte:"}}}
  }
  .test Test{::
  .check{(3.25 .tryGetCeil).ok.assertEq({::}, Opts# 4.0)}
  .check{Math.nan .tryGetCeil .assertInfo{::.isMsg{::.startsWith "Float.getCeil:"}}}
