_InfoExtractor_Examples: Test {::
  .test Test{::
  // info := {"friends": [{"name": "Bob"}, {"name": "Alice"}]}
  .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
  .checkEq(info, {info.extract{::}!})
  .checkEq("bob", {info.extract{:: > "friends" > 0 > "name" .extractMsg}.mapSome{::.lower}!})
  .checkEq("Bob, Alice", {info.extract{:: > "friends" .extractList .where{::
      & > 0 > "name" .isMsg{:: == "Bob"}
      & > 1 > "name" .isMsg{:: == "Alice"}
      }}
    .mapSome{::.flow.map{::.extract{:: > "name" .extractMsg}!}.join ", "}!})
  .checkTrue{info.extract{:: > "friends" .extractList .where{::
      & > 0 > "name" .isMsg{:: == "Bob"}
      & > 1 > "name" .isMsg{:: == "David"}
      }}.isEmpty}
  }
  }

_InfoValidator_Examples: Test {::
  .test Test{::
  // info := {"friends": [{"name": "Bob"}, {"name": "Alice"}]}
  .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
  .checkTrue{info.validate{::}}
  .checkTrue{info.validate{:: > "friends" > 0 > "name" .isMsg{:: == "Bob"}}}
  .checkTrue{info.validate{::
    & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
    & > "friends" > 1 > "name" .isMsg{:: == "Alice"}
    }}
  .checkTrue{info.validate{:: > "friends" .isList{::.size == 2}}}
  .checkFalse{info.validate{::
    & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
    | > "friends" > 1 > "name" .isMsg{:: == "Alice"}
    & > "friends" > 2 > "name" .isMsg{:: == "David"}}}
  .checkTrue{info.validate{::
    & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
    | > "friends" .where{::
      & > 1 > "name" .isMsg{:: == "Alice"}
      & > 2 > "name" .isMsg{:: == "David"}}}}
  .checkTrue{info.validate{::
    & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
    & > "friends" > 1 > "name" .isMsg{:: == "David"} .not}}
  }
  }

_Int_Examples: Test {::
  .test Test{::
  .check{(+2 ** 6) .assertEq +64}
  .checkNonDetErr({::}, {(Math.maxInt) ** 2})
  }
  .test Test{::
  .check{(+6 * +7) .assertEq +42}
  .checkNonDetErr({::}, {(Math.maxInt) * +2})
  }
  .test Test{::
  .check{(+2 + +3) .assertEq +5}
  .checkNonDetErr({::}, {(Math.maxInt) + +1})
  }
  .test Test{::
  .check{(+5 - +3) .assertEq +2}
  .checkNonDetErr({::}, {(Math.minInt) - +1})
  }
  .test Test{::
  .check{+5 .abs .assertEq 5}
  .check{-5 .abs .assertEq 5}
  .check{Math.minInt .abs .assertEq(Math.maxInt.getNat + 1)}
  }
  .test Test{::
  .check{(Math.maxInt) .aluAddWrap +1 .assertEq(Math.minInt)}
  }
  .test Test{::
  .check{+5 .aluAnd +3 .assertEq +1}
  }
  .test Test{::
  .check{+257 .aluByte .assertEq(1.getByte)}
  }
  .test Test{::
  .check{+7 .aluDiv -2 .assertEq -3}
  .checkDetErr({::}, {+7 .aluDiv +0})
  }
  .test Test{::
  .check{(Math.maxInt) .aluMulWrap +2 .assertEq -2}
  }
  .test Test{::
  .check{-1 .aluNat .assertEq (Math.maxNat)}
  }
  .test Test{::
  .check{+5 .aluOr +2 .assertEq +7}
  }
  .test Test{::
  .check{-7 .aluRem +2 .assertEq -1}
  .checkDetErr({::}, {+7 .aluRem +0})
  }
  .test Test{::
  .check{+1 .aluShiftLeft 3 .assertEq +8}
  }
  .test Test{::
  .check{-8 .aluShiftRight 1 .assertEq -4}
  }
  .test Test{::
  .check{(Math.minInt) .aluSubWrap +1 .assertEq(Math.maxInt)}
  }
  .test Test{::
  .check{+5 .aluXor +3 .assertEq +6}
  }
  .test Test{::
  .check{+2 .assertInRange(+1=~~= +4)}
  .checkNonDetErr({::}, {+5 .assertInRange(+1=~~= +4)})
  }
  .test Test{::
  .check{+2 .assertInRange(+1=~~= +4, {`custom context`})}
  }
  .test Test{::
  .check{+5 .byte .assertEq({::}, Opts# (5.getByte))}
  .check{+300 .byte .assertEmpty {::}}
  }
  .test Test{::
  .check{+0 .clampTo(+1=~~= +4) .assertEq +1}
  .check{+9 .clampTo(+1=~~= +4) .assertEq +4}
  }
  .test Test{::
  .check{+6 .div(2) .assertEq({::}, Opts# +3)}
  .check{+7 .div(2) .assertEmpty {::}}
  .check{+7 .div(0) .assertEmpty {::}}
  }
  .test Test{::
  .check{+5 .float .assertEq({::}, Opts# 5.0)}
  .check{Math.maxInt - +1 .float .assertEmpty {::}}
  }
  .test Test{::
  .check{+5 .getByte .assertEq(5.getByte)}
  .checkDetErr({::}, {+300 .getByte})
  }
  .test Test{::
  .check{(+6) .getDiv 2 .assertEq(+3)}
  .checkDetErr({::}, {+7 .getDiv 3})
  .checkDetErr({::}, {+7 .getDiv 0})
  }
  .test Test{::
  .check{+5 .getFloat .assertEq 5.0}
  .checkDetErr({::}, {Math.minInt + +1 .getFloat})
  }
  .test Test{::
  .check{+5 .getNat .assertEq 5}
  .checkDetErr({::}, {-5 .getNat})
  }
  .test Test{::
  .check{+7 .getRem 2 .assertEq +1}
  .checkDetErr({::}, {+7 .getRem 0})
  }
  .test Test{::
  .check{+7 .getTruncDiv 2 .assertEq +3}
  .check{-7 .getTruncDiv 2 .assertEq -3}
  .checkDetErr({::}, {+7 .getTruncDiv 0})
  }
  .test Test{::
  .check{-1 .getWrapIndex 7 .assertEq 6}
  .check{+8 .getWrapIndex 7 .assertEq 1}
  .checkDetErr({::}, {+5 .getWrapIndex 0})
  }
  .test Test{::
  .check{+2 .inRange(+1=~~= +4) .assertTrue}
  .check{+5 .inRange(+1=~~= +4) .assertFalse}
  }
  .test Test{::
  .check{+5 .nat .assertEq({::}, Opts# 5)}
  .check{-5 .nat .assertEmpty {::}}
  }
  .test Test{::
  .check{+5 .negAbs .assertEq -5}
  .check{-5 .negAbs .assertEq -5}
  .check{Math.minInt .negAbs .assertEq(Math.minInt)}
  }
  .test Test{::
  .check{+5 .num .assertEq(5/1)}
  }
  .test Test{::
  .check{+5 .pred .assertEq +4}
  .checkNonDetErr({:: > "msg" .isMsg{::.startsWith "Int.pred"}}, {(Math.minInt) .pred})
  }
  .test Test{::
  .check{+7 .rem 2 .assertEq({::}, Opts# +1)}
  .check{+7 .rem 0 .assertEmpty {::}}
  }
  .test Test{::
  .check{+5 .sign .assertEq +1}
  .check{-5 .sign .assertEq -1}
  .check{+0 .sign .assertEq +0}
  }
  .test Test{::
  .check{+5 .softByte .assertEq(5.getByte)}
  .check{+300 .softByte .assertEq(255.getByte)}
  }
  .test Test{::
