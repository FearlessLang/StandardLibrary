  }
  .test Test{::
  .check{(+5 .tryGetNat).ok.assertEq({::}, Opts# 5)}
  .check{-5 .tryGetNat .assertInfo{::.isMsg{::.startsWith "Int.getNat:"}}}
  }
  .test Test{::
  .check{(+7 .tryGetRem 2).ok.assertEq({::}, Opts# +1)}
  .check{+7 .tryGetRem 0 .assertInfo{::.isMsg{::.startsWith "Int.getRem:"}}}
  }
  .test Test{::
  .check{(-7 .tryGetTruncDiv 2).ok.assertEq({::}, Opts# -3)}
  .check{+7 .tryGetTruncDiv 0 .assertInfo{::.isMsg{::.startsWith "Int.getTruncDiv:"}}}
  }
  .test Test{::
  .check{(-1 .tryGetWrapIndex 7).ok.assertEq({::}, Opts# 6)}
  .check{+5 .tryGetWrapIndex 0 .assertInfo{::.isMsg{::.startsWith "Int.getWrapIndex:"}}}
  }
  .test Test{::
  .check{-1 .wrapIndex 7 .assertEq({::}, Opts# 6)}
  .check{+5 .wrapIndex 0 .assertEmpty {::}}
  }
  .test Test{::
  .check{(+7 / 2) .getFloat .assertEq 3.5}
  .checkDetErr({::}, {+7 / 0})
