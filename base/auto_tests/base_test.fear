  }
  .test Test{::
  .check{(4.0 .tryGetSqrt).ok.assertEq({::}, Opts# 2.0)}
  .check{-4.0 .tryGetSqrt .assertInfo{::.isMsg{::.startsWith "Float.getSqrt:"}}}
  }
  .test Test{::
  .check{(1.0 .tryGetSucc).ok.assertEq({::}, Opts#(1.0 .getSucc))}
  .check{Math.inf .tryGetSucc .assertInfo{::.isMsg{::.startsWith "Float.getSucc:"}}}
  }
  .test Test{::
  .check{(-2.75 .tryGetTrunc0).ok.assertEq({::}, Opts# -2.0)}
  .check{Math.inf .tryGetTrunc0 .assertInfo{::.isMsg{::.startsWith "Float.getTrunc0:"}}}
  }
  .test Test{::
  .check{6.0 / 3.0 .assertEq 2.0}
  .check{1.0 / 0.0 .assertEq(Math.inf)}
  .check{-1.0 / 0.0 .assertEq(Math.negInf)}
  .check{0.0 / 0.0 .isNaN .assertTrue}
  }
  .test Test{::
  .check{(1.0=~~4.0) .start .assertEq 1.0}
  .check{(1.0=~~4.0) .end .assertEq(4.0 .getPred)}
  .checkDetErr({::}, {1.0=~~1.0})
  }
  .test Test{::
  .check{(1.0=~~=4.0) .start .assertEq 1.0}
  .check{(1.0=~~=1.0) .start .assertEq 1.0}
  .checkDetErr({::}, {4.0=~~=1.0})
  }
  .test Test{::
  .check{(1.0~~4.0) .start .assertEq(1.0 .getSucc)}
  .check{(1.0~~4.0) .end .assertEq(4.0 .getPred)}
  .checkDetErr({::}, {1.0~~(1.0 .getSucc)})
  }
  .test Test{::
  .check{(1.0~~=4.0) .start .assertEq(1.0 .getSucc)}
  .check{(1.0~~=4.0) .end .assertEq 4.0}
  .checkDetErr({::}, {1.0~~=1.0})
  }
  }

_Flow_Examples_1: Test {::
  .test Test{::
  .check{Block#
    .let acc={ELists#[Nat]}
    .do{Flows#(1, 2, 3).for(acc, {a, e -> a.add(e * 2).void})}
