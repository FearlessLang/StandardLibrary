_Nat_Examples: Test {::
  .test Test{::
  .check{(2 ** 6) .assertEq 64}
  .checkNonDetErr({::}, {(Math.maxNat) ** 2})
  }
  .test Test{::
  .check{(6 * 7) .assertEq 42}
  .checkNonDetErr({::}, {(Math.maxNat) * 2})
  }
  .test Test{::
  .checkEq(5, {2 + 3})
  .checkNonDetErr(
    {:: > "msg" .isMsg{::.startsWith "Nat+:" & (::.contains "overflow")}},
    {(Math.maxNat - 1) + 2}
    )
  }
  .test Test{::
  .check{(5 - 3) .assertEq 2}
  .checkNonDetErr({::}, {0 - 1})
  }
  .test Test{::
  .check{(Math.maxNat) .aluAddWrap 1 .assertEq 0}
  }
  .test Test{::
  .check{5 .aluAnd 3 .assertEq 1}
