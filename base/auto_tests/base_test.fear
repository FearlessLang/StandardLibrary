  .checkDetErr({::}, {+1~~= +1})
  }
  }

_IsoPods_Examples: Test {::
  .test Test{::
  .check{Block#
    .let pod={IsoPods#(Count.int +5)}
    .do{pod.isClosed .assertTrue}
    .do{pod.peek{ .some c -> c.get .assertEq +5; .empty -> Error.msg`should be closed`}}
    .do{pod.mutate{ .some c -> c++; .empty -> Error.msg`should be closed`}}
    .do{pod.peek{ .some c -> c.get .assertEq +6; .empty -> Error.msg`should be closed`}}
    .do{pod.open.get .assertEq +6}
    .do{pod.isClosed .assertFalse}
    .do{pod.peek{ .some _ -> Error.msg`should be empty`; .empty -> Void}}
    .done}
  .checkDetErr({::}, {Block#
    .let pod={IsoPods#(+5)}
    .do{Block#(pod.open, Void)}
    .do{Block#(pod.open, Void)}
    .return{Void}
    })
  }
  }

