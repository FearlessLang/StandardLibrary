  .test Test{::
  .check{+5 .softNat .assertEq 5}
  .check{-5 .softNat .assertEq 0}
  }
  .test Test{::
  .check{+5 .succ .assertEq +6}
  .checkNonDetErr({:: > "msg" .isMsg{::.startsWith "Int.succ:"}}, {(Math.maxInt) .succ})
  }
  .test Test{::
  .check{+6 .truncDiv(2) .assertEq({::}, Opts# +3)}
  .check{+7 .truncDiv(2) .assertEq({::}, Opts# +3)}
  .check{+7 .truncDiv(0) .assertEmpty {::}}
  }
  .test Test{::
  .check{(+5 .tryGetByte).ok.assertEq({::}, Opts#(5.getByte))}
  .check{+300 .tryGetByte .assertInfo{::.isMsg{::.startsWith "Int.getByte:"}}}
  }
  .test Test{::
  .check{(+6 .tryGetDiv 2).ok.assertEq({::}, Opts# +3)}
  .check{+7 .tryGetDiv 3 .assertInfo{::.isMsg{::.startsWith "Int.getDiv:"}}}
  }
  .test Test{::
  .check{(+5 .tryGetFloat).ok.assertEq({::}, Opts# 5.0)}
