  .test Test{::
  .check{5 .getByte .assertEq(5.getByte)}
  .checkDetErr({::}, {300 .getByte})
  }
  .test Test{::
  .check{6 .getDiv 2 .assertEq 3}
  .checkDetErr({::}, {7 .getDiv 2})
  .checkDetErr({::}, {7 .getDiv 0})
  }
  .test Test{::
  .check{5 .getFloat .assertEq 5.0}
  .checkDetErr({::}, {Math.maxNat.getFloat})
  }
  .test Test{::
  .check{5 .getIndexOffset(+3) .assertEq 8}
  .check{5 .getIndexOffset(-3) .assertEq 2}
  .checkDetErr({::}, {5 .getIndexOffset(-10)})
  }
  .test Test{::
  .check{5 .getInt .assertEq +5}
  .checkDetErr({::}, {Math.maxNat .getInt})
  }
  .test Test{::
  .check{7 .getRem 2 .assertEq 1}
  .checkDetErr({::}, {7 .getRem 0})
  }
  .test Test{::
  .check{7 .getTruncDiv 2 .assertEq 3}
  .checkDetErr({::}, {7 .getDiv 0})
  }
  .test Test{::
  .check{2 .inRange(1=~~=4) .assertTrue}
  .check{5 .inRange(1=~~=4) .assertFalse}
  }
  .test Test{::
  .check{5 .indexOffset(+3) .assertEq({::}, Opts# 8)}
  .check{5 .indexOffset(-10) .assertEmpty {::}}
  }
  .test Test{::
  .check{5 .int .assertEq({::}, Opts# +5)}
  .check{(Math.maxNat) .int .assertEmpty {::}}
  }
  .test Test{::
  .check{5 .num .assertEq(5/1)}
  }
  .test Test{::
  .check{5 .pred .assertEq 4}
  .checkNonDetErr({:: > "msg" .isMsg{::.startsWith "Nat.pred"}}, {0 .pred})
  }
  .test Test{::
  .check{7 .rem 2 .assertEq({::}, Opts# 1)}
  .check{7 .rem 0 .assertEmpty {::}}
  }
  .test Test{::
  .check{5 .softByte .assertEq(5.getByte)}
  .check{300 .softByte .assertEq(255.getByte)}
  }
  .test Test{::
  .check{5 .softFloat .assertEq 5.0}
  }
  .test Test{::
  .check{5 .softInt .assertEq +5}
  .check{(Math.maxNat) .softInt .assertEq(Math.maxInt)}
  }
  .test Test{::
  .check{9 .softSqrt .assertEq 3.0}
  .check{0 .softSqrt .assertEq 0.0}
  }
  .test Test{::
  .check{5 .succ .assertEq 6}
  .checkNonDetErr({:: > "msg" .isMsg{::.startsWith "Nat.succ"}}, {(Math.maxNat) .succ})
  }
  .test Test{::
  .check{7 .truncDiv 2 .assertEq({::}, Opts# (3))}
  .check{7 .truncDiv 0 .assertEmpty {::}}
  }
  .test Test{::
  .check{(5 .tryGetByte).ok.assertEq({::}, Opts#(5.getByte))}
  .check{300 .tryGetByte .assertInfo{::.isMsg{::.startsWith "Nat.getByte:"}}}
  }
  .test Test{::
  .check{(6 .tryGetDiv 2).ok.assertEq({::}, Opts# 3)}
  .check{7 .tryGetDiv 2 .assertInfo{::.isMsg{::.startsWith "Nat.getDiv:"}}}
  }
  .test Test{::
  .check{(5 .tryGetFloat).ok.assertEq({::}, Opts# 5.0)}
  .check{(Math.maxNat).tryGetFloat .assertInfo{::.isMsg{::.startsWith "Nat.getFloat:"}}}
  }
  .test Test{::
  .check{(5 .tryGetIndexOffset(+3)).ok.assertEq({::}, Opts# 8)}
  .check{5 .tryGetIndexOffset(-10) .assertInfo{::.isMsg{::.startsWith "Nat.getIndexOffset:"}}}
  }
  .test Test{::
  .check{(5 .tryGetInt).ok.assertEq({::}, Opts# +5)}
  .check{(Math.maxNat).tryGetInt .assertInfo{::.isMsg{::.startsWith "Nat.getInt:"}}}
  }
  .test Test{::
  .check{(7 .tryGetRem 2).ok.assertEq({::}, Opts# 1)}
  .check{7 .tryGetRem 0 .assertInfo{::.isMsg{::.startsWith "Nat.getRem:"}}}
  }
  .test Test{::
  .check{(7 .tryGetTruncDiv 2).ok.assertEq({::}, Opts# 3)}
  .check{7 .tryGetTruncDiv 0 .assertInfo{::.isMsg{::.startsWith "Nat.getTruncDiv:"}}}
  }
  .test Test{::
  .check{(7 / 2) .softFloat .assertEq 3.5}
  .checkDetErr({::}, {7 / 0})
  }
  .test Test{::
  .check{(1=~~4) .start .assertEq 1}
  .checkDetErr({::}, {1=~~1})
  }
  .test Test{::
  .check{(1=~~=4) .start .assertEq 1}
  .checkDetErr({::}, {4=~~=1})
  }
  .test Test{::
  .check{(1~~4) .start .assertEq 2}
  .checkDetErr({::}, {1~~2})
  }
  .test Test{::
  .check{(1~~=4) .end .assertEq 4}
  .checkDetErr({::}, {1~~=1})
  }
  }

_Num_Examples: Test {::
  .test Test{::
  .check{(2/4 ** +3) .assertEq(8 / 64)}
  .check{(2/1 ** -1) .assertEq(1 / 2)}
  }
  .test Test{::
  .check{2/3 * (3/7) .assertEq(6/21)}
  }
  .test Test{::
  .check{2/3 + (3/2) .assertEq(13/6)}
  }
  .test Test{::
  .check{5/1 - (3/1) .assertEq(2/1)}
  }
  .test Test{::
  .check{3/1 .abs .assertEq(3/1)}
  .check{-3/4 .abs .assertEq(3/4)}
  }
  .test Test{::
  .check{3/1 .absNeg .assertEq(-3/1)}
  .check{-3/4 .absNeg .assertEq(-3/4)}
  }
  .test Test{::
  .check{2/1 .assertInRange((1/1)=~~=(4/1))}
  }
  .test Test{::
  .check{(2/1) .assertInRange((1/1)=~~=(4/1), {`custom context`})}
  }
  .test Test{::
  .check{5/1 .byte .assertEq({::}, Opts# (5.getByte))}
  .check{300/1 .byte .assertEmpty {::}}
  }
  .test Test{::
  .check{(7 / 2) .ceil .assertEq(4/1)}
  .check{((-7) / 2) .ceil .assertEq(-3/1)}
  }
  .test Test{::
  .check{0/1 .clampTo(1/1=~~=(4/1)) .assertEq(1/1)}
  .check{9/1 .clampTo(1/1=~~=(4/1)) .assertEq(4/1)}
  }
  .test Test{::
  .check{5/1 .float .assertEq({::}, Opts# 5.0)}
  .check{(1 / 3) .float .assertEmpty {::}}
  }
  .test Test{::
  .check{(7 / 2) .floor .assertEq(3/1)}
  .check{(-7 / 2) .floor .assertEq(-4/1)}
  }
  .test Test{::
  .check{5/1 .getByte .assertEq(5.getByte)}
  .checkDetErr({::}, {300 .getByte})
  }
  .test Test{::
  .check{5/1 .getFloat .assertEq 5.0}
  .checkDetErr({::}, {(1 / 3) .getFloat})
  }
  .test Test{::
  .check{5/1 .getInt .assertEq +5}
  .checkDetErr({::}, {(1 / 2) .getInt})
  }
  .test Test{::
  .check{5/1 .getNat .assertEq 5}
  .checkDetErr({::}, {(-5) .getNat})
  }
  .test Test{::
  .check{(2/1) .inRange((1/1)=~~=(4/1)) .assertTrue}
  .check{(5/1) .inRange((1/1)=~~=(4/1)) .assertFalse}
  }
  .test Test{::
  .check{5 .int .assertEq({::}, Opts# +5)}
  .check{1 / 2 .int .assertEmpty {::}}
  }
  .test Test{::
  .check{5/1 .isInteger .assertTrue}
  .check{1 / 2 .isInteger .assertFalse}
  }
  .test Test{::
  .check{5/1 .nat .assertEq({::}, Opts# 5)}
  .check{-5/1 .nat .assertEmpty {::}}
  }
  .test Test{::
  .check{(5 / 2) .round .assertEq(3/1)}
  .check{((-5) / 2) .round .assertEq(-3/1)}
  }
  .test Test{::
  .check{(5 / 2) .roundTiesEven .assertEq(2/1)}
  .check{(7 / 2) .roundTiesEven .assertEq(4/1)}
  }
  .test Test{::
  .check{5/1 .sign .assertEq(1/1)}
  .check{(-5/1) .sign .assertEq(-1/1)}
  .check{0/1 .sign .assertEq(0/1)}
  }
  .test Test{::
  .check{7 / 2 .softByte .assertEq(3.getByte)}
  }
  .test Test{::
  .check{1 / 3 .softFloat .assertEq +0.333333333333333314829616256247390992939472198486328125}
  }
  .test Test{::
  .check{7 / 2 .softInt .assertEq +3}
  }
  .test Test{::
  .check{7 / 2 .softNat .assertEq 3}
  .check{-5/1 .softNat .assertEq 0}
  }
  .test Test{::
  .check{(7 / 2) .trunc0 .assertEq(3/1)}
  .check{((-7) / 2) .trunc0 .assertEq(-3/1)}
  }
  .test Test{::
  .check{((5/1).tryGetByte).ok.assertEq({::}, Opts#(5.getByte))}
  .check{(300/1).tryGetByte .assertInfo{::.isMsg{::.startsWith "Num.getByte:"}}}
  }
  .test Test{::
  .check{((5/1).tryGetFloat).ok.assertEq({::}, Opts# 5.0)}
  .check{(1/3).tryGetFloat .assertInfo{::.isMsg{::.startsWith "Num.getFloat:"}}}
  }
  .test Test{::
  .check{((5/1).tryGetInt).ok.assertEq({::}, Opts# +5)}
  .check{(1/2).tryGetInt .assertInfo{::.isMsg{::.startsWith "Num.getInt:"}}}
  }
  .test Test{::
  .check{((5/1).tryGetNat).ok.assertEq({::}, Opts# 5)}
  .check{(1/2).tryGetNat .assertInfo{::.isMsg{::.startsWith "Num.getNat:"}}}
  }
  .test Test{::
  .check{2 / 6 / (4/3) .assertEq((2*3) / (6*4))}
  .checkDetErr({::}, {1 / 0})
  }
  .test Test{::
  .check{1/1=~~(4/3) .contains(1/1) .assertTrue}
  .check{1/1=~~(4/3) .contains(4/3) .assertFalse}
  .checkDetErr({::}, {1/1=~~(1/1)})
  }
  .test Test{::
  .check{(1/1=~~=(4/3)) .contains(4/3) .assertTrue}
  .check{(1/1=~~=(4/3)) .contains(1/1) .assertTrue}
  .checkDetErr({::}, {4/1=~~=(1/1)})
  }
  .test Test{::
  .check{1/1 ~~ (4/1) .contains(2/1) .assertTrue}
  .check{1/1 ~~ (4/1) .contains(1/1) .assertFalse}
  .checkDetErr({::}, {1/1~~(1/1)})
  }
  .test Test{::
  .check{(1/1~~=(4/3)) .contains(4/3) .assertTrue}
  .check{(1/1~~=(4/3)) .contains(1/1) .assertFalse}
  .checkDetErr({::}, {1/1~~=(1/1)})
  }
  }

