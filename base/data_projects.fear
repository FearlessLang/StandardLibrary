DataRead: CaptureFree, Named{}
DataEdit: DataRead{}

CapDataRead: ToIso[CapDataRead], WidenTo[CapDataRead]{
  mut .paths(path: List[Str]): List[Str];
  mut .read(path: List[Str]): mut CapInputCursorNode;
  }

CapDataEdit: ToIso[CapDataEdit], WidenTo[CapDataEdit]{
  mut .paths(path: List[Str]): List[Str];
  mut .read(path: List[Str]): mut CapInputCursorNode;
  mut .writeStrUtf8(path: List[Str], content: Str): Void;
  mut .writeUStrUtf8(path: List[Str], content: UStr): Void;
  mut .writeStrUtf16Le(path: List[Str], content: Str): Void;
  mut .writeUStrUtf16Le(path: List[Str], content: UStr): Void;
  mut .writeStrUtf32Le(path: List[Str], content: Str): Void;
  mut .writeUStrUtf32Le(path: List[Str], content: UStr): Void;
  mut .writeStrUtf16Be(path: List[Str], content: Str): Void;
  mut .writeUStrUtf16Be(path: List[Str], content: UStr): Void;
  mut .writeStrUtf32Be(path: List[Str], content: Str): Void;
  mut .writeUStrUtf32Be(path: List[Str], content: UStr): Void;
  mut .writeStrAscii(path: List[Str], content: Str): Void;
  mut .writeUStrAscii(path: List[Str], content: UStr, recover: mut UnencodableRecover): Void;
  mut .writeStrLatin1(path: List[Str], content: Str): Void;
  mut .writeUStrLatin1(path: List[Str], content: UStr, recover: mut UnencodableRecover): Void;
  mut .writeBytes(path: List[Str], content: List[Byte]): Void;
  mut .writeImagePng(path: List[Str], content: Image): Void;
  mut .delete(path: List[Str]): Void;
  }

UnencodableRecover:{
  mut #(scalar: Nat, index: Nat): List[Byte]
  }
