///A type naming a data project the code needs: the user of the Fearless manager mounts a data project
///on each concrete DataRead type of a code project.
///A DataRead type captures nothing, so its ``.name`` identifies it.
DataRead: CaptureFree, Named{}
///A DataRead type naming a data project the code also writes.
DataEdit: DataRead{}

///The object capability to read the data project mounted on a DataRead type, given by ``System.dataRead``.
///``path`` is the list of the folder names, then the resource name, from the root folder of the data project.
///A zip is a folder named without ".zip": a path enters it as it enters any other folder.
///A resource whose name starts with "." is not part of the data project, and neither is the marker of the
///data project, the file with the extension ".fearless" at its top: a path naming them is not valid.
///A ``path`` that is not valid is a deterministic error.
///A request that the resources of the data project do not allow, like a ``path`` naming no resource, is a deterministic error.
///A root folder of the data project that cannot be reached, a resource that exists but cannot be read or changed,
///and a folder holding a name that is not valid are non deterministic errors.
CapDataRead: ToIso[CapDataRead], WidenTo[CapDataRead]{
  ///The names of the resources in the folder at ``path``, sorted; a zip is named without ".zip".
  ///An empty ``path`` is the root folder.
  mut .paths(path: List[Str]): List[Str];
  ///The file at ``path``, read again at every read.
  mut .read(path: List[Str]): mut CapInputCursorNode;
  }

///The object capability to read and write the data project mounted on a DataEdit type, given by ``System.dataEdit``.
///It reads as `CapDataRead` does.
///A write replaces the file at ``path``, or creates it together with the missing folders of ``path``;
///a file inside a zip is written by rewriting that zip.
///A written path keeps the data project valid: each folder name uses only lowercase letters,
///digits and underscores, and starts with a letter or an underscore;
///the file name is such a name, a dot and an extension, other than ".zip".
///The write methods mirror the read methods of `CapInputCursorNode`, and every text is written with no byte order mark.
///A `Str` holds only ASCII characters, so ``.writeStrUtf8``, ``.writeStrAscii`` and ``.writeStrLatin1`` write the same bytes.
CapDataEdit: ToIso[CapDataEdit], WidenTo[CapDataEdit]{
  mut .paths(path: List[Str]): List[Str];
  mut .read(path: List[Str]): mut CapInputCursorNode;
  mut .writeStrUtf8(path: List[Str], content: Str): Void;
  mut .writeUStrUtf8(path: List[Str], content: UStr): Void;
  mut .writeStrUtf16Le(path: List[Str], content: Str): Void;
  mut .writeUStrUtf16Le(path: List[Str], content: UStr): Void;
  mut .writeStrUtf32Le(path: List[Str], content: Str): Void;
  mut .writeUStrUtf32Le(path: List[Str], content: UStr): Void;
  mut .writeStrUtf16Be(path: List[Str], content: Str): Void;
  mut .writeUStrUtf16Be(path: List[Str], content: UStr): Void;
  mut .writeStrUtf32Be(path: List[Str], content: Str): Void;
  mut .writeUStrUtf32Be(path: List[Str], content: UStr): Void;
  mut .writeStrAscii(path: List[Str], content: Str): Void;
  ///A character above U+007F is written as the bytes ``recover`` gives for it.
  mut .writeUStrAscii(path: List[Str], content: UStr, recover: mut UnencodableRecover): Void;
  mut .writeStrLatin1(path: List[Str], content: Str): Void;
  ///A character above U+00FF is written as the bytes ``recover`` gives for it.
  mut .writeUStrLatin1(path: List[Str], content: UStr, recover: mut UnencodableRecover): Void;
  mut .writeBytes(path: List[Str], content: List[Byte]): Void;
  ///Writes ``content`` as a PNG image.
  mut .writeImagePng(path: List[Str], content: Image): Void;
  ///Deletes the resource at ``path``: a file, or a folder with every resource in it; a zip is a folder.
  ///Then deletes every folder that the delete left empty: a zip left with no file is deleted too.
  mut .delete(path: List[Str]): Void;
  }

///The bytes to write in place of a character that the encoding of a write does not encode.
///``scalar`` is the character, ``index`` its position in the text.
///It can throw, to make the write fail.
UnencodableRecover:{
  mut #(scalar: Nat, index: Nat): List[Byte]
  }
