///The object capability to read the data projects linked to this program.
///The Fearless manager links data projects to a code project ("reads" and "edits" of the
///project in projects.info), each under the type names the code uses for it.
///The roots of this capability are the type names of "reads" and of "edits": ``name`` is one of them.
///A type name is in one link only, so a root names one data project.
///``path`` is the list of the folder names, then the resource name, from the root folder of the data project.
///A zip is a folder named without ".zip": a path enters it as it enters any other folder.
///A resource or folder whose name starts with "." is not part of the data project, and neither is the marker of the
///data project, the resource with the extension ".fearless" at its top: a path naming them is not valid.
///A ``path`` that is not valid is a deterministic error.
///A ``name`` that is not a root, a ``path`` naming no resource or folder, and a data project that changed on disk
///so that the request can not be done are non deterministic errors.
///A program started by the portable Fearless has no root.
CapDataRead: ToIso[CapDataRead], WidenTo[CapDataRead]{
  ///The roots of this capability, sorted.
  mut .roots: List[Str];
  ///The names of the resources and folders in the folder at ``path``, sorted; a zip is named without ".zip".
  ///An empty ``path`` is the root folder.
  mut .paths(name: Str, path: List[Str]): List[Str];
  ///The resource at ``path``, read again at every read.
  mut .read(name: Str, path: List[Str]): mut InputCursorNode;
  }

///The object capability to read and write the data projects linked to this program in "edits".
///The roots of this capability are the type names of "edits": ``name`` is one of them.
///It reads as `CapDataRead` does.
///A write replaces the resource at ``path``, or creates it together with the missing folders of ``path``;
///a resource inside a zip is written by rewriting that zip.
///A written path keeps the data project valid: each folder name uses only lowercase letters,
///digits and underscores, and starts with a letter or an underscore;
///the resource name is such a name, a dot and an extension, other than ".zip".
///The write methods mirror the read methods of `InputCursorNode`, and every text is written with no byte order mark.
///A `Str` holds only ASCII characters, so ``.writeStrUtf8``, ``.writeStrAscii`` and ``.writeStrLatin1`` write the same bytes.
CapDataReadWrite: ToIso[CapDataReadWrite], WidenTo[CapDataReadWrite]{
  ///The roots of this capability, sorted.
  mut .roots: List[Str];
  mut .paths(name: Str, path: List[Str]): List[Str];
  mut .read(name: Str, path: List[Str]): mut InputCursorNode;
  mut .writeStrUtf8(name: Str, path: List[Str], content: Str): Void;
  mut .writeUStrUtf8(name: Str, path: List[Str], content: UStr): Void;
  mut .writeStrUtf16Le(name: Str, path: List[Str], content: Str): Void;
  mut .writeUStrUtf16Le(name: Str, path: List[Str], content: UStr): Void;
  mut .writeStrUtf32Le(name: Str, path: List[Str], content: Str): Void;
  mut .writeUStrUtf32Le(name: Str, path: List[Str], content: UStr): Void;
  mut .writeStrUtf16Be(name: Str, path: List[Str], content: Str): Void;
  mut .writeUStrUtf16Be(name: Str, path: List[Str], content: UStr): Void;
  mut .writeStrUtf32Be(name: Str, path: List[Str], content: Str): Void;
  mut .writeUStrUtf32Be(name: Str, path: List[Str], content: UStr): Void;
  mut .writeStrAscii(name: Str, path: List[Str], content: Str): Void;
  ///A character above U+007F is written as the bytes ``recover`` gives for it.
  mut .writeUStrAscii(name: Str, path: List[Str], content: UStr, recover: mut UnencodableRecover): Void;
  mut .writeStrLatin1(name: Str, path: List[Str], content: Str): Void;
  ///A character above U+00FF is written as the bytes ``recover`` gives for it.
  mut .writeUStrLatin1(name: Str, path: List[Str], content: UStr, recover: mut UnencodableRecover): Void;
  mut .writeBytes(name: Str, path: List[Str], content: List[Byte]): Void;
  ///Writes ``content`` as a PNG image.
  mut .writeImagePng(name: Str, path: List[Str], content: Image): Void;
  ///Deletes the resource at ``path``, then every folder that deleting it left empty:
  ///a zip left with no resource is deleted too.
  mut .delete(name: Str, path: List[Str]): Void;
  }

///The bytes to write in place of a character that the encoding of a write does not encode.
///``scalar`` is the character, ``index`` its position in the text.
///It can throw, to make the write fail.
UnencodableRecover:{
  mut #(scalar: Nat, index: Nat): List[Byte]
  }
