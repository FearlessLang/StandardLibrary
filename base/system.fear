///The object capability to observe the world outside of the program.
///Code without a System can only compute with its arguments: equal calls give equal results,
///so the results can be cached, reordered and computed in parallel with no visible difference.
///Whatever may answer differently to the same question (input, files, downloads, in memory logs,
///non deterministic errors) is observed through a method of System or of a capability created by it.
///Acting on the world needs no capability when the program cannot observe the action:
///Debug, Log and FileLog can be used anywhere, and so can InMemoryLog.log,
///whose content can only be read through System.
///CapOutput only acts: it makes printing explicit in the code, while the program cannot observe what was printed.
System: ToIso[System],WidenTo[System] {
  //mut .io: mut IO;
  //mut .rng: mut RandomSeed;
  mut .try: mut CapTry;
  mut .out: mut CapOutput;
  mut .inputCursor: mut CapInputCursor;
  mut .assetRead: mut CapAssetRead;//TODO: complete real system and the inherited metods returning 'this'
  mut .download: mut CapDownload;
  ///The capability to read the data project mounted on ``data``.
  ///A ``data`` with no data project mounted is a non deterministic error: a program started by the portable Fearless has no mount.
  mut .dataRead(data: DataRead): mut CapDataRead;
  ///The capability to read and write the data project mounted on ``data``.
  ///A ``data`` with no data project mounted for editing is a non deterministic error.
  mut .dataEdit(data: DataEdit): mut CapDataEdit;
  mut .manager: mut CapManager;
  mut .process: mut CapProcess;
  ///Creates a reader for this in memory log.
  ///Concrete log types must be non generic.
  mut .readLog[T](InMemoryLog[T]): mut CapLogReader[T];
  
  mut .gui:mut CapGui;
  ///A new flag, not started: a `RevokableSystem` and the capabilities it gives check it before every call.
  mut .revocation: mut CapRevocationRoot;
  }
  
/// This try-catch will catch non-deterministic errors.
CapTry: ToIso[CapTry],WidenTo[CapTry] {
  /// This method upholds strong exception safety, so you can observe changes to
  ///  the program state from any exception-causing code.
  mut #[R:*](try: read F[R]): mut Action[R];
  
  /// This method is designed to take an iso object capability to do effects while handling
  /// the non deterministic exception.
  /// However any violations of strong exception safety can only be observed with an object
  /// capability because the iso reference is not linked to the outer world, so it is conceptually
  ///  data that could have equivalently been recreated internally.
  mut #[T:**,R:*](data: iso T, try: read F[iso T,R]): mut Action[R];
  
  ///Return the current stack trace
  mut .currentStackTrace: List[StackFrame];
  }

CapTrys: F[mut System, mut CapTry] {sys -> sys.try}
  
CapOutput: ToIso[CapOutput],WidenTo[CapOutput] {
  mut .print(ToStr): Void;
  mut .println(ToStr): Void;//later add printU and printlnU
  mut .byte(Byte): Void;///Does not flush
  mut .bytes(List[Byte]): Void;//Does flush
  }

///A position in the list of the input files of the program, in the order they arrived.
///The file opened to start the program is the first one; every file dropped on a window of the program arrives after it.
///``sys.inputCursor`` is the first position.
CapInputCursor: ToIso[CapInputCursor],WidenTo[CapInputCursor] {
  mut #: mut Opt[mut CapInputCursorNode]; ///the file at this position: empty until a file arrives there, then always that file
  mut .next: mut CapInputCursor;
  }

///An input file, read again at every read: a file that cannot be read is a deterministic error.
CapInputCursorNode: ToIso[CapInputCursorNode],WidenTo[CapInputCursorNode] {
  mut .label: Str; ///best effort portable name to help debugging
  mut .readStrUtf8(recover: mut BadStrUnitRecover): Str;
  mut .readUStrUtf8(recover: mut BadUStrUnitRecover): UStr;
  mut .readStrUtf16Le(recover: mut BadStrUnitRecover): Str;
  mut .readUStrUtf16Le(recover: mut BadUStrUnitRecover): UStr;
  mut .readStrUtf32Le(recover: mut BadStrUnitRecover): Str;
  mut .readUStrUtf32Le(recover: mut BadUStrUnitRecover): UStr;
  mut .readStrUtf16Be(recover: mut BadStrUnitRecover): Str;
  mut .readUStrUtf16Be(recover: mut BadUStrUnitRecover): UStr;
  mut .readStrUtf32Be(recover: mut BadStrUnitRecover): Str;
  mut .readUStrUtf32Be(recover: mut BadUStrUnitRecover): UStr;
  mut .readStrAscii(recover: mut BadStrUnitRecover): Str;
  mut .readUStrAscii(recover: mut BadUStrUnitRecover): UStr;
  mut .readStrLatin1(recover: mut BadStrUnitRecover): Str;
  mut .readUStrLatin1(recover: mut BadUStrUnitRecover): UStr;
  mut .readBytes: List[Byte];
  mut .readImage(maxPixels: Nat): Image;
  }