CaptureFree: {}//special type rule will make sure zero captures
CacheHandler:CaptureFree{}
Norm[T]:Sealed,BaseContainer[T]{ .get: T; read .as[T2](f: BaseId[read/imm T,T2]): Norm[T2]; imm .as[T2](f: BaseId[imm T,T2]): Norm[T2]; }//this means only base can make norms, so we control production of Norms
CacheF[R]: CacheHandler{//Any instantiated type implementing CacheF will be a singleton (because of CaptureFree)
  #: R;
  ._get: R -> _Magic!//this._cache0().get()
  //via magic it defines
  //Cache0 _cache= new Cache0(1, instance);
  }
CacheF[A,R]: CacheHandler{//Any instantiated type implementing CacheF will be a singleton (because of CaptureFree)
  #(Norm[A]): R;
  ._get(a: Norm[A]): R -> _Magic!//this._cache1().get(a)
  //via magic it defines
  //Cache1 _cache= new Cache1(1, instance);
  }
CacheF[A,B,R]: CacheHandler{//Any instantiated type implementing CacheF will be a singleton (because of CaptureFree)
  #(Norm[A], Norm[B]): R;
  ._get(a: Norm[A], b: Norm[B]): R -> _Magic!//this._cache2().get(a,b)
  //via magic it defines
  //Cache2 _cache= new Cache2(1, instance);
  }
CacheMemo[R]: CacheHandler{//Any instantiated type implementing CacheMemo will be a singleton (because of CaptureFree)
  #: R;
  ._get: Norm[R] -> _Magic!//this._cache0().get()
  //via magic it defines
  //Cache0 _cache= new Cache0(1, instance);
  }
CacheMemo[A,R]: CacheHandler{//Any instantiated type implementing CacheMemo will be a singleton (because of CaptureFree)
  #(Norm[A]): R;
  ._get(a: Norm[A]): Norm[R] -> _Magic!//this._cache1().get(a)
  //via magic it defines
  //Cache1 _cache= new Cache1(1, instance);
  }
CacheMemo[A,B,R]: CacheHandler{//Any instantiated type implementing CacheMemo will be a singleton (because of CaptureFree)
  #(Norm[A], Norm[B]): R;
  ._get(a: Norm[A], b: Norm[B]): Norm[R] -> _Magic!//this._cache2().get(a,b)
  //via magic it defines
  //Cache2 _cache= new Cache2(1, instance);
  }
Cache: {
  #[R](f: CacheF[R]): R -> f._get;
  #[A,R](a: Norm[A], f: CacheF[A,R]): R -> f._get(a);
  #[A,B,R](a: Norm[A], b: Norm[B], f: CacheF[A,B,R]): R -> f._get(a,b);
  .of[R](f: CacheF[R]): R -> f._get;
  .of[A,R](a: Norm[A], f: CacheF[A,R]): R -> f._get(a);
  .of[A,B,R](a: Norm[A], b: Norm[B], f: CacheF[A,B,R]): R -> f._get(a,b);
  .ofMemo[R](f: CacheMemo[R]): Norm[R] -> f._get;
  .ofMemo[A,R](a: Norm[A], f: CacheMemo[A,R]): Norm[R] -> f._get(a);
  .ofMemo[A,B,R](a:Norm[A], b: Norm[B], f: CacheMemo[A,B,R]): Norm[R] -> f._get(a,b);
  .flush(h:CacheHandler): Void->_CacheFlush.flush h;
  }
CacheReprF[A,R]: CacheHandler{
  #(read A): R;
  ._get(read Repr[A]): R -> _Magic!//p0._reprCacheGet(this, ()->this#(p0 look), 1)
  //the cache is the field _reprCache of the Repr object p0, keyed by this
  }
CacheReprF[A,B,R]: CacheHandler{
  #(read A, Norm[B]): R;
  ._get(read Repr[A], Norm[B]): R -> _Magic!//p0._reprCacheGet(Cache2.Key(this,p1), ()->this#(p0 look, p1), 1)
  //the cache is the field _reprCache of the Repr object p0, keyed by this and p1
  }

_ListNorm:{#[T:*,R](List[T], mut MF[T,Norm[R]]): Norm[List[Norm[R]]] -> _Magic!}

_ReprCacheFlush:{ #[T](mut Repr[T]): Void->_Magic! }
_CacheFlush:{ .flush(h:CacheHandler): Void->_Magic!; }
