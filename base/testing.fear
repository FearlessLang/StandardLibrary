StackFrame: DataType[StackFrame,StackFrame] {
  .fileName: Str; .typeName: Str; .methodName: Str; .lineNumber: Nat;
  .close -> this; .close -> ::;
  .cmp a, b, m -> a.str<=>(b.str,m);
  .hash -> this.str.hash;
  .str -> 
    "StackFrame[" + (this.imm.fileName)
    + ", " + (this.imm.typeName)
    + ", " + (this.imm.methodName)
    + ", " + (this.imm.lineNumber)
    +"]";
  .info -> Infos.map(
    "fileName", this.imm.fileName,
    "typeName", this.imm.typeName,
    "methodName", this.imm.methodName,
    "lineNumber", this.imm.lineNumber,
    );
  }

StackFrames: F[Str,Str,Str,Nat,StackFrame] { fn,tn,mn,ln ->
  {'self .fileName->fn; .typeName->tn; .methodName->mn; .lineNumber->ln; .imm->self} }

/// Unit tests
///This design blends test suites, tests and individual checks.
///Basically, a test suite is a Test that only calls `.test` on named Tests,
///While a Test is a named Test that only calls `.check`.
///We can then arbitrary make trees of test suites or by nesting them in other test suites.
///
///A name name is only reported when the name is present.
///Example code with two test suites.
///```
///MyTests: UnitTests {::
///  .test TestCars
///  .test TestPerson
///  }
///TestCars: Test {::
///  .let x=... //can declare locals
///  //Test `TestCarsCanMove` inside test suite TestCars
///  .test TestCarsCanMove: Test {:: .check {..}}
///  
///  //disabled test with name inside test suite TestCars
///  .disableTest TestCarsCanFly: Test {:: .check {..}}
///  
///  //unnamed check in the test suite.. possible but not advised
///  .check {Cars#(...).assertEquals(MakeCar#23)  }
///  
///  //A single test can have many checks
///  .test TestCarsCanPark: Test {t-> Block#
///    .if {..} .do{ t.check {..} }
///    .if {..} .do{ t.check {..} }
///    .done}
///  }
/// ```
/// Example using logs:
/// ```
/// Events:InMemoryLog[Event]{"Events"}
///...
/// .checkWithSys { sys -> Block#
///   .let log=Events.reader(sys);
///   .do { log.clear }
///   .do { actionUnderTest# }
///   .do { log.consume.assertEq({::},Lists#(
///     Event1#(...),
///     Event2#(...),
///     ))}
///   .done
///   }
/// ```
/// Example checking that an action fails:
/// ```
/// .checkWithSys { ::.try#{SomethingThatShouldFail#}.assertInfo}
/// ```
/// Example checking that an action succeeds:
/// ```
/// .check{SomethingThatShouldSucceed#}
/// ```
///
/// Compiling a package with doc comments also generates a `UnitTests` suite from
/// its ``//>``/``//-`` examples, built with this same `Test`/`UnitTests`/`TestCap`
/// API: one ``_<Type>_Examples`` per documented type, aggregated into one
/// ``AllAutoTests_<pkg>`` per package. Declaring a type of your own named exactly
/// like a ``_<Type>_Examples`` is reported as an error naming the convention;
/// declaring one named exactly like ``AllAutoTests_<pkg>`` instead suppresses
/// generation for that whole package.
UnitTests: Main {
  .main sys->Block#
    .let[mut RTestCap] ts= {_TestCaps#(sys,ELists#)}
    .do {Block#(this.tests(ts),Void)}
    .return {ts.run};
  .tests(t: mut TestCap): mut TestCap;
  }

LazyToString: MF[read ToStr] {}

TestCap: Sealed {//by making it sealed we can guaranteed the output of the function is the same of the original input
  // Useful for debug expressions in tests
  mut .do[T](f: mut MF[T]): mut TestCap -> Block#(f#, this);
  mut .debug(f: mut LazyToString): mut TestCap -> Block#(Debug#(f#.str), this);
  //so we can use subtyping to get more methods on that object/rely on the injected EList
  mut .let[T](f: F[T],c: TestCont[T]): mut TestCap -> c#(f#,this);
  //so .let must be just imm stuff, nothing else makes sense.
  mut .test(t: Test): mut TestCap -> t.tests this;
  mut .disabledTest(Test): mut TestCap;
  mut .check(Check): mut TestCap;
  mut .disabledCheck(Check): mut TestCap; 
  mut .checkWithSys(CheckSys): mut TestCap;
  mut .disabledCheckWithSys(CheckSys): mut TestCap;  
  mut .checkDetErr[T:*](errorMatch: F[InfoValidator, InfoValidator], f: F[T]): mut TestCap -> this.check{
    Try#(f).run {
     .ok _ -> Error.msg "Expected error but got success";
     .info i -> i.validate errorMatch .match {
       .true -> Void;
       .false -> Error.msg("Error did not match expected: " + (i.str));
       }
     }
    };
  mut .checkNonDetErr[T](errorMatch: F[InfoValidator, InfoValidator], f: F[T]): mut TestCap -> this.checkWithSys{
    sys -> sys.try#({Try#(f).run {
      .ok _ -> "Expected error but got success";
      .info i -> "Expected non-deterministic error, but deterministic error was thrown instead:" + (i.str)
    }}).run {
       .ok errMsg -> Error.msg errMsg;
       .info i -> i.validate errorMatch .match {
         .true -> Void;
         .false -> Error.msg("Error did not match expected: " + (i.str));
         }
       }
     };
  }

TestCont[T]: { #(t: T, self: mut TestCap): mut TestCap }

_TestCaps: {
  #(sys: mut System, ts: mut EList[CheckInfo]): mut RTestCap -> mut RTestCap: TestCap {'self
    .check c -> Block#
      .let[List[StackFrame]] st = {c._fetchTrace {sys.try.currentStackTrace}}
      .do {UnitTestLog.log(_PlanLine#("RUN",st))}
      .do {ts.add(CheckInfos#(
        { _ -> c#; ._fetchTrace f -> c._fetchTrace f },
        st))}
      .return {self};

    .checkWithSys c -> Block#
      .let[List[StackFrame]] st = {c._fetchTrace {sys.try.currentStackTrace}}
      .do {UnitTestLog.log(_PlanLine#("RUN",st))}
      .do {ts.add(CheckInfos#(c,st))}
      .return {self};

    .disabledCheck c -> Block#(
      UnitTestLog.log(_PlanLine#("DISABLED",c._fetchTrace {sys.try.currentStackTrace})),
      self);

    .disabledCheckWithSys c -> Block#(
      UnitTestLog.log(_PlanLine#("DISABLED",c._fetchTrace {sys.try.currentStackTrace})),
      self);

    .disabledTest _ -> Block#(
      UnitTestLog.log(_PlanLine#("DISABLED",sys.try.currentStackTrace)),
      self);

    mut .run: Void ->
      ts.seqFlow.forEach { ci->
        UnitTestLog.log(_AddToLog#(ci.stackTrace,sys.try#(sys.iso.close,{ t: iso System -> ci.check#t })))
      }
    }
  }

Check: { #: Void; ._fetchTrace(f: mut MF[List[StackFrame]]): List[StackFrame]->f#; }
CheckSys: { #(sys: mut System): Void; ._fetchTrace(f: mut MF[List[StackFrame]]): List[StackFrame]->f#; }

CheckInfos: F[CheckSys,List[StackFrame],CheckInfo] {c,st->CheckInfo: {
  .check: CheckSys->c; .stackTrace: List[StackFrame]->st;}}

Test: { .tests(t: mut TestCap): mut TestCap; }

//The frames that belong to this file or blocks.fear are the test DSL itself; the
//others are the user's, and the first of them is the real caller of a check.
_IsUserFile: F[Str, Bool] { fn -> fn.startsWith("testing.fear").not && {fn.startsWith("blocks.fear").not} }

_RealFrame: {
  #(st: List[StackFrame]): StackFrame -> st.flow.filter{_IsUserFile#(::.fileName)}.first!
  }

_AddToLog: {
  #(st: List[StackFrame], a: mut Action[Void]): Str -> Block#
    .let[StackFrame] f = {_RealFrame#st}
    .return {a.run {
      .ok _ ->
        `<testcase classname="` + (_XmlEscape#(f.typeName))
        + `" name="` + (_XmlEscape#(f.typeName)) + " at line: " + (f.lineNumber)
        + `" file="` + (_XmlEscape#(f.fileName))
        + `" line="` + (f.lineNumber)
        + `"></testcase>` |;
      .info i -> Block#(
        Debug#("Test failure "
          + (f.typeName) + " at line: "
          + (f.lineNumber) + " in file: "+ (f.fileName)
          | (_FailureText#i)
          ),
        `<testcase classname="` + (_XmlEscape#(f.typeName))
        + `" name="` + (_XmlEscape#(f.typeName)) + " at line: " + (f.lineNumber)
        + `" file="` + (_XmlEscape#(f.fileName))
        + `" line="` + (f.lineNumber)
        + `">`
        | (_FormatFailure#i)
        | "</testcase>" |
        );
    }};
  }

_FailureText: { #(i: Info): Str -> _FailureMsg#i | (_FailureList#i) }

_FailureMsg: {
  #(i: Info): Str ->
    i.extract{::.extractMsg}
    || {i.extract{:: > "msg" .extractMsg}} // what if the msg is nested in a map, prev implementation just returns `` silently
    .orLazy{i.str}
    //i.msg.isEmpty ? {
    //  .then -> i.softMap.opt(`msg`).match {
    //    .some e -> e.softMsg;
    //    .empty -> i.str;
    //  };
    //  .else -> i.msg;
    //};
  }

_FailureExpected: {
  #(i: Info): Str ->
    i.extract{:: > "expected" .extractMsg}.match {
      .some e -> "<expected>" + (_XmlEscape#e) + "</expected>" |;
      .empty -> "";
    };
    //i.map.opt(`expected`).match {
    //  .some e -> Block#(
    //    Debug#(`Expected: `+(e.msg)),
    //    `<expected>` + (_XmlEscape#(e.msg)) + `</expected>`
    //    );
    //  .empty -> ``;
    //};
  }

_FailureActual: {
  #(i: Info): Str ->
    i.extract{:: > "actual" .extractMsg}.match {
      .some a -> "<actual>" + (_XmlEscape#a) + "</actual>" |;
      .empty -> "";
    };
  }

_FailureList: {
  #(i: Info): Str ->
    i.extract{:: > "list" .extractList}
      .mapSome{::.flow.filter{_IsUserFile#(_FrameField#(::, "fileName"))}.map {_FailureTrace#::}.join ("" |)}
      .orValue ""
  }

_FormatFailure: {
  #(i: Info): Str ->
    "<failure>"
    | (_FailureExpected#i)
    + (_FailureActual#i)
    + (_XmlEscape#(_FailureText#i))
    | "</failure>";
  }

_FrameField: { #(i: Info, k: Str): Str ->
  i.extract{:: > k .extractMsg}
    ! {"Malformed stack frame info, missing key: " + k};
  // if the key isn't a message you get `` throwing out whatever information existed previously
  //i.map.opt(k).orLazy{Error.msg(`Malformed stack frame info, missing key: ` + k)}.msg
  }

_FailureTrace: { #(i: Info): Str -> Block#
  .let[Str] fn = {_FrameField#(i, "fileName")}
  .let[Str] tn = {_FrameField#(i, "typeName")}
  .let[Str] mn = {_FrameField#(i, "methodName")}
  .let[Str] ln = {_FrameField#(i, "lineNumber")}
  .let[Nat] sp = {mn.indexOf(" ").orLazy{Error.msg("Malformed stack frame methodName: " + mn)}}
  .return {
    mn.sub(0,sp + 1)
    + tn
    + (mn.sub(sp + 1,mn.size))
    + " error line: " + ln
    + " in file " + fn
    }
  }

_PlanLine: {
  #(kind: Str, st: List[StackFrame]): Str -> Block#
    .let[StackFrame] f = {_RealFrame#st}
    .return {
      "PLAN|"
      + kind
      + "|"
      + (f.fileName)
      + "|"
      + (f.typeName)
      + "|"
      + (f.typeName) + " at line: " + (f.lineNumber)
      + "|"
      + (f.lineNumber)|//| to end in new line
      };
  }

_XmlEscape: {
  #(s: Str): Str ->
    s.replaceSimultaneous(Lists#(
      "&", "&amp;",
      "<", "&lt;",
      `"`, "&quot;",
      ));}