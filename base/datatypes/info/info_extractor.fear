Extractor[T:*]: Sealed {
  /// `this.extract` returns the value extracted so far, if there is one.
  .extract: Opt[T];
  }

Extractor[T:*, Self]: Extractor[T] {
  .where(f: read F[InfoValidator, InfoCheck]): Self;
  }

/// `InfoExtractor` is a utility class to help extract values from an info.
/// Similar to `InfoValidator` you can descend into an info with the `>` operator.
/// ``.where`` keeps the extracted value only if it satisfies an `InfoValidator`.
//>   // info := {"friends": [{"name": "Bob"}, {"name": "Alice"}]}
//>   .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
//>   .checkEq(info, {info.extract{::}!})
//>   .checkEq("bob", {info.extract{:: > "friends" > 0 > "name" .extractMsg}.mapSome{::.lower}!})
//>   .checkEq("Bob, Alice", {info.extract{:: > "friends" .extractList .where{::
//>       & > 0 > "name" .isMsg{:: == "Bob"}
//>       & > 1 > "name" .isMsg{:: == "Alice"}
//>       }}
//>     .mapSome{::.flow.map{::.extract{:: > "name" .extractMsg}!}.join ", "}!})
//>   .checkTrue{info.extract{:: > "friends" .extractList .where{::
//>       & > 0 > "name" .isMsg{:: == "Bob"}
//>       & > 1 > "name" .isMsg{:: == "David"}
//>       }}.isEmpty}
InfoExtractor: Extractor[Info, InfoExtractor] {
  /// Descend one layer deeper into info,
  /// matching against it being a map with a key `key`
  /// or a List with index key: Nat.
  >(key: InfoKey): InfoExtractor -> {
    .extract -> this.extract.match{
      .some info -> key.indexInto info;
      .empty -> {};
      }
    };

  .where f -> this.extract.match{
    .some info -> info.validate f .match {
      .true -> this;
      .false -> InfoExtractor {
        .extract -> {}
        }
      };
    .empty -> this;
    };

  .extractMsg(fn: F[Str, Bool]): _StrExtractor -> this.extractMsg.where{::.isMsg fn};
  .extractList(fn: F[List[Info], Bool]): _ListExtractor -> this.extractList.where{::.isList fn};
  .extractMap(fn: F[Map[Str,Info], Bool]): _MapExtractor -> this.extractMap.where{::.isMap fn};

  .extractMsg: _StrExtractor -> {.extract -> this.extract.match{.some info -> info.msg; .empty -> {}}};
  .extractList: _ListExtractor -> {.extract -> this.extract.match{.some info -> info.list; .empty -> {}}};
  .extractMap: _MapExtractor -> {.extract -> this.extract.match{.some info -> info.map; .empty -> {}}};

  .extractEmpty: InfoExtractor -> {
    .extract -> this.extract.match {
      .empty -> {};
      .some i -> i.matchWithDefault {
        .empty -> Opts#(i);
        .default -> {};
        }
      }
    };
  }

_StrExtractor: Extractor[Str, _StrExtractor] {
  .extractMsg(fn: F[Str, Bool]): _StrExtractor -> this.where{::.isMsg fn};

  .where f ->  this.extract.match{
    .some str -> Infos.msg str .validate f .match {
      .true -> this;
      .false -> _StrExtractor {
        .extract -> {}
        }
      };
    .empty -> this;
    };
  }

_MapExtractor: Extractor[Map[Str,Info], _MapExtractor] {
  /// Descend deeper into the map
   > (key: Str): InfoExtractor -> {
    .extract -> this.extract.match{
      .empty -> {};
      .some m -> m.opt key;
      }
    };

  // Drop the extraction if the map doesn't match the value
  .extractMap(fn: F[Map[Str,Info], Bool]): _MapExtractor -> this.where{::.isMap fn};

  .where f -> this.extract.match{
    .some map -> map.info {::} .validate f .match {
      .true -> this;
      .false -> _MapExtractor {.extract -> {}}
      };
    .empty -> this;
    };
  }

_ListExtractor: Extractor[List[Info], _ListExtractor] {
  > (index: Nat): InfoExtractor -> {
    .extract -> this.extract.match{
      .empty -> {};
      .some l -> l.opt index;
      }
    };

  .extractList(fn: F[List[Info], Bool]): _ListExtractor -> this.where{::.isList fn};

  .where f -> this.extract.match{
    .some list -> list.info {::} .validate f .match {
      .true -> this;
      .false -> _ListExtractor {.extract -> {};}
      };
    .empty -> this;
    };
  }
