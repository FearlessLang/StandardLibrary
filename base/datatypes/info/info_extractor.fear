Extractor[T:*]: Sealed {
  .close: Info;
  /// `this.extract` returns the value extracted so far, if there is one.
  .extract: Opt[T];
  }

Extractor[T:*, Self]: Extractor[T] {
  .where(f: read F[InfoValidator, InfoValidator]): Self;
  }

/// `InfoExtractor` is a utility class to help extract values from an info.
/// Similar to `InfoValidator` you can descend into an info with the `>` operator.
/// ``.where`` keeps the extracted value only if it satisfies an `InfoValidator`.
//>   // info := {"friends": [{"name": "Bob"}, {"name": "Alice"}]}
//>   .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
//>   .check{info.extract{::}! .assertEq info}
//>   .check{info.extract{:: > "friends" > 0 > "name" .extractMsg}.mapSome{::.lower}! .assertEq "bob"}
//>   .check{info.extract{:: > "friends" .extractList .where{::
//>       & > 0 > "name" .isMsg{:: == "Bob"}
//>       & > 1 > "name" .isMsg{:: == "Alice"}
//>       }}
//>     .mapSome{::.flow.map{::.extract{:: > "name" .extractMsg}!}.join ", "}!
//>     .assertEq "Bob, Alice"}
//>   .check{info.extract{:: > "friends" .extractList .where{::
//>       & > 0 > "name" .isMsg{:: == "Bob"}
//>       & > 1 > "name" .isMsg{:: == "David"}
//>       }}.isEmpty .assertTrue}
InfoExtractor: Extractor[Info, InfoExtractor] {
  /// Descend one layer deeper into info,
  /// matching against it being a map with a key `key`
  /// or a List with index key: Nat.
  >(key: InfoKey): InfoExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match{
      .some info -> key.indexInto info;
      .empty -> {};
      }
    };

  .where f -> this.extract.match{
    .some info -> info.validate f .match {
      .true -> this;
      .false -> InfoExtractor {
        .close -> this.close;
        .extract -> {}
        }
      };
    .empty -> this;
    };

  .extractMsg(fn: F[Str, Bool]): _StrExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match {
      .some info -> info.matchWithDefault {
        .msg str -> fn# str .toOpt{str};
        .default -> {};
        };
      .empty -> {};
      }
    };

  .extractList(fn: F[List[Info], Bool]): _ListExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match {
      .some info -> info.matchWithDefault {
        .list l -> fn#(l).toOpt{l};
        .default -> {};
        };
      .empty -> {};
      }
    };

  .extractMap(fn: F[Map[Str,Info], Bool]): _MapExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match {
      .some info -> info.matchWithDefault {
        .map m -> fn#(m).toOpt{m};
        .default -> {};
        };
      .empty -> {};
      }
    };

  .extractMsg: _StrExtractor -> this.extractMsg{_ -> True};
  .extractList: _ListExtractor -> this.extractList{_ -> True};
  .extractMap: _MapExtractor -> this.extractMap{_ -> True};

  .extractEmpty: InfoExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match {
      .empty -> {};
      .some i -> i.matchWithDefault {
        .empty -> Opts#(i);
        .default -> {};
        }
      }
    };
  }

_StrExtractor: Extractor[Str, _StrExtractor] {
  .extractMsg(fn: F[Str, Bool]): _StrExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match{
      .empty -> {};
      .some str -> fn#(str).toOpt {str}
      }
    };

  .where f ->  this.extract.match{
    .some str -> Infos.msg str .validate f .match {
      .true -> this;
      .false -> _StrExtractor {
        .close -> this.close;
        .extract -> {}
        }
      };
    .empty -> this;
    };
  }

_MapExtractor: Extractor[Map[Str,Info], _MapExtractor] {
  /// Descend deeper into the map
   > (key: Str): InfoExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match{
      .empty -> {};
      .some m -> m.opt key;
      }
    };

  // Drop the extraction if the map doesn't match the value
  .extractMap(fn: F[Map[Str,Info], Bool]): _MapExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match{
      .empty -> {};
      .some m -> fn#(m).toOpt{m};
      }
    };

  .where f -> this.extract.match{
    .some map -> map.info {::} .validate f .match {
      .true -> this;
      .false -> _MapExtractor {.close -> this.close; .extract -> {}}
      };
    .empty -> this;
    };
  }

_ListExtractor: Extractor[List[Info], _ListExtractor] {
  > (index: Nat): InfoExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match{
      .empty -> {};
      .some l -> l.opt index;
      }
    };

  .extractList(fn: F[List[Info], Bool]): _ListExtractor -> {
    .close -> this.close;
    .extract -> this.extract.match{
      .empty -> {};
      .some l -> fn#(l).toOpt{l};
      }
    };

  .where f -> this.extract.match{
    .some list -> list.info {::} .validate f .match {
      .true -> this;
      .false -> _ListExtractor {.close -> this.close; .extract -> {};}
      };
    .empty -> this;
    };
  }
