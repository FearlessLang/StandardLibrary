Extractor[T:*]: Sealed {
  .close: Info;
  /// `this.extractedValue` returns the value extracted so far, if there is one.
  .extractedValue: mut Opt[T];

  #: mut Opt[T] -> this.extractedValue;
  }

Extractor[T:*, Self]: Extractor[T] {
  .where(f: read F[InfoValidator, InfoValidator]): Self;
  }

/// `InfoExtractor` is a utility class to help "fuzzy" extract values from an info.
/// Similar to `InfoValidator` you can descend into an info with the `>` operator.
/// You can match against some deep part of an info by combining this with `InfoValidator` using the `&` operator.
//>   // info := {"friends": [{"name": "Bob"}, {"name": "Alice"}]}
//>   .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
//>   .check{info.extract{::} .assertEq info}
//>   .check{info.extract{:: > "friends" > 0 > "name" .extractMsg}.map{::.lower}! == "bob"}
//>   .check{info.extract{:: > "friends" .extractList .where{::
//>       > 0 > "name" .isMsg{:: == "Bob"}
//>       & > 1 > "name" .isMsg{:: == "Alice"}
//>       }
//>     .map{::.flow.map{:: ~ > "name" .isMsg => {::}!}.join ", "}
//>     .assertEq(Opts# "Bob, Alice")}}
//>   .check{info ~ > "friends"
//>     & > 0 > "name" .isMsg{:: == "Bob"}
//>     & > 1 > "name" .isMsg{:: == "David"}
//>     ~ .isList => {::.flow.map{:: ~ > "name" .isMsg => {::}!}.join ", "}.assertEmpty {::}}
InfoExtractor: Extractor[Info, InfoExtractor] {
  /// Descend one layer deeper into info,
  /// matching against it being a map with a key `key`
  /// or a List with index key: Nat.
  >(key: InfoKey): InfoExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.then{key.indexInto ::}
    };

  .where f -> this.extractedValue.match{
    .some info -> info.validate f .match {
      .true -> this;
      .false -> InfoExtractor {
        .close -> this.close;
        .extractedValue -> {}
        }
      };
    .empty -> this;
    };

  .extractMsg(fn: F[Str, Bool]): StrExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.match {
      .some info -> info.match DefaultInfoMatch[mut Opt[Str]] {
        .msg str -> fn# str .toOpt{str};
        .default -> {};
        };
      .empty -> {};
      }
    };

  .extractList(fn: F[List[Info], Bool]): ListExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.then{::.match DefaultInfoMatch[mut Opt[List[Info]]] {
      .list l -> fn#(l).toOpt{l};
      .default -> {};
      }}
    };

  .extractMap(fn: F[Map[Str,Info], Bool]): MapExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.then{::.match DefaultInfoMatch[mut Opt[Map[Str,Info]]] {
      .map m -> fn#(m).toOpt{m};
      .default -> {};
      }}
    };

  .extractMsg: StrExtractor -> this.extractMsg{_ -> True};
  .extractList: ListExtractor -> this.extractList{_ -> True};
  .extractMap: MapExtractor -> this.extractMap{_ -> True};

  .extractEmpty: InfoExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.match {
      .empty -> {};
      .some i -> i.match {
        .msg _ -> {}; .list _ -> {}; .map _ -> {};
        .empty -> Opts#(i);
        }
      }
    };
  }

StrExtractor: Extractor[Str, StrExtractor] {
  .extractMsg(fn: F[Str, Bool]): StrExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.match{
      .empty -> {};
      .some str -> fn#(str).toOpt {str}
      }
    };

  .where f ->  this.extractedValue.match{
    .some str -> Infos.msg str .validate f .match {
      .true -> this;
      .false -> StrExtractor {
        .close -> this.close;
        .extractedValue -> {}
        }
      };
    .empty -> this;
    };
  }

MapExtractor: Extractor[Map[Str,Info], MapExtractor] {
  /// Descend deeper into the map
   > (key: Str): InfoExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.match{
      .empty -> {};
      .some m -> m.opt key;
      }
    };

  // Drop the extraction if the map doesn't match the value
  .extractMap(fn: F[Map[Str,Info], Bool]): MapExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.match{
      .empty -> {};
      .some m -> fn#(m).toOpt{m};
      }
    };

  .where f -> this.extractedValue.match{
    .some map -> Info {'i
        .match->::.map map;
        .map -> Opts# map;
        .imm->i;
        }.validate f
      .match {
        .true -> this;
        .false -> MapExtractor {.close -> this.close; .extractedValue -> {}}
        };
    .empty -> this;
    };
  }

ListExtractor: Extractor[List[Info], ListExtractor] {
  > (index: Nat): InfoExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.match{
      .empty -> {};
      .some l -> l.opt index;
      }
    };

  .extractList(fn: F[List[Info], Bool]): ListExtractor -> {
    .close -> this.close;
    .extractedValue -> this.extractedValue.match{
      .empty -> {};
      .some l -> fn#(l).toOpt{l};
      }
    };

  .where f -> this.extractedValue.match{
    .some list -> Info {'i
        .match->::.list list;
        .list -> Opts# list;
        .imm->i;
        }.validate f
      .match {
        .true -> this;
        .false -> ListExtractor {.close -> this.close; .extractedValue -> {};}
        };
    .empty -> this;
    };
  }
