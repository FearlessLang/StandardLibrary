Infos: Sealed {
  .msg(str: Str): Info -> str.isEmpty?{
    .then->{};
    .else->{'i
      .match->::.msg str;
      .msg -> Opts# str;
      .imm->i;
      }};
  .list(i1: read ToInfo): Info -> Lists#(i1.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo): Info -> Lists#(i1.info,i2.info).info {::};
  .map(k1: Str, e1: read ToInfo): Info-> Maps#({::},k1,e1.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info).info {::};
  /// parses text produced by ``Info.str`` back into the same `Info`; throws on malformed input
  .fromStr(s: Str): Info -> _InfoFromStr#(s);
  }

//To make an info from arbitrary map/list, just do myList.info {::} or myMap.info {::}
//how to turn keys into string is part of the key datatype of map
//will have to synthetize fresh key suffix if the str is already in there.
Info: Sealed,DataType[Info,Info],_AssertImmEmpty {
  .close->::; .close->this;
  .info->this.imm;
  .imm->{};
  .hash->this.str.hash;
  .cmp a,b,m -> a.str <=> (b.str, m);

  .msg: Opt[Str] -> {};
  .list: Opt[List[Info]] -> {};
  .map: Opt[Map[Str,Info]] -> {};

  .getMsg: Str-> this.msg! {"Info.getMsg: Tried an Info that is not a .msg variant to a Str."};
  .getList: List[Info]->this.list! {"Info.getList: Tried an Info that is not a .list variant to a List[Info]."};
  .getMap: Map[Str,Info]->this.map! {"Info.getMsg: Tried an Info that is not a .map variant to a Map[Str, Info]."};

  .softMsg: Str-> this.msg.orValue ``;
  .softList: List[Info]->this.list.orValue {};
  .softMap: Map[Str,Info]->this.map.orLazy{Maps#[Str,Str,Info] {::}};

  .isEmpty: Bool ->this.msg.isEmpty .and (this.list.isEmpty) .and (this.map.isEmpty);
  .match[R:**](m: InfoMatch[R]): R->m.empty;
  /// valid JSon text; ``.empty`` alone has no JSon value so renders as the bare word ``EmptyInfo``
  .str -> this.imm.match(_InfoToStr);
  +(other: Info) : Info -> this.match {
    .empty -> other;
    .msg(s1) -> other.match {
      .empty   -> this;
      .msg(s2) -> Infos.msg(s1|s2);
      .list(l2)-> Infos.map(`msg`,s1,`list`,l2.info {::});
      .map(_)  -> Infos.map(`msg`,s1)+other
      };
    .list(l1) -> other.match {
      .empty   -> this;
      .msg(s2) -> Infos.map(`msg`,s2,`list`,l1.info {::});
      .list(l2)-> l1 ++ l2 .info {::};
      .map(_)  -> Infos.map(`list`,l1.info {::}) + other;
      };
    .map(m1) -> other.match {
      .empty   -> this;
      .msg  s2 -> _InfoMapPlus#(m1, Infos.map(`msg`,s2).getMap) .info {::};
      .list l2 -> _InfoMapPlus#(m1, Infos.map(`list`,l2.info {::}).getMap) .info {::};
      .map  m2 -> _InfoMapPlus#(m1, m2) .info {::};
      };
    };

  .extract[R:*](f: read ExtractionFunction[R]): Opt[R] -> f#{.close -> this; .extractedValue -> Opts# this }#;
  .validate(f: read F[InfoValidator, InfoValidator]): Bool -> f#(InfoValidators# this)#;
  }

ExtractionFunction[R:*]: F[InfoExtractor, Extractor[R]] {}

/// Allow indexing into an info,
/// Union of Str (index into map) and Nat (index into list)
InfoKey: Sealed, ToStr {
  .indexInto(Info): mut Opt[Info];
  }

_InfoMapPlus: { #[K](m1: Map[K,Info], m2: Map[K,Info]): Map[K,Info] ->
  m2.flow.fold({m1}, {acc,ke->
    acc.opt(ke.key).match {
      .empty -> acc.with(ke.key, ke.elem);
      .some v -> acc.with(ke.key, v+(ke.elem));
    };
  });}

_InfoFreshKey: {
  #(m: Map[Str,Info], base: Str, i: Nat): Str -> Block#
    .let k= {i == 0 ? {.then->base; .else->base + `#` + i.str; }}
    .return { m.containsKey(k)?{
      .then -> this#(m, base, i + 1);
      .else -> k;
  }};}

InfoMatch[R:**]: {
  .empty: R;
  .msg(Str): R;
  .list(List[Info]): R;
  .map(Map[Str,Info]): R;
  }


DefaultInfoMatch[R:**]: InfoMatch[R] {
  .default: R;
  .empty -> this.default;
  .msg _ -> this.default;
  .list _ -> this.default;
  .map _ -> this.default;
  }


_InfoToStr: InfoMatch[Str] {
  .empty ->`EmptyInfo`;
  .msg(msg) -> _JsonEscape#msg;
  .list(list) -> `[` + (list.flow.map{::.str}.join(`,`)) + `]`;
  .map(map) -> `{` + (map.flow.map{_JsonEscape#(::.key) + `:` + (::.elem.str)}.join(`,`)) + `}`;
  }

/// Fearless Str never carries backslash escapes, so a raw ``"``, ``\`` or newline
/// has to be turned into the two-character JSon escape sequence by hand.
_JsonEscape: {
  #(s: Str): Str -> `"` + (s.replaceSimultaneous(Lists#(
    `\`, `\\`,
    `"`, `\"`,
    (`` |), `\n`,
    ))) + `"`;
  }

/// Inverse of `_JsonEscape`'s content: turns each two-character escape sequence back
/// into the raw character it stands for.
_JsonUnescape: {
  #(s: Str): Str -> s.replaceSimultaneous(Lists#(
    `\\`, `\`,
    `\"`, `"`,
    `\n`, (`` |),
    ));
  }

/// Recursive-descent inverse of `_InfoToStr`.
/// `.pos` always indexes the next unread character; each parsing method returns
/// both the `.info` it built and the position right after what it consumed.
_InfoParsed: { .info: Info; .pos: Nat }

_InfoFromStr: {
  #(s: Str): Info -> Block#
    .let result = {this.value(s, 0)}
    .if {(result.pos) != (s.size)} .error {`Infos.fromStr: unexpected trailing characters at position `+(result.pos)+` in `+(s.escape)+`.`}
    .return {result.info};

  .value(s: Str, pos: Nat): _InfoParsed -> Block#
    .if {pos >= (s.size)} .error {`Infos.fromStr: unexpected end of input while expecting a value in `+(s.escape)+`.`}
    .let c = {s.sub(pos, pos + 1)}
    .if {c == `"`} .return {this.msgValue(s, pos)}
    .if {c == `[`} .return {this.listValue(s, pos + 1, {})}
    .if {c == `{`} .return {this.mapValue(s, pos + 1, Maps#[Str,Str,Info]{::}.as{::})}
    .return {this.emptyValue(s, pos)};

  .emptyValue(s: Str, pos: Nat): _InfoParsed -> Block#
    .if {pos + 9 > (s.size)} .error {`Infos.fromStr: unexpected end of input while expecting a value in `+(s.escape)+`.`}
    .if {(s.sub(pos, pos + 9)) != `EmptyInfo`} .error {`Infos.fromStr: unexpected character at position `+pos+` in `+(s.escape)+`; expected a value.`}
    .return {_InfoParsed {.info -> Info; .pos -> pos + 9}};

  .msgValue(s: Str, pos: Nat): _InfoParsed -> Block#
    .let endIdx = {this.strEnd(s, pos + 1)}
    .return {_InfoParsed {
      .info -> Infos.msg(_JsonUnescape#(s.sub(pos + 1, endIdx)));
      .pos -> endIdx + 1;
      }};

  .strEnd(s: Str, pos: Nat): Nat -> Block#
    .if {pos >= (s.size)} .error {`Infos.fromStr: unterminated string in `+(s.escape)+`.`}
    .let c = {s.sub(pos, pos + 1)}
    .if {c == `"`} .return {pos}
    .if {c == `\`} .return {this.strEnd(s, pos + 2)}
    .return {this.strEnd(s, pos + 1)};

  .listValue(s: Str, pos: Nat, acc: List[Info]): _InfoParsed -> Block#
    .if {pos >= (s.size)} .error {`Infos.fromStr: unterminated list in `+(s.escape)+`.`}
    .if {(s.sub(pos, pos + 1)) == `]`} .return {_InfoParsed {.info -> this.list(acc); .pos -> pos + 1}}
    .let start = {acc.isEmpty ? {.then -> pos; .else -> this.expect(s, pos, `,`)}}
    .let elem = {this.value(s, start)}
    .return {this.listValue(s, elem.pos, acc +> (elem.info))};

  .mapValue(s: Str, pos: Nat, acc: Map[Str,Info]): _InfoParsed -> Block#
    .if {pos >= (s.size)} .error {`Infos.fromStr: unterminated map in `+(s.escape)+`.`}
    .if {(s.sub(pos, pos + 1)) == `}`} .return {_InfoParsed {.info -> this.map(acc); .pos -> pos + 1}}
    .let start = {acc.isEmpty ? {.then -> pos; .else -> this.expect(s, pos, `,`)}}
    .let key = {this.msgValue(s, start)}
    .let afterColon = {this.expect(s, key.pos, `:`)}
    .let elem = {this.value(s, afterColon)}
    .return {this.mapValue(s, elem.pos, acc.with(key.info.getMsg, elem.info).as{::})};

  .expect(s: Str, pos: Nat, ch: Str): Nat -> Block#
    .if {pos >= (s.size)} .error {`Infos.fromStr: unexpected end of input; expected `+(ch.escape)+` in `+(s.escape)+`.`}
    .if {(s.sub(pos, pos + 1)) != ch} .error {`Infos.fromStr: expected `+(ch.escape)+` at position `+pos+` in `+(s.escape)+`.`}
    .return {pos + 1};

  .list(list: List[Info]): Info -> {'i
    .match->::.list list;
    .list -> Opts# list;
    .imm->i;
    };

  .map(map: Map[Str,Info]): Info -> {'i
    .match->::.map map;
    .map -> Opts# map;
    .imm->i;
    };
  }

InfoToPrettyString: {
  #(i: Info): Str -> this#(i, 0);

  #(i: Info, depth: Nat): Str -> (i.match InfoMatch[Str] {
    .empty -> `EmptyInfo`;
    .msg(msg) -> msg.escape;
    .list list -> "[" | (list.flow.map{"  ".repeat(depth+1) + (this#(::, depth + 1))}.join(","|)) | + ("  ".repeat(depth)) + "]";
    .map(map) -> "{" | (map.flow.map{"  ".repeat(depth+1) + (::.key + ": " + (this#(::.elem, depth + 1)))}.join(","|)) | + ("  ".repeat(depth)) +"}";
  });
}
