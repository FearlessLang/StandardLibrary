//@Group "structured data"
Infos: Sealed {
  .msg(str: Str): Info -> str.isEmpty?{
    .then->{};
    .else->{'i
      .match->::.msg str;
      .msg -> Opts# str;
      .imm->i;
      }};
  .list(i1: read ToInfo): Info -> Lists#(i1.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo): Info -> Lists#(i1.info,i2.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo, i9: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info,i9.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo, i9: read ToInfo, i10: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info,i9.info,i10.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo, i9: read ToInfo, i10: read ToInfo, i11: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info,i9.info,i10.info,i11.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo, i9: read ToInfo, i10: read ToInfo, i11: read ToInfo, i12: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info,i9.info,i10.info,i11.info,i12.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo, i9: read ToInfo, i10: read ToInfo, i11: read ToInfo, i12: read ToInfo, i13: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info,i9.info,i10.info,i11.info,i12.info,i13.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo, i9: read ToInfo, i10: read ToInfo, i11: read ToInfo, i12: read ToInfo, i13: read ToInfo, i14: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info,i9.info,i10.info,i11.info,i12.info,i13.info,i14.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo, i9: read ToInfo, i10: read ToInfo, i11: read ToInfo, i12: read ToInfo, i13: read ToInfo, i14: read ToInfo, i15: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info,i9.info,i10.info,i11.info,i12.info,i13.info,i14.info,i15.info).info {::};
  .list(i1: read ToInfo, i2: read ToInfo, i3: read ToInfo, i4: read ToInfo, i5: read ToInfo, i6: read ToInfo, i7: read ToInfo, i8: read ToInfo, i9: read ToInfo, i10: read ToInfo, i11: read ToInfo, i12: read ToInfo, i13: read ToInfo, i14: read ToInfo, i15: read ToInfo, i16: read ToInfo): Info -> Lists#(i1.info,i2.info,i3.info,i4.info,i5.info,i6.info,i7.info,i8.info,i9.info,i10.info,i11.info,i12.info,i13.info,i14.info,i15.info,i16.info).info {::};
  .map(k1: Str, e1: read ToInfo): Info-> Maps#({::},k1,e1.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo,k6: Str, e6: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info,k6,e6.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo,k6: Str, e6: read ToInfo,k7: Str, e7: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info,k6,e6.info,k7,e7.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo,k6: Str, e6: read ToInfo,k7: Str, e7: read ToInfo,k8: Str, e8: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info,k6,e6.info,k7,e7.info,k8,e8.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo,k6: Str, e6: read ToInfo,k7: Str, e7: read ToInfo,k8: Str, e8: read ToInfo,k9: Str, e9: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info,k6,e6.info,k7,e7.info,k8,e8.info,k9,e9.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo,k6: Str, e6: read ToInfo,k7: Str, e7: read ToInfo,k8: Str, e8: read ToInfo,k9: Str, e9: read ToInfo,k10: Str, e10: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info,k6,e6.info,k7,e7.info,k8,e8.info,k9,e9.info,k10,e10.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo,k6: Str, e6: read ToInfo,k7: Str, e7: read ToInfo,k8: Str, e8: read ToInfo,k9: Str, e9: read ToInfo,k10: Str, e10: read ToInfo,k11: Str, e11: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info,k6,e6.info,k7,e7.info,k8,e8.info,k9,e9.info,k10,e10.info,k11,e11.info).info {::};
  .map(k1: Str, e1: read ToInfo,k2: Str, e2: read ToInfo,k3: Str, e3: read ToInfo,k4: Str, e4: read ToInfo,k5: Str, e5: read ToInfo,k6: Str, e6: read ToInfo,k7: Str, e7: read ToInfo,k8: Str, e8: read ToInfo,k9: Str, e9: read ToInfo,k10: Str, e10: read ToInfo,k11: Str, e11: read ToInfo,k12: Str, e12: read ToInfo): Info-> Maps#({::},k1,e1.info,k2,e2.info,k3,e3.info,k4,e4.info,k5,e5.info,k6,e6.info,k7,e7.info,k8,e8.info,k9,e9.info,k10,e10.info,k11,e11.info,k12,e12.info).info {::};
  /// parses text produced by ``Info.str`` or ``Info.prettyStr`` back into the same `Info`; throws on malformed input.
  /// Spaces and new lines between the parts of the text are ignored.
  .fromStr(s: Str): Info -> _InfoFromStr#(s);
  }

//To make an info from arbitrary map/list, just do myList.info {::} or myMap.info {::}
//how to turn keys into string is part of the key datatype of map
//@Group "structured data"
//@Group "errors"
Info: Sealed,DataType[Info,Info],_AssertImmEmpty {
  .close->this;
  .info->this.imm;
  .imm->{};
  .hash->this.str.hash;
  .cmp a,b -> a.str <=> (b.str);

  .msg: Opt[Str] -> {};
  .list: Opt[List[Info]] -> {};
  /// The keys of a `.map` variant are in increasing order of `Str`, whatever the order the map was built in.
  .map: Opt[Map[Str,Info]] -> {};

  .getMsg: Str-> this.tryGetMsg!;
  .getList: List[Info]->this.tryGetList!;
  .getMap: Map[Str,Info]->this.tryGetMap!;
  /// `this.tryGetMsg` returns `.ok` of `this.getMsg`, or the error info of `this.getMsg` if `this` is not the `.msg` variant.
  //>   .check{((Infos.msg "hi").tryGetMsg).ok.assertEq({::}, Opts# "hi")}
  //>   .check{(Infos.list(Infos.msg "hi")).tryGetMsg .assertInfo{::.isMsg{::.startsWith "Info.getMsg:"}}}
  .tryGetMsg: mut Action[Str]-> this.msg.match{.some x -> Actions.ok x; .empty -> Actions.msg(_InfoNotA#(this, ".getMsg", ".msg"))};
  /// `this.tryGetList` returns `.ok` of `this.getList`, or the error info of `this.getList` if `this` is not the `.list` variant.
  //>   .check{(Infos.list(Infos.msg "hi")).tryGetList .assertOk}
  //>   .check{(Infos.msg "hi").tryGetList .assertInfo{::.isMsg{::.startsWith "Info.getList:"}}}
  .tryGetList: mut Action[List[Info]]->this.list.match{.some x -> Actions.ok x; .empty -> Actions.msg(_InfoNotA#(this, ".getList", ".list"))};
  /// `this.tryGetMap` returns `.ok` of `this.getMap`, or the error info of `this.getMap` if `this` is not the `.map` variant.
  //>   .check{(Infos.map("k", Infos.msg "hi")).tryGetMap .assertOk}
  //>   .check{(Infos.msg "hi").tryGetMap .assertInfo{::.isMsg{::.startsWith "Info.getMap:"}}}
  .tryGetMap: mut Action[Map[Str,Info]]->this.map.match{.some x -> Actions.ok x; .empty -> Actions.msg(_InfoNotA#(this, ".getMap", ".map"))};

  .softMsg: Str-> this.msg.orValue "";
  .softList: List[Info]->this.list.orValue {};
  .softMap: Map[Str,Info]->this.map.orLazy{Maps#[Str,Str,Info] {::}};

  .isEmpty: Bool ->this.msg.isEmpty .and (this.list.isEmpty) .and (this.map.isEmpty);
  .match[R:**](m: InfoMatch[R]): R->m.empty;
  .matchWithDefault[R:**](m: DefaultInfoMatch[R]): R -> this.match(m);
  /// valid JSon text; ``.empty`` renders as the JSon ``null``
  .str -> this.imm.match(_InfoToStr);
  .prettyStr: Str -> _InfoToPrettyString#(this);
  +(other: Info) : Info -> this.match {
    .empty -> other;
    .msg(s1) -> other.matchWithDefault{ .msg(s2) -> Infos.msg(s1|s2); .default -> _InfoPlus#(this, other) };
    .list(l1) -> other.matchWithDefault{ .list(l2) -> l1 ++ l2 .info {::}; .default -> _InfoPlus#(this, other) };
    .map(_) -> _InfoPlus#(this, other);
    };

  .extract[R:*](f: read ExtractionFunction[R]): Opt[R] -> f#{.extract -> Opts# this }.extract;
  .validate(f: read F[InfoValidator, InfoCheck]): Bool -> f#(_InfoValidators# this).isValid;
  }

//@Group "structured data"
ExtractionFunction[R:*]: F[InfoExtractor, Extractor[R]] {}

//@Group "structured data"
/// Allow indexing into an info,
/// Union of Str (index into map) and Nat (index into list)
InfoKey: Sealed, ToStr {
  .indexInto(Info): Opt[Info];
  }

_InfoPlus: {
  #(a: Info, b: Info): Info -> b.isEmpty ? {.then -> a; .else -> _InfoMapPlus#(this.lift a, this.lift b) .info {::}};
  .lift(i: Info): Map[Str,Info] -> i.match{
    .empty -> Unreachable!;
    .msg s -> Maps#({::}, "msg", s.info);
    .list l -> Maps#({::}, "list", l.info {::});
    .map m -> m;
    };
  }

_InfoMapPlus: { #(m1: Map[Str,Info], m2: Map[Str,Info]): Map[Str,Info] ->
  m2.fold({m1}, {acc, k, e ->
    acc.opt(k).match {
      .empty -> acc.with(k, e);
      .some v -> acc.with(k, v + e);
    };
  });}

_InfoNotA: { #(i: Info, method: Str, variant: Str): Str ->
  "Info"+method+": the Info "+(i.str)+" is the "+(i.match InfoMatch[Str]{.empty -> ".empty"; .msg _ -> ".msg"; .list _ -> ".list"; .map _ -> ".map"})+" variant, not the "+variant+" variant."
  }

_InfoFreshKey: {
  #(m: Map[Str,Info], base: Str, i: Nat): Str -> Block#
    .let k= {i == 0 ? {.then->base; .else->base + "#" + i.str; }}
    .return { m.containsKey(k)?{
      .then -> this#(m, base, i + 1);
      .else -> k;
  }};}

//@Group "structured data"
InfoMatch[R:**]: {
  .empty: R;
  .msg(Str): R;
  .list(List[Info]): R;
  .map(Map[Str,Info]): R;
  }


//@Group "structured data"
DefaultInfoMatch[R:**]: InfoMatch[R] {
  .default: R;
  .empty -> this.default;
  .msg _ -> this.default;
  .list _ -> this.default;
  .map _ -> this.default;
  }


_InfoToStr: InfoMatch[Str] {
  .empty ->"null";
  .msg(msg) -> _JsonEscape#msg;
  .list(list) -> "[" + (list.flow.map{::.str}.join(",")) + "]";
  .map(map) -> "{" + (map.flow{k, e -> _JsonEscape#k + ":" + (e.str)}.join(",")) + "}";
  }

_JsonEscape: {
  #(s: Str): Str -> `"` + (s.replaceSimultaneous(Lists#(
    "\", "\\",
    `"`, `\"`,
    ("" |), "\n",
    ))) + `"`;
  }

_JsonUnescape: {
  #(s: Str): Str -> s.replaceSimultaneous(Lists#(
    "\\", "\",
    `\"`, `"`,
    "\n", ("" |),
    ));
  }

_InfoParsed: { .info: Info; .pos: Nat }

_InfoOpen: { .name: Str; .from: Nat }

_InfoFromStrMessage: Sealed{ #(text: Str, names: List[Str], spans: List[Nat], why: Str): Str -> _Magic! }

_InfoFromStr: {
  #(s: Str): Info -> Block#
    .let result = {this.value(s, 0, {})}
    .let after = {this.skip(s, result.pos)}
    .if {after != (s.size)} .error {this.fail(s, {}, "", after, this.last(s), this.last(s), "Unexpected characters after the value.")}
    .return {result.info};

  .last(s: Str): Nat -> s.isEmpty ? {.then -> 0; .else -> s.size - 1};

  .upTo(a: Nat, b: Nat): Nat -> a < b ? {.then -> a; .else -> b};

  .open(name: Str, from: Nat, fs: List[_InfoOpen]): List[_InfoOpen] -> fs.withAlso(0, {.name -> name; .from -> from});

  .fail(s: Str, fs: List[_InfoOpen], name: Str, from: Nat, to: Nat, upTo: Nat, why: Str): Str -> _InfoFromStrMessage#(
    s,
    Lists#(name) ++ (fs.flow.map{::.name}.list) ++ (Lists#("full text")),
    Lists#(from, to) ++ (fs.flow.flatMap{f -> Lists#(f.from, upTo)}.list) ++ (Lists#(0, this.last(s))),
    why);

  .skip(s: Str, pos: Nat): Nat -> (pos < (s.size)) && {Block#
    .let c = {s.sub(pos, pos + 1)}
    .return {c == " " || {c == ("" |)}}
    } ? {.then -> this.skip(s, pos + 1); .else -> pos};

  .value(s: Str, start: Nat, fs: List[_InfoOpen]): _InfoParsed -> Block#
    .let pos = {this.skip(s, start)}
    .if {pos >= (s.size)} .error {this.fail(s, fs, "", this.last(s), this.last(s), this.last(s), "Unexpected end of the text." | "Expected: a value.")}
    .let c = {s.sub(pos, pos + 1)}
    .if {c == `"`} .return {this.msgValue(s, pos, fs)}
    .if {c == "["} .return {this.listValue(s, pos + 1, this.open("list", pos, fs))}
    .if {c == "{"} .return {this.mapValue(s, pos + 1, this.open("map", pos, fs))}
    .return {this.emptyValue(s, pos, fs)};

  .emptyValue(s: Str, pos: Nat, fs: List[_InfoOpen]): _InfoParsed -> Block#
    .if {pos + 4 > (s.size)} .error {this.fail(s, fs, "", pos, this.last(s), this.last(s), "Unexpected end of the text." | "Expected: a value.")}
    .if {(s.sub(pos, pos + 4)) != "null"} .error {this.fail(s, fs, "", pos, pos, pos, "Unexpected character." | "Expected: a value.")}
    .return {_InfoParsed {.info -> Info; .pos -> pos + 4}};

  .msgValue(s: Str, pos: Nat, fs: List[_InfoOpen]): _InfoParsed -> Block#
    .let endIdx = {this.strEnd(s, pos + 1, this.open("string", pos, fs))}
    .return {_InfoParsed {
      .info -> Infos.msg(_JsonUnescape#(s.sub(pos + 1, endIdx)));
      .pos -> endIdx + 1;
      }};

  .strEnd(s: Str, pos: Nat, fs: List[_InfoOpen]): Nat -> Block#
    .var[Nat] i = {pos}
    .loop { Block#
      .if {(i.get) >= (s.size)} .error {this.fail(s, fs, "", pos - 1, this.last(s), this.last(s), "Unterminated string.")}
      .let c = {s.sub(i.get, (i.get) + 1)}
      .if {c == `"`} .return {OuterReturn#(i.get)}
      .let[Nat] at = {i.get}
      .if {c == "\" && {this.isEscape(s, at).not}} .error {Block#
        .let[Nat] end = {this.upTo(at + 1, this.last(s))}
        .return {this.fail(s, fs, "", at, end, end, ("Invalid escape " + (s.sub(at, end + 1).escape) + ".") | `The escapes are "\\", "\"" and "\n".`)}
        }
      .do {i.set((i.get) + (c == "\" ? {.then -> 2; .else -> 1}))}
      .return {Continue#}
      }
    .return {Unreachable!};

  .isEscape(s: Str, pos: Nat): Bool -> (pos + 2 <= (s.size)) && {Block#
    .let e = {s.sub(pos, pos + 2)}
    .return {e == "\\" || {e == `\"`} || {e == "\n"}}
    };

  .listValue(s: Str, pos: Nat, fs: List[_InfoOpen]): _InfoParsed -> Block#
    .var[Nat] i = {pos}
    .let acc = {ELists#[Info]}
    .loop { Block#
      .let[Nat] at = {this.skip(s, i.get)}
      .if {at >= (s.size)} .error {this.fail(s, fs, "", pos - 1, this.last(s), this.last(s), "Unterminated list.")}
      .if {(s.sub(at, at + 1)) == "]"} .return {Block#
        .let result = {(acc.list).info {::}}
        .return {OuterReturn#(_InfoParsed {.info -> result; .pos -> at + 1})}
        }
      .let start = {(acc.size) == 0 ? {.then -> at; .else -> this.expect(s, at, ",", fs)}}
      .let elem = {this.value(s, start, this.open("list element", this.skip(s, start), fs))}
      .do {acc.add(elem.info).void}
      .do {i.set(elem.pos)}
      .return {Continue#}
      }
    .return {Unreachable!};

  .mapValue(s: Str, pos: Nat, fs: List[_InfoOpen]): _InfoParsed -> Block#
    .var[Nat] i = {pos}
    .let acc = {ELists#[KeyElem[Str,Info]]}
    .let keys = {ESets#[Str,Str]{::}}
    .loop { Block#
      .let[Nat] at = {this.skip(s, i.get)}
      .if {at >= (s.size)} .error {this.fail(s, fs, "", pos - 1, this.last(s), this.last(s), "Unterminated map.")}
      .if {(s.sub(at, at + 1)) == "}"} .return {Block#
        .let result = {(acc.list).seqFlow.mapping({::}, {.key e -> e.key; .elem e -> e.elem}).info {::}}
        .return {OuterReturn#(_InfoParsed {.info -> result; .pos -> at + 1})}
        }
      .let start = {(acc.size) == 0 ? {.then -> at; .else -> this.expect(s, at, ",", fs)}}
      .let[Nat] q = {this.skip(s, start)}
      .let entry = {this.open("map entry", q, fs)}
      .let keyStart = {this.expect(s, q, `"`, entry)}
      .let keyEnd = {this.strEnd(s, keyStart, this.open("map key", q, entry))}
      .let key = {_JsonUnescape#(s.sub(keyStart, keyEnd))}
      .let afterColon = {this.expect(s, this.skip(s, keyEnd + 1), ":", entry)}
      .let elem = {this.value(s, afterColon, entry)}
      .if {keys.contains key} .error {this.fail(s, entry, "map key", q, keyEnd, elem.pos - 1, "Repeated key " + (key.escape) + ".")}
      .do {keys.add(key).void}
      .do {acc.add({.key -> key; .elem -> elem.info}).void}
      .do {i.set(elem.pos)}
      .return {Continue#}
      }
    .return {Unreachable!};

  .expect(s: Str, pos: Nat, ch: Str, fs: List[_InfoOpen]): Nat -> Block#
    .if {pos >= (s.size)} .error {this.fail(s, fs, "", this.last(s), this.last(s), this.last(s), "Unexpected end of the text." | ("Expected: " + (ch.escape) + "."))}
    .if {(s.sub(pos, pos + 1)) != ch} .error {this.fail(s, fs, "", pos, pos, pos, "Unexpected character." | ("Expected: " + (ch.escape) + "."))}
    .return {pos + 1};
  }

_InfoToPrettyString: {
  #(i: Info): Str -> this#(i, 0);

  #(i: Info, depth: Nat): Str -> (i.match InfoMatch[Str] {
    .empty -> "null";
    .msg(msg) -> _JsonEscape#msg;
    .list list -> "[" | (list.flow.map{"  ".repeat(depth+1) + (this#(::, depth + 1))}.join(","|)) | + ("  ".repeat(depth)) + "]";
    .map(map) -> "{" | (map.flow{k, e -> "  ".repeat(depth+1) + (_JsonEscape#k + ": " + (this#(e, depth + 1)))}.join(","|)) | + ("  ".repeat(depth)) +"}";
  });
}
