InfoValidators: Sealed {
  #(info: Info): InfoValidator -> _SuccessfulInfoValidator { .close -> info }
  }

/// `InfoValidator` is a utility class to help match `Info`s. This is useful for dealing with error's in `Action`s,
/// as you can match against the error info to determine what to do next.
/// `InfoValidator`s start from a "root" `Info`, which you can descend into with the `>` operator.
/// For example, ``this > "friends" > 0 > "name"`` will match against an `Info` that is a map with a key ``"friends"`` that is a list with at least one element, and that first element is a map with a key ``"name"``.
/// Often you will want to match against multiple parts of an `Info`, if so you can chain `InfoValidator`s together with the ``&``, ``|`` operators.
/// Each one of these operations will bring you back to the root `Info` to start matching from again.
/// These follow standard fearless operator precedence (left associativity), with no preference between operators.
/// For example: ``InfoValidators# info > "friends" > 0 .isMsg{:: == "Alice"}  | > "friends" > 1 .isMsg {:: == "Bob"} & > "friends" > 2 .isMsg{:: == "Carol"}``
/// can be summarised as (first friend is "Alice" OR second friend is "Bob") AND (third friend is "Carol").
/// If you wish to avoid left associativity you can use the `.where` operator.
/// For example: ```InfoValidators# info > "friends" > 0 .isMsg{:: == "Alice"} | > "friends" .where {
///   :: > 1 .isMsg {:: == "Bob"}} & > "friends" > 2 .isMsg{:: == "Carol"}
///   }``` which will get read as (first friend is "Alice" OR (second friend is "Bob" AND third friend is "Carol")).
/// Expressions can also be negated with `.not`, `.not` acts upon the current "local" expression and doesn't negate the whole expression.
/// Note: ``::`` will match any Info, so you can start an expression with ``:: &`` as ``::`` is always true, this means you should not start with ``|`` as ``:: |`` will always be true
//>   // info := {"friends": [{"name": "Bob"}, {"name": "Alice"}]}
//>   .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
//>   .checkTrue{info.validate{::}}
//>   .checkTrue{info.validate{:: > "friends" > 0 > "name" .isMsg{:: == "Bob"}}}
//>   .checkTrue{info.validate{::
//>     & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
//>     & > "friends" > 1 > "name" .isMsg{:: == "Alice"}
//>     }}
//>   .checkTrue{info.validate{:: > "friends" .isList{::.size == 2}}}
//>   .checkFalse{info.validate{::
//>     & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
//>     | > "friends" > 1 > "name" .isMsg{:: == "Alice"}
//>     & > "friends" > 2 > "name" .isMsg{:: == "David"}}}
//>   .checkFalse{info.validate{:: > "friends" .where{::
//>     & > 0 > "name" .isMsg{:: == "Bob"}
//>     | > 1 > "name" .isMsg{:: == "Alice"}
//>     & > 2 > "name" .isMsg{:: == "David"}}}}
//>   .checkTrue{info.validate{::
//>     & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
//>     | > "friends" .where {::
//>       & > 1 > "name" .isMsg{:: == "Alice"}
//>       & > 2 > "name" .isMsg{:: == "David"}}}}
//>   .checkTrue{info.validate{::
//>     & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
//>     & > "friends" > 1 > "name" .isMsg{:: == "David"}.not
//>   }}
InfoValidator: Sealed {
  .close: Info;
  .isValid: Bool;

  >(key: InfoKey): InfoValidator;

  .where(f: read F[InfoValidator, InfoValidator]): InfoValidator;
  .extract[R:*](f: read ExtractionFunction[R]): Opt[R] -> this.isValid.if {
    .then -> f#{.close -> this.close; .extract -> Opts#(this.close)}.extract;
    .else -> {};
    };

  .isMsg(F[Str, Bool]): InfoValidator;
  .isList(fn: F[List[Info], Bool]): InfoValidator;
  .isMap(fn: F[Map[Str,Info], Bool]): InfoValidator;

  .isMsg: InfoValidator -> this.isMsg{_ -> True};
  .isList: InfoValidator -> this.isList{_ -> True};
  .isMap: InfoValidator -> this.isMap{_ -> True};
  .isEmpty: InfoValidator;

  .not: InfoValidator;

  &: InfoValidator -> _ChainedInfoValidator {
    .close -> this.close;
    .left -> this;
    .right -> InfoValidators#(this.close);
    .combiner l, r -> l & r;
    };

  |: InfoValidator -> _ChainedInfoValidator {
    .close -> this.close;
    .left -> this;
    .right -> InfoValidators#(this.close);
    .combiner l, r -> l | r;
    };
  }

_SuccessfulInfoValidator: InfoValidator {
  /// The Base level info we are matching on, different from .matchLevel as it is the base we chain on.
  /// Is an opt as the matchers produced by InfoExtractors may not have an info in them.
  .close: Info;

  .isValid: Bool -> True;
  /// The info we are matching against - how far we have "descended" into info.
  .matchLevel: Info -> this.close;

  > key -> key.indexInto(this.matchLevel).match {
    .some info -> _SuccessfulInfoValidator { .close -> this.close; .matchLevel -> info; };
    .empty -> _FailedInfoValidator {this.close};
    };

  .where f -> this.matchLevel.validate f .match {
    .true -> this;
    .false -> _FailedInfoValidator {this.close}
    };

  // look for something better for the .match
  .isMsg fn -> this.matchLevel.matchWithDefault {
    .msg m -> fn# m .match {
      .true -> this;
      .false -> _FailedInfoValidator {this.close};
      };
    .default -> _FailedInfoValidator {this.close};
    };

  .isList fn -> this.matchLevel.matchWithDefault {
    .list l -> fn#(l) .match {
      .true -> this;
      .false -> _FailedInfoValidator {this.close};
      };
    .default -> _FailedInfoValidator {this.close}
    };

  .isMap fn -> this.matchLevel.matchWithDefault {
    .map m -> fn#(m) .match {
      .true -> this;
      .false -> _FailedInfoValidator {this.close};
      };
    .default -> _FailedInfoValidator {this.close}
    };

  .isEmpty -> this.matchLevel.matchWithDefault {
    .empty -> this;
    .default -> _FailedInfoValidator {this.close};
    };

  .not -> _FailedInfoValidator {this.close};

  &  -> _SuccessfulInfoValidator {this.close};
  // note this uses the above or's as otherwise you just always ignore this
  }

_FailedInfoValidator: InfoValidator {
  .close: Info;

  .isValid -> False;

  > _ -> this;
  .where _ -> this;

  .isMsg _ -> this;
  .isList _ -> this;
  .isMap _ -> this;
  .isEmpty -> this;

  .not -> _SuccessfulInfoValidator {this.close};

  & -> this;

  |: InfoValidator -> _SuccessfulInfoValidator {this.close};
  }

_ChainedInfoValidator: InfoValidator {
  .close: Info;
  .left: InfoValidator;
  .right: InfoValidator;
  .combiner(Bool, Bool): Bool;
  .isValid: Bool -> this.combiner(this.left.isValid, this.right.isValid);

  > key -> _ChainedInfoValidator {
    .close -> this.close;
    .combiner a, b -> this.combiner(a,b);
    .left -> this.left;
    .right -> this.right > key
    };

  // can use pipe
  .where f -> Block#
    .let right={this.right.where f}
    .return{ _ChainedInfoValidator {
      .close -> this.close;
      .combiner a, b -> this.combiner(a,b);
      .left -> this.left;
      .right -> right
      }};


  .isMsg f -> _ChainedInfoValidator {
    .close -> this.close;
    .combiner a, b -> this.combiner(a,b);
    .left -> this.left;
    .right -> this.right.isMsg f
    };

  .isList f -> _ChainedInfoValidator {
    .close -> this.close;
    .combiner a, b -> this.combiner(a,b);
    .left -> this.left;
    .right -> this.right.isList f
    };

  .isMap f -> _ChainedInfoValidator {
    .close -> this.close;
    .combiner a, b -> this.combiner(a,b);
    .left -> this.left;
    .right -> this.right.isMap f
    };

  .isEmpty -> _ChainedInfoValidator {
   .close -> this.close;
   .combiner a, b -> this.combiner(a,b);
   .left -> this.left;
   .right -> this.right.isEmpty
   };

  .not -> _ChainedInfoValidator {
   .close -> this.close;
   .combiner a, b -> this.combiner(a,b);
   .left -> this.left;
   .right -> this.right.not
   };
  }
