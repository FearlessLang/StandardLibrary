_InfoValidators: Sealed {
  #(info: Info): InfoValidator -> _SuccessfulInfoValidator { .close -> info }
  }

//@Group "input"
//@Group "structured data"
/// `InfoValidator` matches the shape and content of an `Info`, for example the error info of an `Action`.
/// A validator starts from a root `Info` and descends into it with `>`:
/// ``this > "friends" > 0 > "name"`` holds if the root is a map with key ``"friends"``, holding a list whose first element is a map with key ``"name"``.
/// Validators combine with `&` and `|`; each of them restarts from the root.
/// `&` and `|` associate to the left with no precedence between them:
/// ``:: > "a" .isMsg | > "b" .isMsg & > "c" .isMsg`` reads as ``(a or b) and c``.
/// ``.where`` groups a sub expression evaluated from the current position:
/// ``:: > "a" .isMsg | > "b" .where{:: > 0 .isMsg & > 1 .isMsg}`` reads as ``a or (b.0 and b.1)``.
/// ``.whereNot`` is ``.where`` with the sub expression negated:
/// ``:: > "b" .whereNot{:: > 0 .isMsg & > 1 .isMsg}`` reads as ``b exists and not (b.0 and b.1)``.
/// `.isMsg`, `.isList`, `.isMap`, `.isEmpty`, ``.where`` and ``.whereNot`` are the last step of the current validator: after them come only `&`, `|` and `.isValid`.
/// ``::`` alone holds for any `Info`, so ``:: & ...`` is a neutral start, while ``:: | ...`` always holds.
//>   // info := {"friends": [{"name": "Bob"}, {"name": "Alice"}]}
//>   .let info={Infos.map("friends", Infos.list(Infos.map("name", "Bob"), Infos.map("name", "Alice")))}
//>   .checkTrue{info.validate{::}}
//>   .checkTrue{info.validate{:: > "friends" > 0 > "name" .isMsg{:: == "Bob"}}}
//>   .checkTrue{info.validate{::
//>     & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
//>     & > "friends" > 1 > "name" .isMsg{:: == "Alice"}
//>     }}
//>   .checkTrue{info.validate{:: > "friends" .isList{::.size == 2}}}
//>   .checkFalse{info.validate{::
//>     & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
//>     | > "friends" > 1 > "name" .isMsg{:: == "Alice"}
//>     & > "friends" > 2 > "name" .isMsg{:: == "David"}}}
//>   .checkTrue{info.validate{::
//>     & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
//>     | > "friends" .where{::
//>       & > 1 > "name" .isMsg{:: == "Alice"}
//>       & > 2 > "name" .isMsg{:: == "David"}}}}
//>   .checkTrue{info.validate{::
//>     & > "friends" > 0 > "name" .isMsg{:: == "Bob"}
//>     & > "friends" > 1 > "name" .whereNot{::.isMsg{:: == "David"}}}}
InfoValidator: InfoCheck {
  >(key: InfoKey): InfoValidator;

  .where(f: read F[InfoValidator, InfoCheck]): InfoCheck;
  .whereNot(f: read F[InfoValidator, InfoCheck]): InfoCheck;

  .isMsg(F[Str, Bool]): InfoCheck;
  .isList(fn: F[List[Info], Bool]): InfoCheck;
  .isMap(fn: F[Map[Str,Info], Bool]): InfoCheck;

  .isMsg: InfoCheck -> this.isMsg{_ -> True};
  .isList: InfoCheck -> this.isList{_ -> True};
  .isMap: InfoCheck -> this.isMap{_ -> True};
  .isEmpty: InfoCheck;
  }

//@Group "input"
//@Group "structured data"
/// `InfoCheck` is what the last step of a validator returns, and what `Info.validate` and ``.where`` accept.
InfoCheck: Sealed {
  .close: Info;
  .isValid: Bool;

  &: InfoValidator -> this.isValid.if {
    .then -> _InfoValidators#(this.close);
    .else -> _SettledInfoValidator {.close -> this.close; .isValid -> False};
    };

  |: InfoValidator -> this.isValid.if {
    .then -> _SettledInfoValidator {.close -> this.close; .isValid -> True};
    .else -> _InfoValidators#(this.close);
    };
  }

_SettledInfoValidator: InfoValidator {
  .close: Info;
  .isValid: Bool;

  > _ -> this;
  .where _ -> this;
  .whereNot _ -> this;

  .isMsg _ -> this;
  .isList _ -> this;
  .isMap _ -> this;
  .isEmpty -> this;
  }

_SuccessfulInfoValidator: InfoValidator {
  /// The Base level info we are matching on.
  .close: Info;

  .isValid: Bool -> True;
  /// The info we are matching against - how far we have "descended" into info.
  .matchLevel: Info -> this.close;
  .fail: InfoValidator -> _SettledInfoValidator {.close -> this.close; .isValid -> False};

  > key -> key.indexInto(this.matchLevel).match {
    .some info -> _SuccessfulInfoValidator { .close -> this.close; .matchLevel -> info; };
    .empty -> this.fail;
    };

  .where f -> _InfoCheck#(this, this.matchLevel.validate f);
  .whereNot f -> _InfoCheck#(this, this.matchLevel.validate f .not);
  .isMsg fn -> this.matchLevel.matchWithDefault {.msg m -> _InfoCheck#(this, fn# m); .default -> this.fail};
  .isList fn -> this.matchLevel.matchWithDefault {.list l -> _InfoCheck#(this, fn#(l)); .default -> this.fail};
  .isMap fn -> this.matchLevel.matchWithDefault {.map m -> _InfoCheck#(this, fn#(m)); .default -> this.fail};
  .isEmpty -> this.matchLevel.matchWithDefault {
    .empty -> this;
    .default -> this.fail;
    };
  }

_InfoCheck: { #(v: _SuccessfulInfoValidator, ok: Bool): InfoValidator -> ok ? {.then -> v; .else -> v.fail} }
