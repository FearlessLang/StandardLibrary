//@Group "algebra"
BoolMatch[R:**]:{ mut .true: R; mut .false: R; }
//@Group "algebra"
ThenElse[R:**]: { mut .then: R; mut .else: R; }

//@Group "algebra"
Bool: Sealed,DataType[Bool,Bool] {
  .and(b: Bool): Bool;
  &&(b: mut MF[Bool]): Bool;
  &(b: Bool): Bool -> this.and(b);

  .or(b: Bool): Bool;
  |(b: Bool): Bool -> this.or(b);
  ||(b: mut MF[Bool]): Bool;

  .not: Bool;
  ==> (b: mut MF[Bool]): Bool -> this.not || b;

  .if[R:**](f: mut ThenElse[R]): R;
  ?[R:**](f: mut ThenElse[R]): R -> this.if(f);

  /// ``this.thenDo(f)`` runs ``f`` for its side effect if ``this == True``, otherwise does nothing.
  .thenDo(f: mut MF[Void]): Void -> this?{.then->f#; .else->Void};

  .match[R:**](m: mut BoolMatch[R]): R -> this?{.then->m.true; .else->m.false};

  /// ``this.toOpt(f)`` returns ``.some f#`` if ``this == True`` otherwise `.empty`.
  .toOpt[R:*](mut MF[R]): mut Opt[R];

  .close -> this;

  .cmp a, b -> a.imm?{
    .then->b.imm?{ .then->{::.eq}; .else->{::.gt} };
    .else->b.imm?{ .then->{::.lt}; .else->{::.eq} };
    };

  .hash -> this.imm?{ .then->1; .else->0 };

  .str -> this.imm?{ .then->"True"; .else->"False" };

  .info -> Infos.msg(this.str);
  .assertTrue: Void -> this.assertEq True;
  .assertFalse: Void -> this.assertEq False;
  .assertTrue(msg: read LazyInfo): Void -> this.assertEq(True, msg);
  .assertFalse(msg: read LazyInfo): Void -> this.assertEq(False, msg);
  }

//@Group "algebra"
True: Bool {
  .and b -> b;
  && b -> b#;
  .or b -> this;
  || b -> this;
  .not -> False;
  .if f -> f.then;
  .toOpt f -> Opts#(f#);
  .imm -> True;
  }

//@Group "algebra"
False: Bool {
  .and b -> this;
  && b -> this;
  .or b -> b;
  || b -> b#;
  .not -> True;
  .if f -> f.else;
  .toOpt _ -> {};
  .imm -> False;
  }