///Unicode string type
///UStr is a type representing a sequence of Nats in the ranges
///0..55295 and 57344..1114111.
///
///Those numbers are conventionally written in hexadecimal (base 16) using digits 0..9 and letters A..F;
///total of 16 symbols representing numbers 0-15 with a single symbol each.
///For example, ``0061`` is the scalar value for ``a``,
///and ``1F600`` is the scalar value for the grinning face emoji.
///Unicode documentation often writes those same numbers as U+0061 and U+1F600.
///
///Crucially, there are no UStr literals. Use the method `.u` on Str to obtain Unicode strings.
///`` `foo`.u `` converts the ``foo`` Str into the equivalent `UStr`.
///The method `.u` on UStr reads zero or more uppercase hexadecimal numbers
///separated by single spaces, and appends the corresponding scalar values.
///Only digits 0..9 and uppercase letters A..F are allowed. No extra whitespace is accepted. Malformed input throws.
///For example: `` `Hello`.u.u`FB03 0066 0066 0069`+(`World`.u) `` would create a string that may be visualized as "HelloffiffiWorld",
///but where the first ``ffi`` is represented as a single scalar value representing a ligature, while the second ``ffi`` is represented as three distinct scalar values.
///And `` myUString.u`FB03 0066 0066 0069`+(`Hello`.u) `` would append "ffiffiHello" to a pre-existing Unicode string.
///Str also supports `.u` with one argument, that first converts to unicode and then append the new sequence.
///
///This type does support concatenation (+,|,^) as for Str, but this works by simply appending scalar values one after the other in the sequence.
///UStr does not implement DataType.
///UStr does offer .equalRepr(other) and .hashRepr.
UStr: Sealed,ToFlow[Nat],ToUStr,ToImm[UStr],JoinStr[UStr] {
  + (x: read UStr): UStr;           /// string concatenation; throws on result size > maxInt
  | (x: read UStr): UStr;           /// like + but inserts a newline between the two strings
  ^ (x: read UStr): UStr;           /// like + but inserts a double quote between the two strings

  | : UStr;                         /// appends a newline
  ^  : UStr;                        /// appends a double quote
  .isEmpty: Bool;                   /// true iff size == 0
  .size: Nat;                       /// the amount of unicode scalar values in this string
  .escape: Str;                     /// returns a string representing valid Fearless code which yields a string with the same representation of this string when evaluated (will use .u)

  .scalarHex: Str;                  /// uppercase hexadecimal Unicode scalar values separated by single spaces.
  .isStr: Bool;                     /// true if this UStr only uses scalar values allowed inside instances of type Str.
  .str: Opt[Str];                   /// .some containing this string if .isStr; .empty otherwise
  .getStr: Str -> this.tryGetStr!;
  /// `this.tryGetStr` returns `.ok` of `this.getStr`, or the error info of `this.getStr` if not `this.isStr`.
  //>   .check{("hi".u.tryGetStr).ok.assertEq({::}, Opts# "hi")}
  //>   .check{"a".u("00E9").tryGetStr .assertInfo{::.isMsg{::.startsWith "UStr.getStr:"}}}
  .tryGetStr: mut Action[Str];
  .flow: mut Flow[Nat];             /// return a flow of scalar values.
  read .seqFlow: mut Flow[Nat];     /// return a sequential flow of scalar values.
  mut  .seqFlow: mut Flow[Nat];     /// return a sequential flow of scalar values.
  .equalRepr(other: UStr): Bool;    /// checks if the two unicode strings have the same exact scalar value representation.
  .hashRepr: Nat;                   /// hashes all the scalar values together.
  .u(values: Str): UStr;            /// concatenate those scalar values to the end of this string. Example parameter could be ``FB03 0066 0066 0069``; throws on malformed input.
  ///The bytes of this string in UTF-8, with no byte order mark.
  //>   .check{"a".u("00E9").utf8 .assertEq({::}, Lists#(97.getByte, 195.getByte, 169.getByte))}
  .utf8: List[Byte];
  ///The bytes of this string in UTF-16 little endian, with no byte order mark.
  //>   .check{"a".u("1F600").utf16Le .assertEq({::}, Lists#(97.getByte, 0.getByte, 61.getByte, 216.getByte, 0.getByte, 222.getByte))}
  .utf16Le: List[Byte];
  ///The bytes of this string in UTF-16 big endian, with no byte order mark.
  //>   .check{"a".u("00E9").utf16Be .assertEq({::}, Lists#(0.getByte, 97.getByte, 0.getByte, 233.getByte))}
  .utf16Be: List[Byte];
  ///The bytes of this string in UTF-32 little endian, with no byte order mark.
  //>   .check{"a".u.utf32Le .assertEq({::}, Lists#(97.getByte, 0.getByte, 0.getByte, 0.getByte))}
  .utf32Le: List[Byte];
  ///The bytes of this string in UTF-32 big endian, with no byte order mark.
  //>   .check{"a".u.utf32Be .assertEq({::}, Lists#(0.getByte, 0.getByte, 0.getByte, 97.getByte))}
  .utf32Be: List[Byte];
  .norm: Norm[UStr];
  }

ToUStr: { read .uStr: UStr }