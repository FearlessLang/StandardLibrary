/// Support for closed sets of named singleton values (enumerations).
/// A family with a few named values is declared by implementing `Enum` and
/// `Enums`: the family type binds every value to its list via `.enums` and
/// gives `.close`/`.cmp`/`.hash` once; each value then supplies its own `.str`
/// and `.imm` (a fixed singleton value has no other way to prove it is imm).
///
/// Minimal usage, without a dedicated Match type:
/// ```
/// Directions: Enums[Direction]{
///   .list -> Lists#(North,East,South,West);
///   .strBy -> {::};
///   }
/// Direction: Enum[Direction]{
///   .enums->Directions;
///   .close->this; .close->::;
///   .cmp t0,t1,m -> t0.index<=>(t1.index,m);
///   .hash -> this.index;
///   }
/// North: Direction{.imm->North; `North`}
/// East:  Direction{.imm->East;  `East` }
/// South: Direction{.imm->South; `South`}
/// West:  Direction{.imm->West;  `West` }
/// ```
/// With this alone: ``Directions.list`` is ``Lists#(North,East,South,West)``,
/// ``Directions.map`` is a ``Map[Str,Direction]`` from ``North``/``East``/``South``/``West``
/// to the matching value, ``North.index`` is ``0`` and ``West.index`` is ``3``,
/// ``North < East`` is `True`, and ``North.info`` is `` Infos.msg`North` `` (round-tripping
/// through ``Directions.fromInfo``).
///
/// Or, with a dedicated Match type, letting callers dispatch by pattern
/// instead of comparing `.str`:
/// ```
/// DirectionMatch[R:**]: { mut .north: R; mut .east: R; mut .south: R; mut .west: R; }
/// Direction: Enum[Direction]{
///   .enums->Directions;
///   read .match[R:**](m: mut DirectionMatch[R]): R;
///   .close->this; .close->::;
///   .cmp t0,t1,m -> t0.index<=>(t1.index,m);
///   .hash -> this.index;
///   }
/// North: Direction{::.north; .imm->North; `North`}
/// East:  Direction{::.east;  .imm->East;  `East` }
/// South: Direction{::.south; .imm->South; `South`}
/// West:  Direction{::.west;  .imm->West;  `West` }
/// ```
/// Now ``North.match(DirectionMatch[Str]{ .north->`n`; .east->`e`; .south->`s`; .west->`w`; })``
/// is ``n``: every value still gets `.list`/`.map`/`.index`/`.info`/`.fromInfo` for free from
/// `Enums`/`Enum`, on top of its own `.match`.

/// The "list of values" side of an enumeration family.
/// `.strBy` witnesses that E implements `ToStr`: a bare generic parameter
/// carries no methods of its own, so ``{::}`` is how a concrete family
/// vouches for its own values.
Enums[E]: FromInfo[E]{
  /// every value, in declaration order.
  /// ``Directions.list`` is ``Lists#(North,East,South,West)``.
  .list: List[E];
  .strBy: ToStrBy[E];
  /// looks a value up by its `.str`.
  /// `` Directions.map.get`North` `` is ``North``.
  .map: Map[Str,E] -> this.list.flow.mapping({::},{.key e->(this.strBy#e).str; .elem e->e;}).as{::};
  /// declaration index of every value's `.str`.
  /// `` Directions.indexMap.get`West` `` is ``3``.
  .indexMap: Map[Str,Nat] -> this.list.flow.fold(
    {Maps#[Str,Str,Nat]{::}.as{::}},
    {acc,e->acc.with((this.strBy#e).str,acc.size).as{::}}
    );
  /// looks a value up by its `.info`, the inverse of `Enum.info`.
  /// ``Directions.fromInfo(North.info)`` is ``North``.
  .fromInfo i -> this.map.get(i.getMsg);
  }

/// The "single value" side of an enumeration family.
/// E names the concrete family type, but a bare generic parameter carries
/// no methods of its own: `.close`/`.cmp`/`.hash` still need to be given once at the
/// family, since they produce or compare values of that concrete type.
Enum[E]: DataType[E,E]{
  /// the family this value belongs to; families may also add a `.match`
  /// method of their own, as shown in the second example above.
  /// ``North.enums`` is ``Directions``.
  read .enums: Enums[E];
  /// derived from `.str`, and round-trips through `Enums.fromInfo`.
  /// ``North.info`` is `` Infos.msg`North` ``.
  .info -> Infos.msg(this.str);
  /// this value's position in ``.enums.list``.
  /// ``North.index`` is ``0``, ``West.index`` is ``3``, and ``North < East`` is `True`.
  read .index: Nat -> this.enums.indexMap.get(this.str);
  }
