/// Float: 64 bits IEEE values. Note: ==/order instead follow the usual rules:
/// - NaN == NaN (all different NaNs equal); NaN is greater than everything else including +Inf
/// - -0.0 == +0.0
/// Method hash must respect this ordering
Float: Sealed,DataType[Float,Float],SumNumber[Float],_AssertApprox[Float] {
  /// `this.getSucc` returns the closest Floating point number larger than `this`.
  /// Throws if `this` is `Math.nan` or `Math.inf` (there is no larger value).
  /// Note: Unlike `.succ` for the other numeric types this does not return `this + 1`.
  //>   .check{1.0 .getSucc .assertGt 1.0}
  //>   .check{-0.0 .getSucc .assertEq(+0.0.getSucc)}
  //>   .checkDetErr({_ -> True}, {Math.nan .getSucc})
  //>   .checkDetErr({_ -> True}, {Math.inf .getSucc})
  .getSucc: Float;

  /// `this.getPred` returns the closest Floating point number smaller than `this`.
  /// Throws if `this` is `Math.nan` or `Math.negInf` (there is no smaller value).
  /// Note: Unlike `.pred` for the other numeric types this does not return `this - 1`.
  //>   .check{1.0 .getPred .assertLt 1.0}
  //>   .check{0.0 .getPred .assertEq(-0.0.getPred)}
  //>   .checkDetErr({_ -> True}, {Math.nan .getPred})
  //>   .checkDetErr({_ -> True}, {Math.negInf .getPred})
  .getPred: Float;

  /// `this + x` returns the IEEE 754 sum of `this` and `x`. Never throws; NaN propagates.
  //>   .check{2.0 + 3.0 .assertEq 5.0}
  //>   .check{Math.inf + 1.0 .assertEq(Math.inf)}
  //>   .check{Math.nan + 1.0 .isNaN .assertTrue}
  +(x: Float): Float;

  /// `this - x` returns the IEEE 754 difference of `this` and `x`. Never throws; NaN propagates.
  //>   .check{5.0 - 3.0 .assertEq 2.0}
  //>   .check{Math.inf - (Math.inf) .isNaN .assertTrue}
  -(x: Float): Float;

  /// `this * x` returns the IEEE 754 product of `this` and `x`. Never throws; NaN propagates.
  //>   .check{2.0 * 3.0 .assertEq 6.0}
  //>   .check{0.0 * (Math.inf) .isNaN .assertTrue}
  *(x: Float): Float;

  /// `this / x` returns the IEEE 754 quotient of `this` and `x`.
  /// Division by 0 never throws: yields `Math.inf`/`Math.negInf` (signed by operand signs) or NaN for `0.0 / 0.0`.
  //>   .check{6.0 / 3.0 .assertEq 2.0}
  //>   .check{1.0 / 0.0 .assertEq(Math.inf)}
  //>   .check{-1.0 / 0.0 .assertEq(Math.negInf)}
  //>   .check{0.0 / 0.0 .isNaN .assertTrue}
  /(x: Float): Float;

  /// `this ** x` returns the `this` raised to the power `x`. Never throws; NaN propagates
  /// Note: This differs from `this.ieeePow` as it relaxes the assumption that infinities are effectively large even integers,
  ///   and removes special rules precedence, in general if a**x = b for all x, and y**c = d for all y, then y**x == (Math.nan) if c!=d:
  ///  - `x**(Math.inf) for `x < 0.0`, `+/-0.0 ** +/-0.0`, Math.inf ** 0.0 all return `Math.nan`
  //>   .check{2.0 ** 3.0 .assertEq 8.0}
  //>   .check{Math.nan ** 0.0 .isNaN .assertTrue} // not true of ieee
  //>   .check{0.0 ** -0.0 .isNaN .assertTrue}  // not true of ieee
  **(x: Float): Float;

  /// `this.absOrNaN` returns the IEEE absolute value of `this`: `this` if `this >= 0`,
  /// `-this` if `this < 0`, and `Math.nan` if `this` is NaN (payload preserved semantics not guaranteed).
  //>   .check{4.75 .absOrNaN .assertEq 4.75}
  //>   .check{-4.75 .absOrNaN .assertEq 4.75}
  //>   .check{Math.nan .absOrNaN .isNaN .assertTrue}
  .absOrNaN: Float;

  /// `this.abs` returns `.some` of `this` if `this >= 0`, `.some` of `-this` if `this < 0`,
  /// `.empty` if `this` is NaN.
  //>   .check{4.75 .abs .assertEq({::}, Opts# 4.75)}
  //>   .check{-4.75 .abs .assertEq({::}, Opts# 4.75)}
  //>   .check{Math.nan .abs .assertEmpty}
  .abs: Opt[Float] -> this.isNaN.not .toOpt {this.absOrNaN};

  /// `this.getAbs` returns `this` if `this >= 0`, `-this` otherwise. Throws if `this` is NaN.
  //>   .check{4.75 .getAbs .assertEq 4.75}
  //>   .check{-4.75 .getAbs .assertEq 4.75}
  //>   .checkDetErr({_ -> True}, {Math.nan .getAbs})
  .getAbs: Float ->
    this.isNaN .if {
      .then -> Error.msg "Cannot take the absolute value of NaN";
      .else -> this.absOrNaN;
      };

  /// `this.negAbsOrNaN` returns the negative of the absolute value of `this`
  /// (i.e. `-|this|`), or `Math.nan` if `this` is NaN.
  //>   .check{4.75 .negAbsOrNaN .assertEq -4.75}
  //>   .check{-4.75 .negAbsOrNaN .assertEq -4.75}
  //>   .check{Math.nan .negAbsOrNaN .isNaN .assertTrue}
  .negAbsOrNaN: Float -> this.absOrNaN * -1.0;

  /// `this.negAbs` returns `.some` of `-|this|` if `this` is not NaN, `.empty` otherwise.
  //>   .check{4.75 .negAbs .assertEq({::}, Opts# -4.75)}
  //>   .check{Math.nan .negAbs .assertEmpty}
  .negAbs: Opt[Float] -> this.isNaN.not .toOpt {this.absOrNaN * -1.0};

  /// `this.getNegAbs` returns `-|this|`. Throws if `this` is NaN.
  //>   .check{4.75 .getNegAbs .assertEq(-4.75)}
  //>   .checkDetErr({_ -> True}, {(Math.nan) .getNegAbs})
  .getNegAbs: Float -> this.getAbs * -1.0;

  /// `this.sqrtOrNaN` returns the IEEE square root of `this`.
  /// Returns `Math.nan` iff `this` is negative (excluding `-0.0`, whose sqrt is `-0.0`) or NaN.
  //>   .check{4.0 .sqrtOrNaN .assertEq 2.0}
  //>   .check{-0.0 .sqrtOrNaN .assertEq -0.0}
  //>   .check{-4.0 .sqrtOrNaN .isNaN .assertTrue}
  //>   .check{Math.nan .sqrtOrNaN .isNaN .assertTrue}
  .sqrtOrNaN: Float;

  /// `this.sqrt` returns `.some` of the IEEE sqrt of `this` if `this >= 0.0` and not NaN, `.empty` otherwise.
  //>   .check{4.0 .sqrt .assertEq({::}, Opts# 2.0)}
  //>   .check{-4.0 .sqrt .assertEmpty}
  //>   .check{Math.nan .sqrt .assertEmpty}
  .sqrt: Opt[Float] -> this.isNaN.not && {this >= 0.0} .toOpt {this.sqrtOrNaN};

  /// `this.getSqrt` returns the IEEE sqrt of `this`. Throws if `this` is NaN or negative (excluding `-0.0`).
  //>   .check{4.0 .getSqrt .assertEq 2.0}
  //>   .checkDetErr({_ -> True}, {-4.0 .getSqrt})
  //>   .checkDetErr({_ -> True}, {Math.nan .getSqrt})
  .getSqrt: Float -> this.isNaN || {this < -0.0} .if {
    .then -> Error.msg("Cannot take the sqrt of "+this);
    .else -> this.sqrtOrNaN;
    };

  /// `this.signOrNaN` returns the sign of `this`: `+0.0`/`-0.0` if `this` is `+0.0`/`-0.0`,
  /// `1.0` if `this` is positive, `-1.0` if `this` is negative, `Math.nan` if `this` is NaN.
  //>   .check{4.75 .signOrNaN .assertEq 1.0}
  //>   .check{-4.75 .signOrNaN .assertEq -1.0}
  //>   .check{0.0 .signOrNaN .isPosZero .assertTrue}
  //>   .check{-0.0 .signOrNaN .isNegZero .assertTrue}
  //>   .check{Math.nan .signOrNaN .isNaN .assertTrue}
  .signOrNaN: Float;

  /// `this.sign` returns `.some` of `this.signOrNaN` if `this` is not NaN, `.empty` otherwise.
  //>   .check{4.75 .sign .assertEq({::}, Opts# 1.0)}
  //>   .check{Math.nan .sign .assertEmpty}
  .sign: Opt[Float] -> this.isNaN.not .toOpt {this.signOrNaN};

  /// `this.getSign` returns `this.signOrNaN`. Throws if `this` is NaN.
  //>   .check{-4.75 .getSign .assertEq -1.0}
  //>   .checkDetErr({_ -> True}, {Math.nan .getSign})
  .getSign: Float -> this.isNaN .if {
    .then -> Error.msg "Cannot get the sign of NaN";
    .else -> this.signOrNaN;
    };

  /// `this.softFloor` returns `this` unchanged if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise returns `this` rounded down to the nearest integer.
  //>   .check{4.75 .softFloor .assertEq 3.0}
  //>   .check{-3.25 .softFloor .assertEq -4.0}
  //>   .check{Math.inf .softFloor .assertEq(Math.inf)}
  //>   .check{Math.nan .softFloor .isNaN .assertTrue}
  .softFloor: Float;

  /// `this.floor` returns `.empty` if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise `.some` of `this` rounded down to the nearest integer.
  //>   .check{4.75 .floor .assertEq({::}, Opts# 4.0)}
  //>   .check{Math.inf .floor .assertEmpty}
  //>   .check{Math.nan .floor .assertEmpty}
  .floor: Opt[Float] -> this.isFinite.toOpt{this.softFloor};

  /// `this.getFloor` returns `this` rounded down to the nearest integer.
  /// Throws if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`.
  //>   .check{4.75 .getFloor .assertEq 4.0}
  //>   .checkDetErr({_ -> True}, {(Math.inf) .getFloor})
  //>   .checkDetErr({_ -> True}, {(Math.nan) .getFloor})
  .getFloor: Float -> this.isFinite .if {
    .then -> this.softFloor;
    .else -> Error.msg("Floor expected finite number, got "+this);
    };

  /// `this.softCeil` returns `this` unchanged if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise returns `this` rounded up to the nearest integer.
  //>   .check{3.25 .softCeil .assertEq 4.0}
  //>   .check{-4.75 .softCeil .assertEq -4.0)}
  //>   .check{Math.negInf .softCeil .assertEq(Math.negInf)}
  //>   .check{Math.nan .softCeil .isNaN .assertTrue}
  .softCeil: Float;

  /// `this.ceil` returns `.empty` if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise `.some` of `this` rounded up to the nearest integer.
  //>   .check{3.25 .ceil .assertEq({::}, Opts# 4.0)}
  //>   .check{Math.negInf .ceil .assertEmpty}
  //>   .check{Math.nan .ceil .assertEmpty}
  .ceil: Opt[Float] -> this.isFinite.toOpt{this.softCeil};

  /// `this.getCeil` returns `this` rounded up to the nearest integer.
  /// Throws if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`.
  //>   .check{3.25 .getCeil .assertEq 4.0}
  //>   .checkDetErr({_ -> True}, {Math.negInf .getCeil})
  //>   .checkDetErr({_ -> True}, {Math.nan .getCeil})
  .getCeil: Float -> this.isFinite .if {
    .then -> this.softCeil;
    .else -> Error.msg("Ceil expected finite number, got "+this);
    };

  /// `this.softTrunc0` returns `this` unchanged if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise returns `this` rounded towards `0`.
  //>   .check{2.75 .softTrunc0 .assertEq 2.0}
  //>   .check{-2.75 .softTrunc0 .assertEq -2.0}
  //>   .check{Math.inf .softTrunc0 .assertEq(Math.inf)}
  //>   .check{Math.nan .softTrunc0 .isNaN .assertTrue}
  .softTrunc0: Float;

  /// `this.trunc0` returns `.empty` if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise `.some` of `this` rounded towards `0`.
  //>   .check{2.75 .trunc0 .assertEq({::}, Opts# 2.0)}
  //>   .check{-2.75 .trunc0 .assertEq({::}, Opts# -2.0)}
  //>   .check{Math.inf .trunc0 .assertEmpty}
  //>   .check{Math.nan .trunc0 .assertEmpty}
  .trunc0: Opt[Float] -> this.isFinite.toOpt{this.softTrunc0};

  /// `this.getTrunc0` returns `this` rounded towards `0`. Throws if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`.
  //>   .check{-2.75 .getTrunc0 .assertEq -2.0}
  //>   .checkDetErr({_ -> True}, {(Math.inf) .getTrunc0})
  //>   .checkDetErr({_ -> True}, {(Math.nan) .getTrunc0})
  .getTrunc0: Float -> this.isFinite .if {
    .then -> this.softTrunc0;
    .else -> Error.msg("Float.getTrunc0: Expected finite number, got "+this);
    };

  /// `this.softRound` returns `this` unchanged if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise returns `this` rounded to the nearest integer, with ties rounded away from `0`.
  //>   .check{2.5 .softRound .assertEq 3.0}
  //>   .check{-2.5 .softRound .assertEq(-3.0)}
  //>   .check{Math.inf .softRound .assertEq(Math.inf)}
  //>   .check{Math.nan .softRound .isNaN .assertTrue}
  .softRound: Float;

  /// `this.round` returns `.empty` if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise `.some` of `this` rounded to the nearest integer, ties rounded away from `0`.
  //>   .check{2.5 .round .assertEq({::}, Opts# 3.0)}
  //>   .check{-2.5 .round .assertEq({::}, Opts# (-3.0))}
  //>   .check{Math.inf .round .assertEmpty}
  //>   .check{Math.nan .round .assertEmpty}
  .round: Opt[Float] -> this.isFinite.toOpt{this.softRound};

  /// `this.getRound` returns `this` rounded to the nearest integer, ties rounded away from `0`.
  /// Throws if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`.
  //>   .check{-2.5 .getRound .assertEq(-3.0)}
  //>   .checkDetErr({_ -> True}, {(Math.inf) .getRound})
  //>   .checkDetErr({_ -> True}, {(Math.nan) .getRound})
  .getRound: Float -> this.isFinite .if {
    .then -> this.softRound;
    .else -> Error.msg("Float.getRound: expected finite number, got "+this);
    };

  /// `this.softRoundTiesEven` returns `this` unchanged if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise returns `this` rounded to the nearest integer, with ties rounded to the nearest even integer.
  //>   .check{2.5 .softRoundTiesEven .assertEq 2.0}
  //>   .check{3.5 .softRoundTiesEven .assertEq 4.0}
  //>   .check{-2.5 .softRoundTiesEven .assertEq -2.0}
  //>   .check{Math.inf .softRoundTiesEven .assertEq(Math.inf)}
  //>   .check{Math.nan .softRoundTiesEven .isNaN .assertTrue}
  .softRoundTiesEven: Float;

  /// `this.roundTiesEven` returns `.empty` if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`,
  /// otherwise `.some` of `this` rounded to the nearest integer, ties rounded to even.
  //>   .check{2.5 .roundTiesEven .assertEq({::}, Opts# 2.0)}
  //>   .check{Math.inf .roundTiesEven .assertEmpty}
  //>   .check{Math.nan .roundTiesEven .assertEmpty}
  .roundTiesEven: Opt[Float] -> this.isFinite.toOpt{this.softRoundTiesEven};

  /// `this.getRoundTiesEven` returns `this` rounded to the nearest integer, ties rounded to even.
  /// Throws if `this` is `Math.inf`, `Math.negInf`, or `Math.nan`.
  //>   .check{2.5 .getRoundTiesEven .assertEq 2.0}
  //>   .checkDetErr({_ -> True}, {(Math.inf) .getRoundTiesEven})
  //>   .checkDetErr({_ -> True}, {(Math.nan) .getRoundTiesEven})
  .getRoundTiesEven: Float -> this.isFinite .if {
    .then -> this.softRoundTiesEven;
    .else -> Error.msg("Float.getRoundTiesEven: expected finite number got "+this);
    };

  /// `this.isNaN` returns `True` iff `this` is NaN, regardless of payload.
  //>   .check{Math.nan .isNaN .assertTrue}
  //>   .check{1.0 .isNaN .assertFalse}
  .isNaN: Bool;

  /// `this.isInfinite` returns `True` iff `this` is `Math.inf` or `Math.negInf`.
  //>   .check{Math.inf .isInfinite .assertTrue}
  //>   .check{Math.negInf .isInfinite .assertTrue}
  //>   .check{1.0 .isInfinite .assertFalse}
  .isInfinite: Bool;

  /// `this.isPosInfinity` returns `True` iff `this` is `Math.inf`.
  //>   .check{Math.inf .isPosInfinity .assertTrue}
  //>   .check{Math.negInf .isPosInfinity .assertFalse}
  .isPosInfinity: Bool;

  /// `this.isNegInfinity` returns `True` iff `this` is `Math.negInf`.
  //>   .check{Math.negInf .isNegInfinity .assertTrue}
  //>   .check{Math.inf .isNegInfinity .assertFalse}
  .isNegInfinity: Bool;

  /// `this.isNegZero` returns `True` iff the raw bits of `this` are exactly `-0.0`
  /// (distinct from `+0.0` at the bit level, even though `-0.0 == +0.0`).
  //>   .check{-0.0 .isNegZero .assertTrue}
  //>   .check{0.0 .isNegZero .assertFalse}
  .isNegZero: Bool;

  /// `this.isPosZero` returns `True` iff the raw bits of `this` are exactly `+0.0`.
  //>   .check{0.0 .isPosZero .assertTrue}
  //>   .check{-0.0 .isPosZero .assertFalse}
  .isPosZero: Bool;

  /// `this.isFinite` returns `True` if `this` is not `Math.nan`, `Math.inf`, or `Math.negInf`.
  /// Note: this is not equivalent to `this.isInfinite.not`, since both are `False` for `Math.nan`.
  //>   .check{1.0 .isFinite .assertTrue}
  //>   .check{0.0 .isFinite .assertTrue}
  //>   .check{Math.inf .isFinite .assertFalse}
  //>   .check{Math.nan .isFinite .assertFalse}
  .isFinite: Bool ->
      this.match({
      .posInf -> False; .negInf -> False; .nan -> False;
      .posZero -> True; .negZero -> True;
      .regular x -> True;
      });

  /// `this.ieeePow(x)` returns the IEEE 754-2008 `pow(this, x)`, following the full IEEE special-value rules
  ///  unlike `**` - see its docs for how the two differ. Rules apply top down
  ///   - `x.ieeePow(+/-0.0)` is `+1.0` for any `x` including `Math.nan`, `+/-0.0`, ;
  ///   - `(+/-0.0).ieeePow(y)` is:
  ///         - `+/-Math.inf` if `y` is negative odd integer,
  ///         - `Math.inf` if y is `Math.negInf`,
  ///         - +0.0 if y is `Math.inf` - `Math.inf` is considered a large positive integer,
  ///         - `Math.inf` for finite `y < 0` that is not an odd integer,
  ///         - `+/-0.0` for finite `y > 0` an odd integer
  ///         - `+0.0` for finite `y > 0` that is not an odd integer;
  ///   - `-1.0.ieeePow(+/-Math.inf)` is `1.0`;
  ///   - `1.0.ieeePow(y)` is `1.0` for any `y` - even `Math.nan`;
  ///   - `x.ieeePow(y)` is `Math.nan` for finite `x < 0` and finite non-integer `y`.
  .ieeePow(x: Float): Float;

  /// `this.ieeeSameBits(x)` compares raw bit patterns: distinguishes NaN payloads and signed zero
  /// (unlike `ieeeEq` and the type's own `==`).
  //>   .check{(0.0 .ieeeSameBits(-0.0)) .assertFalse}
  //>   .check{(1.0 .ieeeSameBits 1.0) .assertTrue}
  .ieeeSameBits(x: Float): Bool;

  /// `this.ieeeStr` returns an IEEE 754 round-trip decimal string for `this` (includes NaN/Inf).
  /// NaN payloads are not distinguished (all NaNs render identically); use `ieeeSameBits` for that.
  //>   .check{1.5 .ieeeStr .assertEq "1.5"}
  //>   .check{Math.nan .ieeeStr .assertEq `NaN`}
  //>   .check{Math.inf .ieeeStr .assertEq `Infinity`}
  .ieeeStr: Str;

  /// `this.ieeeRemainder(d)` returns the IEEE remainder `r = this - n*d`, where `n` is the
  /// integer nearest `this/d` (ties-to-even).
  //>   .check{5.0 .ieeeRemainder 3.0 .assertEq -1.0}
  .ieeeRemainder(d: Float): Float;

  /// `this.ieeeEq(x)` return true if `this` equals `x` according to the IEEE standard.
  /// Note: this differs from Fearless `==` as `Math.nan.ieeeEq(Math.nan) is false`
  //>   .check{Math.nan.ieeeEq(Math.nan).assertFalse}
  //>   .check{+0.0 .ieeeEq -0.0  .assertTrue}
  .ieeeEq(x: Float): Bool;

  /// `this.int` returns `.some` of `this` as an `Int` if `this` is an integer in `[minInt, maxInt]`,
  /// `.empty` otherwise (non-integral, out of range, NaN, or infinite).
  //>   .check{3.0 .int .assertEq({::}, Opts# +3)}
  //>   .check{3.5 .int .assertEmpty}
  //>   .check{Math.nan .int .assertEmpty}
  .int: Opt[Int];

  /// `this.nat` returns `.some` of `this` as a `Nat` if `this` is an integer in `[0, maxNat]`,
  /// `.empty` otherwise.
  //>   .check{3.0 .nat .assertEq({::}, Opts# 3)}
  //>   .check{-1.0 .nat .assertEmpty}
  .nat: Opt[Nat];

  /// `this.byte` returns `.some` of `this` as a `Byte` if `this` is an integer in `[0, maxByte]`,
  /// `.empty` otherwise.
  //>   .check{3.0 .byte .assertEq({::}, Opts#(3.getByte))}
  //>   .check{300.0 .byte .assertEmpty}
  .byte: Opt[Byte];

  /// `this.num` returns `.some` of `this` as a `Num` if `this` is finite, `.empty` on NaN/Inf.
  //>   .check{3.5 .num .assertEq({::}, Opts#(7/2))}
  //>   .check{Math.inf .num .assertEmpty}
  .num: Opt[Num];

  /// `this.softInt` clamps and truncates `this` towards `0` into an `Int`.
  /// `Math.nan -> 0`; `Math.inf -> maxInt`; `Math.negInf -> minInt`.
  //>   .check{4.75 .softInt .assertEq +4}
  //>   .check{Math.nan .softInt .assertEq +0}
  //>   .check{Math.inf .softInt .assertEq(Math.maxInt)}
  .softInt: Int;

  /// `this.softNat` clamps and truncates `this` towards `0` into a `Nat`.
  /// `Math.nan -> 0`; `Math.inf -> maxNat`; `Math.negInf -> 0`.
  //>   .check{4.75 .softNat .assertEq 4}
  //>   .check{Math.negInf .softNat .assertEq 0}
  //>   .check{Math.inf .softNat .assertEq(Math.maxNat)}
  .softNat: Nat;

  /// `this.softByte` clamps and truncates `this` towards `0` into a `Byte`.
  /// `Math.nan -> 0`; `Math.inf -> maxByte`; `Math.negInf -> 0`.
  //>   .check{4.75 .softByte .assertEq(4.getByte)}
  //>   .check{Math.inf .softByte .assertEq(Math.maxByte)}
  .softByte: Byte;

  /// `this.getInt` converts `this` to an `Int` if it is an integer in `[minInt, maxInt]`; throws otherwise.
  //>   .check{3.0 .getInt .assertEq +3}
  //>   .checkDetErr({_ -> True}, {3.5 .getInt})
  //>   .checkDetErr({_ -> True}, {(Math.nan) .getInt})
  .getInt: Int;

  /// `this.getNat` converts `this` to a `Nat` if it is an integer in `[0, maxNat]`; throws otherwise.
  //>   .check{3.0 .getNat .assertEq 3}
  //>   .checkDetErr({_ -> True}, {(-1.0) .getNat})
  .getNat: Nat;

  /// `this.getByte` converts `this` to a `Byte` if it is an integer in `[0, maxByte]`; throws otherwise.
  //>   .check{3.0 .getByte.nat .assertEq 3}
  //>   .checkDetErr({_ -> True}, {300.0 .getByte})
  .getByte: Byte;

  /// `this.getNum` converts `this` to a `Num` if finite; throws on NaN/Inf.
  //>   .check{3.5 .getNum .assertEq(7/2)}
  //>   .checkDetErr({_ -> True}, {(Math.inf) .getNum})
  //>   .checkDetErr({_ -> True}, {(Math.nan) .getNum})
  .getNum: Num;

  /// `this.hash` returns a hash consistent with `==`: `-0.0` hashes the same as `+0.0`, and every
  /// NaN hashes the same as every other NaN (since `ieeeStr` does not distinguish NaN payloads).
  //>   .check{0.0 .hash .assertEq((-0.0) .hash)}
  //>   .check{Math.nan .hash .assertEq((Math.nan.negAbsOrNaN) .hash)}
  //>   .check{1.0 .hash .assertNe(2.0 .hash)}
  .hash -> this.imm.isNegZero?{.then->`0.0`.hash; .else->this.imm.ieeeStr.hash};/// hash via str

  /// fixpoint type closed
  .close->::; .close->this;

  /// `this.sumNumber(xs)` sums all numbers in `xs` starting from `this`.
  //>   .check{(0.0 .sumNumber(List#(1.0, 2.0, 3.0))) .assertEq 6.0}
  //>   .check{(10.0 .sumNumber(List#())) .assertEq 10.0}
  .sumNumber xs ->
    xs.fold( {this}, {acc,e -> acc + e} );

  /// `this.match(m)` dispatches on the special variants of float weirdness:
  /// `+0.0`, `-0.0`, `+Inf`, `-Inf`, `NaN`, or a regular finite/non-special value.
  //>   .check{(0.0 .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "pz"}
  //>   .check{(3.5 .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "r"}
  //>   .check{((Math.nan) .match({.posZero -> "pz"; .negZero -> "nz"; .posInf -> "pi"; .negInf -> "ni"; .nan -> "n"; .regular x -> "r"})) .assertEq "n"}
  .match[R:*](m: mut FloatMatch[R]): R ->
    this.isPosZero .toOpt {m.posZero}
    || {this.isNegZero .toOpt {m.negZero}}
    || {this.isPosInfinity .toOpt {m.posInf}}
    || {this.isNegInfinity .toOpt {m.negInf}}
    || {this.isNaN .toOpt {m.nan}}
    .orLazy{ m.regular this };

  /// `this.deg` returns `.some` of `this` interpreted as an angle in degrees if `this` is finite,
  /// `.empty` if `this` is `Math.nan`, `Math.inf`, or `Math.negInf`.
  /// Note: there is no `soft` variant, since it's unclear how to map non-finite values to an angle.
  //>   .check{90.0 .deg .assertEq({::}, Opts#(90.0.getDeg))}
  //>   .check{Math.nan .deg .assertEmpty}
  //>   .check{Math.inf .deg .assertEmpty}
  .deg: Opt[Degree] -> this.isFinite.toOpt{{this}};

  /// `this.getDeg` returns `this` as a `Degree`. Throws if `this` is not finite.
  /// Note: there is no `soft` variant, since it's unclear how to map non-finite values to an angle.
  //>   .check{90.0 .getDeg# .assertEq(90.0)}
  //>   .checkDetErr({_ -> True}, {(Math.inf) .getDeg})
  .getDeg: Degree -> this.isFinite .if {
    .then -> {this};
    .else -> Error.msg("Invalid angle, "+this+" is not finite.");
    };

  /// `this.rad` returns `.some` of `this` interpreted as an angle in radians if `this` is finite,
  /// `.empty` if `this` is `Math.nan`, `Math.inf`, or `Math.negInf`.
  /// Note: there is no `soft` variant, since it's unclear how to map non-finite values to an angle.
  //>   .check{1.5 .rad .assertEq({::}, Opts#(1.5.getRad))}
  //>   .check{Math.nan .rad .assertEmpty}
  .rad: Opt[Radian] -> this.isFinite.toOpt{{this}};

  /// `this.getRad` returns `this` as a `Radian`. Throws if `this` is NaN or `+/-` Infinity.
  //>   .check{1.5 .getRad# .assertEq 1.5}
  //>   .checkDetErr({_ -> True}, {(Math.nan) .getRad})
  .getRad: Radian -> this.isFinite .if {
    .then -> {this};
    .else -> Error.msg("Invalid angle, "+this+" is not finite.");
    };

  /// `this~~end` returns the open range `(this, end)`: from `this.getSucc` to `end.getPred`.
  /// Throws if either endpoint is NaN, `this` is `Math.inf`, `end` is `Math.negInf`,
  /// or the resulting range would be empty (`this.getSucc > end.getPred`).
  //>   .check{(1.0~~4.0) .start .assertEq(1.0 .getSucc)}
  //>   .check{(1.0~~4.0) .end .assertEq(4.0 .getPred)}
  //>   .checkDetErr({_ -> True}, {1.0~~(1.0 .getSucc)})
  ~~(end: Float): Range[Float] -> Block#
    .if {this == (Math.nan) || {end == (Math.nan)}} .error {"Float ~~: Math.nan is not a valid start or end point"}
    .if {this == (Math.inf)} .error{"Float ~~: Start of open range cannot be Math.inf"}
    .if {end == (Math.negInf)} .error{"Float ~~: End of open range cannot be Math.negInf"}
    .let endInclusive={end.getPred}
    .let startInclusive={this.getSucc}
    .if {startInclusive > endInclusive } .error {
      "Float ~~: Tried to produce empty range, start ("+this+") .getSucc must be <= end (" + end + ") .getPred"
      }
    .return {_FloatRanges#(startInclusive, endInclusive, "("+this+", "+end+")")};

  /// `this~~=endInclusive` returns the range `(this, endInclusive]`: from `this.getSucc` to `endInclusive`.
  /// Throws if either endpoint is NaN, `this` is `Math.inf`, or the range would be empty
  /// (`this >= endInclusive`).
  //>   .check{(1.0~~=4.0) .start .assertEq(1.0 .getSucc)}
  //>   .check{(1.0~~=4.0) .end .assertEq 4.0}
  //>   .checkDetErr({_ -> True}, {1.0~~=1.0})
  ~~=(endInclusive: Float): Range[Float] -> Block#
    .if {this == (Math.nan) || {endInclusive == (Math.nan)}} .error {"Float ~~=: Math.nan is not a valid start or end point"}
    .if {this == (Math.inf)} .error{"Float ~~=: Start of open range cannot be Math.inf"}
    .if {this >= endInclusive } .error {
      "Float ~~=: Tried to produce empty range, start ("+this+") must be < endInclusive (" + endInclusive + ")"
      }
    .return {_FloatRanges#(this.getSucc, endInclusive, "("+this+", "+endInclusive+"]")};

  /// `this=~~end` returns the range `[this, end)`: from `this` to `end.getPred`.
  /// Throws if either endpoint is NaN, `end` is `Math.negInf`, or the range would be empty
  /// (`this >= end`).
  //>   .check{(1.0=~~4.0) .start .assertEq 1.0}
  //>   .check{(1.0=~~4.0) .end .assertEq(4.0 .getPred)}
  //>   .checkDetErr({_ -> True}, {1.0=~~1.0})
  =~~(end: Float): Range[Float] -> Block#
    .if {this == (Math.nan) || {end == (Math.nan)}} .error {"Float =~~: Math.nan is not a valid start or end point"}
    .if {end == (Math.negInf)} .error{
      "Float =~~: End of open range cannot be Math.negInf"
      }
    .if {this >= end } .error {
      "Float =~~: Tried to produce an empty range, invalid range start ("+this+") must be < end (" + end + ")"
      }
    .return {_FloatRanges#(this, end.getPred, "["+this+", "+end+")")};

  /// `this=~~=endInclusive` returns the inclusive range `[this, endInclusive]`.
  /// Throws if either endpoint is NaN, or the range would be empty (`this > endInclusive`).
  //>   .check{(1.0=~~=4.0) .start .assertEq 1.0}
  //>   .check{(1.0=~~=1.0) .start .assertEq 1.0}
  //>   .checkDetErr({_ -> True}, {4.0=~~=1.0})
  =~~=(endInclusive: Float): Range[Float] -> Block#
    .if {this == (Math.nan) || {endInclusive == (Math.nan)}} .error {"Float =~~=: Math.nan is not a valid start or end point"}
    .if {this > endInclusive } .error {
      "Float =~~=: Tried to produce an empty range, invalid range, start ("+this+") must be <= endInclusive (" + endInclusive + ")"
      }
    .return {_FloatRanges#(this, endInclusive, "["+this+", "+endInclusive+"]")};

  /// `this.inRange(range)` returns `True` iff `range.start <= this <= range.end`.
  /// Note: since NaN is greater than everything, `this.inRange(range)` is `False` when `this` is NaN.
  //>   .check{(2.0 .inRange(1.0=~~=4.0)) .assertTrue}
  //>   .check{(5.0 .inRange(1.0=~~=4.0)) .assertFalse}
  .inRange(range: Range[Float]): Bool -> range.start <= this && {this <= (range.end)};

  /// `this.assertInRange(range)` asserts `this.inRange(range)`, using a default empty message.
  //>   .check{2.0 .assertInRange(1.0=~~=4.0)}
  //>   .checkDetErr({_ -> True}, {5.0 .assertInRange(1.0=~~=4.0)})
  .assertInRange(range: Range[Float]): Void -> this.assertInRange(range, {``});

  /// `this.assertInRange(range, msg)` is equivalent to `this.inRange(range).assertTrue`
  .assertInRange(range: Range[Float], msg: read LazyInfo): Void -> Assert!(
    this.inRange(range),
    { msg#.info + (`Expected in range: `+ (range.str) // technically a DD point...
      | `actual: `+this
      .info)});

  /// `this.clampTo(range)` clamps `this` into `[range.start, range.end]`.
  /// Note: since NaN is greater than everything, a `Math.nan.clamp(range)` always clamps to `range.end`;
  //>   .check{0.0 .clampTo(1.0=~~=4.0) .assertEq 1.0}
  //>   .check{5.0 .clampTo(1.0=~~=4.0) .assertEq 4.0}
  //>   .check{Math.nan .clampTo(1.0=~~=4.0) .assertEq 4.0}
  .clampTo(range: Range[Float]): Float -> Block#
      .if {this <= (range.start)} .return {range.start}
      .if {this >= (range.end)} .return {range.end}
      .return {this};
  }

_FloatRanges: Sealed {
    #(startInclusive: Float, endInclusive: Float, str: Str): Range[Float] -> {'self
        /// Magic method that counts all floats in a given range.
        /// Counts -0.0 and +0.0 as the same float i.e. -0.0 =~~= +0.0 .size == 1;
        .size -> _FloatsBetween#(startInclusive, endInclusive);
        .start -> startInclusive;
        .end -> endInclusive;
        .flow -> _NumFlow.floats(startInclusive, endInclusive);
        .flow step -> _NumFlow.floats(startInclusive, endInclusive, step);
        .contains n -> n.inRange(self);
        .clamp n -> n.clampTo(self);
        .str -> str;
      };
  }

_FloatsBetween: Sealed {
  #(startInclusive: Float, endInclusive: Float): Nat -> Magic!;
  }

/// A matcher for floats, has all the special cases of float:
/// 1. Regular floats (which are none of the following)
/// 2. +0.0 and -0.0 (numbers can get rounded/FPE'd to these)
/// 3. +inf and -inf
/// 4. NaN
FloatMatch[R:**]: {
  mut .regular(x: Float): R;
  mut .posZero: R;
  mut .negZero: R;
  mut .posInf: R;
  mut .negInf: R;
  mut .nan: R;
  }
