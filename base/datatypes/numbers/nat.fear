// Nat: 64-bit unsigned (bitty, index-flavored). Ordering is UNSIGNED.
// Note: / is not provided; use div/rem (divisor is Nat).
Nat: Sealed,DataType[Nat,Nat],SumNumber[Nat],InfoKey {
  /// `this.getSucc` returns `this + 1`. Throws if `this` is `Math.maxNat` (overflow).
  //>   .check{5 .getSucc .assertEq 6}
  //>   .checkDetErr({:: & .msgMatch{::.startsWith "Nat.getSucc"}#}, {(Math.maxNat) .getSucc})
  .getSucc: Nat -> this == (Math.maxNat) .if {
    .then -> Error.msg("Nat.getSucc: cannot get the successor of Math.maxNat ("+(Math.maxNat)+").");
    .else -> this + 1;
    };

  /// `this.getPred` returns `this - 1`. Throws if `this` is `0` (underflow).
  //>   .check{5 .getPred .assertEq 4}
  //>   .checkDetErr({_ -> True}, {0 .getPred})
  .getPred: Nat -> this == (Math.minNat) .if {
    .then -> Error.msg("Nat.getPred: cannot get the predecessor of Math.minNat ("+(Math.minNat)+").");
    .else -> this - 1;
    };

  /// `this + x` returns the checked sum of `this` and `x`. Throws on overflow past `Math.maxNat`.
  //>   .check{(2 + 3) .assertEq 5}
  //>   .checkDetErr({_ -> True}, {(Math.maxNat - 1) + 2})
  +(x: Nat): Nat;

  /// `this - x` returns the checked difference of `this` and `x`. Throws on underflow below `0`.
  //>   .check{(5 - 3) .assertEq 2}
  //>   .checkDetErr({_ -> True}, {0 - 1})
  -(x: Nat): Nat;

  /// `this * x` returns the checked product of `this` and `x`. Throws on overflow.
  //>   .check{(6 * 7) .assertEq 42}
  //>   .checkDetErr({_ -> True}, {(Math.maxNat) * 2})
  *(x: Nat): Nat;

  /// `this ** x` returns the checked power of `this` raised to `x`. Throws on overflow.
  //>   .check{(2 ** 6) .assertEq 64}
  //>   .checkDetErr({_ -> True}, {(Math.maxNat) ** 2})
  **(x: Nat): Nat;

  /// `this / d` returns the exact rational quotient of `this` and `d` as a `Num`. Throws iff `d == 0`.
  //>   .check{(7 / 2) .softFloat .assertEq 3.5}
  //>   .checkDetErr({_ -> True}, {7 / 0})
  /(d: Nat) : Num;

  /// `this.getDiv(d)` returns `this` divided by `d`, truncated toward `0`. Throws iff `d == 0`.
  //>   .check{7 .getDiv 2 .assertEq 3}
  //>   .checkDetErr({_ -> True}, {7 .getDiv 0})
  .getDiv(d: Nat): Nat;

  /// `this.getRem(d)` returns the remainder `this - (this.getDiv(d)) * d`. Throws iff `d == 0`.
  //>   .check{7 .getRem 2 .assertEq 1}
  //>   .checkDetErr({_ -> True}, {7 .getRem 0})
  .getRem(d: Nat): Nat;

  /// `this.rem(d)` returns `.some` of `this.getRem(d)` if `d != 0`, `.empty` iff `d == 0`.
  //>   .check{7 .rem 2 .assertEq({::}, Opts# 1)}
  //>   .check{7 .rem 0 .assertEmpty}
  .rem(d: Nat): Opt[Nat] ->
      d != 0 .toOpt {this.getRem(d)};

  /// `this.div(d)` returns `.some` of `this.getDiv(d)` if `d != 0`, `.empty` otherwise.
  //>   .check{(7.getByte) .div(2) .assertEq({::}, Opts# (3.getByte))}
  //>   .check{(7.getByte) .div(0) .assertEmpty}
  .div(d: Nat): Opt[Nat]
    -> d != 0 .toOpt {this.getDiv(d)};

  /// `this.exactDiv(d)` returns `.some` of `this.getDiv(d)` if `d` evenly divides `this`
  /// if `d != 0` and `this.rem(d) == 0`, `.empty` otherwise.
  //>   .check{6 .exactDiv 2 .assertEq({::}, Opts# 3)}
  //>   .check{7 .exactDiv 2 .assertEmpty}
  //>   .check{7 .exactDiv 0 .assertEmpty}
  .exactDiv(d: Nat): Opt[Nat]
    -> this.rem(d).match {
      .empty -> {};
      .some r -> r == 0 .toOpt {this.getDiv(d)}.as{::};
      };

  /// `this.softSqrt` returns an approximate `Float` square root of `this`.
  //>   .check{9 .softSqrt .assertEq 3.0}
  //>   .check{0 .softSqrt .assertEq 0.0}
  .softSqrt: Float;

  /// `this.getIndexOffset(delta)` returns `this + delta` (index-arithmetic helper).
  /// Throws if the result would underflow below `0` or overflow past `Math.maxNat`.
  //>   .check{5 .getIndexOffset(+3) .assertEq 8}
  //>   .check{5 .getIndexOffset(-3) .assertEq 2}
  //>   .checkDetErr({_ -> True}, {5 .getIndexOffset(-10)})
  .getIndexOffset(delta: Int): Nat;

  /// `this.indexOffset(delta)` returns `.some` of `this + delta` if it would neither underflow
  /// nor overflow, `.empty` otherwise.
  //>   .check{5 .indexOffset(+3) .assertEq({::}, Opts# 8)}
  //>   .check{5 .indexOffset(-10) .assertEmpty}
  .indexOffset(delta: Int): Opt[Nat] -> delta >= +0 .if {
      // See if this + delta.nat would overflow
      .then -> delta.getNat <= (Math.maxNat - this) .toOpt {this.getIndexOffset(delta)};
      // See if this + delta.nat would underflow
      .else -> delta.abs <= this .toOpt {this.getIndexOffset(delta)};
      };

  /// `this.num` converts `this` to a `Num`. Always exact; never throws as `Num` can safely
  /// represent every `Nat` value, so there is no `soft`/`get` variant needed for this conversion.
  // Equivalent to: `this / 1`
  //>   .check{5 .num .assertEq(5/1)}
  .num: Num -> this / 1;

  /// `this.int` returns `.some` of `this` as an `Int` if `this <= maxInt`, `.empty` otherwise.
  //>   .check{5 .int .assertEq({::}, Opts# +5)}
  //>   .check{(Math.maxNat) .int .assertEmpty}
  .int: Opt[Int];

  /// `this.byte` returns `.some` of `this` as a `Byte` if `this <= maxByte`, `.empty` otherwise.
  //>   .check{5 .byte .assertEq({::}, Opts# (5.getByte))}
  //>   .check{300 .byte .assertEmpty}
  .byte: Opt[Byte];

  /// `this.float` returns `.some` of `this` as a `Float` if `this` is exactly representable, `.empty` otherwise.
  //>   .check{5 .float .assertEq({::}, Opts# 5.0)}
  //>   .check{Math.maxNat.float .assertEmpty}
  .float: Opt[Float];

  /// `this.getInt` converts `this` to an `Int`. Throws if `this > maxInt`.
  //>   .check{5 .getInt .assertEq +5}
  //>   .checkDetErr({_ -> True}, {Math.maxNat .getInt})
  .getInt: Int;

  /// `this.getByte` converts `this` to a `Byte`. Throws if `this > maxByte`.
  //>   .check{5 .getByte .assertEq(5.getByte)}
  //>   .checkDetErr({_ -> True}, {300 .getByte})
  .getByte: Byte;

  /// `this.getFloat` converts `this` to a `Float`. Throws if `this` is not exactly representable.
  //>   .check{5 .getFloat .assertEq 5.0}
  //>   .checkDetErr({_ -> True}, {Math.maxNat.getFloat})
  .getFloat: Float;

  /// `this.softInt` converts `this` to an `Int` by clamping into `[0, maxInt]`
  //>   .check{5 .softInt .assertEq +5}
  //>   .check{(Math.maxNat) .softInt .assertEq(Math.maxInt)}
  .softInt: Int;

  /// `this.softByte` converts `this` to a `Byte` by clamping into `[0, maxByte]`
  //>   .check{5 .softByte .assertEq(5.getByte)}
  //>   .check{300 .softByte .assertEq(255.getByte)}
  .softByte: Byte;

  /// `this.softFloat` converts `this` to the closest representable `Float`
  //>   .check{5 .softFloat .assertEq 5.0}
  .softFloat: Float;

  /// `this.aluAddWrap(x)` returns `this + x` mod `2^64` (u64 wraparound add)
  //>   .check{(Math.maxNat) .aluAddWrap 1 .assertEq 0}
  .aluAddWrap(x: Nat): Nat;

  /// `this.aluSubWrap(x)` returns `this - x` mod `2^64` (u64 wraparound sub)
  //>   .check{0 .aluSubWrap 1 .assertEq(Math.maxNat)}
  .aluSubWrap(x: Nat): Nat;

  /// `this.aluMulWrap(x)` returns `this * x` mod `2^64` (u64 wraparound mul)
  //>   .check{(Math.maxNat) .aluMulWrap 2 .assertEq(Math.maxNat - 1)}
  .aluMulWrap(x: Nat): Nat;

  /// `this.aluDiv(x)` returns `this` divided by `x`, truncated toward `0` (u64 semantics). Throws iff `x == 0`.
  //>   .check{7 .aluDiv 2 .assertEq 3}
  //>   .checkDetErr({_ -> True}, {7 .aluDiv 0})
  .aluDiv(x: Nat): Nat;

  /// `this.aluRem(x)` returns the remainder paired with `this.aluDiv(x)`. Throws iff `x == 0`.
  //>   .check{7 .aluRem 2 .assertEq 1}
  //>   .checkDetErr({_ -> True}, {7 .aluRem 0})
  .aluRem(x: Nat): Nat;

  /// `this.aluShiftLeft(bits)` returns `this` shifted left by `bits`, with the effective shift
  /// taken modulo `64` (`bits & 63`)
  //>   .check{1 .aluShiftLeft 3 .assertEq 8}
  .aluShiftLeft(bits: Nat): Nat;

  /// `this.aluShiftRight(bits)` returns `this` logically shifted right by `bits`, with the
  /// effective shift taken modulo `64` (`bits & 63`)
  //>   .check{8 .aluShiftRight 3 .assertEq 1}
  .aluShiftRight(bits: Nat): Nat;

  /// `this.aluXor(x)` returns the bitwise XOR of `this` and `x` (u64)
  //>   .check{5 .aluXor 3 .assertEq 6}
  .aluXor(x: Nat): Nat;

  /// `this.aluAnd(x)` returns the bitwise AND of `this` and `x` (u64)
  //>   .check{5 .aluAnd 3 .assertEq 1}
  .aluAnd(x: Nat): Nat;

  /// `this.aluOr(x)` returns the bitwise OR of `this` and `x` (u64)
  //>   .check{5 .aluOr 2 .assertEq 7}
  .aluOr(x: Nat): Nat;

  /// `this.aluInt` reinterprets the raw u64 bits of `this` as a signed i64 `Int` (bit-cast, not a value conversion).
  //>   .check{(Math.maxNat) .aluInt .assertEq -1}
  .aluInt: Int;

  /// `this.aluByte` returns the low 8 bits of `this`, wrapped (not clamped).
  //>   .check{257 .aluByte .assertEq(1.getByte)}
  .aluByte: Byte;

  /// `this~~end` returns the open range `(this, end)`.
  /// Throws if `this` is `Math.maxNat`, `end` is `Math.minNat`, or the resulting range would be empty.
  //>   .check{(1~~4) .start .assertEq 2}
  //>   .checkDetErr({_ -> True}, {1~~2})
  ~~(end: Nat): Range[Nat] -> Block#
    .if {this == (Math.maxNat)} .error{"Nat ~~: Start of open range cannot be Math.maxNat"}
    .if {end == (Math.minNat)} .error{"Nat ~~: End of open range cannot be Math.minNat"}
    .let endInclusive={end.getPred}
    .let startInclusive={this.getSucc}
    .if {startInclusive > endInclusive } .error {
      "Nat ~~: Tried to produce empty range, start ("+this+") .getSucc must be <= end (" + end + ") .getPred"
      }
    .return {_NatRanges#(startInclusive, endInclusive, "("+this+", "+end+")")};

  /// `this~~=endInclusive` returns the range `(this, endInclusive]`.
  /// Throws if `this` is `Math.maxNat`, or the range would be empty (`this >= endInclusive`).
  //>   .check{(1~~=4) .end .assertEq 4}
  //>   .checkDetErr({_ -> True}, {1~~=1})
  ~~=(endInclusive: Nat): Range[Nat] -> Block#
    .if {this == (Math.maxNat)} .error{"Nat ~~=: Start of open range cannot be Math.maxNat"}
    .if {this >= endInclusive } .error {
      "Nat ~~=: Tried to produce empty range, start ("+this+") must be < endInclusive (" + endInclusive + ")"
      }
    .return {_NatRanges#(this.getSucc, endInclusive, "("+this+", "+endInclusive+"]")};

  /// `this=~~end` returns the range `[this, end)`.
  /// Throws if `end` is `Math.minNat`, or the range would be empty (`this >= end`).
  //>   .check{(1=~~4) .start .assertEq 1}
  //>   .checkDetErr({_ -> True}, {1=~~1})
  =~~(end: Nat): Range[Nat] -> Block#
    .if {end == (Math.minNat)} .error{
      "Nat =~~: End of open range cannot be Math.minNat"
      }
    .if {this >= end } .error {
      "Nat =~~: invalid range start ("+this+") must be < end (" + end + ")"
      }
    .return {_NatRanges#(this, end.getPred, "["+this+", "+end+")")};

  /// `this=~~=endInclusive` returns the inclusive range `[this, endInclusive]`.
  /// Throws if the range would be empty (`this > endInclusive`).
  //>   .check{(1=~~=4) .start .assertEq 1}
  //>   .checkDetErr({_ -> True}, {4=~~=1})
  =~~=(endInclusive: Nat): Range[Nat] -> Block#
    .if {this > endInclusive } .error {
      "Nat =~~=: invalid range, start ("+this+") must be <= endInclusive (" + endInclusive + ")"
      }
    .return {_NatRanges#(this, endInclusive, "["+this+", "+endInclusive+"]")};

  /// `this.inRange(range)` returns `True` iff `range.start <= this <= range.end`.
  //>   .check{2 .inRange(1=~~=4) .assertTrue}
  //>   .check{5 .inRange(1=~~=4) .assertFalse}
  .inRange(range: Range[Nat]): Bool -> range.start <= this && {this <= (range.end)};

  /// `this.assertInRange(range)` asserts `this.inRange(range)`, using a default empty message.
  /// Note: This method calls `.str` method on the non-sealed range, meaning you should be careful to call this on a
  ///   range you do not control, as doing so may invoke arbitrary code.
  //>   .check{2 .assertInRange(1=~~=4)}
  //>   .checkDetErr({_ -> True}, {5 .assertInRange(1=~~=4)})
  .assertInRange(range: Range[Nat]): Void -> this.assertInRange(range, {``});

  /// `this.assertInRange(range, msg)` asserts `this.inRange(range)` with custom error message.
  /// Note: This method calls `.str` method on the non-sealed range, meaning you should be careful to call this on a
  ///   range you do not control, as doing so may invoke arbitrary code.
  //>   .check{2 .assertInRange(1=~~=4, {`custom context`})}
  .assertInRange(range: Range[Nat], msg: read LazyInfo): Void -> Assert!(
    this.inRange(range),
    { msg#.info + (`Expected in range: `+ (range.str) // technically a DD point...
      | `lo: `+(range.start)
      | `hi: `+(range.end)
      | `actual: `+this
      .info)});

  /// `this.clampTo(range)` returns `this` clamped into `[range.start, range.end]`
  //>   .check{0 .clampTo(1=~~=4) .assertEq 1}
  //>   .check{9 .clampTo(1=~~=4) .assertEq 4}
  .clampTo(range: Range[Nat]): Nat -> Block#
      .if {this <= (range.start)} .return {range.start}
      .if {this >= (range.end)} .return {range.end}
      .return {this}; .hash -> this.str.hash;                 /// hash via str


  /// `this.indexInfo info` returns `.empty` if `info` is not the `.list` variant,
  /// otherwise returns .some the `this`-th element of the list if it exists, `.empty` otherwise.
  .indexInto info -> info.match DefaultInfoMatch[mut Opt[Info]] {
    .list list -> list.opt(this);
    .default -> {};
    };

  /// `this.info` returns a `.msg` info with the string representation of `this` as the message.
  //>   .check{5.info .assertEq Infos#("5")}
  .info -> Infos.msg(this.str);            /// info via str
  .close->::; .close->this;               /// fixpoint type closed
  .sumNumber xs ->                        /// summing all numbers starting from this
    xs.fold( {this}, {acc,e -> acc + e} );
  .hashWith(other: Nat): Nat -> this.aluMulWrap(31).aluAddWrap(other);
  .norm: Norm[Nat];
  }


_NatRanges: Sealed {
  #(startInclusive: Nat, endInclusive: Nat, str: Str): Range[Nat] -> {'self
    .size -> startInclusive - endInclusive; // Performance cost is low enough that this is okay
    .start -> startInclusive;
    .end -> endInclusive;
    .flow -> _NumFlow.nats(startInclusive, endInclusive);
    .flow step -> _NumFlow.nats(startInclusive, endInclusive, step);
    .contains n -> n.inRange(self);
    .clamp n -> n.clampTo(self);
    .str -> str;
    };
  }
