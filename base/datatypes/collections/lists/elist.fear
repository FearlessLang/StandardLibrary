ELists: Sealed {
  #[E:*]: mut EList[E] -> _Magic!;
  /// ``ELists.withCapacity n`` creates and returns an empty EList with capacity ``n``.
  /// Throws if ``n >= 2147483647``.
  //>   .check{ELists.withCapacity[Nat] 10 .isEmpty .assertTrue}
  //>   .checkDetErr({::.isMsg{::.startsWith "ELists.withCapacity:"}}, {ELists.withCapacity[Nat] 2147483647})
  .withCapacity[E:*](capacity: Nat): mut EList[E] -> _Magic!;

  #[E:*](E): mut EList[E] -> _Magic!;
  #[E:*](E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  #[E:*](E,E,E,E,E,E,E,E,E,E,E,E,E,E,E,E): mut EList[E] -> _Magic!;
  }

EList[E:*]: Sealed, _EditableList[E, EList[E]] {
  /// ``this.size`` returns the number of elements in this collection.
  //> .check{Block#
  //>   .let l={ELists.withCapacity[Nat] 3}
  //>   .do{l.size .assertEq 0}
  //>   .do{l.add(1).size .assertEq 1}
  //>   .done}
  read .size: Nat;

  /// ``this.isEmpty`` returns `True` if this collection has no elements.
  /// Equivalent to: ``this.size == 0``
  //> .check{Block#
  //>   .let l={ELists.withCapacity[Nat] 3}
  //>   .do{l.isEmpty .assertTrue}
  //>   .do{l.add(1).isEmpty .assertFalse}
  //>   .done}
  read .isEmpty: Bool -> this.size == 0;

  /// ``this.notEmpty`` returns `True` if this collection has any elements.
  /// Equivalent to: ``this.isEmpty.not``
  //> .check{Block#
  //>   .let l={ELists.withCapacity[Nat] 3}
  //>   .do{l.notEmpty .assertFalse}
  //>   .do{l.add(1).notEmpty .assertTrue}
  //>   .done}
  read .notEmpty: Bool -> this.isEmpty.not;

  /// ``this.get i`` returns the element at index ``i`` (0-based) in this collection.
  /// Throws if ``i >= this.size``.
  /// Time Complexity: O(1)
  //> .check{ELists# 1 .get(0) .assertEq 1}
  //> .checkDetErr({::.isMsg{:: == "EList.get: index 1 is out of range for an EList of size 1."}}, {ELists# 1 .get(1)})
  mut .get(Nat): E; //simpler model with most methods ``mut``
  read .get(Nat): read/imm E;

  /// ``this.tryGet(i)`` returns `.ok` of ``this.get(i)``, or the error info of ``this.get(i)`` iff ``i >= size``.
  //>   .check{(ELists#[Nat].add(4).tryGet 0).ok.assertEq({::}, Opts# 4)}
  //>   .check{ELists#[Nat].tryGet 0 .assertInfo{::.isMsg{::.startsWith "EList.get:"}}}
  //> .check{Block#
  //>   .let[read EList[Nat]] l={ELists#(4,5)}
  //>   .do{(l.tryGet 1).ok.assertEq({::}, Opts# 5)}
  //>   .do{l.tryGet 2 .assertInfo{::.isMsg{:: == "EList.get: index 2 is out of range for an EList of size 2."}}}
  //>   .done}
  mut .tryGet(Nat): mut Action[E];
  read .tryGet(Nat): mut Action[read/imm E];

  /// ``this.opt(index)`` returns ``.some`` of ``this.get(index)`` if ``index < this.size``, ``.empty`` otherwise.
  /// Time Complexity: O(1)
  //> .check{ELists# 1 .opt(0) .assertEq({::}, Opts# 1)}
  //> .check{ELists# 1 .opt(1) .assertEmpty{::}}
  //> .check{Block#
  //>   .let[read EList[Nat]] l={ELists#(4,5)}
  //>   .do{l.opt(1) .assertEq({::}, Opts# 5)}
  //>   .do{l.opt(2) .assertEmpty{::}}
  //>   .done}
  mut .opt(index: Nat): mut Opt[E] -> index < (this.size) .toOpt { this.get(index) };
  read .opt(index: Nat): mut Opt[read/imm E] -> index < (this.size) .toOpt { this.get(index) };

  /// Time Complexity: O(1) amortized, O(n) worst case.
  /// ``this.add e`` adds ``e`` to the end of this collection and returns ``this``.
  //> .check{ELists#[Nat].add(1).add(2).list .assertEq({::}, Lists#(1, 2))}
  mut .add(E): mut EList[E];

  /// ``this.addAll xs`` adds all elements of ``xs`` to the end of this collection and returns ``this``.
  /// ``xs`` is left unchanged.
  /// Time Complexity: O(m) amortized, O(n+m) worst case, where m is the size of ``xs``.
  //> .check{Block#
  //>   .let l={ELists#[Nat] 3}
  //>   .do{l.addAll(ELists#(1,2,3,4)).size .assertEq 5}
  //>   .do{l.list .assertEq({::}, Lists#(3,1,2,3,4))}
  //>   .done}
  mut .addAll(mut EList[E]): mut EList[E];

  /// Time Complexity: O(n).
  /// ``this.addFirst(e)`` adds ``e`` to the beginning of this collection and returns ``this``.
  //> .check{Flows#(1,2,3,4).eList.addFirst(0).list.assertEq({::}, Lists#(0,1,2,3,4))}
  //> .check{ELists#[Nat].addFirst(0).list.assertEq({::}, Lists#(0))}
  mut .addFirst(e: E): mut EList[E] -> this.insertBefore(0, e);

  /// ``this.insertBefore(index, e)`` inserts ``e`` before the element at ``index`` and returns ``this``.
  /// ``index == this.size`` inserts at the end. Throws if ``index > this.size``.
  /// Time Complexity: O(n) worst case.
  //> .check{Flows#(1,2,3,4).eList.insertBefore(1, 0).list.assertEq({::}, Lists#(1,0,2,3,4))}
  //> .check{ELists#(1,2).insertBefore(2, 0).list.assertEq({::}, Lists#(1,2,0))}
  //> .checkDetErr({::.isMsg{:: == "EList.insertBefore: index 3 is out of range for an EList of size 2."}}, {ELists#(1,2).insertBefore(3, 0)})
  mut .insertBefore(Nat, E): mut EList[E];

  /// ``this.first`` returns ``.some(first)`` if this collection is non-empty, and ``.empty`` otherwise.
  /// Equivalent to: ``this.tryGetFirst.ok``
  //> .check{Flows#(1,2,3).eList.first .assertEq({::}, Opts# 1)}
  //> .check{ELists#[Nat] .first .assertEmpty {::}}
  read .first: mut Opt[read/imm E] -> this.tryGetFirst.ok;
  mut  .first: mut Opt[E] -> this.tryGetFirst.ok;

  /// ``this.last`` returns ``.some(last)`` if this collection is non-empty, and ``.empty`` otherwise.
  /// Equivalent to: ``this.tryGetLast.ok``
  //> .check{Flows#(1,2,3).eList.last .assertEq({::}, Opts#(3))}
  //> .check{ELists.withCapacity[Nat] 3 .last .assertEmpty {::}}
  read .last: mut Opt[read/imm E] -> this.tryGetLast.ok;
  mut  .last: mut Opt[E] -> this.tryGetLast.ok;

  /// ``this.getFirst`` returns the first element of this collection.
  /// Throws if this collection is empty.
  /// Equivalent to: ``this.get(0)``
  //> .check{ELists#(1,2,3).getFirst .assertEq 1}
  //> .checkDetErr({::.isMsg{::.startsWith "EList.getFirst:"}}, {ELists#[Nat] .getFirst})
  read .getFirst: read/imm E -> this.tryGetFirst!;
  mut  .getFirst: E -> this.tryGetFirst!;

  /// `this.tryGetFirst` returns `.ok` of `this.getFirst`, or the error info of `this.getFirst` iff `this` is empty.
  //> .check{ELists#[Nat] .tryGetFirst .assertInfo{::.isMsg{:: == "EList.getFirst: called on an empty EList."}}}
  read .tryGetFirst: mut Action[read/imm E] -> this.isEmpty .if{ .then -> Actions.msg "EList.getFirst: called on an empty EList."; .else -> Actions.ok(this.get 0) };
  mut  .tryGetFirst: mut Action[E] -> this.isEmpty .if{ .then -> Actions.msg "EList.getFirst: called on an empty EList."; .else -> Actions.ok(this.get 0) };

  /// ``this.getLast`` returns the last element of this collection.
  /// Throws if this collection is empty.
  /// Equivalent to: ``this.get(this.size - 1)``
  //> .check{ELists#(1,2,3).getLast .assertEq 3}
  //> .checkDetErr({::.isMsg{::.startsWith "EList.getLast:"}}, {ELists#[Nat] .getLast})
  read .getLast: read/imm E -> this.tryGetLast!;
  mut  .getLast: E -> this.tryGetLast!;

  /// `this.tryGetLast` returns `.ok` of `this.getLast`, or the error info of `this.getLast` iff `this` is empty.
  //> .check{(ELists#(1,2,3).tryGetLast).ok .assertEq({::}, Opts# 3)}
  read .tryGetLast: mut Action[read/imm E] -> this.isEmpty .if{ .then -> Actions.msg "EList.getLast: called on an empty EList."; .else -> Actions.ok(this.get(this.size - 1)) };
  mut  .tryGetLast: mut Action[E] -> this.isEmpty .if{ .then -> Actions.msg "EList.getLast: called on an empty EList."; .else -> Actions.ok(this.get(this.size - 1)) };

  /// ``this.set(i, e)`` replaces the element at index ``i`` with ``e``, returning ``this``.
  /// Throws if ``i >= this.size``.
  //> .check{ELists#(1, 2, 3).set(1, 9).list .assertEq({::}, Lists#(1, 9, 3))}
  //> .checkDetErr({::.isMsg{:: == "EList.set: index 3 is out of range for an EList of size 3."}}, {ELists#(1, 2, 3).set(3, 9)})
  mut .set(Nat, E): mut EList[E];

  /// ``this.clear`` removes all the elements of this collection, returning ``this``.
  /// The capacity is unchanged.
  //> .check{ELists#(1, 2, 3).clear.isEmpty .assertTrue}
  mut .clear: mut EList[E];

  /// ``this.remove(i)`` removes the element at index ``i``, returning ``this``;
  /// the elements after it move down by one index.
  /// Throws if ``i >= this.size``.
  /// Time Complexity: O(n)
  //> .check{ELists#(1, 2, 3).remove(0).list .assertEq({::}, Lists#(2, 3))}
  //> .checkDetErr({::.isMsg{:: == "EList.remove: index 3 is out of range for an EList of size 3."}}, {ELists#(1, 2, 3).remove(3)})
  mut .remove(Nat): mut EList[E];

  /// ``this.removeAll indices`` removes the elements at ``indices``, returning ``this``.
  /// The indices refer to the positions before any removal; the remaining elements keep their order.
  /// Throws if an index is present twice, or if any index is ``>= this.size``.
  //> .check{ELists#(0, 1, 2, 3, 4).removeAll(ELists#(3, 0)).list .assertEq({::}, Lists#(1, 2, 4))}
  //> .checkDetErr({::.isMsg{::.startsWith "EList.removeAll: index 1 is present twice"}}, {ELists#(0, 1, 2).removeAll(ELists#(1, 1))})
  mut .removeAll(read EList[Nat]): mut EList[E];

  /// ``this.removeIf(f)`` removes every element for which ``f`` returns `True`, returning ``this``;
  /// the remaining elements keep their order.
  //> .check{ELists#(1, 2, 3, 4).removeIf{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 3))}
  mut .removeIf(read F[E, Bool]): mut EList[E];

  /// ``this.retainIf(f)`` removes every element for which ``f`` returns `False`, returning ``this``.
  /// Equivalent to: ``this.removeIf{e -> f#e .not}``
  //> .check{ELists#(1, 2, 3, 4).retainIf{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(2, 4))}
  mut .retainIf(f: read F[E, Bool]): mut EList[E] -> this.removeIf{f#:: .not};

  /// ``this.removeFirstWhere(f)`` removes the first element for which ``f`` returns `True`, returning ``this``.
  /// Does nothing if no such element exists.
  //> .check{ELists#(1, 2, 3, 4).removeFirstWhere{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 3, 4))}
  mut .removeFirstWhere(read F[E, Bool]): mut EList[E];

  /// ``this.removeLastWhere(f)`` removes the last element for which ``f`` returns `True`, returning ``this``.
  /// Does nothing if no such element exists.
  //> .check{ELists#(1, 2, 3, 4).removeLastWhere{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 2, 3))}
  //> .check{ELists#(1, 3).removeLastWhere{e -> (e.getRem 2) == 0}.list .assertEq({::}, Lists#(1, 3))}
  mut .removeLastWhere(read F[E, Bool]): mut EList[E];

  /// ``this.trimTo(start, end)`` keeps only the elements at indices ``[start, end)``, returning ``this``;
  /// the element at ``start`` moves to index ``0``.
  /// Throws if ``start > end`` or ``end > this.size``.
  //> .check{ELists#(0, 1, 2, 3, 4).trimTo(1, 3).list .assertEq({::}, Lists#(1, 2))}
  //> .check{ELists#(0, 1, 2).trimTo(3, 3).list .assertEq({::}, {})}
  //> .checkDetErr({::.isMsg{::.startsWith "EList.trimTo:"}}, {ELists#(0, 1, 2).trimTo(2, 1)})
  mut .trimTo(start: Nat, end: Nat): mut EList[E];

  /// ``this.reverse`` reverses the order of the elements in place, returning ``this``.
  //> .check{ELists#(1, 2, 3).reverse.list .assertEq({::}, Lists#(3, 2, 1))}
  mut .reverse: mut EList[E];

  /// ``this.swap(i, j)`` swaps the elements at indices ``i`` and ``j``, returning ``this``.
  /// Throws if ``i >= this.size`` or ``j >= this.size``.
  //> .check{ELists#(1, 2, 3).swap(0, 2).list .assertEq({::}, Lists#(3, 2, 1))}
  //> .checkDetErr({::.isMsg{:: == "EList.swap: index 5 is out of range for an EList of size 3."}}, {ELists#(1, 2, 3).swap(0, 5)})
  mut .swap(Nat, Nat): mut EList[E];

  /// ``this.sort by`` returns ``this`` after sorting all the elements (min-first) in place according to ``by``.
  /// Time Complexity: O(n log n)
  //> .check{ELists#(1,2,3,4).sort{::.imm.getInt * -1}.list.assertEq({::}, Lists#(4,3,2,1))}
  mut .sort[K](by: OrderBy[imm E,K]): mut EList[E];

  /// ``this.distinct by`` returns ``this`` after removing in place every element that ``by`` ranks equal to an earlier one.
  ///    The first occurrence of each element is kept, and the kept elements stay in order.
  /// Time Complexity: O(n)
  //> .check{ELists#(-2,+1,-1,-3,+2,-1).distinct{::.imm.abs}.list.assertEq({::}, Lists#(-2,+1,-3))}
  mut .distinct[K](by: OrderHashBy[imm E,K]): mut EList[E];

  /// ``this.sortDistinct by`` returns ``this`` after sorting it in place according to ``by``
  ///    and removing every element that ``by`` ranks equal to the previous one.
  /// Time Complexity: O(n log n)
  //> .check{ELists#(3,1,2,1,3).sortDistinct{::}.list.assertEq({::}, Lists#(1,2,3))}
  mut .sortDistinct[K](by: OrderBy[imm E,K]): mut EList[E];

  /// ``this.trimToSize`` removes any extra capacity, so that the capacity is ``this.size``.
  /// On a view made by `EList.eView`, ``this.trimToSize`` trims the EList the view was made from.
  /// Time Complexity: O(n) worst case.
  //> .check{ELists#(1,2,3,4,5).trimToSize.size .assertEq 5}
  //> .check{ELists#(1,2,3).eView(1, 2).trimToSize.list .assertEq({::}, Lists#(2))}
  mut .trimToSize: mut EList[E];

  /// ``this.expandCapacity newCapacity`` expands the capacity of this collection to at least ``newCapacity``.
  /// On a view made by `EList.eView`, ``this.expandCapacity newCapacity`` expands the EList the view was made from
  /// to ``newCapacity`` plus the number of its elements outside the view, so that the view can grow to ``newCapacity`` elements.
  /// Throws if ``newCapacity`` plus the number of elements outside the view is ``>= 2147483647``.
  /// Time Complexity: O(n) worst case.
  //> .check{ELists#(1,2).expandCapacity(100).add(3).list .assertEq({::}, Lists#(1,2,3))}
  //> .check{Block#
  //>   .let l={ELists#(1,2,3)}
  //>   .do{l.eView(1, 2).expandCapacity(100).add(9).void}
  //>   .return{l.list .assertEq({::}, Lists#(1,2,9,3))}}
  //> .checkDetErr({::.isMsg{:: == "EList.expandCapacity: capacity 2147483645 plus the 2 elements outside the view is not less than 2147483647"}}, {ELists#(1,2,3).eView(1, 2).expandCapacity 2147483645})
  mut .expandCapacity(newCapacity: Nat): mut EList[E];

  /// ``this.fold(acc, f)`` folds this collection from left to right,
  /// starting with the given accumulator and applying ``f`` to the accumulator, the index of each element and the element.
  /// Time Complexity: T(``this``, ``f``) * O(n), where T(l, f) is the maximum time complexity of ``f`` applied to any element of ``this`` and the accumulator.
  //> .check{Block#
  //>   .let l={ELists#(1,2,3,4,5)}
  //>   .do{l.fold({0}, {a,_,b -> a+b}) .assertEq 15}
  //>   .do{l.fold({1}, {a,_,b -> a*b}) .assertEq 120}
  //>   .done}
  mut .fold[R:*](acc: iso MF[R], f: read F[R, Nat, E, R]): R;

  /// ``this.foldRight(acc, f)`` folds this collection from right to left,
  /// starting with the given accumulator and applying ``f`` to the accumulator, the index of each element and the element.
  //> .check{Block#
  //>   .let l={ELists#(1,2,3,4,5)}
  //>   .do{l.foldRight({List[Nat]}, {a,_,b -> a +> b}) .assertEq({::}, Lists#(5,4,3,2,1))}
  //>   .do{l.foldRight({1}, {a,_,b -> a*b}) .assertEq 120}
  //>   .done}
  mut .foldRight[R:*](acc: iso MF[R], f: read F[R, Nat, E, R]): R;

  /// ``this.foldUntil(acc, f, pred)`` folds this collection from left to right as `EList.fold` does,
  /// stopping as soon as ``pred`` returns `True` for the accumulator.
  /// Time Complexity: T(``this``, ``f``) * O(n), where T(l, f) is the maximum time complexity of ``f`` applied to any element of ``this`` and the accumulator.
  //> .check{Block#
  //>   .let l={ELists#(1,2,3,4,5)}
  //>   .do{l.foldUntil({0}, {a,_,b -> a+b}, {a -> a >= 10}) .assertEq 10}
  //>   .do{l.foldUntil({1}, {a,_,b -> a*b}, {a -> a >= 100}) .assertEq 120}
  //>   .done}
  mut .foldUntil[R:*](
    acc: iso MF[R],
    f: read F[R, Nat, E, R],
    pred: read F[R, Bool]
    ): R;

  /// ``this.foldRightUntil(acc, f, pred)`` folds this collection from right to left as `EList.foldRight` does,
  /// stopping as soon as ``pred`` returns `True` for the accumulator.
  /// Time Complexity: T(``this``, ``f``) * O(n), where T(l, f) is the maximum time complexity of ``f`` applied to any element of ``this`` and the accumulator.
  //> .check{ELists#(1,2,3,4,5).foldRightUntil({0}, {a,_,b -> a+b}, {a -> a >= 9}) .assertEq 9}
  mut .foldRightUntil[R:*](
    acc: iso MF[R],
    f: read F[R, Nat, E, R],
    pred: read F[R, Bool]
    ): R;

  /// ``this.accumulateInPlace f`` replaces each element, from left to right, with ``f`` applied to the (already replaced) previous element and the current element.
  /// Time Complexity: T(``this``, ``f``) * O(n), where T(l, f) is the maximum time complexity of ``f`` applied to any element of ``this`` and the accumulator.
  //> .check{ELists#(1,2,3,4,5).accumulateInPlace{acc, e -> acc + e}.list.assertEq({::}, Lists#(1, 3, 6, 10, 15))}
  mut .accumulateInPlace(read F[E,E,E]): mut EList[E];

  /// ``this.accumulateRightInPlace f`` replaces each element, from right to left, with ``f`` applied to the (already replaced) next element and the current element.
  /// Time Complexity: T(``this``, ``f``) * O(n), where T(l, f) is the maximum time complexity of ``f`` applied to any element of ``this`` and the accumulator.
  //> .check{ELists#(1,2,3,4,5).accumulateRightInPlace{acc, e -> acc + e}.list.assertEq({::}, Lists#(15, 14, 12, 9, 5))}
  mut .accumulateRightInPlace(read F[E,E,E]): mut EList[E];

  /// ``this.seqFlow`` drains ``this`` and returns a sequential `Flow` of all the elements of this.
  //> .check{Block#
  //>   .let elist ={ELists#(1,2,3,4)}
  //>   .do{elist.seqFlow.list .assertEq({::}, Lists#(1,2,3,4))}
  //>   .do{elist.isEmpty.assertTrue}.done}
  mut .seqFlow: mut Flow[E];

  /// ``this.flow mode`` drains ``this`` and returns a `Flow` of all the elements of this, flowing in ``mode``.
  //> .check{Block#
  //>   .let[mut EList[Nat]] elist={ELists#(1,2,3,4)}
  //>   .do{elist.flow(ParImm#).list .assertEq({::}, Lists#(1,2,3,4))}
  //>   .do{elist.isEmpty.assertTrue}.done}
  mut .flow(mode: FlowMode[E]): mut Flow[E];

  /// ``this.flow`` returns a `Flow` of all the elements of this; it does not drain.
  imm .flow: mut Flow[imm E];

  /// ``this.list`` drains ``this`` and returns a `List` of all the elements of this.
  /// Time Complexity: O(1)
  //> .check{Block#
  //>   .let elist ={ELists#(1,2,3,4)}
  //>   .do{elist.list .assertEq({::}, Lists#(1,2,3,4))}
  //>   .do{elist.isEmpty.assertTrue}.done}
  mut .list: mut List[E];

  /// ``this.eView(start, end)`` returns a mutable view of this collection containing only the elements
  /// with indices in the range ``[start, end)``.
  /// Throws if ``start > end`` or ``end > this.size``; returns an empty view if ``start == end``.
  /// Changes made to the view are reflected in this collection.
  /// The view is the range of indices ``[start, end)`` of this collection: adding or removing through the view moves ``end``,
  /// and a change of size of this collection other than through the view moves neither ``start`` nor ``end``.
  /// Using the view when ``end`` is greater than ``this.size`` throws.
  /// Time Complexity: O(1).
  //> .check{Block#
  //>   .let elist={ELists#(1,2,3,4,5)}
  //>   .do{elist.eView(1, 4).list .assertEq({::}, Lists#(2,3,4))}
  //>   .do{elist.list.assertEq({::}, Lists#(1,5))}
  //>   .done}
  //> .check{Block#
  //>   .let elist={ELists#(1,2,3)}
  //>   .do{elist.eView(1, 3).set(0, 9).void}
  //>   .do{elist.eView(3, 3).add(4).void}
  //>   .return{elist.list.assertEq({::}, Lists#(1,9,3,4))}}
  //> .checkDetErr({::.isMsg{:: == "EList.eView: the range 1 to 4 is out of range for an EList of size 3."}}, {ELists#(1,2,3).eView(1, 4)})
  mut .eView(start: Nat, end: Nat): mut EList[E];
  }
