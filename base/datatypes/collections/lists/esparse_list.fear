ESparseLists: {
  /// ``ESparseLists.backedWithArray capacity`` returns an ESparseList of ``capacity`` holes, backed by an array.
  /// Throws if ``capacity >= 2147483647``, the limit of Java arrays.
  //> .check{ESparseLists.backedWithArray[Nat] 3 .capacity .assertEq 3}
  //> .checkDetErr({::.isMsg{::.startsWith "ESparseLists.backedWithArray:"}}, {ESparseLists.backedWithArray[Nat] 2147483647})
  .backedWithArray[E:*](capacity: Nat): mut ESparseList[E] -> _Magic!;
  /// ``ESparseLists.backedWithMap capacity`` returns an ESparseList of ``capacity`` holes, backed by a sorted map.
  /// Any `Nat` is a valid capacity, and the memory used depends on the number of elements, not on the capacity;
  /// each element costs more than in `ESparseLists.backedWithArray`, so it fits very sparse lists.
  //> .check{ESparseLists.backedWithMap[Nat](Math.maxNat).set(1000000000000, 7) .get(1000000000000) .assertEq({::}, Opts# 7)}
  .backedWithMap[E:*](capacity: Nat): mut ESparseList[E] -> _Magic!;
  }

/// A list with "holes": every index below `ESparseList.capacity` holds either an element or a hole.
/// `ESparseList.set` fills a hole; `ESparseList.remove` makes a hole; the indices of the other elements never change,
/// except by `ESparseList.trimTo`, `ESparseList.reverse` and `ESparseList.swap`.
/// The holes are not elements: the methods taking a function of the elements never call it on a hole.
ESparseList[E:*]: _EditableList[E, ESparseList[E]] {
  /// ``this.isFull`` returns `True` if there are no holes in this collection.
  //> .checkTrue{ESparseLists.backedWithArray[Nat] 3 .set(0, 1).set(1, 2).set(2, 3).isFull}
  //> .checkFalse{ESparseLists.backedWithArray[Nat] 3 .set(0, 1).set(2, 3).isFull}
  read .isFull: Bool -> this.numHoles == 0;

  /// ``this.hasHoles`` returns `True` if there is at least one hole in this collection.
  /// Equivalent to: ``this.isFull.not``
  read .hasHoles: Bool -> this.isFull.not;

  /// ``this.isEmpty`` returns `True` if this collection is all holes (or has capacity ``0``).
  //> .checkTrue{ESparseLists.backedWithMap[Nat] 3 .isEmpty}
  //> .checkFalse{ESparseLists.backedWithMap[Nat] 3 .set(0, 1).isEmpty}
  read .isEmpty: Bool -> this.numHoles == (this.capacity);

  /// ``this.capacity`` returns the number of indices of this collection: elements and holes together.
  //> .checkEq(3, {ESparseLists.backedWithArray[Nat] 3 .capacity})
  read .capacity: Nat;

  /// ``this.numHoles`` returns the number of holes in this collection.
  //> .check{Block#
  //>   .let list={ESparseLists.backedWithArray[Nat] 3}
  //>   .do{list.numHoles.assertEq 3}
  //>   .do{list.set(0, 1).numHoles.assertEq 2}
  //>   .done}
  read .numHoles: Nat;

  /// ``this.increaseCapacity n`` returns ``this`` after adding holes at the end, up to capacity ``n``.
  /// Throws if ``n <= this.capacity``.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .increaseCapacity 4 .capacity .assertEq 4}
  //> .checkDetErr({::.isMsg{:: == "ESparseList.increaseCapacity: the capacity 2 is not greater than the current capacity 2"}}, {ESparseLists.backedWithArray[Nat] 2 .increaseCapacity 2})
  mut .increaseCapacity(n: Nat): mut ESparseList[E] -> (n > (this.capacity)).if {
    .then -> this.softIncreaseCapacity n;
    .else -> Error.msg("ESparseList.increaseCapacity: the capacity " + n + " is not greater than the current capacity " + (this.capacity));
    };

  /// ``this.softIncreaseCapacity n`` returns ``this`` after adding holes at the end, up to capacity ``n``.
  /// Does nothing if ``n <= this.capacity``.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .softIncreaseCapacity 4 .capacity .assertEq 4}
  //> .check{ESparseLists.backedWithArray[Nat] 4 .softIncreaseCapacity 2 .capacity .assertEq 4}
  mut .softIncreaseCapacity(n: Nat): mut ESparseList[E];

  /// ``this.get i`` returns ``.some`` of the element at index ``i``, or ``.empty`` if index ``i`` is a hole.
  /// Throws if ``i >= this.capacity``.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7) .get 0 .assertEmpty {::}}
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7) .get 1 .assertEq({::}, Opts# 7)}
  //> .checkDetErr({::.isMsg{:: == "ESparseList.get: Index 2 out of bounds for ESparseList of capacity 2"}}, {ESparseLists.backedWithArray[Nat] 2 .get 2})
  read .get(Nat): mut Opt[read/imm E];
  mut .get(Nat): mut Opt[E];

  /// ``this.set(i, e)`` puts ``e`` at index ``i``, filling the hole or replacing the element there, and returns ``this``.
  /// Throws if ``i >= this.capacity``.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7).set(1, 8) .get 1 .assertEq({::}, Opts# 8)}
  //> .checkDetErr({::.isMsg{:: == "ESparseList.set: Index 2 out of bounds for ESparseList of capacity 2"}}, {ESparseLists.backedWithArray[Nat] 2 .set(2, 7)})
  mut .set(Nat, E): mut ESparseList[E];

  /// ``this.clear`` makes every index a hole, returning ``this``. The capacity is unchanged.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7).clear.numHoles .assertEq 2}
  mut .clear: mut ESparseList[E];

  /// ``this.remove(i)`` makes index ``i`` a hole, returning ``this``; removing a hole does nothing.
  /// Throws if ``i >= this.capacity``.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(0, 6).set(1, 7).remove 0 .get 1 .assertEq({::}, Opts# 7)}
  mut .remove(Nat): mut ESparseList[E];

  /// ``this.removeAll indices`` makes a hole of each index in ``indices``, returning ``this``.
  /// Throws if an index is present twice, or if any index is ``>= this.capacity``.
  //> .check{ESparseLists.backedWithArray[Nat] 3 .fillHoles{i -> i}.removeAll(ELists#(2, 0)).numHoles .assertEq 2}
  mut .removeAll(read EList[Nat]): mut ESparseList[E];

  /// ``this.removeIf(f)`` makes a hole of every index whose element ``f`` returns `True` for, returning ``this``.
  //> .check{ESparseLists.backedWithArray[Nat] 3 .fillHoles{i -> i}.removeIf{e -> e > 0}.flatSeqFlow.list .assertEq({::}, Lists#(0))}
  mut .removeIf(mut MF[E, Bool]): mut ESparseList[E];

  /// ``this.retainIf(f)`` makes a hole of every index whose element ``f`` returns `False` for, returning ``this``.
  /// Equivalent to: ``this.removeIf{e -> f#e .not}``
  mut .retainIf(f: mut MF[E, Bool]): mut ESparseList[E] -> this.removeIf{f#:: .not};

  /// ``this.removeFirstWhere(f)`` makes a hole of the lowest index whose element ``f`` returns `True` for, returning ``this``.
  /// Does nothing if no such element exists.
  mut .removeFirstWhere(mut MF[E, Bool]): mut ESparseList[E];

  /// ``this.removeLastWhere(f)`` makes a hole of the highest index whose element ``f`` returns `True` for, returning ``this``.
  /// Does nothing if no such element exists.
  mut .removeLastWhere(mut MF[E, Bool]): mut ESparseList[E];

  /// ``this.trimTo(start, end)`` keeps only the indices ``[start, end)``, elements and holes, returning ``this``;
  /// index ``start`` moves to index ``0``, and the capacity becomes ``end - start``.
  /// Throws if ``start > end`` or ``end > this.capacity``.
  //> .check{ESparseLists.backedWithArray[Nat] 4 .set(2, 7).trimTo(1, 3).get 1 .assertEq({::}, Opts# 7)}
  mut .trimTo(start: Nat, end: Nat): mut ESparseList[E];

  /// ``this.reverse`` moves the element or hole at each index ``i`` to index ``this.capacity - 1 - i``, returning ``this``.
  //> .check{ESparseLists.backedWithArray[Nat] 3 .set(0, 7).reverse.get 2 .assertEq({::}, Opts# 7)}
  mut .reverse: mut ESparseList[E];

  /// ``this.swap(i, j)`` swaps the contents of indices ``i`` and ``j``, elements or holes, returning ``this``.
  /// Throws if ``i >= this.capacity`` or ``j >= this.capacity``.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(0, 7).swap(0, 1).get 0 .assertEmpty {::}}
  mut .swap(Nat, Nat): mut ESparseList[E];

  /// ``this.fillHoles f`` returns ``this`` after putting ``f#i`` in every hole ``i``, in ascending order.
  /// Equivalent to: ``this.mapOpts{i, e -> e || {Opts#(f#i)}}``
  //> .check{ESparseLists.backedWithArray[Nat] 3 .set(1, 7).fillHoles{i -> i}.getEList.list
  //>   .assertEq({::}, Lists#(0,7,2))}
  mut .fillHoles(mut MF[Nat, E]): mut ESparseList[E];

  /// ``this.mapOpts f`` returns ``this`` after replacing every index ``i``, in ascending order, with ``f#(i, old)``:
  /// ``old`` is ``.some`` of the element at ``i`` or ``.empty`` for a hole; a ``.some`` result puts its element at ``i``, an ``.empty`` result makes ``i`` a hole.
  //> .check{ESparseLists.backedWithArray[Nat] 3 .set(0, 5).set(1, 6)
  //>   .mapOpts{i, e -> (i == 0).if{ .then -> {}; .else -> Opts#(i)}}.flowOpts(ParImm#).map{o -> o.isSome}.list
  //>   .assertEq({::}, Lists#(False, True, True))}
  mut .mapOpts(mut MF[Nat, mut Opt[E], mut Opt[E]]): mut ESparseList[E];

  /// ``this.fillFrom list`` returns ``this`` after filling the holes, in ascending order, with the elements of ``list`` in order,
  /// until there are no more holes or no more elements. ``list`` is left unchanged.
  //> .check{ESparseLists.backedWithArray[Nat] 3 .set(1, 9).fillFrom(ELists#(4,5,6)).getEList.list
  //>   .assertEq({::}, Lists#(4,9,5))}
  mut .fillFrom(list: mut EList[E]): mut ESparseList[E];

  /// ``this.fillAndExpand list`` is `ESparseList.fillFrom`, increasing the capacity of ``this`` to fit the elements of ``list`` left over.
  //> .check{ESparseLists.backedWithArray[Nat] 1 .fillAndExpand(ELists#(4,5)).getEList.list
  //>   .assertEq({::}, Lists#(4,5))}
  mut .fillAndExpand(list: mut EList[E]): mut ESparseList[E];

  /// ``this.seqFlowOpts`` drains ``this`` into a sequential flow of one `Opt` per index:
  /// ``.some`` of the element, or ``.empty`` for a hole.
  /// ``this`` is left all holes, with the same capacity.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(1, 7).seqFlowOpts.map{o -> o.isSome}.list .assertEq({::}, Lists#(False, True))}
  mut .seqFlowOpts: mut Flow[mut Opt[E]];

  /// ``this.flowOpts mode`` is `ESparseList.seqFlowOpts`, flowing in ``mode``.
  mut .flowOpts(mode: FlowMode[E]): mut Flow[mut Opt[E]];

  /// ``this.flatSeqFlow`` drains ``this`` into a sequential flow of its elements, skipping the holes.
  /// ``this`` is left all holes, with the same capacity.
  //> .check{ESparseLists.backedWithArray[Nat] 3 .set(0, 1).set(2, 3).flatSeqFlow.list
  //>   .assertEq({::}, Lists#(1,3))}
  mut .flatSeqFlow: mut Flow[E];

  /// ``this.flatFlow mode`` is `ESparseList.flatSeqFlow`, flowing in ``mode``.
  mut .flatFlow(mode: FlowMode[E]): mut Flow[E];

  /// ``this.seqFlow`` returns ``.some`` of `ESparseList.flatSeqFlow` if there are no holes, ``.empty`` otherwise.
  /// Drains ``this`` only when returning ``.some``.
  mut .seqFlow: mut Opt[mut Flow[E]] -> this.isFull .toOpt {this.flatSeqFlow};

  /// ``this.flow mode`` returns ``.some`` of ``this.flatFlow mode`` if there are no holes, ``.empty`` otherwise.
  /// Drains ``this`` only when returning ``.some``.
  mut .flow(mode: FlowMode[E]): mut Opt[mut Flow[E]] -> this.isFull .toOpt {this.flatFlow(mode)};

  /// ``this.getSeqFlow`` returns `ESparseList.flatSeqFlow` if there are no holes, and throws otherwise.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(0, 1).set(1, 2).getSeqFlow.list
  //>   .assertEq({::}, Lists#(1,2))}
  //> .checkDetErr({::.isMsg{::.startsWith "ESparseList.getSeqFlow:"}}, {ESparseLists.backedWithArray[Nat] 2 .set(0, 1).getSeqFlow})
  mut .getSeqFlow: mut Flow[E] -> this.isFull .if {
    .then -> this.flatSeqFlow;
    .else -> Error.msg(
      "ESparseList.getSeqFlow: this ESparseList has " + (this.numHoles) + " holes."
      | "Use a flow that skips or shows the holes, or fill the holes first."
      );
    };

  /// ``this.getFlow mode`` returns ``this.flatFlow mode`` if there are no holes, and throws otherwise.
  mut .getFlow(mode: FlowMode[E]): mut Flow[E] -> this.isFull .if {
    .then -> this.flatFlow(mode);
    .else -> Error.msg(
      "ESparseList.getFlow: this ESparseList has " + (this.numHoles) + " holes."
      | "Use a flow that skips or shows the holes, or fill the holes first."
      );
    };

  /// ``this.getEList`` drains ``this`` into an `EList` of its elements, and throws if there are any holes.
  /// ``this`` is left all holes, with the same capacity.
  //> .check{Block#
  //>   .let slist = {ESparseLists.backedWithArray[Nat] 3 .fillHoles {::}}
  //>   .do{slist.getEList.list.assertEq({::}, Lists#(0,1,2))}
  //>   .do{slist.isEmpty.assertTrue}.done}
  //> .checkDetErr({::.isMsg{:: == "ESparseList.getEList: this ESparseList has 2 holes; fill the holes first"}}, {ESparseLists.backedWithArray[Nat] 3 .set(0, 1).getEList})
  mut .getEList: mut EList[E];

  /// ``this.eList`` returns ``.some`` of `ESparseList.getEList` if there are no holes, ``.empty`` otherwise.
  /// Drains ``this`` only when returning ``.some``.
  //> .check{ESparseLists.backedWithArray[Nat] 2 .set(0, 1).eList .isEmpty .assertTrue}
  mut .eList: mut Opt[mut EList[E]] -> this.isFull .toOpt {this.getEList};
  }
