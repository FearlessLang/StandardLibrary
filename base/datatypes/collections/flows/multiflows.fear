_MultiFlow[Self]: Pipe[Self]{
  /// ``this.noMoreThan(n)`` returns a ``this`` limited to the first ``n`` elements of each channel,
  /// truncating silently if ``n`` exceeds a channel's size.
  //> .check{Flows#(1,2).with(Flows#(3,4)).noMoreThan(1).getMerge{a,b -> a+b}.list
  //>   .assertEq({::}, Lists#(4))}
  mut .noMoreThan(n: Nat): mut Self;

  /// ``this.cutToSmallest`` explicitly limits this multiflow to the smallest of the n channels.
  //> .check{Flows#(1,2).with(Flows#(3)).cutToSmallest.getMerge{a,b -> a+b}.list
  //>   .assertEq({::}, Lists#(4))}
  mut .cutToSmallest: mut Self;
  }


BiKeyElemMapper[A:*,B:*,K,E:*]: {
  .key(A,B): K;
  .elem(A,B): E;
  }

BiFlow[A:*,B:*]: _MultiFlow[BiFlow[A,B]] {
  /// ``this.with(flow)`` returns a TriFlow with ``flow`` added as a new channel.
  mut .with[C:*](flow: mut Flow[C]): mut TriFlow[A,B,C];

  /// ``this.withBoth(flow)`` returns a QuadFlow with both channels from ``flow`` added.
  mut .withBoth[C:*,D:*](flow: mut BiFlow[C,D]): mut QuadFlow[A,B,C,D];

  // ``this.enumerate`` returns a TriFlow with a channel of indices (starting from 0) prepended.
  // The index channel has size equal to ``this.maxSize``.
  // Note: this mutates this BiFlow; references to it before this call will be broken.
  mut .enumerate: mut TriFlow[Nat,A,B];

  /// ``this.mapping(by, kem)`` returns a map holding one entry per element of `this`,
  /// with key's and values determined by ``kem``
  /// Throws a deterministic error when two elements produce the same key, or if the channels have different numbers of elements
  //> .check{Flows#(1,2).with(Flows#(10,20)).mapping({::},{.key a,b -> a; .elem a,b -> b}).size.assertEq 2}
  mut .mapping[K,K',E:*](OrderHashBy[K,K'], read BiKeyElemMapper[A,B,K,E]): mut Map[K,E];

  /// ``this.getMerge(f)`` merges both channels using ``f``.
  /// Warning: downstream operations will throw if the channels differ in size.
  /// Note: we have no ``.merge`` as we have to know if the flow is the right size at call time we have to collect it.
  ///   if you want the `Opt` use ``this.mergeToList f``
  //> .check{Flows#(1,2).with(Flows#(10,20)).getMerge{a,b -> a+b}.list
  //>   .assertEq({::}, Lists#(11,22))}
  mut .getMerge[R:*](f: read F[A,B,R]): mut Flow[R];

  /// ``this.mergeToList(f)`` returns ``.some`` of the merged flow if the channels are the same size,
  /// otherwise ``.empty``.
  //> .check{Flows#(1,2).with(Flows#(10,20))
  //>   .mergeToList{a,b -> a+b}!.assertEq({::}, Lists#(11,22))}
  mut .mergeToList[R:*](f: read F[A,B,R]): mut Opt[mut List[R]];

  /// ``this.mergeOpts(f)`` merges both channels using ``f``, passing ``.empty`` for missing values.
  /// Continues until all channels are exhausted.
  mut .mergeOpts[R:*](f: read F[Opt[A],Opt[B],R]): mut Flow[R];

  /// ``this.getFold(acc, f)`` folds both channels pairwise from left to right, starting from ``acc``.
  /// For each pair ``(a, b)`` the accumulator is updated to ``f#(acc, a, b)``.
  /// Throws if the channels differ in size.
  //> .check{Flows#(1,2).with(Flows#(10,20)).getFold({0},{acc,a,b -> acc+a+b}).assertEq 33}
  mut .getFold[R:*](acc: mut MF[R], f: read F[R, A, B, R]): R;

  /// ``this.fold(acc, f)`` returns ``.some`` of the fold result if the channels are the same size,
  /// otherwise ``.empty``.
  //> .check{Flows#(1,2).with(Flows#(10)).fold({0},{acc,a,b -> acc+a+b}).assertEmpty {::}}
  mut .fold[R:*](acc: mut MF[R], f: read F[R, A, B, R]): mut Opt[R];

  /// ``this.foldOpts(acc, f)`` folds both channels pairwise from left to right, starting from ``acc``,
  /// passing ``.empty`` for missing values. Continues until all channels are exhausted.
  mut .foldOpts[R:*](acc: mut MF[R], f: read F[R,Opt[A],Opt[B],R]): R;

  /// ``this.getFoldUntil(acc, f, pred)`` folds both channels pairwise from left to right, starting
  /// from ``acc``, updating the accumulator with ``f`` at each pair and stopping as soon as ``pred``
  /// is true of the resulting accumulator (that pair is included in the result). If ``pred`` is
  /// never satisfied, folds all the way through and returns the final accumulator.
  /// Throws if the channels differ in size.
  mut .getFoldUntil[R:*](acc: mut MF[R], f: read F[R,A,B,R], pred: read F[R,Bool]): R;

  /// ``this.foldUntil(acc, f, pred)`` returns ``.some`` of the ``getFoldUntil`` result if the channels
  /// are the same size, otherwise ``.empty``.
  mut .foldUntil[R:*](acc: mut MF[R], f: read F[R,A,B,R], pred: read F[R,Bool]): mut Opt[R];

  /// ``this.foldOptsUntil(acc, f, pred)`` folds both channels pairwise from left to right, starting
  /// from ``acc``, passing ``.empty`` for missing values, and stopping as soon as ``pred`` is true of
  /// the resulting accumulator. Continues until all channels are exhausted or ``pred`` is satisfied.
  mut .foldOptsUntil[R:*](acc: mut MF[R], f: read F[R,Opt[A],Opt[B],R], pred: read F[R,Bool]): R;

  /// ``this.fillA(f)`` returns a BiFlow where missing values in channel A are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  //> .check{Flows#(1).with(Flows#(10,20)).fillA{n -> n}.getMerge{a,b -> a+b}.list
  //>   .assertEq({::}, Lists#(11,21))}
  mut .fillA(f: read F[Nat,A]): mut BiFlow[A,B];

  /// ``this.fillB(f)`` returns a BiFlow where missing values in channel B are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  //> .check{Flows#(1,2).with(Flows#(10)).fillB{n -> n}.getMerge{a,b -> a+b}.list
  //>   .assertEq({::}, Lists#(11,3))}
  mut .fillB(f: read F[Nat,B]): mut BiFlow[A,B];
  }


TriFlow[A:*,B:*,C:*]: _MultiFlow[TriFlow[A,B,C]] {

  /// ``this.with(flow)`` returns a QuadFlow with ``flow`` added as a new channel.
  mut .with[D:*](flow: mut Flow[D]): mut QuadFlow[A,B,C,D];

  // ``this.enumerate`` returns a QuadFlow with a channel of indices (starting from 0) prepended.
  // The index channel has size equal to ``this.maxSize``.
  // Note: this mutates this TriFlow; references to it before this call will be broken.
  //> .check{Flows#(10,20).with(Flows#(1,2)).with(Flows#(100,200)).enumerate
  //>   .getMerge{i,a,b,c -> i+a+b+c}.list.assertEq({::}, Lists#(111,223))}
  mut .enumerate: mut QuadFlow[Nat,A,B,C];

  /// ``this.fillA(f)`` returns a TriFlow where missing values in channel A are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  mut .fillA(f: read F[Nat,A]): mut TriFlow[A,B,C];

  /// ``this.fillB(f)`` returns a TriFlow where missing values in channel B are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  mut .fillB(f: read F[Nat,B]): mut TriFlow[A,B,C];

  /// ``this.fillC(f)`` returns a TriFlow where missing values in channel C are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  mut .fillC(f: read F[Nat,C]): mut TriFlow[A,B,C];

  /// ``this.getMerge(f)`` merges all three channels using ``f``.
  /// Throws if the channels differ in size.
  //> .check{Flows#(1,2).with(Flows#(10,20)).with(Flows#(100,200)).getMerge{a,b,c -> a+b+c}.list
  //>   .assertEq({::}, Lists#(111,222))}
  mut .getMerge[R:*](f: read F[A,B,C,R]): mut Flow[R];

  /// ``this.merge(f)`` returns ``.some`` of the merged flow if all channels are the same size,
  /// otherwise ``.empty``.
  mut .mergeToList[R:*](f: read F[A,B,C,R]): mut Opt[mut List[R]];

  /// ``this.mergeOpts(f)`` merges all three channels using ``f``, passing ``.empty`` for missing values.
  /// Continues until all channels are exhausted.
  mut .mergeOpts[R:*](f: read F[Opt[A],Opt[B],Opt[C],R]): mut Flow[R];

  /// ``this.getFold(acc, f)`` folds all three channels from left to right, starting from ``acc``.
  /// For each triple ``(a, b, c)`` the accumulator is updated to ``f#(acc, a, b, c)``.
  /// Throws if the channels differ in size.
  mut .getFold[R:*](acc: mut MF[R], f: read F[R, A, B, C, R]): R;

  /// ``this.fold(acc, f)`` returns ``.some`` of the fold result if all channels are the same size,
  /// otherwise ``.empty``.
  mut .fold[R:*](acc: mut MF[R], f: read F[R, A, B, C, R]): mut Opt[R];

  /// ``this.foldOpts(acc, f)`` folds all three channels from left to right, starting from ``acc``,
  /// passing ``.empty`` for missing values. Continues until all channels are exhausted.
  mut .foldOpts[R:*](acc: mut MF[R], f: read F[R,Opt[A],Opt[B],Opt[C],R]): R;

  /// ``this.getFoldUntil(acc, f, pred)`` folds all three channels from left to right, starting
  /// from ``acc``, updating the accumulator with ``f`` at each triple and stopping as soon as ``pred``
  /// is true of the resulting accumulator (that triple is included in the result). If ``pred`` is
  /// never satisfied, folds all the way through and returns the final accumulator.
  /// Throws if the channels differ in size.
  mut .getFoldUntil[R:*](acc: mut MF[R], f: read F[R, A, B, C, R], pred: read F[R,Bool]): R;

  /// ``this.foldUntil(acc, f, pred)`` returns ``.some`` of the ``getFoldUntil`` result if all channels
  /// are the same size, otherwise ``.empty``.
  mut .foldUntil[R:*](acc: mut MF[R], f: read F[R,A,B,C,R], pred: read F[R,Bool]): mut Opt[R];

  /// ``this.foldOptsUntil(acc, f, pred)`` folds all three channels from left to right, starting
  /// from ``acc``, passing ``.empty`` for missing values, and stopping as soon as ``pred`` is true of
  /// the resulting accumulator. Continues until all channels are exhausted or ``pred`` is satisfied.
  mut .foldOptsUntil[R:*](acc: mut MF[R], f: read F[R,Opt[A],Opt[B],Opt[C],R], pred: read F[R,Bool]): R;
  }


QuadFlow[A:*,B:*,C:*,D:*]: _MultiFlow[QuadFlow[A,B,C,D]] {

  /// ``this.fillA(f)`` returns a QuadFlow where missing values in channel A are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  mut .fillA(f: read F[Nat,A]): mut QuadFlow[A,B,C,D];

  /// ``this.fillB(f)`` returns a QuadFlow where missing values in channel B are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  mut .fillB(f: read F[Nat,B]): mut QuadFlow[A,B,C,D];

  /// ``this.fillC(f)`` returns a QuadFlow where missing values in channel C are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  mut .fillC(f: read F[Nat,C]): mut QuadFlow[A,B,C,D];

  /// ``this.fillD(f)`` returns a QuadFlow where missing values in channel D are filled using ``f(n)``
  /// where ``n`` is the index of the missing slot.
  mut .fillD(f: read F[Nat,D]): mut QuadFlow[A,B,C,D];

  /// ``this.getMerge(f)`` merges all four channels using ``f``.
  /// Throws if the channels differ in size.
  //> .check{Flows#(1,2).with(Flows#(10,20)).with(Flows#(100,200)).with(Flows#(1000,2000))
  //>   .getMerge{a,b,c,d -> a+b+c+d}.list.assertEq({::}, Lists#(1111,2222))}
  mut .getMerge[R:*](f: read F[A,B,C,D,R]): mut Flow[R];

  /// ``this.mergeToList(f)`` returns ``.some`` of the merged flow if all channels are the same size,
  /// otherwise ``.empty``.
  mut .mergeToList[R:*](f: read F[A,B,C,D,R]): mut Opt[mut List[R]];

  /// ``this.mergeOpts(f)`` merges all four channels using ``f``, passing ``.empty`` for missing values.
  /// Continues until all channels are exhausted.
  mut .mergeOpts[R:*](f: read F[Opt[A],Opt[B],Opt[C],Opt[D],R]): mut Flow[R];

  /// ``this.getFold(acc, f)`` folds all four channels from left to right, starting from ``acc``.
  /// For each tuple ``(a, b, c, d)`` the accumulator is updated to ``f#(acc, a, b, c, d)``.
  /// Throws if the channels differ in size.
  mut .getFold[R:*](acc: mut MF[R], f: read F[R, A, B, C, D, R]): R;

  /// ``this.fold(acc, f)`` returns ``.some`` of the fold result if all channels are the same size,
  /// otherwise ``.empty``.
  mut .fold[R:*](acc: mut MF[R], f: read F[R, A, B, C, D, R]): mut Opt[R];

  /// ``this.foldOpts(acc, f)`` folds all four channels from left to right, starting from ``acc``,
  /// passing ``.empty`` for missing values. Continues until all channels are exhausted.
  mut .foldOpts[R:*](acc: mut MF[R], f: read F[R,Opt[A],Opt[B],Opt[C],Opt[D],R]): R;

  /// ``this.getFoldUntil(acc, f, pred)`` folds all four channels from left to right, starting
  /// from ``acc``, updating the accumulator with ``f`` at each tuple and stopping as soon as ``pred``
  /// is true of the resulting accumulator (that tuple is included in the result). If ``pred`` is
  /// never satisfied, folds all the way through and returns the final accumulator.
  /// Throws if the channels differ in size.
  mut .getFoldUntil[R:*](acc: mut MF[R], f: read F[R, A, B, C, D, R], pred: read F[R,Bool]): R;

  /// ``this.foldUntil(acc, f, pred)`` returns ``.some`` of the ``getFoldUntil`` result if all channels
  /// are the same size, otherwise ``.empty``.
  mut .foldUntil[R:*](acc: mut MF[R], f: read F[R, A, B, C, D, R], pred: read F[R,Bool]): mut Opt[R];

  /// ``this.foldOptsUntil(acc, f, pred)`` folds all four channels from left to right, starting
  /// from ``acc``, passing ``.empty`` for missing values, and stopping as soon as ``pred`` is true of
  /// the resulting accumulator. Continues until all channels are exhausted or ``pred`` is satisfied.
  mut .foldOptsUntil[R:*](acc: mut MF[R], f: read F[R,Opt[A],Opt[B],Opt[C],Opt[D],R], pred: read F[R,Bool]): R;
  }