//@Group "flows"
AsImm[E:*, R]: { read #(E): R; }

//@Group "flows"
FoldAcc[E:*,R:**]: { mut .result: R; mut .acc(E): mut FoldAcc[E,R] }
//@Group "imperative"
//@Group "flows"
ForEachBody[A,E:*]: { mut #(a: mutH A, e: E): Void }

//@Group "algebra"
//@Group "flows"
JoinStr[E:*]: { .joinStr(mut Flow[E]): E }
//@Group "algebra"
//@Group "flows"
SumNumber[E:*]: { .sumNumber(mut Flow[E]): E }

//@Group "flows"
FlowMode[T:*]:Sealed{.flowMode:FlowMode[T];}
//@Group "flows"
ToFlow[E:*]: Sealed {
  read .seqFlow: mut Flow[read/imm E];
  mut  .seqFlow: mut Flow[E];
  }
//@Group "flows"
ParImm:Sealed{#[T:imm]:ParImm[T]->ParImm[T]}
//@Group "flows"
ParImm[T:imm]:FlowMode[T]{this}
//@Group "flows"
ParRead:Sealed{#[T:imm,read]:ParRead[T]->ParRead[T]}
//@Group "flows"
ParRead[T:imm,read]:FlowMode[T]{this}
//@Group "flows"
ParRepr:Sealed{#[T]:ParRepr[T]->ParRepr[T]}
//@Group "flows"
ParRepr[T]:FlowMode[mut Repr[T]]{this}
//@Group "flows"
ParPod:Sealed{#[T]:ParPod[T]->ParPod[T]}
//@Group "flows"
ParPod[T]:FlowMode[mut IsoPod[T]]{this}

//@Group "flows"
ActorImpl[S:*,E:*,R]: {
  read #(down: mut ActorSink[R], state: S, e: E): mut ContinueBreak[Void]
  }
//@Group "flows"
ActorImplMut[S:*,E:*,R:*]: {
  read #(down: mutH ActorSink[R], state: mutH S, e: E): mut ContinueBreak[Void]
  }

/// Where an actor lambda pushes the elements it emits.
/// ``down#e`` pushes ``e`` on a ``mut`` sink, as in `ActorImpl`.
/// ``down.push#(down, e)`` pushes ``e`` on any sink, the ``mutH`` one of
/// `ActorImplMut` included.
/// ``down.pushOpt#(down, o)`` pushes what ``o`` holds, and nothing when it holds
/// nothing.
//@Group "flows"
ActorSink[E:*]: Sealed {
  read .push: ActorSinkHelper -> ActorSinkHelper;
  read .pushOpt: ActorSinkOptHelper -> ActorSinkOptHelper;
  mut #(E): Void;
  }

/// ``ActorSinkHelper#(down, e)`` is ``down#e``, on a ``mutH`` sink too.
//@Group "flows"
ActorSinkHelper: Sealed {
  imm #[E:*](down: mutH ActorSink[E], e: E): Void -> _Magic!;
  }

//@Group "flows"
ActorSinkOptHelper: Sealed {
  imm #[E:*](down: mutH ActorSink[E], e: mut Opt[E]): Void -> e.isSome
    .if[_PushOptStep[E]]{ .then -> {d, o -> d.push#(d, o!)}; .else -> {_, _ -> Void} }
    #(down, e);
  }
_PushOptStep[E:*]: { read #(down: mutH ActorSink[E], e: mut Opt[E]): Void }

//@Group "collections"
//@Group "flows"
IfSome: { #[E:*](b: Bool, e: E): mut Opt[E] -> b ?{ .then -> Opts#e; .else -> {} } }
//@Group "flows"
Yield: Sealed { #: Void -> Void }
