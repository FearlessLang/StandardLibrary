AsImm[E:*, R]: { read #(E): R; }

FoldAcc[E:*,R:**]: { mut .result: R; mut .acc(E): mut FoldAcc[E,R] }
ForEachBody[A,E:*]: { mut #(a: mutH A, e: E): Void }
ELists: { #[E:*]: mut EList[E]-> _Magic! }

JoinStr[E:*]: { .joinStr(mut Flow[E]): E }
SumNumber[E:*]: { .sumNumber(mut Flow[E]): E }

FlowMode[T:*]:Sealed{.flowMode:FlowMode[T];}
Par:Sealed{#[T:imm,read]:Par[T]->Par[T]}
Par[T:imm,read]:FlowMode[T]{this}
ParRepr:Sealed{#[T]:ParRepr[T]->ParRepr[T]}
ParRepr[T]:FlowMode[mut Repr[T]]{this}
ParPod:Sealed{#[T]:ParPod[T]->ParPod[T]}
ParPod[T]:FlowMode[mut IsoPod[T]]{this}

ActorImpl[S:*,E:*,R]: {
  read #(down: mutH ActorSink[R], state: S, e: E): mut ContinueBreak[Void]
  }
ActorImplMut[S:*,E:*,R:*]: {
  read #(down: mutH ActorSink[R], state: mutH S, e: E): mut ContinueBreak[Void]
  }

/// Where an actor lambda pushes the elements it emits. The sink is ``mutH`` in
/// `ActorImpl` and `ActorImplMut`: it can be pushed to and passed on, never
/// stored or captured.
/// ``down#e`` pushes an ``imm`` ``e``, as `ActorImpl` emits.
/// ``down.push#(down, e)`` pushes any ``e``, a ``mut`` one of `ActorImplMut`
/// included.
/// ``down.pushOpt#(down, o)`` pushes what ``o`` holds, and nothing when it holds
/// nothing.
ActorSink[E:*]: Sealed {
  read .push: ActorSinkHelper -> ActorSinkHelper;
  read .pushOpt: ActorSinkOptHelper -> ActorSinkOptHelper;
  mut #(E): Void;
  }

/// ``ActorSinkHelper#(down, e)`` is ``down#e`` for any ``e``, ``mut`` included.
ActorSinkHelper: Sealed {
  imm #[E:*](down: mutH ActorSink[E], e: E): Void -> _Magic!;
  }

ActorSinkOptHelper: Sealed {
  imm #[E:*](down: mutH ActorSink[E], e: mut Opt[E]): Void -> e.isSome
    .if[_PushOptStep[E]]{ .then -> {d, o -> d.push#(d, o!)}; .else -> {_, _ -> Void} }
    #(down, e);
  }
_PushOptStep[E:*]: { read #(down: mutH ActorSink[E], e: mut Opt[E]): Void }
