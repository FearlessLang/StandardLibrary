Maps: Sealed {
  #[K,K',E:*](OrderHashBy[K,K']):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;
  #[K,K',E:*](OrderHashBy[K,K'], K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E,K,E):mut Map[K,E]->_Magic!;

  .singletonRead[K,K',E:*](OrderHashBy[K,K'], K, read E): read Map[K,E]->_Magic!;
  }

/// Keys are only imm and compared/hashed using the map's stored OrderHashBy[K,...].
/// The flow order, .str order etc all respect/follow the map insertion order.
Map[K,E:*]: Sealed,ToFlow[mut KeyElem[K,E]],BaseContainer[E],DataType[Map[K,E],Map[K,imm E],E,imm E],_AssertEmpty,_AssertSize {

  read .size: Nat;                 /// number of elements
  read .isEmpty: Bool;             /// `True` iff size == 0

  read .keyOh: OrderHashBy[K];     /// key comparator+hash used by this map;

  mut  .get(k: K): E;              /// value for k; throws iff k absent
  read .get(k: K): read/imm E;     /// value for k; throws iff k absent
  /// ``this.tryGet(k)`` returns `.ok` of ``this.get(k)``, or the error info of ``this.get(k)`` iff ``k`` is absent.
  //>   .check{(Maps#({::}, "a", 1).tryGet "a").ok.assertEq({::}, Opts# 1)}
  //>   .check{Maps#({::}, "a", 1).tryGet "b" .assertInfo{::.isMsg{::.startsWith "Map.get:"}}}
  mut  .tryGet(k: K): mut Action[E];
  read .tryGet(k: K): mut Action[read/imm E];

  mut  .opt(k: K): mut Opt[E];           /// .some(get(k)) if present; .empty otherwise
  read .opt(k: K): mut Opt[read/imm E];  /// .some(get(k)) if present; .empty otherwise
  imm  .opt(k: K): mut Opt[imm E];       /// .some(get(k)) if present; .empty otherwise

  read .containsKey(k: K): Bool;         /// true iff k present

  /// ``this.with(k, e)`` binds ``k`` to ``e``; elements can be ``mut``.
  //>   .check{Maps#[Str,Str,mut Var[Nat]]({::}).with("a", Vars#[Nat](1)).get "a" .get .assertEq 1}
  //>   .check{Maps#[Str,Str,mut Var[Nat]]({::}, "a", Vars#[Nat](1)).with("b", Vars#[Nat](2)).get "a" .get .assertEq 1}
  mut  .with(k: K, e: E): mut Map[K,E];           /// insert/replace binding for k
  read .with(k: K, e: read E): read Map[K,E];     /// insert/replace binding for k

  mut  .without(k: K): mut Map[K,E];       /// remove binding for k; throws iff k absent
  read .without(k: K): read Map[K,E];      /// remove binding for k; throws iff k absent

  mut  ++ (other: mut Map[K,E]): mut Map[K,E];    /// union; Note: the left map has priority: elements in left are not overridden by elements in right; and the key Order is always the left one (left map's ordering reinterprets right map's keys)
  read ++ (other: read Map[K,E]): read Map[K,E];  /// union; Note: the left map has priority: elements in left are not overridden by elements in right; and the key Order is always the left one (left map's ordering reinterprets right map's keys)

//  TODO: for the future, but there are big questions about the exact type signature(s)
//  mut  .merge(merge: mut F[E,E,E], other: mut Map[K,E]): mut Map[K,E];

  /// ``this.flow`` returns a `BiFlow` of the keys and the elements of `this`, in insertion order.
  /// The merges of the `BiFlow` of an ``imm`` map are in mode `ParImm`, the others are sequential.
  //>   .check{Maps#({::}, "a", 1, "b", 2).flow.getMerge{k, e -> k + e}.list .assertEq({::}, Lists#("a1", "b2"))}
  //>   .check{Maps#({::}, "a", 1, "b", 2).flow.getFold({0}, {acc, _, e -> acc + e}) .assertEq 3}
  //>   .check{Maps#({::}, "a", "x", "b", "y").flow.getFold({""}, {acc, k, e -> acc + k + e}) .assertEq "axby"}
  mut  .flow: mut BiFlow[K,E];                 /// keys and elements as a BiFlow, in insertion order; its merges are sequential
  read .flow: mut BiFlow[K,read/imm E];        /// keys and elements as a BiFlow, in insertion order; its merges are sequential
  imm  .flow: mut BiFlow[K,imm E];             /// keys and elements as a BiFlow, in insertion order; its merges are in mode ParImm
  read .keys: mut Flow[K];               /// keys as a flow (same iteration order as .flow)
  read .elems: mut Flow[read/imm E];     /// values as a flow (same iteration order as .flow)

  read .as[T2](f: BaseId[read/imm E,T2]): Map[K,T2];       /// zero cost retyping, returns `this`

  //TODO: for the future, we need to consider the variants of this (update, computeIfAbsent, etc)
  //mut  .update(k: K, f: mut MF[E,E]): mut Map[K,E];        /// replace value at k with f(get(k)); throws iff absent
  
  /*.info by->Block#
    .let map= {this.flow.mapping({::},{
      .key e->this.keyOh#(e.key).str;
      .elem e->by#(e.elem).info;
      }).as{::}}
    .return{{'i
    .match->::.map map;
    .map -> map;
    .imm->i;
    }};*/
  .info by->Block#
    .if {this.isEmpty} .return {Info}
    .let map= {this.flow.getFold(
      {Maps#[Str,Str,Info]{::}.as{::}},
      {acc, key, e -> Block#
        .let base= {this.keyOh#key .str}
        .let k= {_InfoFreshKey#(acc, base, 0)}
        .return{acc.with(k, by#e .info).as{::}}
    })}
  .return{{'i //correct to make the Info object (as for List), calling .info here would go in stack overflow
    .match->::.map map;
    .map -> Opts# map;
    .imm->i;
    }};
  }

KeyElem[K,E:*]: {
  read .key: K;
  mut .elem: E;
  read .elem: read/imm E;
  imm .elem: imm E;
  }

KeyElems: {#[K,E:*](key: K, elem: E): mut KeyElem[K,E] -> { .key->key; .elem->elem; } }
KeyElemMapper[A:*,K,E:*]: {.key(A):K;.elem(A):E;}//needed in Flow.mapping