///The object capability to send messages to the Fearless manager running this program.
///Each method sends one message, as the manager program does when started with the arguments ``FearlessCommand<Verb>``,
///and returns once the manager has applied the message; `.run` and `.compile` return once the mains or the compilation end.
///A message the manager refuses is a non deterministic error saying why, as the manager window shows it.
///`.quit`, `.reset` and `.terminate` of the project of this program end this program before the method returns.
///A program started by the portable Fearless has no manager: every method is a non deterministic error.
///``name`` is the name of a registered project.
///``path`` is the bytes naming an absolute path on this system:
///on Windows the UTF-16 code units of the path, little endian (`UStr.utf16Le`);
///on the other systems the bytes of the path, most often its UTF-8 encoding (`UStr.utf8`).
///A ``path`` that is not absolute is a deterministic error.
CapManager: ToIso[CapManager], WidenTo[CapManager]{
  ///Shows the manager window.
  mut .show: Void;
  ///Shows the manager window and selects the project ``name``.
  mut .show(name: Str): Void;
  ///Registers the folder at ``path``, or the folder holding the file at ``path``, then selects it.
  mut .register(path: List[Byte]): Void;
  ///Ends the manager and every main and compilation it runs, this program included.
  mut .quit: Void;
  ///Ends the manager and every main and compilation it runs, this program included,
  ///removes every file association of the manager and deletes the manager folder.
  mut .reset: Void;
  ///Connects the Eclipse found from ``path``.
  mut .connectEclipse(path: List[Byte]): Void;
  ///Replaces the record of the registered projects with the content of the file at ``path``.
  mut .editMetadata(path: List[Byte]): Void;
  ///Opens the file at ``path`` with the main claiming its extension, as a double click on the file does.
  mut .openWithOrShortcut(path: List[Byte]): Void;
  ///Opens the file at ``path`` with the main ``main`` of the project ``name``, one of the mains claiming its extension.
  mut .openWithOrShortcut(path: List[Byte], name: Str, main: Str): Void;
  ///Selects the project ``name`` and runs ``mains``, in the order of the mains of the project.
  ///Returns the Output of those mains, empty when no main starts.
  mut .run(name: Str, mains: List[Str]): UStr;
  ///Selects the project ``name`` and compiles it if it needs compiling.
  ///Returns the Output of that compilation, empty when no compilation starts.
  mut .compile(name: Str): UStr;
  ///Selects the project ``name`` and reports in its Output why it is invalid or out of date, or that it is neither.
  mut .check(name: Str): Void;
  ///Selects the project ``name`` and ends the main or the compilation of the project currently running, if any.
  mut .terminate(name: Str): Void;
  ///Selects the project ``name`` and deletes its compilation cache.
  mut .deleteCache(name: Str): Void;
  ///Sets the kind of the project ``name`` to idle.
  mut .kindIdle(name: Str): Void;
  ///Sets the kind of the project ``name`` to code; the kind changes only from idle.
  mut .kindCode(name: Str): Void;
  ///Sets the kind of the project ``name`` to read only data; the kind changes only from idle.
  mut .kindDataReadOnly(name: Str): Void;
  ///Sets the kind of the project ``name`` to read write data; the kind changes only from idle.
  mut .kindDataReadWrite(name: Str): Void;
  ///Forgets the project ``name``.
  mut .forget(name: Str): Void;
  ///Links the code project ``name`` to the data project ``data`` for reading, under the type names ``types``.
  ///No type names removes that link.
  mut .linkRead(name: Str, data: Str, types: List[Str]): Void;
  ///Links the code project ``name`` to the data project ``data`` for reading and writing, under the type names ``types``.
  ///No type names removes that link.
  mut .linkWrite(name: Str, data: Str, types: List[Str]): Void;
  ///Sets the attenuators the manager applies to the main ``main`` of the project ``name`` to ``attenuators``, in that order.
  ///No attenuator removes them all.
  mut .attenuate(name: Str, main: Str, attenuators: List[Str]): Void;
  }
