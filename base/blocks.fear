//@Group "imperative"
Continuation[T:*,R:*]: {mut #(x: T, self: mut Block[R]): R}
//@Group "imperative"
//@Group "flows"
FlowContinuation[E:*,T:*,R:*]: {mut #(x: T, self: mut List[E]): R}
//@Group "imperative"
OpenIsoContinuation[T,R:*]: {mut #(x: mut T, self: mut Block[R]): R}//Only needed for limitations of inference
//otherwise the same as Continuation[mut X,R]
//@Group "imperative"
//@Group "structured data"
ReprWithInvariant[T]: { mut .elem: iso T; mut .invariant: F[read T,Bool];}

//@Group "imperative"
Block: Sealed {
  #[R:*]: mut Block[R] -> {};
  #[A:**, R:**](A, res: R): R -> res;
  #[A:**, B:**, R:**](A, B, res: R): R -> res;
  #[A:**, B:**, C:**, R:**](A, B, C, res: R): R -> res;
  #[A:**, B:**, C:**, D:**, R:**](A, B, C, D, res: R): R -> res;
  }

//@Group "imperative"
Block[R:*]: Sealed {
  mut .done: Void -> {};
  mut .return(a: mut MF[R]): R -> a#;
  mut .error(errorInfo: LazyInfo): R -> Error!(errorInfo#.info);
  mut .do(r: mut MF[Void]): mut Block[R] -> 
    Block#(r#,this);
  mut .assert(p: read F[Bool]): mut Block[R] ->
    Block#(Assert!(p#),this);
  mut .assert(p: read F[Bool], failMsg: read LazyInfo): mut Block[R] ->
    Block#(Assert!(p#,failMsg),this);
  mut .let[X:*](x: mut MF[X], cont: mut Continuation[X,R]): R ->
    cont#(x#, this);
  mut .openIso[X](x: iso X, cont: mut OpenIsoContinuation[X,R]): R ->
    cont#(x, this);
  mut .var[X:*]( x: mut MF[X], cont: mut Continuation[mut Var[X], R] ): R ->
    cont#(Vars#(x#), this);
  mut .repr[X](x: mut ReprWithInvariant[X], cont: mut Continuation[mut Repr[X], R] ): R ->
    cont#(Reprs#(x.elem,x.invariant), this);
//  mut .isoPod[X]( x: iso X, cont: mut Continuation[mut IsoPod[X], R]): R ->
//    cont#(IsoPod#(x), this);
  mut .if(p: mut MF[Bool]): mut BlockIf[R] -> p# ? {
    .then -> {
      .return a -> _DecidedBlock#(a#);
      .error  i -> Error!(i#.info);
      .do     r -> Block#(r#,this);
      .done     -> _DecidedBlock#(Void);
      };
    .else -> {
      .return _ -> this;
      .error  _ -> this;
      .do     _ -> this;
      .done     -> Block#[Void];
      };
    };
  /// iterates `body` without growing the call stack per iteration.
  /// Logically equivalent to:
  /// ```
  ///   body#.match ControlFlowMatch[R]: {
  ///     .continue -> this.loop(body);
  ///     .break    -> this;
  ///     .return v -> _DecidedBlock#v;
  ///     };
  /// ```
  mut .loop(body: mut MF[mut ControlFlow[R]]): mut Block[R] -> _NativeLoop#(this, body);
  /// ``this.loop(a, body)`` is `Block.loop` handing ``a`` to every iteration.
  mut .loop[A](a: mutH A, body: mut LoopBody[A,R]): mut Block[R] ->
    _NativeLoop#(this, a, body);
  }

_NativeLoop: Sealed {
  #[R:*](self: mut Block[R], body: mut MF[mut ControlFlow[R]]): mut Block[R] -> _Magic!;
  #[A,R:*](self: mut Block[R], a: mutH A, body: mut LoopBody[A,R]): mut Block[R] -> _Magic!;
  }

//@Group "imperative"
LoopBody[A,R:*]: { mut #(a: mutH A): mut ControlFlow[R] }

//@Group "imperative"
BlockIf[R:*]: {
  mut .return(a: mut MF[R]): mut Block[R];
  mut .do(r: mut MF[Void]): mut Block[R];
  mut .error(info: LazyInfo): mut Block[R];
  mut .done: mut Block[Void];
  }

_DecidedBlock: {
  #[R:*](res: R): mut Block[R] -> { 'self
    .return  _    -> res;
    .do      _    -> self;
    .let     _, _ -> res;
    .openIso _, _ -> res;
    .var     _, _ -> res;
    .repr    _, _ -> res;
    .error   _    -> res;
    //.isoPod  _, _ -> res;
    .assert  _    -> self;
    .assert  _, _ -> self;
    .loop    _    -> self;
    .loop    _, _ -> self;
    .if      _    -> {
      .return _ -> self;
      .do     _ -> self;
      .error  _ -> self;
      .done     -> _DecidedBlock#(Void);
      };
    }
  }

//@Group "imperative"
ControlFlow[R:*]: Sealed { mut .match(m: mut ControlFlowMatch[R]): mut Block[R]; }
//@Group "imperative"
ControlFlowMatch[R:*]: {
  mut .continue: mut Block[R];
  mut .break: mut Block[R];
  mut .return(v: R): mut Block[R];
  }
/// `Continue` or `Break`, never `OuterReturn`: the `ControlFlow` an actor lambda answers.
//@Group "imperative"
ContinueBreak[R:*]: ControlFlow[R] {}
//@Group "imperative"
Continue: {#[R:*]: mut ContinueBreak[R]->{::.continue}}
//@Group "imperative"
Break: {#[R:*]: mut ContinueBreak[R]->{::.break}}
//@Group "imperative"
OuterReturn: {#[R:*](r: R): mut ControlFlow[R]->{::.return r} }