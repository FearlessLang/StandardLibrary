Var[E:imm,mut,read]: {
  read .get: read/imm E;
  mut  .get: E;
  mut .swap(v: E): E;
  mut .set(v: E): Void -> Block#(this.swap(v), Void);
  }

Vars:Sealed{#[E:*](var: E): mut Var[E] -> _Magic!}

Count[N]: Var[N] {
  mut ++: Void;
  mut --: Void;
  mut +=(n: N): Void;
  mut -=(n: N): Void;
  mut *=(n: N): Void;
  }

Count: {
  .int(n: Int): mut Count[Int] -> Block#
    .var[Int] c = {n}
    .return {{
      mut .get    -> c.get[mut];
      read .get   -> c.get[read];
      .swap x -> c.swap(x);
      ++      -> c .set (c.get + +1);
      --      -> c .set (c.get - +1);
      +=   n2 -> c .set (c.get + n2);
      -=   n2 -> c .set (c.get - n2);
      *=   n2 -> c .set (c.get * n2);
      }};
  .nat(n: Nat): mut Count[Nat] -> Block#
    .var[Nat] c = {n}
    .return {{
      mut .get    -> c.get[mut];
      read .get   -> c.get[read];
      .swap x -> c.swap(x);
      ++      -> c .set (c.get + 1);
      --      -> c .set (c.get - 1);
      +=   n2 -> c .set (c.get + n2);
      -=   n2 -> c .set (c.get - n2);
      *=   n2 -> c .set (c.get * n2);
      }};
  }

IsoPods: {
  /// ``IsoPods#(v)`` wraps a fresh ``iso T`` value into a mutable capsule (``IsoPod[T]``), initially closed:
  /// it can be peeked or mutated in place any number of times, or opened exactly once to hand the wrapped
  /// ``iso T`` back out, after which the pod is permanently empty.
  //>   .check{Block#
  //>     .let pod={IsoPods#(Count.int +5)}
  //>     .do{pod.isClosed .assertTrue}
  //>     .do{pod.peek{ .some c -> c.get .assertEq +5; .empty -> Error.msg`should be closed`}}
  //>     .do{pod.mutate{ .some c -> c++; .empty -> Error.msg`should be closed`}}
  //>     .do{pod.peek{ .some c -> c.get .assertEq +6; .empty -> Error.msg`should be closed`}}
  //>     .do{pod.open.get .assertEq +6}
  //>     .do{pod.isClosed .assertFalse}
  //>     .do{pod.peek{ .some _ -> Error.msg`should be empty`; .empty -> Void}}
  //>     .done}
  //>   .checkDetErr({::}, {Block#
  //>     .let pod={IsoPods#(+5)}
  //>     .do{Block#(pod.open, Void)}
  //>     .do{Block#(pod.open, Void)}
  //>     .return{Void}
  //>     })
  #[T](val: iso T): mut IsoPod[T] -> _Magic!;
  }

IsoPod[T]: {
  read .isClosed: Bool;
  read .peek[R:iso,imm,mut,read,mutH](f: mut IsoViewer[T, R]): R;//Crucially not readH
  read .look[R:iso,imm,mut,read,mutH](f: mut MF[readH T, R]): R -> this.peek{
    .some x -> f#x;
    .empty -> Error.msg `The IsoPod was open`;
    };
  mut .open: iso T;                ///and makes .isClosed false; errors (deterministically) if already open
  read .isOpen: Bool -> this.isClosed.not;
  mut .consume[R:**](f: mut IsoConsumer[T, R]): R ->
    this.isClosed ? { .then -> f.some(this.open); .else -> f.empty };
  mut .mutate[R:iso,imm,mut,read](f: mut IsoMutator[T, R]): R;
  mut .blindMutate(f: F[mut T, Void]): Void-> ///NO operation on open
    this.mutate{
      mhT->f#mhT;//by useMutH1 promotion
      Void;
      };
  }

IsoConsumer[T, R:**]: {
  mut .some(x: iso T): R;
  mut .empty: R;
  }

IsoMutator[T, R:iso,imm,mut,read]: {
  mut .some(x: mutH T): R;
  mut .empty: R;
  }

IsoViewer[T, R:iso,imm,mut,read,mutH]: {//crucially readH not allowed
  mut .some(x: readH T): R;
  mut .empty: R;
  }

Reprs: {
  #[T](x: iso T, inv: F[read T,Bool]): mut Repr[T] -> Block#
    .openIso _x = x
    .if {inv#(_x).not} .error {Infos.msg`Invariant does not initially hold`} 
    .return{mut Repr[T]: {'self
      mut .mutate[R:iso,imm,mut,read](f: mut MF[mutH T,R]): R -> _IdOrErr#(_NoYield#{f#(_x)},inv#(_x),_ReprCacheFlush#(self));
      read .look[R](f: read F[read T,R]): R -> f#(_x);
      read .cachableLook[R](f: CacheReprF[T,R]): R -> f._get(self);
      read .cachableLook[A,R](a: Norm[A], f: CacheReprF[T,A,R]): R -> f._get(self,a);
      }}
  }

/// Runs the block with `Yield` disabled, so a mutation is never cut halfway.
_NoYield: Sealed { #[R:iso,imm,mut,read](f: mut MF[R]): R -> _Magic!; }

_IdOrErr: {#[R:iso,imm,mut,read](r:R,b:Bool,_:Void):R->Block#(//Needed for the iso case of R
  b?{.then->Void; .else->Error.msg`Invariant does not hold after mutation`},
  r
  )}

FilterAny: {
  /// ``FilterAny#(r, pred, fallback)`` returns ``r`` if ``pred#(r)`` is ``True``, otherwise calls and returns ``fallback#``.
  //>   .check{FilterAny#(+5, {n -> n == +5}, {-1}) .assertEq +5}
  //>   .check{FilterAny#(+3, {n -> n == +5}, {-1}) .assertEq -1}
  #[R:**](R,F[R,Bool],F[R]):R->_Magic!
  }//Needed in some cases. Should it be part of the magic?
