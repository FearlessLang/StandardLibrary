CapDownload: ToIso[CapDownload], WidenTo[CapDownload] {
  mut .downloadBytes(url: Str, maxBytes: Nat): List[Byte];

  mut .downloadStr(url: Str, maxBytes: Nat, cleaner: F[Str, mut StrCleaner]): Str;
  mut .downloadUStr(url: Str, maxBytes: Nat, cleaner: F[UStr, mut UStrCleaner]): UStr;

  mut .downloadImage(url: Str, maxBytes: Nat, maxPixels: Nat): Image;
  }
