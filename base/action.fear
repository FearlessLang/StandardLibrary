Actions: {
  //.lazy is a bad method, suggests failure causes .info, but of course not.
  //.lazy[T:*](f: mut MF[T]): mut Action[T] -> {::.ok(f#)};
  .ok[R:*](x: R): mut Action[R] -> {::.ok(x)};
  .info[R:*](info: Info): mut Action[R] -> {::.info(info)};
  .msg[R:*](msg: Str): mut Action[R] -> {::.info(Infos.msg msg)};
  }

Action[R:*]: {
  mut .run[RR:*](m: mut ActionMatch[R,RR]): RR;
  mut .map[RR:*](f: mut MF[R,RR]): mut Action[RR] -> {m -> this.run{
    .ok   x -> m.ok(f#x);
    .info i -> m.info(i);
    }};
  mut .andThen[RR:*](f: mut MF[R,mut Action[RR]]): mut Action[RR] -> {m -> this.run{
    .ok   x -> f#x.run(m);
    .info i -> m.info(i);
    }};
  mut .mapInfo(f: mut MF[Info,Info]): mut Action[R] -> {m -> this.run{
    .ok   x -> m.ok(x);
    .info i -> m.info(f#i);
    }};
  mut !: R -> this.run{.ok(x) -> x; .info(i) -> Error!i};
  mut .ok  : mut Opt[R] -> this.run{.ok x -> Opts#x; .info _ -> {}};
  mut .info: Opt[Info]  -> this.run[Opt[Info]]{.ok _ -> {}; .info i -> Opts#i};
  mut .context(msg: read LazyInfo): mut Action[R] -> { m -> this.run {
    .ok x -> m.ok(x);
    .info i -> m.info(msg#.info + i)
    }};

  mut .assertOk: Void -> this.run{
    .ok _ -> {};
    .info i -> Assert.msg("Success expected but an Info was thrown:" | i.str);
  };
  mut .assertInfo: Void -> this.run{
    .ok _ -> Assert.msg "Failure expected but nothing was thrown";
    .info _->{};
    };

  mut .recover(recoveryMechanism: mut MF[Info, mut Opt[R]]): mut Action[R] -> {m -> this.run {
    .ok x -> m.ok(x);
    .info i -> recoveryMechanism#i .match {
       .some x' -> m.ok(x');
       .empty -> m.info(i);
      }
    }};


  mut .catch(fallback: mut MF[Info, R]): R -> this.run {
    .ok t -> t;
    .info i -> fallback#i;
    };

  /// ``this.assertInfo constraint`` asserts that this action fails and that the failure info satisfies the given constraint.
  //> .checkNonDetErr({::}, {Try#{1 / 0}.assertInfo{::.isMsg{::.contains "divide by zero"}}});
  mut .assertInfo(constraint: F[InfoValidator, InfoValidator]): Void -> this.run{
    .ok _ -> Assert.msg "Failure expected but nothing was thrown";
    .info info ->
      Assert!(
        info.validate constraint,
        {"Failure correctly occurred but error info doesn't match constraint."
        | "Got: "+info}
        )
    }; // TODO: Should InfoValidator implement ToStr so it can be used in this error message?
  }

ActionMatch[R:*,RR:*]: {
  mut .ok(x: R): RR;
  mut .info(info: Info): RR;
  }
