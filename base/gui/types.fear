_Caption[S]: Widget[S]{
  mut .text(s:Str):mut S->this.uText(s.u);
  mut .uText(UStr):mut S;
  mut .textHeight(n:Nat): mut S->this.textHeight'(HeightNat#n);
  mut .textHeight'(HeightNat):mut S;
  mut .aboveBaseline(f:Float):mut S->this.aboveBaseline'(TextRatio#f);
  mut .aboveBaseline'(TextRatio):mut S;
  mut .belowBaseline(f:Float):mut S->this.belowBaseline'(TextRatio#f);
  mut .belowBaseline'(TextRatio):mut S;
  read .text:Str->this.uText.getStr; ///throws if the text was set with .uText and is not a valid Str
  read .uText:UStr;
  read .textHeight:HeightNat;
  read .aboveBaseline:TextRatio;
  read .belowBaseline:TextRatio;
  }
TextRatio:LevelFloat[TextRatio]{.name->"TextRatio"; .getDataType -> +1.0;
  .lowest -> 0.0 .getSucc; .highest -> +1024.0 .getPred;
  ._unchecked t -> { .getDataType->t };
  .close->this; .close->::; }
Button: _Caption[Button]{
