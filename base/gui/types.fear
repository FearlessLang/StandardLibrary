Wrapper[S,T]: DataType[S,S] {
  read .get: T -> this.getDataType.close;
  read .name: Str;
  read .getDataType: DataType[T,T];
  .str -> this.name+"["+(this.getDataType.close(this.get).str)+"]";
  read #(t:T): S;
  .hash -> this.getDataType.close(this.get).hash;
  .cmp(a,b,m) ->
    this.getDataType.cmp(this.close(a).get, this.close(b).get, m);
  read .close(s: read S): read Wrapper[S,T];
  .info->this.getDataType.close(this.get).info;
  .imm->this#(this.get);
}
ExtentNat[S]: Wrapper[S,Nat] {
  +(other: S): S -> this#(this.get + (this.close(other).get));
  -(other: S): S -> this#(this.get - (this.close(other).get));
  .gap(other: S): S -> Block#
    .let a = { this.get }
    .let b = { this.close(other).get }
    .return { (a >= b).if{ .then -> this#(a - b); .else -> this#(b - a) } };
  *(k: Nat): S -> this#(this.get * k);
  .getTruncDiv(k: Nat): S -> this#(this.get.getTruncDiv k);
  /// ``this.tryGetTruncDiv(k)`` returns `.ok` of ``this.getTruncDiv(k)``, or the error info of ``this.get.getTruncDiv(k)`` iff ``k == 0``.
  //>   .check{((WidthNat#6).tryGetTruncDiv 2).assertOk}
  //>   .check{(WidthNat#6).tryGetTruncDiv 0 .assertInfo{::.isMsg{::.startsWith "Nat.getTruncDiv:"}}}
  .tryGetTruncDiv(k: Nat): mut Action[S] -> this.get.tryGetTruncDiv(k).map{x -> this#x};
  .zero: S -> this#0;
  }

CoordNat[S,E]: Wrapper[S,Nat] {
  read .extent: Wrapper[E,Nat];
  +(d: E): S -> this#(this.get + (this.extent.close(d).get));
  -(d: E): S -> this#(this.get - (this.extent.close(d).get));
  .to(other: S): E -> this.extent#(this.close(other).get - (this.get));
  .gap(other: S): E -> Block#
    .let a = { this.get }
    .let b = { this.close(other).get }
    .return { (a >= b).if{ .then -> this.extent#(a - b); .else -> this.extent#(b - a) } };
  .origin: S -> this#0;
  }

CoordInt[S,E]: Wrapper[S,Int] {
  read .extent: Wrapper[E,Nat];
  +(d: E): S -> this#(this.get + (this.extent.close(d).get.getInt));
  -(d: E): S -> this#(this.get - (this.extent.close(d).get.getInt));
  .to(other: S): E -> this.extent#(this.close(other).get - (this.get) .getNat);
  .gap(other: S): E -> Block#
    .let a = { this.get }
    .let b = { this.close(other).get }
    .return { (a >= b).if{
      .then -> this.extent#(a - b .getNat);
      .else -> this.extent#(b - a .getNat) } };
  .origin: S -> this#(+0);
  }

XInt:CoordInt[XInt,WidthNat]{.name->"X"; .getDataType -> +0; .extent -> WidthNat;
  # t ->{ .getDataType->t }; .close->this; .close->::; }
YInt:CoordInt[YInt,HeightNat]{.name->"Y"; .getDataType -> +0; .extent -> HeightNat;
  # t ->{ .getDataType->t }; .close->this; .close->::; }
WidthNat:ExtentNat[WidthNat]{.name->"Width"; .getDataType -> 0;
  # t ->{ .getDataType->t }; .close->this; .close->::; }
HeightNat:ExtentNat[HeightNat]{.name->"Height"; .getDataType -> 0;
  # t ->{ .getDataType->t }; .close->this; .close->::; }

Rect: {
  .x: XInt; .y: YInt; .width: WidthNat; .height: HeightNat;
  .right: XInt -> this.x + (this.width);
  .bottom: YInt -> this.y + (this.height);
  .contains(x: XInt, y: YInt): Bool ->
    x >= (this.x) && { x <= (this.right) }
    && { y >= (this.y) } && { y <= (this.bottom) };
  }
Rects: { #(x: XInt, y: YInt, width: WidthNat, height: HeightNat): Rect ->
  { .x -> x; .y -> y; .width -> width; .height -> height; } }

LevelByte[S]: Wrapper[S,Byte] {
  +(other: S): S -> this#(this.get + (this.close(other).get));
  -(other: S): S -> this#(this.get - (this.close(other).get));
  .gap(other: S): S -> Block#
    .let a = { this.get }
    .let b = { this.close(other).get }
    .return { (a >= b).if{ .then -> this#(a - b); .else -> this#(b - a) } };
  .getTruncDiv(k: Nat): S -> this#(this.get.getTruncDiv k);
  /// ``this.tryGetTruncDiv(k)`` returns `.ok` of ``this.getTruncDiv(k)``, or the error info of ``this.get.getTruncDiv(k)`` iff ``k == 0``.
  //>   .check{((Red#(6.getByte)).tryGetTruncDiv 2).assertOk}
  //>   .check{(Red#(6.getByte)).tryGetTruncDiv 0 .assertInfo{::.isMsg{::.startsWith "Byte.getTruncDiv:"}}}
  .tryGetTruncDiv(k: Nat): mut Action[S] -> this.get.tryGetTruncDiv(k).map{x -> this#x};
  .min: S -> this#(Math.minByte);
  .max: S -> this#(Math.maxByte);
  }

LevelFloat[S]: Wrapper[S,Float] {
  read .lowest: Float;
  read .highest: Float;
  +(other: S): S -> this#(this.get + (this.close(other).get));
  -(other: S): S -> this#(this.get - (this.close(other).get));
  .gap(other: S): S -> this#((this.get - (this.close(other).get)).getAbs);
  .min: S -> this#(this.lowest);
  .max: S -> this#(this.highest);
  }

Red:LevelByte[Red]{.name->"Red"; .getDataType -> 0.getByte;
  # t ->{ .getDataType->t }; .close->this; .close->::; }
Green:LevelByte[Green]{.name->"Green"; .getDataType -> 0.getByte;
  # t ->{ .getDataType->t }; .close->this; .close->::; }
Blue:LevelByte[Blue]{.name->"Blue"; .getDataType -> 0.getByte;
  # t ->{ .getDataType->t }; .close->this; .close->::; }
Alpha:LevelByte[Alpha]{.name->"Alpha"; .getDataType -> 0.getByte;
  # t ->{ .getDataType->t }; .close->this; .close->::;
  .opaque:Alpha->Alpha.max;
  .transparent:Alpha->Alpha.min;
  }
CyclicFloat[S]: Wrapper[S,Float] {
  read .period: Float;
  +(other: S): S -> this#(Math.euclideanMod(this.get + (this.close(other).get), this.period));
  -(other: S): S -> this#(Math.euclideanMod(this.get - (this.close(other).get), this.period));
  .normalize: S -> this#(Math.euclideanMod(this.get, this.period));
  }

Hue:CyclicFloat[Hue]{.name->"Hue"; .getDataType -> 0.0; .period -> +1.0;
  # t ->Block#(t.assertInRange(0.0=~~=1.0, {"Hue must be between 0 and 1"}),
  { .getDataType->t });
  .close->this; .close->::; }
Saturation:LevelFloat[Saturation]{.name->"Saturation"; .getDataType -> 0.0;
  .lowest -> 0.0; .highest -> +1.0;
  # t ->Block#(t.assertInRange(0.0=~~=1.0,{"Saturation must be between 0 and 1"}),
  { .getDataType->t });
  .close->this; .close->::; }
Brightness:LevelFloat[Brightness]{.name->"Brightness"; .getDataType -> 0.0;
  .lowest -> 0.0; .highest -> +1.0;
  # t ->Block#(t.assertInRange(0.0=~~=1.0,{"Brightness must be between 0 and 1"}),
  { .getDataType->t });
  .close->this; .close->::; }

_KeyNames: Sealed{ .isName(name: Str): Bool -> _Magic!; }
KeyStroke:Wrapper[KeyStroke,Str]{.name->"KeyStroke"; .getDataType -> "UNDEFINED";
  # t ->Block#
    .if{_KeyNames.isName(t).not}.error{`KeyStroke#"`+t+`" is not a key name. Key names are the names of the VK_ constants of java.awt.event.KeyEvent without VK_, for example "A", "7", "SPACE", "ENTER", "ESCAPE", "BACK_SPACE", "LEFT", "F1", "SHIFT".`}
    .return{{ .getDataType->t }};
  .close->this; .close->::; }

Duration:ExtentNat[Duration]{.name->"Duration"; .getDataType -> 0;
  # t ->{ .getDataType->t };
  .seconds(t:Nat):Duration->this#(t*1000000);
  .milliSeconds(t:Nat):Duration->this#(t*1000);
  .close->this; .close->::; }
Instant:CoordNat[Instant,Duration]{.name->"Instant"; .getDataType -> 0; .extent -> Duration;
  # t ->{ .getDataType->t }; .close->this; .close->::; }
Color:DataType[Color,Color]{
  .close->this; .close->::;
  read .red:Red->{};
  read .green:Green->{};
  read .blue:Blue->{};
  read .alpha:Alpha->Alpha.opaque;
  #(red:Red,green:Green,blue:Blue,alpha:Alpha):Color->{
    .red->red;
    .green->green;
    .blue->blue;
    .alpha->alpha;
    };
  .str -> "Color["+(this.red)+", "+(this.green)+", "+(this.blue)+", "+(this.alpha)+"]";
  .hash ->     this.red.hash
    .hashWith (this.green.hash)
    .hashWith (this.blue.hash)
    .hashWith (this.alpha.hash);
  .cmp(a,b,m) -> a.red<=>(b.red,m &&{a.green<=>(b.green,m &&{a.blue<=>(b.blue,m &&{a.alpha<=>(b.alpha,m)})})});
  .info->this.str.info;
  .imm->Color#(this.red,this.green,this.blue,this.alpha);
  .transparent:Color->Color#({},{},{},Alpha.transparent);
  .rgb(r:Nat,g:Nat,b:Nat):Color->Color#(Red#(r.getByte),Green#(g.getByte),Blue#(b.getByte),Alpha.opaque);
  .boringGray:Color->this.rgb(160,160,160);
  .voidBlack:Color->this.rgb(0,0,0);
  .ghostWhite:Color->this.rgb(245,245,245);
  .rubberDuck:Color->this.rgb(255,220,40);
  .bananaBruise:Color->this.rgb(126,96,32);
  .dangerTomato:Color->this.rgb(230,64,48);
  .lavaOrange:Color->this.rgb(255,96,16);
  .wizardPurple:Color->this.rgb(116,64,196);
  .sleepyBlue:Color->this.rgb(72,120,210);
  .deepNapBlue:Color->this.rgb(24,48,112);
  .goblinGreen:Color->this.rgb(40,170,64);
  .toxicSlime:Color->this.rgb(120,255,32);
  .alienMint:Color->this.rgb(128,255,190);
  .swampTea:Color->this.rgb(82,112,54);
  .rustyRobot:Color->this.rgb(174,86,44);
  .dustyRose:Color->this.rgb(196,120,132);
  .blueberrySoup:Color->this.rgb(64,72,176);
  .terminalGreen:Color->this.rgb(32,220,80);
  .panicPink:Color->this.rgb(255,72,168);
  .cardboard:Color->this.rgb(178,136,86);
  .moonCheese:Color->this.rgb(236,226,148);
  }
_Styled[S]:{
  mut .self:mut S;
  mut .save(c:mut Consumer[mut S]):mut S->Block#(c.accept(this.self),this.self);
  mut .style(s:mut Scope[S]):mut S->Block#(s.run(this.self),this.self);
}
Widget[S]:_Styled[S]{
  mut .topInset(n:Nat):mut S->this.topInset'(HeightNat#n);
  mut .topInset'(HeightNat):mut S;
  mut .bottomInset(n:Nat):mut S->this.bottomInset'(HeightNat#n);
  mut .bottomInset'(HeightNat):mut S;
  mut .leftInset(n:Nat):mut S->this.leftInset'(WidthNat#n);
  mut .leftInset'(WidthNat):mut S;
  mut .rightInset(n:Nat):mut S->this.rightInset'(WidthNat#n);
  mut .rightInset'(WidthNat):mut S;
  mut .width(n:Nat):mut S->this.width'(WidthNat#n);
  mut .width'(WidthNat):mut S;
  mut .height(n:Nat):mut S->this.height'(HeightNat#n);
  mut .height'(HeightNat):mut S;
  mut .autoWidth:mut S;
  mut .autoHeight:mut S;
  mut .radius(Nat):mut S;
  mut .foreground(Color):mut S;
  mut .background(Color):mut S;
  mut .autoSize:mut S->Block#(this.autoWidth,this.autoHeight);
  read .topInset: HeightNat;
  read .bottomInset: HeightNat;
  read .leftInset:WidthNat;
  read .rightInset:WidthNat;
  read .width:Opt[WidthNat];
  read .height:Opt[HeightNat];
  read .radius:Nat;
  read .foreground:Color;
  read .background:Color;
}
_Container[S]:Widget[S]{
  mut .heightGap(n:Nat):mut S->this.heightGap'(HeightNat#n);
  mut .heightGap'(HeightNat):mut S;
  mut .widthGap(n:Nat):mut S->this.widthGap'(WidthNat#n);
  mut .widthGap'(WidthNat):mut S;
  mut .mouse(mut Scope[Mouse]):mut S;
  mut .paint(Painter):mut S;
  read .heightGap:HeightNat;
  read .widthGap:WidthNat;
}
Border:_Container[Border]{
  .self->this;
  mut .north(mut Scope[Pane]):mut Border;
  mut .south(mut Scope[Pane]):mut Border;
  mut .east(mut Scope[Pane]):mut Border;
  mut .west(mut Scope[Pane]):mut Border;
  mut .center(mut Scope[Pane]):mut Border;
  mut .northB(mut Scope[Border]):mut Border;
  mut .southB(mut Scope[Border]):mut Border;
  mut .eastB(mut Scope[Border]):mut Border;
  mut .westB(mut Scope[Border]):mut Border;
