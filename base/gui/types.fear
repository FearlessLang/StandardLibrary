  }
ResizeRequest:ScreenContext{ read .aspectRatio: Float; }
ScreenContext:{
  read .elapsed: Instant;
  read .panelWidth: WidthNat;
  read .panelHeight: HeightNat;
  }
Graphics:ScreenContext{
  mut .color(Color): mut Graphics;
  mut .position(XInt, YInt): mut Graphics;
  mut .line(XInt, YInt): mut Graphics;
  mut .rect(WidthNat, HeightNat): mut Graphics;
  mut .oval(WidthNat, HeightNat): mut Graphics;
  mut .image(image: Image): mut Graphics -> this.image(image, image.width, image.height);
  ///Draws ``image`` scaled to ``width`` x ``height``, with its top left corner at the position.
  ///The image goes to the screen in one scaling step: an image with more pixels than the virtual pixels it covers stays sharp on a window scaled up.
  mut .image(image: Image, width: WidthNat, height: HeightNat): mut Graphics;
  mut .textHeight(n: Nat): mut Graphics -> this.textHeight'(HeightNat#n);
  mut .textHeight'(HeightNat): mut Graphics;
  mut .text(s: Str): mut Graphics -> this.uText(s.u);
  ///Draws ``text`` in the color, on one line whose top left corner is the position.
  ///The baseline is ``textHeight`` below the position, and the line is one and a half ``textHeight`` high, as the line of a ``Label`` with the default ``.aboveBaseline`` and ``.belowBaseline``.
  ///The position does not change. The text height starts at 12.
  mut .uText(text: UStr): mut Graphics;
  ///The color of the next drawing: the foreground of the widget, or opaque black for an image, until ``.color`` changes it.
  read .color: Color;
  read .positionX: XInt;
  read .positionY: YInt;
  read .textHeight: HeightNat;
  read .textWidth(text: Str): WidthNat -> this.uTextWidth(text.u);
  ///The width of ``text`` drawn by ``.uText`` at the current ``.textHeight``, rounded up to a whole virtual pixel.
  read .uTextWidth(text: UStr): WidthNat;
  }
///Text is drawn with fonts bundled in the standard library (Noto Sans, one Noto font per major script,
///Noto Sans Symbols/Math, Noto Sans CJK and Twemoji), never with the fonts installed on the machine:
///the same text looks the same on every OS, and a character outside those fonts is drawn as a box everywhere.
Gui:{
  mut .screenWidth: WidthNat;
  mut .screenHeight: HeightNat;
  mut .name(s: Str): mut Gui -> this.uName(s.u);
  mut .uName(UStr): mut Gui;
  mut .icon(ImageFile): mut Gui;
  mut .startAsWindow(initialArea: Float): mut Gui;
  mut .startMaximised: mut Gui;
  mut .startUndecorated(initialArea: Float): mut Gui;
  mut .startFullScreen: mut Gui;
  mut .minArea(Float): mut Gui;
  mut .opacityFloor(Alpha): mut Gui;
  mut .closeKey(KeyStroke): mut Gui;
  mut .fullScreenKey(KeyStroke): mut Gui;
  mut .run(mut Consumer[mut Frame]): Void;//public interface TopF{ void run(Frame f); }
  }
Label:_Caption[Label]{
