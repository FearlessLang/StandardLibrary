Mouse:_Styled[Mouse]{ .self->this;
  mut .clicked(mut MouseHandler):mut Mouse;
  ///On a widget with a ``.doubleClicked``, the second click of a double click runs ``.doubleClicked`` instead of ``.clicked``; a click after a double click is a single click again.
  ///A click is the second click of a double click when it is of the same mouse button as the click before, pressed at most 500 milliseconds after it, and at most 4 pixels of the screen away from it.
  mut .doubleClicked(mut MouseHandler):mut Mouse;
  mut .pressed(mut MouseHandler):mut Mouse;
  mut .released(mut MouseHandler):mut Mouse;
  mut .moved(mut MouseHandler):mut Mouse;
  mut .dragged(mut MouseHandler):mut Mouse;
  mut .entered(mut MouseHandler):mut Mouse;
  mut .exited(mut MouseHandler):mut Mouse;
}
///Runs for one mouse event of a widget.
///``x`` and ``y`` are where the pointer is, in virtual pixels from the top left corner of the widget.
///``elapsed``, ``panelWidth`` and ``panelHeight`` are as in ``ScreenContext``.
MouseHandler:{ mut #(x: XInt, y: YInt, elapsed: Instant, panelWidth: WidthNat, panelHeight: HeightNat): Void; }
///A column of items and separators, drawn by the library over every widget of the window, with the look of the library on every desk.
///A menu exists only while it is open: its scope builds it each time it opens, so it shows the state of the program when it opened.
///A menu with no item does not open.
///The items of a menu are fixed once its scope returns.
///A frame has at most one open menu, and the submenus opened from it: opening a menu closes the open one.
///A menu opens after its anchor or, when it does not fit there and fits before it, before it: below or above a widget or the pointer; right or left of the menu of its item.
///A menu below or above a widget or the pointer starts at the left edge of the widget or at the pointer or, when it does not fit there and fits so, ends at the right edge of the widget or at the pointer.
///Then it moves back by the least amount that keeps it inside the virtual pixel space.
///A menu taller than the virtual pixel space is as tall as the space and has a scroll bar on its right: the mouse wheel, the scroll bar, Up and Down scroll its items.
///While a menu is open, the mouse and the keys reach only the menus:
///  a click of the primary mouse button on an enabled item chooses it; a press and a release on two different items choose nothing;
///  a press outside the menus closes them all, and neither the press nor the rest of its gesture reaches anything else;
///  the window losing the focus closes them all;
///  text from an input method reaches nothing;
///  the second click of a double click reaches nothing when a menu took its first click or opened after it;
///  Up and Down highlight the previous and the next enabled item of the last open menu, Enter chooses the highlighted one;
///  the close key of the Gui closes the last open menu; the full screen key keeps its meaning; every other key reaches nothing.
///Choosing an item with a submenu opens the submenu, or closes it when it is open; choosing an item without a submenu closes every menu and queues its action.
///Nothing opens a menu on its own: no hover, no delay, no key binding.
Menu:_Styled[Menu]{ .self->this;
  mut .item(mut Scope[MenuItem]):mut Menu;
  mut .separator:mut Menu;
  }
///An item of a ``Menu``: one line of text, enabled by default, with no mark, no action and no submenu.
///An item shows the mark it is given, a check box or a radio button, ticked or not; choosing it changes no mark: the scope of the next opening shows the new state.
///An item has an action or a submenu, never both; it shows a check box or a radio button, never both: the second setter is an error.
MenuItem:_Styled[MenuItem]{ .self->this;
  mut .text(s:Str):mut MenuItem->this.uText(s.u);
  mut .uText(UStr):mut MenuItem;
  mut .enabled(Bool):mut MenuItem;
  mut .check(Bool):mut MenuItem;
  mut .radio(Bool):mut MenuItem;
  mut .action(mut MF[Void]):mut MenuItem;
  mut .submenu(mut Scope[Menu]):mut MenuItem;
  }
Pane:_Container[Pane]{
  .self->this;
  mut .pane(mut Scope[Pane]):mut Pane;
  mut .border(mut Scope[Border]):mut Pane;
  mut .split: mut RegionFiller[mut And[mut SplitWith[mut Pane]]];
  mut .sections(mut Scope[Sections]):mut Pane;
  mut .button(mut Scope[Button]):mut Pane;
  mut .label(mut Scope[Label]):mut Pane;
  mut .picture(mut Scope[Picture]):mut Pane;
  mut .textField(mut Scope[TextField]):mut Pane;
  mut .textArea(mut Scope[TextArea]):mut Pane;
  mut .clear:mut Pane;
  //Flow axis: .horizontal (default) lays children left-to-right, wrapping
  //into new rows; .vertical lays them top-to-bottom, wrapping into new
  //columns.
  mut .horizontal: mut Pane;
  mut .vertical: mut Pane;
  //A line holds at least .minPerLine children (default 1) and at most
  //.maxPerLine children (default Math.maxNat). Between the two, a child
  //that would overflow the Pane starts a new line.
  //A line holding .minPerLine children too long for the Pane overflows it.
  mut .minPerLine(Nat): mut Pane;
  mut .maxPerLine(Nat): mut Pane;
  //.lineScroll(True) scrolls along the lines, .stackScroll(True) across them;
  //with False (the default) what does not fit is clipped. A scroll bar is
  //shown whenever its setting is True, and the lines break against the
  //space left beside the bars.
  mut .lineScroll(Bool): mut Pane;
  mut .stackScroll(Bool): mut Pane;
  //.centered(True) (the default) centers each line along the flow axis,
  //the stack of lines across it, and each child across its line.
  //.centered(False) places them all at the start: the left and the top.
  mut .centered(Bool): mut Pane;
  }

RegionFiller[S:*]:{
  mut .pane(mut Scope[Pane]): S;
  mut .border(mut Scope[Border]): S;
  mut .split: mut RegionFiller[mut And[mut SplitWith[S]]];
  mut .sections(mut Scope[Sections]): S;
  mut .button(mut Scope[Button]): S;
  mut .label(mut Scope[Label]): S;
  mut .picture(mut Scope[Picture]): S;
  mut .textField(mut Scope[TextField]): S;
  mut .textArea(mut Scope[TextArea]): S;
  }
And[T:*]:{ mut .and: mut RegionFiller[T]; }
SplitWith[S:*]:{ mut .with(mut Scope[Split]): S; }

Scope[T]: { mut .run(mut T): mut T; }
Painter: { .run(mut Graphics): mut Graphics; }

Consumer[E:*]: { mut .accept(E): Void; }
Slots: {#[E:*]: mut Slot[E] -> Block#
  .var[mut Opt[E]] e = {{}}
  .return {mut Slot[E:*]: Consumer[E] {'slot
    .accept x -> slot.fill x;
    mut  !: E -> e.get!;
    read !: read/imm E -> e.get!;
    mut .fill(x: E): Void -> e.set(e.get.match{
      .some _ -> Error.msg "Slot was already full";
      .empty  -> Opts#x;
      });
    read .isFull: Bool -> e.get.isSome;
    mut .opt: mut Opt[E] -> e.get;
    //read .opt: read Opt[read/imm E] -> e.get; //TODO: correctly returning Opt[E], but it is undesirable?
    }};
  }
KeyEvent:ScreenContext{
  read .keyStroke:KeyStroke;
}
KeyActions:{#:mut KeyAction->Block#
  .let[mut EList[KeyStroke]] match= {ELists#}
  .let[mut EList[mut Consumer[KeyEvent]]] actions= {ELists#}
  .return{mut KeyAction:_Styled[KeyAction]{'self .self->self;
    mut .match: mut EList[KeyStroke]->match;
    mut .actions: mut EList[mut Consumer[KeyEvent]]->actions;
    mut .matchOnly(k: KeyStroke): mut KeyAction ->
      Block#(match.clear,self.matchAlso(k));
    mut .matchAlso(k: KeyStroke): mut KeyAction ->
      Block#(match.add(k),self);
    mut .doOnly(c: mut Consumer[KeyEvent]): mut KeyAction ->
      Block#(actions.clear,self.doAlso(c));
    mut .doAlso(c: mut Consumer[KeyEvent]): mut KeyAction ->
      Block#(actions.add(c),self);
  }}
}
Keys:_Styled[Keys]{ .self->this;
  mut .pressed(mut Scope[KeyAction]):mut Keys;
  mut .released(mut Scope[KeyAction]):mut Keys;
  }
