}
_TextWidget[S]: Widget[S]{
  mut .text(s:Str):mut S->this.uText(s.u);
  mut .uText(UStr):mut S;
  mut .textHeight(n:Nat): mut S->this.textHeight'(HeightNat#n);
  mut .textHeight'(HeightNat):mut S;
  read .text:Str->this.uText.getStr; ///throws if the text was set with .uText and is not a valid Str
  read .uText:UStr;
  read .textHeight:HeightNat;
}
Button: _TextWidget[Button]{
  .self-> this;
  mut .action(mut MF[Void]):mut Button;
}

ModelFps:_Styled[ModelFps]{ .self->this;
  mut .action(mut MF[Void]): mut ModelFps;
}
Frame:_Styled[Frame]{ .self->this;
  mut .title(s: Str): mut Frame -> this.uTitle(s.u);
  mut .uTitle(UStr): mut Frame;
  read .title: Str -> this.uTitle.getStr; ///throws if the title was set with .uTitle and is not a valid Str
  read .uTitle: UStr;
  mut .fps(fps: Nat): mut Frame;
  read .fps: Nat;
  read .elapsed: Instant;  //Time since game time zero (warmup end), as seen by the last repaint tick.
  read .screenWidth: WidthNat;
  read .screenHeight: HeightNat;
  read .locationX: XInt;
  read .locationY: YInt;
  mut .modelFps(fps: Nat, s: mut Scope[ModelFps]): mut Frame;
  mut .content(s: mut Scope[Pane]): Void;
  mut .contentB(s: mut Scope[Border]): Void;
  mut .location(x: Int, y: Int): mut Frame -> this.location'(XInt#x, YInt#y);
  mut .location'(XInt, YInt): mut Frame;
  mut .onKey(mut Scope[Keys]): mut Frame;
  mut .maximized: mut Frame;
  //The user may resize by dragging the window edges; without arguments the
  //initial size is computed from the content, with arguments it is as given.
  //The arguments are the content size, in the same unit as panelWidth and
  //panelHeight; the title bar and borders of a decorated window come on top.
  //Note: an undecorated window can be technically resizable, but there is no
  //border to drag, so the user cannot actually resize it.
  mut .resizable: mut Frame;
  mut .resizable(w: Nat, h: Nat): mut Frame -> this.resizable'(WidthNat#w, HeightNat#h);
  mut .resizable'(WidthNat, HeightNat): mut Frame;
  //The window size cannot be changed by the user; without arguments the size
  //is computed from the content, with arguments it is exactly as given.
  //The arguments are the content size, in the same unit as panelWidth and
  //panelHeight; the title bar and borders of a decorated window come on top.
  mut .fixedSize: mut Frame;
  mut .fixedSize(w: Nat, h: Nat): mut Frame -> this.fixedSize'(WidthNat#w, HeightNat#h);
  mut .fixedSize'(WidthNat, HeightNat): mut Frame;
  mut .undecorated(a: Alpha): mut Frame;
  mut .decorated: mut Frame;
  }
ScreenContext:{
  read .elapsed: Instant;
  read .screenWidth: WidthNat;
  read .screenHeight: HeightNat;
  read .panelWidth: WidthNat;
  read .panelHeight: HeightNat;
  }
Graphics:ScreenContext{
  mut .color(Color): mut Graphics;
  mut .position(x: Int, y: Int): mut Graphics -> this.position'(XInt#x, YInt#y);
  mut .position'(XInt, YInt): mut Graphics;
  mut .line(x: Int, y: Int): mut Graphics -> this.line'(XInt#x, YInt#y);
  mut .line'(XInt, YInt): mut Graphics;
  mut .rect(w: Nat, h: Nat): mut Graphics -> this.rect'(WidthNat#w, HeightNat#h);
  mut .rect'(WidthNat, HeightNat): mut Graphics;
  mut .oval(w: Nat, h: Nat): mut Graphics -> this.oval'(WidthNat#w, HeightNat#h);
  mut .oval'(WidthNat, HeightNat): mut Graphics;
  mut .image(Image): mut Graphics;
  }
///Text is drawn with fonts bundled in the standard library (Noto Sans, one Noto font per major script,
///Noto Sans Symbols/Math, Noto Sans CJK and Twemoji), never with the fonts installed on the machine:
///the same text looks the same on every OS, and a character outside those fonts is drawn as a box everywhere.
Gui:{ mut .run(mut Consumer[mut Frame]): Void }//public interface TopF{ void run(Frame f); }
Label:_TextWidget[Label]{
  .self->this;
}
Mouse:_Styled[Mouse]{ .self->this;
  mut .clicked(mut Consumer[MouseEvent]):mut Mouse;
  mut .pressed(mut Consumer[MouseEvent]):mut Mouse;
  mut .released(mut Consumer[MouseEvent]):mut Mouse;
  mut .moved(mut Consumer[MouseEvent]):mut Mouse;
  mut .dragged(mut Consumer[MouseEvent]):mut Mouse;
  mut .entered(mut Consumer[MouseEvent]):mut Mouse;
  mut .exited(mut Consumer[MouseEvent]):mut Mouse;
}
MouseEvent:ScreenContext{
  .mouseX:XInt;
  .mouseY:YInt;
}
Pane:_Container[Pane]{
  .self->this;
  mut .pane(mut Scope[Pane]):mut Pane;
  mut .border(mut Scope[Border]):mut Pane;
  mut .button(mut Scope[Button]):mut Pane;
  mut .label(mut Scope[Label]):mut Pane;
  mut .clear:mut Pane;
  //Flow axis: .horizontal (default) lays children left-to-right, wrapping
  //into new rows; .vertical lays them top-to-bottom, wrapping into new
  //columns.
  mut .horizontal:mut Pane;
  mut .vertical:mut Pane;
  //Breaks the flow into fixed-size lines of exactly n children each,
  //regardless of the container's available size along the flow axis (so,
  //unlike the default wrap, it neither depends on nor changes with a
  //resize). 0 (the default) means "no chunking": wrap by available size,
  //as before.
  mut .chunk(Nat):mut Pane;
}
Scope[T]:{ mut .run(mut T): mut T; }
Painter:{ .run(mut Graphics): mut Graphics; }

Consumer[E:*]:{ mut .accept(E):Void; }
Slots: {#[E:*]: mut Slot[E] -> Block#
  .var[mut Opt[E]] e = {{}}
  .return {mut Slot[E:*]:Consumer[E] {'slot
    .accept x-> slot.fill x;
    mut  !: E -> e.get!;
    read !: read/imm E -> e.get!;
    mut .fill(x: E): Void -> e.set(e.get.match{
      .some _ -> Error.msg "Slot was already full";
      .empty  -> Opts#x;
      });
    read .isFull: Bool -> e.get.isSome;
    mut .opt: mut Opt[E] -> e.get;
    //read .opt: read Opt[read/imm E] -> e.get; //TODO: correctly returning Opt[E], but it is undesirable?
    }};
  }
KeyEvent:ScreenContext{
  .keyStroke:KeyStroke;
}
KeyActions:{#:mut KeyAction->Block#
  .let[mut EList[KeyStroke]] match= {ELists#}
  .let[mut EList[mut Consumer[KeyEvent]]] actions= {ELists#}
  .return{mut KeyAction:_Styled[KeyAction]{'self .self->self;
    mut .match: mut EList[KeyStroke]->match;
    mut .actions: mut EList[mut Consumer[KeyEvent]]->actions;
    mut .matchOnly( k:KeyStroke): mut KeyAction->
      Block#(match.clear,self.matchAlso(k));
    mut .matchAlso( k:KeyStroke): mut KeyAction->
      Block#(match.add(k),self);
    mut .doOnly( c:mut Consumer[KeyEvent]): mut KeyAction->
      Block#(actions.clear,self.doAlso(c));
    mut .doAlso( c:mut Consumer[KeyEvent]): mut KeyAction->
      Block#(actions.add(c),self);
  }}
}
Keys:_Styled[Keys]{ .self->this;
  mut .pressed(mut Scope[KeyAction]):mut Keys;
  mut .released(mut Scope[KeyAction]):mut Keys;
  }
