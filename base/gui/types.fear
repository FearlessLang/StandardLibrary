CaretPainter:{ .run(mut CaretGraphics):mut Graphics; }
CaretGraphics:Graphics{ read .sinceMove:Duration; read .lineHeight:HeightNat; }
//The image always covers the whole widget, insets excluded.
//With .keepAspect(False) the image stretches to the widget.
//With .keepAspect(True) (the default) the last of .width and .height decides
//the other one, so the widget has the proportions of the image; a widget drawn
//larger by .fill shows the image scaled to cover it, centered, clipped on one axis.
Picture:Widget[Picture]{
  .self->this;
  mut .image(Image):mut Picture;
  mut .keepAspect(Bool):mut Picture;
  read .keepAspect:Bool;
